# Copy to project/android/signing.local.env (gitignored).
# Godot 4.3 reads these names and overrides the empty keystore fields
# in export_presets.cfg. Leave them unset to use Godot's generated debug keystore.
# Do not commit real keystores, .jks files, or passwords.

# GODOT_ANDROID_KEYSTORE_DEBUG_PATH=
# GODOT_ANDROID_KEYSTORE_DEBUG_USER=androiddebugkey
# GODOT_ANDROID_KEYSTORE_DEBUG_PASSWORD=
# GODOT_ANDROID_KEYSTORE_RELEASE_PATH=
# GODOT_ANDROID_KEYSTORE_RELEASE_USER=
# GODOT_ANDROID_KEYSTORE_RELEASE_PASSWORD=

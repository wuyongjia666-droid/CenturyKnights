      "lines": [
        {
          "speaker": "旁白",
          "text": "铁峡收窄。峡口的回声会把旗号喊成别人的——所以出峡前先对口令。"
        },
        {
          "speaker": "老旗手",
          "text": "窄路。弓手先占高。"
        },
        {
          "speaker": "系统",
          "text": "第三十一章·铁峡。"
        }
      ]
    },
    {
      "id": "31.1",
      "title": "铁峡关",
      "battle": "ch31_gorge",
      "unlock": [
        "ch31_gorge_done"
      ],
      "next": "31.2",
      "lines": [
        {
          "speaker": "旁白",
          "text": "「铁峡关」这一仗，要的不是热闹，是灰旗还敢不敢把姓念清楚。"
        },
        {
          "speaker": "斥候",
          "text": "敌阵已立。我探过东翼，西翼有林，南面是硬地。"
        },
        {
          "speaker": "系统",
          "text": "出战「铁峡关」。"
        }
      ]
    },
    {
      "id": "31.2",
      "title": "铁峡炉心",
      "battle": "ch31_forge",
      "unlock": [
        "ch31_forge_done"
      ],
      "next": "31.3",
      "lines": [
        {
          "speaker": "斥候",
          "text": "「铁峡炉心」——我听见金属声，不像农具。"
        },
        {
          "speaker": "管事",
          "text": "以我马鞭为号。鞭落，全队动。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "有人受伤就往后传，别硬撑在前排。"
        },
        {
          "speaker": "系统",
          "text": "出战「铁峡炉心」。"
        }
      ]
    },
    {
      "id": "31.3",
      "title": "铁印",
      "unlock": [
        "chapter31_done"
      ],
      "next": null,
      "lines": [
        {
          "speaker": "旁白",
          "text": "第三十一章·铁峡到了收束处。风停一刻，墨才能干。"
        },
        {
          "speaker": "春令使者",
          "text": "印若已落，便可回堡，也可继续下一章。灰旗的路，从来不是单行。"
        },
        {
          "speaker": "管事",
          "text": "银粮与声望已按章结算。旗手歇口气。"
        },
        {
          "speaker": "系统",
          "text": "第三十一章完成。"
        }
      ]
    }
  ]
}
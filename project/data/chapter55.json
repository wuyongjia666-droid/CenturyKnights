{
  "id": "chapter55",
  "title": "第五十五章·朔风",
  "beats": [
    {
      "id": "55.0",
      "title": "朔风令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "八卷中段之后，朔风关的风比镜湖硬。后半要验的是：破晓与水印之后，灰旗还敢不敢迎着北风举旗。"
        },
        {
          "speaker": "管事",
          "text": "两场：朔风关、朔风隘。打完，旅馆写『可朔风』。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "隘口一战路窄。治疗跟紧，别在风口站成靶。"
        },
        {
          "speaker": "老旗手",
          "text": "北风欺人。欺人的风，最怕整齐的阵。"
        },
        {
          "speaker": "系统",
          "text": "第八卷后半开启。"
        }
      ],
      "next": "55.1"
    },
    {
      "id": "55.1",
      "title": "朔风关",
      "lines": [
        {
          "speaker": "斥候",
          "text": "「朔风关」。北有丘，南有水，中间一块能站人的硬地——大家都想要。"
        },
        {
          "speaker": "老旗手",
          "text": "硬地让给弓手。步兵走侧。"
        },
        {
          "speaker": "系统",
          "text": "出战「朔风关」。"
        }
      ],
      "battle": "ch55_gale",
      "unlock": [
        "ch55_gale_done"
      ],
      "next": "55.2"
    },
    {
      "id": "55.2",
      "title": "朔风隘",
      "lines": [
        {
          "speaker": "管事",
          "text": "这一仗银粮都押上了——不是赌，是护。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "「朔风隘」我跟第三排。谁落单我就骂谁。"
        },
        {
          "speaker": "老旗手",
          "text": "骂完再救。"
        },
        {
          "speaker": "系统",
          "text": "出战「朔风隘」。"
        }
      ],
      "battle": "ch55_pass",
      "unlock": [
        "ch55_pass_done"
      ],
      "next": "55.3"
    },
    {
      "id": "55.3",
      "title": "可朔风",
      "lines": [
        {
          "speaker": "旁白",
          "text": "朔风两印落下。陆桥旅馆写入『可朔风』。北风还在，旗却没倒。"
        },
        {
          "speaker": "春令使者",
          "text": "下一章是曜廷。外阶与御座要落廷印。"
        },
        {
          "speaker": "系统",
          "text": "第五十五章完成。"
        }
      ],

{
  "id": "chapter170",
  "title": "第一百七十章·撞钟",
  "beats": [
    {
      "id": "170.0",
      "title": "撞钟令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可开市之后，撞钟要验的是：灰旗敢不敢把刀放短、把声放稳——声歪了，警会先从夜里倒进空票。"
        },
        {
          "speaker": "管事",
          "text": "两场：撞钟、守夜鼓。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "撞钟竖井高室，两侧有厢。守夜鼓棋丘环心。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸钟钮。砸了要写进王朝手记的黑页——无声之撞等于无警。"
        },
        {
          "speaker": "系统",
          "text": "第二十七卷后半。"
        }
      ],
      "next": "170.1"
    },
    {
      "id": "170.1",
      "title": "撞钟",
      "lines": [
        {
          "speaker": "斥候",
          "text": "撞钟室被撬，好锤堆在北室。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护钟火，别把战拖成哑城。竖井不利浪冲，先清厢。"
        },
        {
          "speaker": "管事",
          "text": "清厢掩护，北室夺锤。"
        },
        {
          "speaker": "系统",
          "text": "出战「撞钟」。"
        }
      ],
      "battle": "ch170_strike",
      "unlock": [
        "ch170_strike_done"
      ],
      "next": "170.2"
    },
    {
      "id": "170.2",
      "title": "守夜鼓",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "守夜鼓棋丘有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "丘格交错，场心垒禁乱火，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清索再守鼓。火不稳，席终盖不下印。"
        },
        {
          "speaker": "春令使者",
          "text": "鼓一哑，满城的夜都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「守夜鼓」。"
        }
      ],
      "battle": "ch170_nightwatch",
      "unlock": [
        "ch170_nightwatch_done"
      ],
      "next": "170.3"
    },
    {
      "id": "170.3",
      "title": "可守夜",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可守夜』。下一章是二十七卷席终——要把钟鼓的姓真正写入旗角。"
        },
        {
          "speaker": "春令使者",
          "text": "席终不是歇锤。是还敢不敢让满城听灰旗的声笺。"
        },
        {
          "speaker": "系统",
          "text": "第一百七十章完成。"
        }

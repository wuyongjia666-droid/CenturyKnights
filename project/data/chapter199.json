{
  "id": "chapter199",
  "title": "第一百九十九章·影市",
  "beats": [
    {
      "id": "199.0",
      "title": "影市令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "影印盖过之后，三十二卷后半要验影市与匣架——市里的影票会骗人，匣里的人偶会先动手。"
        },
        {
          "speaker": "管事",
          "text": "两场：影市、匣架。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "影市三列棚廊。匣架竖廊夹中，像一排关着影的屉。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸匣纽。砸了写进黑页——空匣等于空幕。"
        },
        {
          "speaker": "系统",
          "text": "第三十二卷后半。"
        }
      ],
      "next": "199.1"
    },
    {
      "id": "199.1",
      "title": "影市",
      "lines": [
        {
          "speaker": "斥候",
          "text": "影市棚廊被撬，好票堆在中廊。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护票，别把战拖成散市。三廊交错，落脚先想第二步。"
        },
        {
          "speaker": "管事",
          "text": "清廊掩护，中廊夺票。"
        },
        {
          "speaker": "系统",
          "text": "出战「影市」。"
        }
      ],
      "battle": "ch199_fair",
      "unlock": [
        "ch199_fair_done"
      ],
      "next": "199.2"
    },
    {
      "id": "199.2",
      "title": "匣架",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "匣架竖廊有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "外廊内屉，禁乱火，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清廊再夺匣。火不稳，独影开不了。"
        },
        {
          "speaker": "春令使者",
          "text": "匣一散，满市的影都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「匣架」。"
        }
      ],
      "battle": "ch199_box",
      "unlock": [
        "ch199_box_done"
      ],
      "next": "199.3"
    },
    {
      "id": "199.3",
      "title": "可匣",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可匣』。下一章是独影——要把后半真正推上台。"
        },
        {
          "speaker": "春令使者",
          "text": "独影不是歇灯。是还敢不敢一人成影。"
        },
        {
          "speaker": "系统",
          "text": "第一百九十九章完成。"
        }
      ],

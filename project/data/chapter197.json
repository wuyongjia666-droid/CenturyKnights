{
  "id": "chapter197",
  "title": "第一百九十七章·灯影",
  "beats": [
    {
      "id": "197.0",
      "title": "灯影令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可入幕之后，灯影要验的是：灰旗敢不敢把刀放短、把灯放稳——灯歪了，影会先从幕上倒进空票。"
        },
        {
          "speaker": "管事",
          "text": "两场：灯影、后台。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "灯影棋灯环心。后台曲尺廊，内有道具垒。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸灯芯。砸了要写进王朝手记的黑页——无灯之影等于无戏。"
        },
        {
          "speaker": "系统",
          "text": "第三十二卷中段。"
        }
      ],
      "next": "197.1"
    },
    {
      "id": "197.1",
      "title": "灯影",
      "lines": [
        {
          "speaker": "斥候",
          "text": "灯影被撬，好灯堆在心幕。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护灯火，别把战拖成散幕。棋灯格交错，落脚先想第二步。"
        },
        {
          "speaker": "管事",
          "text": "清格掩护，心幕夺灯。"
        },
        {
          "speaker": "系统",
          "text": "出战「灯影」。"
        }
      ],
      "battle": "ch197_lamp",
      "unlock": [
        "ch197_lamp_done"
      ],
      "next": "197.2"
    },
    {
      "id": "197.2",
      "title": "后台",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "后台曲尺有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "外廊内室，道具垒禁乱火，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清廊再夺台。火不稳，影印盖不下。"
        },
        {
          "speaker": "春令使者",
          "text": "台一散，满幕的影都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「后台」。"
        }
      ],
      "battle": "ch197_backstage",
      "unlock": [
        "ch197_backstage_done"
      ],
      "next": "197.3"
    },
    {
      "id": "197.3",
      "title": "可后台",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可后台』。下一章是影印——要把三十二卷中段真正盖上。"
        },
        {
          "speaker": "春令使者",
          "text": "影印不是歇灯。是还敢不敢续幕。"
        },
        {
          "speaker": "系统",
          "text": "第一百九十七章完成。"
        }
      ],

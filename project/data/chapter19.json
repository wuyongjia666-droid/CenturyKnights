{
  "id": "chapter19",
  "title": "第十九章·远岸",
  "beats": [
    {
      "id": "19.0",
      "title": "远岸点名",
      "next": "19.1",
      "lines": [
        {
          "speaker": "旁白",
          "text": "远岸的灯像在招手，招手的人要灰旗把姓写进潮汐表——写进去就得守。"
        },
        {
          "speaker": "管事",
          "text": "远岸一战。"
        },
        {
          "speaker": "系统",
          "text": "第十九章·远岸。"
        }
      ]
    },
    {
      "id": "19.1",
      "title": "远岸灯火",
      "battle": "ch19_shore",
      "unlock": [
        "ch19_shore_done"
      ],
      "next": "19.2",
      "lines": [
        {
          "speaker": "斥候",
          "text": "远岸灯有真有假。真灯按航线，假灯往礁区引。"
        },
        {
          "speaker": "管事",
          "text": "认航线再进。别买『近路』——近路要改姓。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "第一盏太亮的往往是诱饵。"
        },
        {
          "speaker": "系统",
          "text": "出战「远岸」。"
        }
      ]
    },
    {
      "id": "19.2",
      "title": "雾礁航道",
      "battle": "ch19_reef",
      "unlock": [
        "ch19_reef_done"
      ],
      "next": "19.3",
      "lines": [
        {
          "speaker": "斥候",
          "text": "礁区窄，船骨当障碍。一人探路，大队慢跟。"
        },
        {
          "speaker": "老旗手",
          "text": "别跳水。水里有暗桩，也有刀。"
        },
        {
          "speaker": "管事",
          "text": "护旗手走干礁脊。"
        },
        {
          "speaker": "系统",
          "text": "出战「礁带」。"
        }
      ]
    },
    {
      "id": "19.3",
      "title": "灯屿夜宴",
      "battle": "ch19_isle",
      "unlock": [
        "ch19_isle_done"
      ],
      "next": "19.4",
      "lines": [
        {
          "speaker": "斥候",
          "text": "「灯屿夜宴」敌阵已立。地形会骗人，人会藏在骗人的地方。"
        },
        {
          "speaker": "管事",
          "text": "按地形展开：先清射界，再推进。别浪冲成靶。"
        },
        {
          "speaker": "老旗手",
          "text": "护旗。技能别藏到用不上的时候。败了可重试，旗不能丢。"
        },
        {
          "speaker": "系统",
          "text": "出战「灯屿夜宴」。"
        }
      ]
    },
    {
      "id": "19.4",
      "title": "可远岸",
      "unlock": [
        "chapter19_done"
      ],
      "next": null,
      "lines": [
        {
          "speaker": "旁白",
          "text": "第十九章·远岸到了收束处。风停一刻，墨才能干。"
        },
        {
          "speaker": "春令使者",
          "text": "印若已落，便可回堡，也可继续下一章。灰旗的路，从来不是单行。"
        },
        {
          "speaker": "管事",
          "text": "银粮与声望已按章结算。旗手歇口气。"
        },
        {
          "speaker": "系统",
          "text": "第十九章完成。可进入第二十章·潮墙冠塔。"
        }
      ]
    }
  ]
}
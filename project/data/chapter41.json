      "lines": [
        {
          "speaker": "旁白",
          "text": "石冢下埋的不是鬼，是旧契约。挖开的人要负责把字读完。"
        },
        {
          "speaker": "管事",
          "text": "石冢。注意伏兵。"
        },
        {
          "speaker": "系统",
          "text": "第四十一章·石冢。"
        }
      ]
    },
    {
      "id": "41.1",
      "title": "石冢守望",
      "battle": "ch41_cairn",
      "unlock": [
        "ch41_cairn_done"
      ],
      "next": "41.2",
      "lines": [
        {
          "speaker": "旁白",
          "text": "「石冢守望」：旗帜可以湿，名册不能湿。"
        },
        {
          "speaker": "斥候",
          "text": "敌精锐靠后。前排散兵是诱饵，别追过深。"
        },
        {
          "speaker": "斥候",
          "text": "主旗居中，两翼用呼号，不靠眼神。"
        },
        {
          "speaker": "系统",
          "text": "出战「石冢守望」。"
        }
      ]
    },
    {
      "id": "41.2",
      "title": "石冢地库",
      "battle": "ch41_vault",
      "unlock": [
        "ch41_vault_done"
      ],
      "next": "41.3",
      "lines": [
        {
          "speaker": "春令使者",
          "text": "「石冢地库」——风从敌阵那边过来，带着金属味。 此地多林、垒。"
        },
        {
          "speaker": "老旗手",
          "text": "技能留给打开口的那一下，别打在空地上。"
        },
        {
          "speaker": "老旗手",
          "text": "我把东翼探过了：有伏，但伏得不深。"
        },
        {
          "speaker": "系统",
          "text": "出战「石冢地库」。"
        }
      ]
    },
    {
      "id": "41.3",
      "title": "石印",
      "unlock": [
        "chapter41_done"
      ],
      "next": null,
      "lines": [
        {
          "speaker": "旁白",
          "text": "第四十一章·石冢到了收束处。风停一刻，墨才能干。"
        },
        {
          "speaker": "春令使者",
          "text": "印若已落，便可回堡，也可继续下一章。灰旗的路，从来不是单行。"
        },
        {
          "speaker": "管事",
          "text": "银粮与声望已按章结算。旗手歇口气。"
        },
        {
          "speaker": "系统",
          "text": "第四十一章完成。"
        }
      ]
    }
  ]

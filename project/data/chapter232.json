{
  "id": "chapter232",
  "title": "第二百三十二章·瓷市",
  "beats": [
    {
      "id": "232.0",
      "title": "瓷市令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "三十七卷已执。第三十八卷·瓷市要验的是：灰旗敢不敢把脚放稳、把釉放清——釉裂了，瓷会先从架上碎成空旗。"
        },
        {
          "speaker": "管事",
          "text": "两场：瓷市、窑廊。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "瓷市釉池星布。窑廊中隔，桥口错落。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸瓷架。砸了写进黑页——空架等于空瓷。"
        },
        {
          "speaker": "系统",
          "text": "第三十八卷中段。"
        }
      ],
      "next": "232.1"
    },
    {
      "id": "232.1",
      "title": "瓷市",
      "lines": [
        {
          "speaker": "斥候",
          "text": "瓷市釉池被撬，好瓷堆在心垒。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护釉，别把战拖成碎雾。"
        },
        {
          "speaker": "管事",
          "text": "清池掩护，心垒夺瓷。"
        },
        {
          "speaker": "系统",
          "text": "出战「瓷市」。"
        }
      ],
      "battle": "ch232_yard",
      "unlock": [
        "ch232_yard_done"
      ],
      "next": "232.2"
    },
    {
      "id": "232.2",
      "title": "窑廊",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "窑廊中隔有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "外市内廊，桥口禁乱砸，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清桥再夺垒。釉不稳，釉池开不了。"
        },
        {
          "speaker": "春令使者",
          "text": "廊一散，满市的瓷都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「窑廊」。"
        }
      ],
      "battle": "ch232_kiln",
      "unlock": [
        "ch232_kiln_done"
      ],
      "next": "232.3"
    },
    {
      "id": "232.3",
      "title": "可廊",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可窑廊』。下一章是釉池。"
        },
        {
          "speaker": "春令使者",
          "text": "釉池不是歇釉。是还敢不敢成瓷。"
        },
        {
          "speaker": "系统",
          "text": "第二百三十二章完成。"
        }
      ],

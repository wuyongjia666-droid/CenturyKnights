{
  "id": "chapter146",
  "title": "第一百四十六章·义仓",
  "beats": [
    {
      "id": "146.0",
      "title": "义仓令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可开仓之后，义仓要验的是：灰旗敢不敢把刀放短、把粮放公——粮偏了，民会先从夜里倒在空票上。"
        },
        {
          "speaker": "管事",
          "text": "两场：义仓、守囤。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "义仓散垒。守囤场心有小垒，开阔。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸义仓。砸了要写进王朝手记的黑页——无义之仓等于无城。"
        },
        {
          "speaker": "系统",
          "text": "第二十三卷后半。"
        }
      ],
      "next": "146.1"
    },
    {
      "id": "146.1",
      "title": "义仓",
      "lines": [
        {
          "speaker": "斥候",
          "text": "义仓被撬，好粮堆在东垒。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护仓票，别把战拖成纵火。"
        },
        {
          "speaker": "管事",
          "text": "西垒掩护，东垒夺粮。"
        },
        {
          "speaker": "系统",
          "text": "出战「义仓」。"
        }
      ],
      "battle": "ch146_charity",
      "unlock": [
        "ch146_charity_done"
      ],
      "next": "146.2"
    },
    {
      "id": "146.2",
      "title": "守囤",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "守囤场有人投火折。"
        },
        {
          "speaker": "斥候",
          "text": "场心垒禁乱火，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清折再守囤。火不稳，席终盖不下印。"
        },
        {
          "speaker": "春令使者",
          "text": "囤一烧，满城的夜都会饿。"
        },
        {
          "speaker": "系统",
          "text": "出战「守囤」。"
        }
      ],
      "battle": "ch146_guard",
      "unlock": [
        "ch146_guard_done"
      ],
      "next": "146.3"
    },
    {
      "id": "146.3",
      "title": "可守囤",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可守囤』。下一章是二十三卷席终——要把粮仓的姓真正写入旗角。"
        },
        {
          "speaker": "春令使者",
          "text": "席终不是歇碾。是还敢不敢让满城看灰旗的仓票。"
        },
        {
          "speaker": "系统",
          "text": "第一百四十六章完成。"
        }
      ],
      "unlock": [

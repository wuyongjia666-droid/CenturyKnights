{
  "id": "chapter229",
  "title": "第二百二十九章·潮市",
  "beats": [
    {
      "id": "229.0",
      "title": "潮市令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "潮印盖过之后，三十七卷后半要验潮市与潮架——市里的潮票会骗人，架上的壳会先碎。"
        },
        {
          "speaker": "管事",
          "text": "两场：潮市、潮架。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "潮市三列棚廊。潮架竖廊夹中，像一排关着潮的屉。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸架纽。砸了写进黑页——空架等于空潮。"
        },
        {
          "speaker": "系统",
          "text": "第三十七卷后半。"
        }
      ],
      "next": "229.1"
    },
    {
      "id": "229.1",
      "title": "潮市",
      "lines": [
        {
          "speaker": "斥候",
          "text": "潮市棚廊被撬，好道堆在中廊。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护迹，别把战拖成退潮。"
        },
        {
          "speaker": "管事",
          "text": "清廊掩护，中廊夺道。"
        },
        {
          "speaker": "系统",
          "text": "出战「潮市」。"
        }
      ],
      "battle": "ch229_fair",
      "unlock": [
        "ch229_fair_done"
      ],
      "next": "229.2"
    },
    {
      "id": "229.2",
      "title": "潮架",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "潮架竖廊有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "外廊内屉，禁乱踏，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清廊再夺架。潮不稳，独潮开不了。"
        },
        {
          "speaker": "春令使者",
          "text": "架一散，满市的迹都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「潮架」。"
        }
      ],

{
  "id": "chapter116",
  "title": "第一百一十六章·驿站",
  "beats": [
    {
      "id": "116.0",
      "title": "驿站令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可开市之后，驿站要验的是：灰旗敢不敢把刀放短、把车放稳——车歪了，旗会先从镖师背上摔下去。"
        },
        {
          "speaker": "管事",
          "text": "两场：驿站、护镖。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "驿站西丘东垒。护镖场心有小垒，开阔。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸驿牌。砸了要写进王朝手记的黑页——无站之镖等于无旗。"
        },
        {
          "speaker": "系统",
          "text": "第十八卷后半。"
        }
      ],
      "next": "116.1"
    },
    {
      "id": "116.1",
      "title": "驿站",
      "lines": [
        {
          "speaker": "斥候",
          "text": "驿站被撬，好牌堆在东垒。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护驿牌，别把战拖成拆屋。"
        },
        {
          "speaker": "管事",
          "text": "西丘掩护，东垒夺牌。"
        },
        {
          "speaker": "系统",
          "text": "出战「驿站」。"
        }
      ],
      "battle": "ch116_way",
      "unlock": [
        "ch116_way_done"
      ],
      "next": "116.2"
    },
    {
      "id": "116.2",
      "title": "护镖",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "护镖场有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "场心垒禁火，主护线在中。"
        },
        {
          "speaker": "管事",
          "text": "清索再护镖。护不稳，席终盖不下印。"
        },
        {
          "speaker": "系统",
          "text": "出战「护镖」。"
        }
      ],
      "battle": "ch116_escort",
      "unlock": [
        "ch116_escort_done"
      ],
      "next": "116.3"
    },
    {
      "id": "116.3",
      "title": "可驿护",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可驿护』。下一章是十八卷席终——要把镖行的姓真正写入旗角。"
        },
        {
          "speaker": "春令使者",
          "text": "席终不是歇路。是还敢不敢让满市看灰旗的路引。"
        },
        {
          "speaker": "系统",
          "text": "第一百一十六章完成。"
        }
      ],

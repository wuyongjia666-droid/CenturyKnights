{
  "id": "chapter203",
  "title": "第二百零三章·盐堆",
  "beats": [
    {
      "id": "203.0",
      "title": "盐堆令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可渠之后，盐堆与晒盘要验：灰旗敢不敢把刀放短、把壳放稳——壳歪了，盐会先从盘上白进空旗。"
        },
        {
          "speaker": "管事",
          "text": "两场：盐堆、晒盘。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "盐堆丘格交错。晒盘卤格棋布，内有心垒。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸盘边。砸了写进王朝手记——无盘之盐等于无滩。"
        },
        {
          "speaker": "系统",
          "text": "第三十三卷中段。"
        }
      ],
      "next": "203.1"
    },
    {
      "id": "203.1",
      "title": "盐堆",
      "lines": [
        {
          "speaker": "斥候",
          "text": "盐堆丘格被拦，心垒有人。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "择丘夺心，别浪踏软壳。"
        },
        {
          "speaker": "管事",
          "text": "护丘清射，再夺心垒。"
        },
        {
          "speaker": "系统",
          "text": "出战「盐堆」。"
        }
      ],
      "battle": "ch203_pile",
      "unlock": [
        "ch203_pile_done"
      ],
      "next": "203.2"
    },
    {
      "id": "203.2",
      "title": "晒盘",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "晒盘卤格有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "外盘内心，禁乱踏，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清盘再夺台。卤不稳，盐印盖不下。"
        },
        {
          "speaker": "春令使者",
          "text": "盘一散，满滩的盐都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「晒盘」。"
        }
      ],
      "battle": "ch203_pan",
      "unlock": [
        "ch203_pan_done"
      ],
      "next": "203.3"
    },
    {
      "id": "203.3",
      "title": "可盘",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可盘』。下一章是盐印——要把三十三卷中段真正盖上。"
        },
        {
          "speaker": "春令使者",
          "text": "盐印不是歇卤。是还敢不敢续滩。"
        },
        {
          "speaker": "系统",
          "text": "第二百零三章完成。"
        }
      ],

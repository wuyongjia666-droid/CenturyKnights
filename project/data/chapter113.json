{
  "id": "chapter113",
  "title": "第一百一十三章·夜营",
  "beats": [
    {
      "id": "113.0",
      "title": "夜营令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可镖局之后，夜营要验的是：灰旗敢不敢在圆环里把刀收短——圈太紧，镖车会先把旗压断。"
        },
        {
          "speaker": "管事",
          "text": "两场：夜营、关卡。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "营心有垒丘环。关卡在隘口边，窄。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸关印架。砸了要写进王朝手记的黑页——无印之镖等于无旗。"
        },
        {
          "speaker": "系统",
          "text": "第十八卷。"
        }
      ],
      "next": "113.1"
    },
    {
      "id": "113.1",
      "title": "夜营",
      "lines": [
        {
          "speaker": "斥候",
          "text": "夜营门封，镖车在环心。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "破门先护环心车，别把战拖成劫营。"
        },
        {
          "speaker": "管事",
          "text": "顺环推进。逆环会惊马惊车。"
        },
        {
          "speaker": "系统",
          "text": "出战「夜营」。"
        }
      ],
      "battle": "ch113_camp",
      "unlock": [
        "ch113_camp_done"
      ],
      "next": "113.2"
    },
    {
      "id": "113.2",
      "title": "关卡",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "关印被撬。铁环散了一地。"
        },
        {
          "speaker": "斥候",
          "text": "隘口护架禁火，主印在心。"
        },
        {
          "speaker": "管事",
          "text": "清贼再拾印。印不全，下一章镖印盖不下去。"
        },
        {
          "speaker": "系统",
          "text": "出战「关卡」。"
        }
      ],
      "battle": "ch113_pass",
      "unlock": [
        "ch113_pass_done"
      ],
      "next": "113.3"
    },
    {
      "id": "113.3",
      "title": "可夜关",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可夜关』。下一章是十八卷钤印——镖印。"
        },
        {
          "speaker": "春令使者",
          "text": "镖印烙在车辕。烙歪了，镖行不认。"
        },
        {
          "speaker": "系统",
          "text": "第一百一十三章完成。"
        }
      ],

      "lines": [
        {
          "speaker": "旁白",
          "text": "星津的灯按航线亮。航线外的灯是诱饵。"
        },
        {
          "speaker": "斥候",
          "text": "认灯再进。"
        },
        {
          "speaker": "系统",
          "text": "第三十二章·星津。"
        }
      ]
    },
    {
      "id": "32.1",
      "title": "星津渡",
      "battle": "ch32_star",
      "unlock": [
        "ch32_star_done"
      ],
      "next": "32.2",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "「星津渡」——这里一仗，赢的不只是地，是旅馆墙上那一行字还改不改。 此地多林、桥、水。"
        },
        {
          "speaker": "斥候",
          "text": "先清射界，再向心。侧翼留一个人专门喊风向。"
        },
        {
          "speaker": "管事",
          "text": "别砸民居与作坊。砸了要赔，也要写进手记。"
        },
        {
          "speaker": "系统",
          "text": "出战「星津渡」。"
        }
      ]
    },
    {
      "id": "32.2",
      "title": "星津望楼",
      "battle": "ch32_tower",
      "unlock": [
        "ch32_tower_done"
      ],
      "next": "32.3",
      "lines": [
        {
          "speaker": "斥候",
          "text": "「星津望楼」——有人要在这里把灰旗的名字换成税签。 此地多丘、垒。"
        },
        {
          "speaker": "管事",
          "text": "先清射界，再向心。侧翼留一个人专门喊风向。"
        },
        {
          "speaker": "老旗手",
          "text": "我把东翼探过了：有伏，但伏得不深。"
        },
        {
          "speaker": "系统",
          "text": "出战「星津望楼」。"
        }
      ]
    },
    {
      "id": "32.3",
      "title": "星印",
      "unlock": [
        "chapter32_done"
      ],
      "next": null,
      "lines": [
        {
          "speaker": "旁白",
          "text": "第三十二章·星津到了收束处。风停一刻，墨才能干。"
        },
        {
          "speaker": "春令使者",
          "text": "印若已落，便可回堡，也可继续下一章。灰旗的路，从来不是单行。"
        },
        {
          "speaker": "管事",
          "text": "银粮与声望已按章结算。旗手歇口气。"
        },
        {
          "speaker": "系统",
          "text": "第三十二章完成。"
        }
      ]
    }
  ]

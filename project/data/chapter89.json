{
  "id": "chapter89",
  "title": "第八十九章·蒸青",
  "beats": [
    {
      "id": "89.0",
      "title": "蒸青令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可茶梯之后，蒸青竈要验的是：灰旗敢不敢把水汽当成敌人的雾——雾里看不清，才最容易被人换罐。"
        },
        {
          "speaker": "管事",
          "text": "两场：蒸青、炒青。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "蒸青有水道。炒青丘散，火点多。"
        },
        {
          "speaker": "老旗手",
          "text": "别把旗伸进蒸汽里。"
        },
        {
          "speaker": "系统",
          "text": "第十四卷。"
        }
      ],
      "next": "89.1"
    },
    {
      "id": "89.1",
      "title": "蒸青",
      "lines": [
        {
          "speaker": "斥候",
          "text": "中线水槽，桥四口。蒸汽迷眼。"
        },
        {
          "speaker": "管事",
          "text": "短视距。呼号联络。分翼过桥。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "治疗别站槽沿。"
        },
        {
          "speaker": "系统",
          "text": "出战「蒸青」。"
        }
      ],
      "battle": "ch89_steam",
      "unlock": [
        "ch89_steam_done"
      ],
      "next": "89.2"
    },
    {
      "id": "89.2",
      "title": "炒青",
      "lines": [
        {
          "speaker": "旁白",
          "text": "蒸青既过，炒青锅还热。热锅边有人要灰旗『借火』——借走的不是火，是整岭的配方。"
        },
        {
          "speaker": "老旗手",
          "text": "丘间推进。护住主竈，别灭该留的火。"
        },
        {
          "speaker": "斥候",
          "text": "假竈诱敌。认烟色。"
        },
        {
          "speaker": "系统",
          "text": "出战「炒青」。"
        }
      ],
      "battle": "ch89_roast",
      "unlock": [
        "ch89_roast_done"
      ],
      "next": "89.3"
    },
    {
      "id": "89.3",
      "title": "可蒸炒",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可蒸炒』。下一章是十四卷钤印——茶印。"
        },
        {
          "speaker": "春令使者",
          "text": "茶印盖在罐底。盖歪了，客商不收。"
        },
        {
          "speaker": "系统",
          "text": "第八十九章完成。"
        }
      ],
      "unlock": [
        "chapter89_done"
      ],

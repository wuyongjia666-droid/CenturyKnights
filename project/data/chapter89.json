  "title": "第八十九章·蒸青",
  "beats": [
    {
      "id": "89.0",
      "title": "蒸青令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可茶梯之后，蒸青竈要验的是：灰旗敢不敢把水汽当成敌人的雾——雾里看不清，才最容易被人换罐。"
        },
        {
          "speaker": "管事",
          "text": "两场：蒸青、炒青。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "蒸青有水道。炒青丘散，火点多。"
        },
        {
          "speaker": "老旗手",
          "text": "别把旗伸进蒸汽里。"
        },
        {
          "speaker": "系统",
          "text": "第十四卷。"
        }
      ],
      "next": "89.1"
    },
    {
      "id": "89.1",
      "title": "蒸青",
      "lines": [
        {
          "speaker": "斥候",
          "text": "蒸青水槽蒸汽迷眼。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "短视距呼号，分翼过桥。"
        },
        {
          "speaker": "系统",
          "text": "出战「蒸青」。"
        }
      ],
      "battle": "ch89_steam",

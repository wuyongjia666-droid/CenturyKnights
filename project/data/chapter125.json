{
  "id": "chapter125",
  "title": "第一百二十五章·抄帘",
  "beats": [
    {
      "id": "125.0",
      "title": "抄帘令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可纸坊之后，抄帘要验的是：灰旗敢不敢在白浆里把刀收短——手太重，纸会先把令字撕碎。"
        },
        {
          "speaker": "管事",
          "text": "两场：抄帘、晾纸。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "帘架散林。晾场有竖水槽。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸晾架。砸了要写进王朝手记的黑页——无纸之令等于无旗。"
        },
        {
          "speaker": "系统",
          "text": "第二十卷。"
        }
      ],
      "next": "125.1"
    },
    {
      "id": "125.1",
      "title": "抄帘",
      "lines": [
        {
          "speaker": "斥候",
          "text": "抄帘门封，新帘在架心。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "破门先护帘架，别把战拖成撕纸。"
        },
        {
          "speaker": "管事",
          "text": "轻步进。重步会震裂湿纸。"
        },
        {
          "speaker": "系统",
          "text": "出战「抄帘」。"
        }
      ],
      "battle": "ch125_screen",
      "unlock": [
        "ch125_screen_done"
      ],
      "next": "125.2"
    },
    {
      "id": "125.2",
      "title": "晾纸",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "晾架被撬。白纸散了一地。"
        },
        {
          "speaker": "斥候",
          "text": "水槽护架禁火，主架在心。"
        },
        {
          "speaker": "管事",
          "text": "清贼再拾纸。纸不全，下一章纸印盖不下去。"
        },
        {
          "speaker": "系统",
          "text": "出战「晾纸」。"
        }
      ],
      "battle": "ch125_dry",
      "unlock": [
        "ch125_dry_done"
      ],
      "next": "125.3"
    },
    {
      "id": "125.3",
      "title": "可抄晾",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可抄晾』。下一章是二十卷钤印——纸印。"
        },
        {
          "speaker": "春令使者",
          "text": "纸印盖在笺角。盖歪了，纸坊不认。"
        },
        {
          "speaker": "系统",
          "text": "第一百二十五章完成。"
        }
      ],

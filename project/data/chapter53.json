{
  "id": "chapter53",
  "title": "第五十三章·镜湖",
  "beats": [
    {
      "id": "53.0",
      "title": "镜湖令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "八卷可入之后，镜湖把天空翻过来给人看。水印要验的是：旗倒影里，还敢不敢认自己。"
        },
        {
          "speaker": "管事",
          "text": "两场：镜湖堤、镜湖心屿。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "心屿一战会挤。重步与治疗别省。"
        },
        {
          "speaker": "老旗手",
          "text": "堤上别站成一条线。一条线最容易被射穿。"
        },
        {
          "speaker": "系统",
          "text": "第八卷前半。"
        }
      ],
      "next": "53.1"
    },
    {
      "id": "53.1",
      "title": "镜湖堤",
      "lines": [
        {
          "speaker": "管事",
          "text": "「镜湖堤」——这一格格子都像在等谁先心急。 此地多丘、垒。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "敌精锐靠后。前排散兵是诱饵，别追过深。"
        },
        {
          "speaker": "老旗手",
          "text": "旗在，名册在，人可以撤；三者丢一，这一仗就算白打。"
        },
        {
          "speaker": "系统",
          "text": "出战「镜湖堤」。"
        }
      ],
      "battle": "ch53_mirror",
      "unlock": [
        "ch53_mirror_done"
      ],
      "next": "53.2"
    },
    {
      "id": "53.2",
      "title": "镜湖心屿",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "「镜湖心屿」——打完要把活口留下一个——问清谁在出钱。 此地多林、垒。"
        },
        {
          "speaker": "管事",
          "text": "夺林之后立刻成阵，别恋战收割。"
        },
        {
          "speaker": "斥候",
          "text": "旗在，名册在，人可以撤；三者丢一，这一仗就算白打。"
        },
        {
          "speaker": "系统",
          "text": "出战「镜湖心屿」。"
        }
      ],
      "battle": "ch53_isle",
      "unlock": [
        "ch53_isle_done"
      ],
      "next": "53.3"
    },
    {
      "id": "53.3",
      "title": "水印",
      "lines": [
        {
          "speaker": "旁白",
          "text": "镜湖两印落下。水静下去，旗的倒影才清楚。"
        },
        {
          "speaker": "春令使者",
          "text": "下一章是八卷钤印——中段收束。"
        },
        {
          "speaker": "管事",
          "text": "军饷再加。可回堡。"
        },
        {
          "speaker": "系统",
          "text": "第五十三章完成。"
        }
      ],

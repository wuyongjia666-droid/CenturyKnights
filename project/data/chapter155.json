    },
    {
      "id": "155.2",
      "title": "竹楼",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "竹楼场有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "场心垒禁乱火，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清索再守楼。火不稳，竹印盖不下。"
        },
        {
          "speaker": "春令使者",
          "text": "楼一塌，满海的径都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「竹楼」。"
        }
      ],

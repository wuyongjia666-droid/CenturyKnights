{
  "id": "chapter120",
  "title": "第一百二十章·港印",
  "beats": [
    {
      "id": "120.0",
      "title": "港印令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "码头与潮礁之后，十九卷要在港印战场盖上中段印。印不是车辕烙，是舵柄那一捺：捺下去，后半才肯开港。"
        },
        {
          "speaker": "管事",
          "text": "一场：港印。打赢，旅馆写『十九卷中段』。"
        },
        {
          "speaker": "老旗手",
          "text": "中分水桥。敌酋在心。"
        },
        {
          "speaker": "春令使者",
          "text": "中段印不是歇潮。是还敢不敢续缆。"
        },
        {
          "speaker": "系统",
          "text": "第十九卷中段。"
        }
      ],
      "next": "120.1"
    },
    {
      "id": "120.1",
      "title": "港印",
      "lines": [
        {
          "speaker": "春令使者",
          "text": "港印水桥中分，印台在心。"
        },
        {
          "speaker": "管事",
          "text": "择口夺心，舵柄捺印。别让敌酋把印纽抢走。"
        },
        {
          "speaker": "斥候",
          "text": "酋与精锐同列。护旗手留后。"
        },
        {
          "speaker": "系统",
          "text": "出战「港印」。"
        }
      ],
      "battle": "ch120_seal",
      "unlock": [
        "ch120_seal_done"
      ],
      "next": "120.2"
    },
    {
      "id": "120.2",
      "title": "十九卷中段",
      "lines": [
        {
          "speaker": "旁白",
          "text": "港印落下。旅馆写『十九卷中段』。缆还在桩上，潮还可以再等——等的是后半。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "中段既执，可回堡，亦可等候后半。"
        },
        {
          "speaker": "管事",
          "text": "银粮与战技点已结。"
        },
        {
          "speaker": "春令使者",
          "text": "从镖行走到渔港，灰旗学的是第十种脾气：回港比出航更难——港要让姓靠得住。"
        },
        {
          "speaker": "系统",
          "text": "第十九卷中段完成（v4.2）。"
        }
      ],

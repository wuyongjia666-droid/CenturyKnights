    },
    {
      "id": "62.2",
      "title": "曜阙心",
      "lines": [
        {
          "speaker": "旁白",
          "text": "阶既开，阙心空着——空座等谁敢把旗插上去。"
        },
        {
          "speaker": "老旗手",
          "text": "守住殿心。旗立住，廷才肯认。"
        },
        {
          "speaker": "系统",
          "text": "出战「曜阙心」。"
        }

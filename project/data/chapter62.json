{
  "id": "chapter62",
  "title": "第六十二章·曜阙",
  "beats": [
    {
      "id": "62.0",
      "title": "曜阙令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可烬之后，曜阙的灯比余烬港更亮，也更会审判。廷印要验：灰旗能不能在别人的阙下，仍用自己的姓走路。"
        },
        {
          "speaker": "管事",
          "text": "两场：曜阙外、曜阙心。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "阙心挤。技能冷却要算。"
        },
        {
          "speaker": "老旗手",
          "text": "台阶上别停太久。"
        },
        {
          "speaker": "系统",
          "text": "第九卷后半。"
        }
      ],
      "next": "62.1"
    },
    {
      "id": "62.1",
      "title": "曜阙外",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "「曜阙外」——打完要把活口留下一个——问清谁在出钱。 此地多水、桥、垒。"
        },
        {
          "speaker": "管事",
          "text": "桥/窄路只过一人宽时，单列，掩护弓先到位。"
        },
        {
          "speaker": "斥候",
          "text": "旗在，名册在，人可以撤；三者丢一，这一仗就算白打。"
        },
        {
          "speaker": "系统",
          "text": "出战「曜阙外」。"
        }
      ],
      "battle": "ch62_court",
      "unlock": [
        "ch62_court_done"
      ],
      "next": "62.2"
    },
    {
      "id": "62.2",
      "title": "曜阙心",
      "lines": [
        {
          "speaker": "苇原·灯影",
          "text": "「曜阙心」——敌方不急着歼灭——他们急着让你们先乱。 此地多丘、垒。"
        },
        {
          "speaker": "管事",
          "text": "先清射界，再向心。侧翼留一个人专门喊风向。"
        },
        {
          "speaker": "春令使者",
          "text": "风偏丘，烟会迷眼时改侧翼。"
        },
        {
          "speaker": "系统",
          "text": "出战「曜阙心」。"
        }
      ],
      "battle": "ch62_throne",
      "unlock": [
        "ch62_throne_done"
      ],
      "next": "62.3"
    },
    {
      "id": "62.3",
      "title": "廷印",
      "lines": [
        {
          "speaker": "旁白",
          "text": "曜阙两印落下。席终只剩最后一场。"
        },
        {
          "speaker": "春令使者",
          "text": "下一章是九卷席终。把能带的都带上。"
        },
        {
          "speaker": "系统",
          "text": "第六十二章完成。"
        }

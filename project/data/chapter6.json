{
  "id": "chapter6",
  "title": "第六章·托孤之约",
  "beats": [
    {
      "id": "6.0",
      "title": "可托孤文书",
      "next": "6.1",
      "lines": [
        {
          "speaker": "旁白",
          "text": "烽烟之后，有人把孩子的名字递到灰旗手里——不是托付温柔，是托付刀与印。托孤一旦签署，毁约的人会先毁自己的姓。"
        },
        {
          "speaker": "管事",
          "text": "三关：典籍库、石垒、血印。打完，「托孤」二字才进旅馆。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "血印一战最沉。带上你最信的人。"
        },
        {
          "speaker": "系统",
          "text": "第六章·托孤之约。"
        }
      ]
    },
    {
      "id": "6.1",
      "title": "族谱密室",
      "battle": "ch6_archive",
      "unlock": [
        "ch6_archive_done"
      ],
      "next": "6.2",
      "lines": [
        {
          "speaker": "斥候",
          "text": "典籍库第三进锁着托孤抄本。"
        },
        {
          "speaker": "管事",
          "text": "窄廊短兵。禁火。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "护认字的人。"
        },
        {
          "speaker": "系统",
          "text": "出战「典籍库」。"
        }
      ]
    },
    {
      "id": "6.2",
      "title": "托孤堡垒",
      "battle": "ch6_redoubt",
      "unlock": [
        "ch6_redoubt_done"
      ],
      "next": "6.3",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "石垒一门。门前投石，侧翼可翻矮墙。"
        },
        {
          "speaker": "斥候",
          "text": "破门后占内圈，别散。"
        },
        {
          "speaker": "系统",
          "text": "出战「石垒」。"
        }
      ]
    },
    {
      "id": "6.3",
      "title": "血印祭坛",
      "battle": "ch6_bloodseal",
      "unlock": [
        "ch6_bloodseal_done"
      ],
      "next": "6.4",
      "lines": [
        {
          "speaker": "旁白",
          "text": "血印要的是证人，不是垒。台倒，托孤作废。"
        },
        {
          "speaker": "春令使者",
          "text": "护中央石台。"
        },
        {
          "speaker": "老旗手",
          "text": "最信的人顶前。"
        },
        {
          "speaker": "系统",
          "text": "出战「血印」。"
        }
      ]
    },
    {
      "id": "6.4",
      "title": "约成",
      "unlock": [
        "chapter6_done"
      ],
      "next": null,
      "lines": [
        {
          "speaker": "旁白",
          "text": "托孤执印。孩子的名字进了灰旗的族谱边栏——边栏不宽，却比城墙难攻。"
        },
        {
          "speaker": "春令使者",
          "text": "下一章会有人竞标授旗。先正名，再谈争。"
        },
        {
          "speaker": "系统",
          "text": "第六章完成。"
        }
      ]
    }
  ]

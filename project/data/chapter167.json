{
  "id": "chapter167",
  "title": "第一百六十七章·守钟",
  "beats": [
    {
      "id": "167.0",
      "title": "守钟令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可闻钟之后，守钟要验的是：灰旗敢不敢把刀放短、把声放稳——声歪了，警会先从夜里倒进空票。"
        },
        {
          "speaker": "管事",
          "text": "两场：守钟、鼓场。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "守钟水环孤垒，门桥八处。鼓场四角丘，中心小垒。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸钟钮。砸了要写进王朝手记的黑页——无声之城等于无警。"
        },
        {
          "speaker": "系统",
          "text": "第二十七卷中段。"
        }
      ],
      "next": "167.1"
    },
    {
      "id": "167.1",
      "title": "守钟",
      "lines": [
        {
          "speaker": "斥候",
          "text": "守钟被撬，好锤堆在岛垒。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护钟火，别把战拖成哑城。择桥再登。"
        },
        {
          "speaker": "管事",
          "text": "择桥掩护，岛垒夺锤。"
        },
        {
          "speaker": "系统",
          "text": "出战「守钟」。"
        }
      ],
      "battle": "ch167_watchbell",
      "unlock": [
        "ch167_watchbell_done"
      ],
      "next": "167.2"
    },
    {
      "id": "167.2",
      "title": "鼓场",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "鼓场四角有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "角丘掩护敌射，场心垒禁乱火，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清索再守场。火不稳，钟印盖不下。"
        },
        {
          "speaker": "春令使者",
          "text": "场一哑，满城的夜都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「鼓场」。"
        }
      ],
      "battle": "ch167_square",
      "unlock": [
        "ch167_square_done"
      ],
      "next": "167.3"
    },
    {
      "id": "167.3",
      "title": "可鼓场",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可鼓场』。下一章是钟印——要把二十七卷中段真正盖上。"
        },
        {
          "speaker": "春令使者",
          "text": "钟印不是歇锤。是还敢不敢续声。"
        },
        {
          "speaker": "系统",
          "text": "第一百六十七章完成。"
        }
      ],

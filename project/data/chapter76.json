{
  "id": "chapter76",
  "title": "第七十六章·台口",
  "beats": [
    {
      "id": "76.0",
      "title": "梨园令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "十一卷窑火席终之后，旅馆贴的不是匣钵片，是一张撕掉戏单角的红纸。十二卷是梨园——台口认的不是火温，是谁敢把姓念给满场听，念错了就得当场改戏。"
        },
        {
          "speaker": "管事",
          "text": "两场：台口、厢廊。打完，旅馆写『可台口』。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "台口前开阔、后有林。厢廊两侧长廊，缺口少。"
        },
        {
          "speaker": "老旗手",
          "text": "梨园不认哑嗓。旗号要喊清楚。"
        },
        {
          "speaker": "系统",
          "text": "第十二卷·梨园开启。"
        }
      ],
      "next": "76.1"
    },
    {
      "id": "76.1",
      "title": "台口",
      "lines": [
        {
          "speaker": "斥候",
          "text": "台口被占。后台林里有弓，像检场的人提前入戏。"
        },
        {
          "speaker": "管事",
          "text": "先夺台心。林后弓清完再压前。"
        },
        {
          "speaker": "老旗手",
          "text": "别站在『台沿』被打下场。"
        },
        {
          "speaker": "系统",
          "text": "出战「台口」。"
        }
      ],
      "battle": "ch76_stage",
      "unlock": [
        "ch76_stage_done"
      ],
      "next": "76.2"
    },
    {
      "id": "76.2",
      "title": "厢廊",
      "lines": [
        {
          "speaker": "旁白",
          "text": "台口既亮，厢廊仍暗。暗廊里传的是假戏单——假戏单把灰旗写成龙套。"
        },
        {
          "speaker": "斥候",
          "text": "两侧林廊，中段缺口。"
        },
        {
          "speaker": "管事",
          "text": "缺口汇合。别分兵钻廊底。"
        },
        {
          "speaker": "系统",
          "text": "出战「厢廊」。"
        }
      ],
      "battle": "ch76_gallery",
      "unlock": [
        "ch76_gallery_done"
      ],
      "next": "76.3"
    },
    {
      "id": "76.3",
      "title": "可台口",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可台口』。下一章是检场与锣鼓。"
        },
        {
          "speaker": "春令使者",
          "text": "检场要验行头。锣鼓乱了，整出戏都会塌。"
        },
        {
          "speaker": "系统",
          "text": "第七十六章完成。"
        }
      ],

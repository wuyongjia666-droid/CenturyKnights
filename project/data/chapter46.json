{
  "id": "chapter46",
  "title": "第四十六章·余烬",
  "beats": [
    {
      "id": "46.0",
      "title": "余烬点名",
      "next": "46.1",
      "lines": [
        {
          "speaker": "旁白",
          "text": "七卷余烬。烬还能烫手，说明火没灭干净——没灭干净的火，最适合藏刀。"
        },
        {
          "speaker": "管事",
          "text": "余烬。护伤员。"
        },
        {
          "speaker": "系统",
          "text": "第四十六章·余烬。"
        }
      ]
    },
    {
      "id": "46.1",
      "title": "余烬关",
      "battle": "ch46_ember",
      "unlock": [
        "ch46_ember_done"
      ],
      "next": "46.2",
      "lines": [
        {
          "speaker": "旁白",
          "text": "「余烬关」这一仗，要的不是热闹，是灰旗还敢不敢把姓念清楚。"
        },
        {
          "speaker": "斥候",
          "text": "敌阵已立。我探过东翼，西翼有林，南面是硬地。"
        },
        {
          "speaker": "系统",
          "text": "出战「余烬关」。"
        }
      ]
    },
    {
      "id": "46.2",
      "title": "余烬渡",
      "battle": "ch46_ash",
      "unlock": [
        "ch46_ash_done"
      ],
      "next": "46.3",
      "lines": [
        {
          "speaker": "斥候",
          "text": "「余烬渡」——我听见金属声，不像农具。"
        },
        {
          "speaker": "管事",
          "text": "以我马鞭为号。鞭落，全队动。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "有人受伤就往后传，别硬撑在前排。"
        },
        {
          "speaker": "系统",
          "text": "出战「余烬渡」。"
        }
      ]
    },
    {
      "id": "46.3",
      "title": "七卷可入",
      "unlock": [
        "chapter46_done",
        "volume7_open"
      ],
      "next": null,
      "lines": [
        {
          "speaker": "旁白",
          "text": "余烬关与余烬渡之后，陆桥旅馆把灰旗写入『七卷可入』。火灭了一次，又被人点回来——族谱上多了一行不肯灭的字。"
        },
        {
          "speaker": "春令使者",
          "text": "下一章是冠火。城垣与炉心要落火印。把战技点与子嗣都带上。"
        },
        {
          "speaker": "管事",
          "text": "银两与粮已结算。旗手可以歇一口气，但别歇太久。"
        },
        {
          "speaker": "系统",
          "text": "第四十六章完成。"
        }
      ]
    }
  ]
}
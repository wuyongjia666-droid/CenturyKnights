{
  "id": "chapter8",
  "title": "第八章·港灯夜议",
  "beats": [
    {
      "id": "8.0",
      "title": "港灯点亮",
      "next": "8.1",
      "lines": [
        {
          "speaker": "旁白",
          "text": "正名之后，港灯亮得过分客气。海商要灰旗在夜宴上签字——签的是通行，也是把姓氏写进潮汐表。"
        },
        {
          "speaker": "管事",
          "text": "三关：港湾、码头、盟约厅。打完，「可通行」才进旅馆。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "盟约厅里别只带刀。带能算账的人。"
        },
        {
          "speaker": "系统",
          "text": "第八章·港灯夜议。"
        }
      ]
    },
    {
      "id": "8.1",
      "title": "港灯夜议",
      "battle": "ch8_harbor",
      "unlock": [
        "ch8_harbor_done"
      ],
      "next": "8.2",
      "lines": [
        {
          "speaker": "斥候",
          "text": "港湾潮位低，船搁浅成障碍。海商的弓手在桅后。"
        },
        {
          "speaker": "管事",
          "text": "沿岸推进，别下到潮泥里。码头还在下一场。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "旗别被潮打湿——海商认湿旗为『未通行』。"
        },
        {
          "speaker": "系统",
          "text": "出战「港湾」。"
        }
      ]
    },
    {
      "id": "8.2",
      "title": "潮汐码头",
      "battle": "ch8_quay",
      "unlock": [
        "ch8_quay_done"
      ],
      "next": "8.3",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "码头木栈窄。两人并肩就会互相挡刀。"
        },
        {
          "speaker": "斥候",
          "text": "栈桥尽头有货箱可掩。清完弓再谈盟约厅。"
        },
        {
          "speaker": "管事",
          "text": "别把辎重队卷进混战。"
        },
        {
          "speaker": "系统",
          "text": "出战「码头」。"
        }
      ]
    },
    {
      "id": "8.3",
      "title": "盟约厅卫",
      "battle": "ch8_treaty",
      "unlock": [
        "ch8_treaty_done"
      ],
      "next": "8.4",
      "lines": [
        {
          "speaker": "旁白",
          "text": "盟约厅的桌是空的。空桌比满桌凶——因为它在等谁先把刀放上去，而不是笔。"
        },
        {
          "speaker": "春令使者",
          "text": "先清廊柱后的刀客，再碰桌。签字是打完的事。"
        },
        {
          "speaker": "管事",
          "text": "厅内禁骑。步弓配合。"
        },
        {
          "speaker": "系统",
          "text": "出战「盟约厅」。"
        }
      ]
    },
    {
      "id": "8.4",
      "title": "可通行",
      "unlock": [
        "chapter8_done"
      ],
      "next": null,
      "lines": [
        {
          "speaker": "旁白",
          "text": "港灯夜议落定。灰旗「可通行」——船肯停，驿肯开，姓氏便有了海边的回声。"
        },
        {
          "speaker": "春令使者",
          "text": "下一章会有人烧商路。通行不是永恒，是每一队辎重都要护。"
        },
        {
          "speaker": "系统",
          "text": "第八章完成。"
        }
      ]
    }
  ]
}
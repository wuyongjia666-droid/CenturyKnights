{
  "id": "chapter50",
  "title": "第五十章·百旗",
  "beats": [
    {
      "id": "50.0",
      "title": "百旗令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "百旗不是比谁旗多——是比谁的旗还能在烬原上认出自己的姓。灰旗只带一面，一面要顶百面的眼神。"
        },
        {
          "speaker": "管事",
          "text": "两场：百旗相关。护住主旗。"
        },
        {
          "speaker": "老旗手",
          "text": "假旗砍倒即可，别追。"
        },
        {
          "speaker": "系统",
          "text": "第五十章·百旗。"
        }
      ],
      "next": "50.1"
    },
    {
      "id": "50.1",
      "title": "百旗外门",
      "lines": [
        {
          "speaker": "斥候",
          "text": "「百旗外门」敌阵已立。地形会骗人，人会藏在骗人的地方。"
        },
        {
          "speaker": "管事",
          "text": "按地形展开：先清射界，再推进。别浪冲成靶。"
        },
        {
          "speaker": "老旗手",
          "text": "护旗。技能别藏到用不上的时候。败了可重试，旗不能丢。"
        },
        {
          "speaker": "系统",
          "text": "出战「百旗外门」。"
        }
      ],
      "battle": "ch50_gate",
      "unlock": [
        "ch50_gate_done"
      ],
      "next": "50.2"
    },
    {
      "id": "50.2",
      "title": "百旗正殿",
      "lines": [
        {
          "speaker": "斥候",
          "text": "百旗厅。一面真旗要顶百面眼神——眼神里全是竞标授旗的人。"
        },
        {
          "speaker": "管事",
          "text": "护主旗。假旗砍倒即可。"
        },
        {
          "speaker": "老旗手",
          "text": "别被喊声诱出厅心。"
        },
        {
          "speaker": "系统",
          "text": "出战「百旗厅」。"
        }
      ],
      "battle": "ch50_hall",
      "unlock": [
        "ch50_hall_done"
      ],
      "next": "50.3"
    },
    {
      "id": "50.3",
      "title": "阙印",
      "lines": [
        {
          "speaker": "旁白",
          "text": "百旗两印落下。门阙认旗之后，席终只剩最后一场。"
        },
        {
          "speaker": "春令使者",
          "text": "下一章是七卷席终。把能带的战技、契约与子嗣都带上。"
        },
        {
          "speaker": "管事",
          "text": "军饷再加一笔。回去喝口水，然后出发。"
        },
        {
          "speaker": "系统",
          "text": "第五十章完成。"
        }
      ],
      "unlock": [
        "chapter50_done"
      ],
      "next": null
    }
  ]

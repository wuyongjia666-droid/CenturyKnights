  "title": "第六十一章·烬原",
  "beats": [
    {
      "id": "61.0",
      "title": "烬原令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "九卷中段钤印之后，后半从烬原起。灰还热，旗还冷——冷的是别人不许灰旗把『可烬』写进旅馆。"
        },
        {
          "speaker": "管事",
          "text": "两场：烬原、百旗坡。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "百旗坡开阔。骑冲与连射有用。"
        },
        {
          "speaker": "老旗手",
          "text": "烬里站得住，九卷后半才肯认你。"
        },
        {
          "speaker": "系统",
          "text": "第九卷后半。"
        }
      ],
      "next": "61.1"
    },
    {
      "id": "61.1",
      "title": "烬原",
      "lines": [
        {
          "speaker": "斥候",
          "text": "烬原烟未散。敌阵已立。"
        },
        {
          "speaker": "管事",
          "text": "先夺烬原。坡上要有前线。"
        },
        {
          "speaker": "系统",
          "text": "出战「烬原」。"
        }
      ],

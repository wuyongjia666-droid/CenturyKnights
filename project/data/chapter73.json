{
  "id": "chapter73",
  "title": "第七十三章·烟囱",
  "beats": [
    {
      "id": "73.0",
      "title": "烟囱令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "中段窑印之后，后半从烟囱起。烟是窑的笔迹——笔迹歪了，整窑的坯都会被写成废品。"
        },
        {
          "speaker": "管事",
          "text": "两场：烟囱、窑神龛。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "烟道林带竖切。龛前开阔但丘后有弓。"
        },
        {
          "speaker": "老旗手",
          "text": "别在烟道里久留。久留会咳血，也会忘姓。"
        },
        {
          "speaker": "系统",
          "text": "第十一卷后半。"
        }
      ],
      "next": "73.1"
    },
    {
      "id": "73.1",
      "title": "烟囱",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "「烟囱」——这里一仗，赢的不只是地，是旅馆墙上那一行字还改不改。 此地多林、垒。"
        },
        {
          "speaker": "斥候",
          "text": "先清射界，再向心。侧翼留一个人专门喊风向。"
        },
        {
          "speaker": "春令使者",
          "text": "风偏林，烟会迷眼时改侧翼。"
        },
        {
          "speaker": "系统",
          "text": "出战「烟囱」。"
        }
      ],
      "battle": "ch73_chimney",
      "unlock": [
        "ch73_chimney_done"
      ],
      "next": "73.2"
    },
    {
      "id": "73.2",
      "title": "窑神龛",
      "lines": [
        {
          "speaker": "旁白",
          "text": "「窑神龛」：旗帜可以湿，名册不能湿。"
        },
        {
          "speaker": "斥候",
          "text": "技能留给打开口的那一下，别打在空地上。"
        },
        {
          "speaker": "春令使者",
          "text": "风偏丘，烟会迷眼时改侧翼。"
        },
        {
          "speaker": "系统",
          "text": "出战「窑神龛」。"
        }
      ],
      "battle": "ch73_kilngod",
      "unlock": [
        "ch73_kilngod_done"
      ],
      "next": "73.3"
    },
    {
      "id": "73.3",
      "title": "可烟龛",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可烟龛』。下一章是火塘与冷却道。"
        },
        {
          "speaker": "春令使者",
          "text": "火塘多点，冷却道有水。温度管理像战技冷却。"
        },
        {
          "speaker": "系统",
          "text": "第七十三章完成。"
        }
      ],
      "unlock": [
        "chapter73_done"
      ],

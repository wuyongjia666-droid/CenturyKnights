{
  "id": "chapter73",
  "title": "第七十三章·烟囱",
  "beats": [
    {
      "id": "73.0",
      "title": "烟囱令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "中段窑印之后，后半从烟囱起。烟是窑的笔迹——笔迹歪了，整窑的坯都会被写成废品。"
        },
        {
          "speaker": "管事",
          "text": "两场：烟囱、窑神龛。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "烟道林带竖切。龛前开阔但丘后有弓。"
        },
        {
          "speaker": "老旗手",
          "text": "别在烟道里久留。久留会咳血，也会忘姓。"
        },
        {
          "speaker": "系统",
          "text": "第十一卷后半。"
        }
      ],
      "next": "73.1"
    },
    {
      "id": "73.1",
      "title": "烟囱",
      "lines": [
        {
          "speaker": "管事",
          "text": "这一仗银粮都押上了——不是赌，是护。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "「烟囱」我跟第三排。谁落单我就骂谁。"
        },
        {
          "speaker": "老旗手",
          "text": "骂完再救。"
        },
        {
          "speaker": "系统",
          "text": "出战「烟囱」。"
        }
      ],
      "battle": "ch73_chimney",
      "unlock": [
        "ch73_chimney_done"
      ],
      "next": "73.2"
    },
    {
      "id": "73.2",
      "title": "窑神龛",
      "lines": [
        {
          "speaker": "斥候",
          "text": "风向偏东。烟会迷眼，短视距前进。"
        },
        {
          "speaker": "老旗手",
          "text": "「窑神龛」。呼号联络，别靠眼神。"
        },
        {
          "speaker": "管事",
          "text": "主旗居中。"
        },
        {
          "speaker": "系统",
          "text": "出战「窑神龛」。"
        }
      ],
      "battle": "ch73_kilngod",

{
  "id": "chapter233",
  "title": "第二百三十三章·釉池",
  "beats": [
    {
      "id": "233.0",
      "title": "釉池令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可窑廊之后，釉池与瓷架要验：灰旗敢不敢把刀放短、把坯放稳。"
        },
        {
          "speaker": "管事",
          "text": "两场：釉池、瓷架。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "釉池棋格交错。瓷架盘格棋布，内有心垒。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸池边。砸了写进王朝手记——无池之釉等于无市。"
        },
        {
          "speaker": "系统",
          "text": "第三十八卷中段。"
        }
      ],
      "next": "233.1"
    },
    {
      "id": "233.1",
      "title": "釉池",
      "lines": [
        {
          "speaker": "斥候",
          "text": "釉池棋格被拦，心垒有人。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "择格夺心，别浪踏软坯。"
        },
        {
          "speaker": "管事",
          "text": "护格清射，再夺心垒。"
        },
        {
          "speaker": "系统",
          "text": "出战「釉池」。"
        }
      ],
      "battle": "ch233_glaze",
      "unlock": [
        "ch233_glaze_done"
      ],
      "next": "233.2"
    },
    {
      "id": "233.2",
      "title": "瓷架",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "瓷架盘格有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "外架内心，禁乱砸，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清架再夺台。釉不稳，瓷印盖不下。"
        },
        {
          "speaker": "春令使者",
          "text": "架一散，满市的瓷都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「瓷架」。"
        }
      ],
      "battle": "ch233_shelf",
      "unlock": [

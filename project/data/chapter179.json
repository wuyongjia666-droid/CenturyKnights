{
  "id": "chapter179",
  "title": "第一百七十九章·案台",
  "beats": [
    {
      "id": "179.0",
      "title": "案台令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可入砚之后，案台要验的是：灰旗敢不敢把刀放短、把墨放稳——墨歪了，字会先从案上倒进空票。"
        },
        {
          "speaker": "管事",
          "text": "两场：案台、印房。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "案台双横案。印房丘套平原，心有小垒。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸砚钮。砸了要写进王朝手记的黑页——无墨之案等于无字。"
        },
        {
          "speaker": "系统",
          "text": "第二十九卷中段。"
        }
      ],
      "next": "179.1"
    },
    {
      "id": "179.1",
      "title": "案台",
      "lines": [
        {
          "speaker": "斥候",
          "text": "案台被撬，好砚堆在心案。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护墨火，别把战拖成糊案。双案先合桥。"
        },
        {
          "speaker": "管事",
          "text": "合桥掩护，心案夺砚。"
        },
        {
          "speaker": "系统",
          "text": "出战「案台」。"
        }
      ],
      "battle": "ch179_desk",
      "unlock": [
        "ch179_desk_done"
      ],
      "next": "179.2"
    },
    {
      "id": "179.2",
      "title": "印房",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "印房丘套有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "外丘内平，场心垒禁乱火，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "破丘再夺房。火不稳，砚印盖不下。"
        },
        {
          "speaker": "春令使者",
          "text": "房一糊，满市的字都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「印房」。"
        }
      ],
      "battle": "ch179_sealroom",
      "unlock": [
        "ch179_sealroom_done"
      ],
      "next": "179.3"
    },
    {
      "id": "179.3",
      "title": "可印房",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可印房』。下一章是砚印——要把二十九卷中段真正盖上。"
        },
        {
          "speaker": "春令使者",
          "text": "砚印不是歇墨。是还敢不敢续案。"
        },
        {
          "speaker": "系统",
          "text": "第一百七十九章完成。"
        }
      ],

{
  "id": "chapter128",
  "title": "第一百二十八章·案库",
  "beats": [
    {
      "id": "128.0",
      "title": "案库令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可开坊之后，案库要验的是：灰旗敢不敢把刀放短、把诏放稳——诏歪了，姓会先从纸上摔下去。"
        },
        {
          "speaker": "管事",
          "text": "两场：案库、诏板。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "案库西丘东垒。诏板场心有小垒，开阔。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸诏架。砸了要写进王朝手记的黑页——无板之令等于无旗。"
        },
        {
          "speaker": "系统",
          "text": "第二十卷后半。"
        }
      ],
      "next": "128.1"
    },
    {
      "id": "128.1",
      "title": "案库",
      "lines": [
        {
          "speaker": "斥候",
          "text": "案库被撬，好档堆在东垒。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护档架，别把战拖成撕卷。"
        },
        {
          "speaker": "管事",
          "text": "西丘掩护，东垒夺档。禁火。"
        },
        {
          "speaker": "系统",
          "text": "出战「案库」。"
        }
      ],
      "battle": "ch128_archive",
      "unlock": [
        "ch128_archive_done"
      ],
      "next": "128.2"
    },
    {
      "id": "128.2",
      "title": "诏板",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "诏板场有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "场心垒禁火，主板线在中。"
        },
        {
          "speaker": "管事",
          "text": "清索再立板。板不稳，席终盖不下印。"
        },
        {
          "speaker": "春令使者",
          "text": "板一裂，满城的令都会假。"
        },
        {
          "speaker": "系统",
          "text": "出战「诏板」。"
        }
      ],
      "battle": "ch128_edict",
      "unlock": [
        "ch128_edict_done"
      ],
      "next": "128.3"
    },
    {
      "id": "128.3",
      "title": "可案诏",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可案诏』。下一章是二十卷席终——要把纸坊的姓真正写入旗角。"
        },
        {
          "speaker": "春令使者",
          "text": "席终不是歇抄。是还敢不敢让满城看灰旗的白笺。"
        },
        {
          "speaker": "系统",
          "text": "第一百二十八章完成。"
        }
      ],
      "unlock": [

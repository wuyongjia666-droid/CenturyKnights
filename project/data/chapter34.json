      "next": "34.1",
      "lines": [
        {
          "speaker": "旁白",
          "text": "五卷破晓。光来得早，早到敌方把阴影当掩体——阴影里才是编制。"
        },
        {
          "speaker": "管事",
          "text": "破晓两场。"
        },
        {
          "speaker": "系统",
          "text": "第三十四章·破晓。"
        }
      ]
    },
    {
      "id": "34.1",
      "title": "五卷破晓",
      "battle": "ch34_dawn",
      "unlock": [
        "ch34_dawn_done"
      ],
      "next": "34.2",
      "lines": [
        {
          "speaker": "春令使者",
          "text": "「五卷破晓」——风从敌阵那边过来，带着金属味。 此地多林、丘、垒。"
        },
        {
          "speaker": "老旗手",
          "text": "治疗跟主旗三步内。落单的人我会点名。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "活口留一个。问清背后宅邸。"
        },
        {
          "speaker": "系统",
          "text": "出战「五卷破晓」。"
        }
      ]
    },
    {
      "id": "34.2",
      "title": "破晓渡",
      "battle": "ch34_cross",
      "unlock": [
        "ch34_cross_done"
      ],
      "next": "34.3",
      "lines": [
        {
          "speaker": "春令使者",
          "text": "「破晓渡」——风从敌阵那边过来，带着金属味。 此地多水、桥。"
        },
        {
          "speaker": "老旗手",
          "text": "技能留给打开口的那一下，别打在空地上。"
        },
        {
          "speaker": "老旗手",
          "text": "我把东翼探过了：有伏，但伏得不深。"
        },
        {
          "speaker": "系统",
          "text": "出战「破晓渡」。"
        }
      ]
    },
    {
      "id": "34.3",
      "title": "五卷可入",
      "unlock": [
        "chapter34_done",
        "volume5_open"
      ],
      "next": null,
      "lines": [
        {
          "speaker": "旁白",
          "text": "第三十四章·破晓到了收束处。风停一刻，墨才能干。"
        },
        {
          "speaker": "春令使者",
          "text": "印若已落，便可回堡，也可继续下一章。灰旗的路，从来不是单行。"
        },
        {
          "speaker": "管事",
          "text": "银粮与声望已按章结算。旗手歇口气。"
        },
        {
          "speaker": "系统",
          "text": "第三十四章完成。"
        }
      ]
    }
  ]
}
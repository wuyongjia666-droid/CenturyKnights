{
  "id": "chapter223",
  "title": "第二百二十三章·香摊",
  "beats": [
    {
      "id": "223.0",
      "title": "香摊令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "香印盖过之后，三十六卷后半要验香摊与香架——摊上的香票会骗人，架上的炉灰会先散。"
        },
        {
          "speaker": "管事",
          "text": "两场：香摊、香架。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "香摊三列棚廊。香架竖廊夹中，像一排关着香的屉。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸架纽。砸了写进黑页——空架等于空香。"
        },
        {
          "speaker": "系统",
          "text": "第三十六卷后半。"
        }
      ],
      "next": "223.1"
    },
    {
      "id": "223.1",
      "title": "香摊",
      "lines": [
        {
          "speaker": "斥候",
          "text": "香摊棚廊被撬，好香堆在中廊。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护烟，别把战拖成灰雾。"
        },
        {
          "speaker": "管事",
          "text": "清廊掩护，中廊夺香。"
        },
        {
          "speaker": "系统",
          "text": "出战「香摊」。"
        }
      ],
      "battle": "ch223_fair",
      "unlock": [
        "ch223_fair_done"
      ],
      "next": "223.2"
    },
    {
      "id": "223.2",
      "title": "香架",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "香架竖廊有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "外廊内屉，禁乱翻，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清廊再夺架。烟不稳，独香开不了。"
        },
        {
          "speaker": "春令使者",
          "text": "架一散，满市的香都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「香架」。"
        }
      ],
      "battle": "ch223_rack",

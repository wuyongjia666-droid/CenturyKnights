{
  "id": "chapter88",
  "title": "第八十八章·茶梯",
  "beats": [
    {
      "id": "88.0",
      "title": "茶岭令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "十三卷丝印席终之后，旅馆贴的不是桑叶，是一片焦边的茶青。十四卷是茶岭——梯田认的不是织与戏，是谁还肯把姓焙进罐里：罐破了，客商就不认路。"
        },
        {
          "speaker": "管事",
          "text": "两场：茶梯、茶垛。打完，旅馆写『可茶梯』。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "梯田丘多。垛场有林墙隔仓。"
        },
        {
          "speaker": "老旗手",
          "text": "踩坏茶青的人，配不上十四卷。"
        },
        {
          "speaker": "系统",
          "text": "第十四卷·茶岭开启。"
        }
      ],
      "next": "88.1"
    },
    {
      "id": "88.1",
      "title": "茶梯",
      "lines": [
        {
          "speaker": "春令使者",
          "text": "茶梯一层一层往上。上层的人看不起下层——用刀证明也一样。"
        },
        {
          "speaker": "斥候",
          "text": "丘田交错，中心有垒。弓占上层。"
        },
        {
          "speaker": "管事",
          "text": "侧翼绕上，别仰攻硬顶。"
        },
        {
          "speaker": "系统",
          "text": "出战「茶梯」。"
        }
      ],
      "battle": "ch88_terrace",
      "unlock": [
        "ch88_terrace_done"
      ],
      "next": "88.2"
    },
    {
      "id": "88.2",
      "title": "茶垛",
      "lines": [
        {
          "speaker": "旁白",
          "text": "茶梯既通，茶垛却被人浇了水——水一浇，整垛发霉，客商就会改道。"
        },
        {
          "speaker": "老旗手",
          "text": "林墙隔仓。缺口汇合。别推倒垛。"
        },
        {
          "speaker": "斥候",
          "text": "浇水的人在西仓。优先拿下。"
        },
        {
          "speaker": "系统",
          "text": "出战「茶垛」。"
        }
      ],
      "battle": "ch88_heap",
      "unlock": [
        "ch88_heap_done"
      ],
      "next": "88.3"
    },
    {
      "id": "88.3",
      "title": "可茶梯",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可茶梯』。下一章是蒸青与炒青。"
        },
        {
          "speaker": "春令使者",
          "text": "火候与水汽，都是脾气。脾气不理顺，茶就苦。"
        },
        {
          "speaker": "系统",
          "text": "第八十八章完成。"
        }
      ],
      "unlock": [
        "chapter88_done",
        "volume14_open"
      ],
      "next": null
    }
  ]
}
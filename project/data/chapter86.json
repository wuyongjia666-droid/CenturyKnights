{
  "id": "chapter86",
  "title": "第八十六章·经轴",
  "beats": [
    {
      "id": "86.0",
      "title": "经轴令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可烘染之后，经轴厅要验的是：灰旗敢不敢把每一根经都理顺——经乱，纬再美也是废匹。"
        },
        {
          "speaker": "管事",
          "text": "两场：经轴、成绢。"
        },
        {
          "speaker": "老旗手",
          "text": "厅里横着一道『经林』。缺口少，别硬拆。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "成绢场开阔。假匹多，认印再收。"
        },
        {
          "speaker": "系统",
          "text": "第十三卷后半。"
        }
      ],
      "next": "86.1"
    },
    {
      "id": "86.1",
      "title": "经轴",
      "lines": [
        {
          "speaker": "春令使者",
          "text": "经轴厅中林墙隔断。"
        },
        {
          "speaker": "管事",
          "text": "南北两垒，优先救经。"
        },
        {
          "speaker": "系统",
          "text": "出战「经轴」。"
        }
      ],
      "battle": "ch86_warp",
      "unlock": [
        "ch86_warp_done"
      ],
      "next": "86.2"
    },
    {
      "id": "86.2",
      "title": "成绢",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "成绢场挂未钤匹头。"
        },
        {
          "speaker": "斥候",
          "text": "认印再收，别毁绢；先清北丘弓。"
        },
        {
          "speaker": "系统",
          "text": "出战「成绢」。"
        }

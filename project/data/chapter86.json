{
  "id": "chapter86",
  "title": "第八十六章·经轴",
  "beats": [
    {
      "id": "86.0",
      "title": "经轴令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可烘染之后，经轴厅要验的是：灰旗敢不敢把每一根经都理顺——经乱，纬再美也是废匹。"
        },
        {
          "speaker": "管事",
          "text": "两场：经轴、成绢。"
        },
        {
          "speaker": "老旗手",
          "text": "厅里横着一道『经林』。缺口少，别硬拆。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "成绢场开阔。假匹多，认印再收。"
        },
        {
          "speaker": "系统",
          "text": "第十三卷后半。"
        }
      ],
      "next": "86.1"
    },
    {
      "id": "86.1",
      "title": "经轴",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "我年青时在比这更烂的地方打过。听指挥，别英雄。"
        },
        {
          "speaker": "斥候",
          "text": "「经轴」入口只有一处干净的。其余都是坑。"
        },
        {
          "speaker": "系统",
          "text": "出战「经轴」。"
        }
      ],
      "battle": "ch86_warp",
      "unlock": [
        "ch86_warp_done"
      ],
      "next": "86.2"
    },
    {
      "id": "86.2",
      "title": "成绢",
      "lines": [
        {
          "speaker": "春令使者",
          "text": "对手想逼你们改约。改约的人先毁自己的姓。"
        },
        {
          "speaker": "斥候",
          "text": "「成绢」敌军人数与编制如下：精锐靠后，散兵在前诱。"
        },
        {
          "speaker": "系统",
          "text": "出战「成绢」。"
        }
      ],
      "battle": "ch86_bolt",
      "unlock": [
        "ch86_bolt_done"
      ],
      "next": "86.3"
    },
    {
      "id": "86.3",
      "title": "可经绢",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可经绢』。席终只剩一场——把十三卷的丝织进族谱边栏。"
        },
        {
          "speaker": "春令使者",
          "text": "下一章是十三卷席终。把能带的都带上。"
        },
        {
          "speaker": "系统",
          "text": "第八十六章完成。"
        }
      ],

  "title": "第七十一章·釉河",
  "beats": [
    {
      "id": "71.0",
      "title": "釉河令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可窑口之后，釉河亮得像有人把整条河上了釉。河不深，深的是谁敢把旗伸进釉里——伸进去就得认：旗也是一件坯。"
        },
        {
          "speaker": "管事",
          "text": "两场：釉河、素坯。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "釉河多桥。素坯场开阔，侧林有弓。"
        },
        {
          "speaker": "老旗手",
          "text": "釉沾身洗不掉。别浪。"
        },
        {
          "speaker": "系统",
          "text": "第十一卷。"
        }
      ],
      "next": "71.1"
    },
    {
      "id": "71.1",
      "title": "釉河",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "釉河多桥，对岸泼釉障眼。"
        },
        {
          "speaker": "斥候",
          "text": "分翼过桥，别晒成坯架。"
        },
        {
          "speaker": "系统",
          "text": "出战「釉河」。"
        }
      ],

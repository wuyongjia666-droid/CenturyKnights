{
  "id": "chapter71",
  "title": "第七十一章·釉河",
  "beats": [
    {
      "id": "71.0",
      "title": "釉河令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可窑口之后，釉河亮得像有人把整条河上了釉。河不深，深的是谁敢把旗伸进釉里——伸进去就得认：旗也是一件坯。"
        },
        {
          "speaker": "管事",
          "text": "两场：釉河、素坯。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "釉河多桥。素坯场开阔，侧林有弓。"
        },
        {
          "speaker": "老旗手",
          "text": "釉沾身洗不掉。别浪。"
        },
        {
          "speaker": "系统",
          "text": "第十一卷。"
        }
      ],
      "next": "71.1"
    },
    {
      "id": "71.1",
      "title": "釉河",
      "lines": [
        {
          "speaker": "管事",
          "text": "「釉河」——这一格格子都像在等谁先心急。 此地多水、桥、垒。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "桥/窄路只过一人宽时，单列，掩护弓先到位。"
        },
        {
          "speaker": "老旗手",
          "text": "旗在，名册在，人可以撤；三者丢一，这一仗就算白打。"
        },
        {
          "speaker": "系统",
          "text": "出战「釉河」。"
        }
      ],
      "battle": "ch71_glaze",
      "unlock": [
        "ch71_glaze_done"
      ],
      "next": "71.2"
    },
    {
      "id": "71.2",
      "title": "素坯",
      "lines": [
        {
          "speaker": "春令使者",
          "text": "「素坯」——风从敌阵那边过来，带着金属味。 此地多林、丘、垒。"
        },
        {
          "speaker": "老旗手",
          "text": "技能留给打开口的那一下，别打在空地上。"
        },
        {
          "speaker": "管事",
          "text": "别砸民居与作坊。砸了要赔，也要写进手记。"
        },
        {
          "speaker": "系统",
          "text": "出战「素坯」。"
        }
      ],
      "battle": "ch71_bisque",
      "unlock": [
        "ch71_bisque_done"
      ],
      "next": "71.3"
    },
    {
      "id": "71.3",
      "title": "可釉坯",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可釉坯』。下一章是十一卷钤印——窑印。"
        },
        {
          "speaker": "春令使者",
          "text": "窑印在丘环中心。火温要稳。"
        },
        {
          "speaker": "系统",
          "text": "第七十一章完成。"
        }
      ],

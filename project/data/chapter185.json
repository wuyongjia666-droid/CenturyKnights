{
  "id": "chapter185",
  "title": "第一百八十五章·烟熏",
  "beats": [
    {
      "id": "185.0",
      "title": "烟熏令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可入场之后，烟熏要验的是：灰旗敢不敢把刀放短、把蜜放稳——蜜歪了，人会先从陌上倒进空票。"
        },
        {
          "speaker": "管事",
          "text": "两场：烟熏、蜜房。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "烟熏双障夹心。蜜房格垒如脾，疏密交错。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸巢门。砸了要写进王朝手记的黑页——无蜜之熏等于无场。"
        },
        {
          "speaker": "系统",
          "text": "第三十卷中段。"
        }
      ],
      "next": "185.1"
    },
    {
      "id": "185.1",
      "title": "烟熏",
      "lines": [
        {
          "speaker": "斥候",
          "text": "烟熏障被截，好脾堆在心垒。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护脾火，别把战拖成蛰场。双障择桥再进。"
        },
        {
          "speaker": "管事",
          "text": "择桥掩护，心垒夺脾。"
        },
        {
          "speaker": "系统",
          "text": "出战「烟熏」。"
        }
      ],
      "battle": "ch185_smoker",
      "unlock": [
        "ch185_smoker_done"
      ],
      "next": "185.2"
    },
    {
      "id": "185.2",
      "title": "蜜房",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "蜜房格垒有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "格如蜂房，疏密交错，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清索再守房。火不稳，蜂印盖不下。"
        },
        {
          "speaker": "春令使者",
          "text": "房一蛰，满陌的蜜都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「蜜房」。"
        }
      ],
      "battle": "ch185_comb",
      "unlock": [
        "ch185_comb_done"
      ],
      "next": "185.3"
    },
    {
      "id": "185.3",
      "title": "可蜜房",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可蜜房』。下一章是蜂印——要把三十卷中段真正盖上。"
        },
        {
          "speaker": "春令使者",
          "text": "蜂印不是歇脾。是还敢不敢续场。"
        },
        {
          "speaker": "系统",
          "text": "第一百八十五章完成。"
        }
      ],

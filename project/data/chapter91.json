{
  "id": "chapter91",
  "title": "第九十一章·晾青",
  "beats": [
    {
      "id": "91.0",
      "title": "晾青令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "十四卷中段茶印之后，后半从晾青起。青叶摊在簸箕上，风一不对就会红变——红变了，客商说『这不是灰旗的茶』。"
        },
        {
          "speaker": "管事",
          "text": "两场：晾青、窨花。打完，旅馆写『可晾窨』。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "晾场靠北丘。窨花在林环里，香气会迷鼻，也会迷刀。"
        },
        {
          "speaker": "老旗手",
          "text": "别踩簸箕。踩了等于毁一季。"
        },
        {
          "speaker": "系统",
          "text": "第十四卷后半。"
        }
      ],
      "next": "91.1"
    },
    {
      "id": "91.1",
      "title": "晾青",
      "lines": [
        {
          "speaker": "斥候",
          "text": "晾青北丘弓，簸箕翻半。"
        },
        {
          "speaker": "管事",
          "text": "夺场心扶簸箕，防泼水。"
        },
        {
          "speaker": "系统",
          "text": "出战「晾青」。"
        }
      ],
      "battle": "ch91_wither",
      "unlock": [
        "ch91_wither_done"
      ],
      "next": "91.2"
    },
    {
      "id": "91.2",
      "title": "窨花",
      "lines": [
        {
          "speaker": "管事",
          "text": "窨花林环换花种。"
        },
        {
          "speaker": "老旗手",
          "text": "护花匣禁火，真匣在西。"
        },
        {
          "speaker": "系统",
          "text": "出战「窨花」。"
        }
      ],
      "battle": "ch91_scent",
      "unlock": [

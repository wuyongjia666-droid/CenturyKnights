{
  "id": "chapter137",
  "title": "第一百三十七章·灯棚",
  "beats": [
    {
      "id": "137.0",
      "title": "灯棚令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可灯街之后，灯棚要验的是：灰旗敢不敢在火星里把刀收短——火太乱，灯会先把夜烧掉。"
        },
        {
          "speaker": "管事",
          "text": "两场：灯棚、油库。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "棚心有垒。油库有竖水槽。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸油罐。砸了要写进王朝手记的黑页——无油之灯等于无夜。"
        },
        {
          "speaker": "系统",
          "text": "第二十二卷。"
        }
      ],
      "next": "137.1"
    },
    {
      "id": "137.1",
      "title": "灯棚",
      "lines": [
        {
          "speaker": "斥候",
          "text": "灯棚门封，新灯在心。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "破门先护棚心，别把战拖成纵火。"
        },
        {
          "speaker": "管事",
          "text": "顺灯推进。逆风会燎己。"
        },
        {
          "speaker": "系统",
          "text": "出战「灯棚」。"
        }
      ],
      "battle": "ch137_booth",
      "unlock": [
        "ch137_booth_done"
      ],
      "next": "137.2"
    },
    {
      "id": "137.2",
      "title": "油库",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "油库被撬。油桶散了一地。"
        },
        {
          "speaker": "斥候",
          "text": "水槽护库禁乱火，主罐在心。"
        },
        {
          "speaker": "管事",
          "text": "清贼再合罐。油不全，下一章灯印盖不下去。"
        },
        {
          "speaker": "系统",
          "text": "出战「油库」。"
        }
      ],
      "battle": "ch137_oil",
      "unlock": [
        "ch137_oil_done"
      ],
      "next": "137.3"
    },
    {
      "id": "137.3",
      "title": "可棚油",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可棚油』。下一章是二十二卷钤印——灯印。"
        },
        {
          "speaker": "春令使者",
          "text": "灯印烙在笼底。烙歪了，灯市不认。"
        },
        {
          "speaker": "系统",
          "text": "第一百三十七章完成。"
        }
      ],

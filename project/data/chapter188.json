{
  "id": "chapter188",
  "title": "第一百八十八章·蜂后",
  "beats": [
    {
      "id": "188.0",
      "title": "蜂后令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可开市之后，蜂后要验的是：灰旗敢不敢把刀放短、把蜜放稳——蜜歪了，人会先从陌上倒进空票。"
        },
        {
          "speaker": "管事",
          "text": "两场：蜂后、守场。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "蜂后丘环心垒。守场双巢夹陌，曲廊相连。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸后房。砸了要写进王朝手记的黑页——无蜜之后等于无场。"
        },
        {
          "speaker": "系统",
          "text": "第三十卷后半。"
        }
      ],
      "next": "188.1"
    },
    {
      "id": "188.1",
      "title": "蜂后",
      "lines": [
        {
          "speaker": "斥候",
          "text": "蜂后环被撬，好脾堆在心垒。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护脾火，别把战拖成蛰场。丘环择桥再登。"
        },
        {
          "speaker": "管事",
          "text": "择桥掩护，心垒夺脾。"
        },
        {
          "speaker": "系统",
          "text": "出战「蜂后」。"
        }
      ],
      "battle": "ch188_queen",
      "unlock": [
        "ch188_queen_done"
      ],
      "next": "188.2"
    },
    {
      "id": "188.2",
      "title": "守场",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "守场双巢有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "近巢远巢分据，曲廊禁乱火，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "先近后远。火不稳，席终盖不下印。"
        },
        {
          "speaker": "春令使者",
          "text": "场一蛰，满陌的蜜都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「守场」。"
        }
      ],
      "battle": "ch188_guard",
      "unlock": [
        "ch188_guard_done"
      ],
      "next": "188.3"
    },
    {
      "id": "188.3",
      "title": "可守场",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可守场』。下一章是三十卷席终——要把蜂场的姓真正写入旗角。"
        },
        {
          "speaker": "春令使者",
          "text": "席终不是歇脾。是还敢不敢让满陌看灰旗的蜜笺。"
        },
        {
          "speaker": "系统",
          "text": "第一百八十八章完成。"
        }
      ],

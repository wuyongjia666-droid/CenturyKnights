{
  "id": "chapter28",
  "title": "第二十八章·南泽",
  "beats": [
    {
      "id": "28.0",
      "title": "南泽点名",
      "next": "28.1",
      "lines": [
        {
          "speaker": "旁白",
          "text": "南泽开四卷。泽国的路会动——动的不是土，是谁肯给路钱。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "泥地减益。别硬冲。"
        },
        {
          "speaker": "系统",
          "text": "第二十八章·南泽。"
        }
      ]
    },
    {
      "id": "28.1",
      "title": "南泽斥候",
      "battle": "ch28_marsh",
      "unlock": [
        "ch28_marsh_done"
      ],
      "next": "28.2",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "「南泽斥候」——打完要把活口留下一个——问清谁在出钱。 此地多水、林、垒。"
        },
        {
          "speaker": "管事",
          "text": "别在开阔地站成一排。弓手换位要快。"
        },
        {
          "speaker": "斥候",
          "text": "旗在，名册在，人可以撤；三者丢一，这一仗就算白打。"
        },
        {
          "speaker": "系统",
          "text": "出战「南泽斥候」。"
        }
      ]
    },
    {
      "id": "28.2",
      "title": "南渡口",
      "battle": "ch28_ferry",
      "unlock": [
        "ch28_ferry_done"
      ],
      "next": "28.3",
      "lines": [
        {
          "speaker": "旁白",
          "text": "「南渡口」：旗帜可以湿，名册不能湿。"
        },
        {
          "speaker": "斥候",
          "text": "技能留给打开口的那一下，别打在空地上。"
        },
        {
          "speaker": "管事",
          "text": "别砸民居与作坊。砸了要赔，也要写进手记。"
        },
        {
          "speaker": "系统",
          "text": "出战「南渡口」。"
        }
      ]
    },
    {
      "id": "28.3",
      "title": "四卷可入",
      "unlock": [
        "chapter28_done",
        "volume4_open"
      ],
      "next": null,
      "lines": [
        {
          "speaker": "旁白",
          "text": "第二十八章·南泽到了收束处。风停一刻，墨才能干。"
        },
        {
          "speaker": "春令使者",
          "text": "印若已落，便可回堡，也可继续下一章。灰旗的路，从来不是单行。"
        },
        {
          "speaker": "管事",
          "text": "银粮与声望已按章结算。旗手歇口气。"
        },
        {
          "speaker": "系统",
          "text": "第二十八章完成。"
        }
      ]
    }
  ]
}
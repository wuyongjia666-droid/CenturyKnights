{
  "id": "chapter211",
  "title": "第二百一十一章·色市",
  "beats": [
    {
      "id": "211.0",
      "title": "色市令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "染印盖过之后，三十四卷后半要验色市与织架——市里的色票会骗人，架上的纬线会先断。"
        },
        {
          "speaker": "管事",
          "text": "两场：色市、织架。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "色市三列棚廊。织架竖廊夹中，像一排关着色的屉。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸架纽。砸了写进黑页——空架等于空色。"
        },
        {
          "speaker": "系统",
          "text": "第三十四卷后半。"
        }
      ],
      "next": "211.1"
    },
    {
      "id": "211.1",
      "title": "色市",
      "lines": [
        {
          "speaker": "斥候",
          "text": "色市棚廊被撬，好布堆在中廊。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护色，别把战拖成花雾。"
        },
        {
          "speaker": "管事",
          "text": "清廊掩护，中廊夺布。"
        },
        {
          "speaker": "系统",
          "text": "出战「色市」。"
        }
      ],
      "battle": "ch211_fair",
      "unlock": [
        "ch211_fair_done"
      ],
      "next": "211.2"
    },
    {
      "id": "211.2",
      "title": "织架",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "织架竖廊有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "外廊内屉，禁乱踏，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清廊再夺架。色不稳，独染开不了。"
        },
        {
          "speaker": "春令使者",
          "text": "架一散，满市的色都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「织架」。"
        }
      ],
      "battle": "ch211_loom",
      "unlock": [
        "ch211_loom_done"
      ],
      "next": "211.3"
    },
    {
      "id": "211.3",
      "title": "可架",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可织架』。下一章是独染。"
        },
        {
          "speaker": "春令使者",
          "text": "独染不是歇色。是还敢不敢一人成色。"
        },
        {
          "speaker": "系统",
          "text": "第二百一十一章完成。"
        }
      ],

{
  "id": "chapter214",
  "title": "第二百一十四章·鼓楼",
  "beats": [
    {
      "id": "214.0",
      "title": "鼓楼令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "三十四卷已执。第三十五卷·鼓楼要验的是：灰旗敢不敢把脚放稳、把拍放清——拍乱了，鼓会先从楼上哑成空旗。"
        },
        {
          "speaker": "管事",
          "text": "两场：鼓楼、鼓廊。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "鼓楼同心垒环。鼓廊横贯，桥口错落。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸鼓面。砸了写进黑页——空鼓等于空楼。"
        },
        {
          "speaker": "系统",
          "text": "第三十五卷中段。"
        }
      ],
      "next": "214.1"
    },
    {
      "id": "214.1",
      "title": "鼓楼",
      "lines": [
        {
          "speaker": "斥候",
          "text": "鼓楼心垒被撬，好鼓堆在中环。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护拍，别把战拖成哑场。"
        },
        {
          "speaker": "管事",
          "text": "清环掩护，中环夺鼓。"
        },
        {
          "speaker": "系统",
          "text": "出战「鼓楼」。"
        }
      ],
      "battle": "ch214_tower",
      "unlock": [
        "ch214_tower_done"
      ],
      "next": "214.2"
    },
    {
      "id": "214.2",
      "title": "鼓廊",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "鼓廊横贯有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "外廊内室，桥口禁乱踏，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清廊再夺垒。拍不稳，擂台开不了。"
        },
        {
          "speaker": "春令使者",
          "text": "廊一散，满楼的鼓都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「鼓廊」。"
        }
      ],
      "battle": "ch214_gallery",
      "unlock": [
        "ch214_gallery_done"
      ],
      "next": "214.3"
    },
    {
      "id": "214.3",
      "title": "可廊",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可鼓廊』。下一章是擂台。"
        },
        {
          "speaker": "春令使者",
          "text": "擂台不是歇拍。是还敢不敢成拍。"
        },
        {
          "speaker": "系统",
          "text": "第二百一十四章完成。"
        }
      ],

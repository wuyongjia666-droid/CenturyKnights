{
  "id": "chapter107",
  "title": "第一百零七章·糟坊",
  "beats": [
    {
      "id": "107.0",
      "title": "糟坊令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可曲房之后，糟坊要验的是：灰旗敢不敢在火圈里把刀收短——火太猛，酒会先把宴席烧掉。"
        },
        {
          "speaker": "管事",
          "text": "两场：糟坊、酒旗。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "坊心有垒丘环。酒旗在跑道边，窄。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸旗杆。砸了要写进王朝手记的黑页——无旗之酒等于无宴。"
        },
        {
          "speaker": "系统",
          "text": "第十七卷。"
        }
      ],
      "next": "107.1"
    },
    {
      "id": "107.1",
      "title": "糟坊",
      "lines": [
        {
          "speaker": "斥候",
          "text": "糟坊门封，新糟在环心。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "破门先护环心灶，别把战拖成纵火。"
        },
        {
          "speaker": "管事",
          "text": "顺环推进。逆环会掀锅。"
        },
        {
          "speaker": "系统",
          "text": "出战「糟坊」。"
        }
      ],
      "battle": "ch107_mash",
      "unlock": [
        "ch107_mash_done"
      ],
      "next": "107.2"
    },
    {
      "id": "107.2",
      "title": "酒旗",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "酒旗被撬。旗布散了一地。"
        },
        {
          "speaker": "斥候",
          "text": "跑道护杆禁火，主杆在心。"
        },
        {
          "speaker": "管事",
          "text": "清贼再升旗。旗不全，下一章酒印盖不下去。"
        },
        {
          "speaker": "系统",
          "text": "出战「酒旗」。"
        }
      ],
      "battle": "ch107_banner",
      "unlock": [
        "ch107_banner_done"
      ],
      "next": "107.3"
    },
    {
      "id": "107.3",
      "title": "可糟旗",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可糟旗』。下一章是十七卷钤印——酒印。"
        },
        {
          "speaker": "春令使者",
          "text": "酒印盖在坛底。盖歪了，酒坊不认。"
        },
        {
          "speaker": "系统",
          "text": "第一百零七章完成。"
        }
      ],

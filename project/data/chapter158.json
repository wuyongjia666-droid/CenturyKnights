{
  "id": "chapter158",
  "title": "第一百五十八章·篁祠",
  "beats": [
    {
      "id": "158.0",
      "title": "篁祠令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可开市之后，篁祠要验的是：灰旗敢不敢把刀放短、把径放通——径歪了，人会先从海里倒进空票。"
        },
        {
          "speaker": "管事",
          "text": "两场：篁祠、望楼。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "篁祠呈曲尺垒。望楼夹丘如廊，中心小垒。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸祠柱。砸了要写进王朝手记的黑页——无径之祠等于无海。"
        },
        {
          "speaker": "系统",
          "text": "第二十五卷后半。"
        }
      ],
      "next": "158.1"
    },
    {
      "id": "158.1",
      "title": "篁祠",
      "lines": [
        {
          "speaker": "斥候",
          "text": "篁祠被撬，好径牌堆在曲尺垒东臂。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护祠火，别把战拖成纵火。曲尺两臂都要顾。"
        },
        {
          "speaker": "管事",
          "text": "西林掩护，东臂夺牌。"
        },
        {
          "speaker": "系统",
          "text": "出战「篁祠」。"
        }
      ],
      "battle": "ch158_altar",
      "unlock": [
        "ch158_altar_done"
      ],
      "next": "158.2"
    },
    {
      "id": "158.2",
      "title": "望楼",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "望楼夹丘有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "丘廊交错，场心垒禁乱火，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清索再守楼。火不稳，席终盖不下印。"
        },
        {
          "speaker": "春令使者",
          "text": "楼一塌，满海的径都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「望楼」。"
        }
      ],
      "battle": "ch158_watch",
      "unlock": [
        "ch158_watch_done"
      ],
      "next": "158.3"
    },
    {
      "id": "158.3",
      "title": "可望楼",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可望楼』。下一章是二十五卷席终——要把竹海的姓真正写入旗角。"
        },
        {
          "speaker": "春令使者",
          "text": "席终不是歇径。是还敢不敢让满海看灰旗的篁笺。"
        },
        {
          "speaker": "系统",
          "text": "第一百五十八章完成。"
        }
      ],

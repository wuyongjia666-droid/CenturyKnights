{
  "id": "chapter40",
  "title": "第四十章·雾原",
  "beats": [
    {
      "id": "40.0",
      "title": "雾原点名",
      "next": "40.1",
      "lines": [
        {
          "speaker": "旁白",
          "text": "六卷雾原。雾不是天气，是有人把路牌拧反。"
        },
        {
          "speaker": "斥候",
          "text": "短视距。别散。"
        },
        {
          "speaker": "系统",
          "text": "第四十章·雾原。"
        }
      ]
    },
    {
      "id": "40.1",
      "title": "雾原初旗",
      "battle": "ch40_mist",
      "unlock": [
        "ch40_mist_done"
      ],
      "next": "40.2",
      "lines": [
        {
          "speaker": "春令使者",
          "text": "「雾原初旗」——风从敌阵那边过来，带着金属味。 此地多林、丘、垒。"
        },
        {
          "speaker": "老旗手",
          "text": "两路：一路粘住正面，一路从林摸进去。"
        },
        {
          "speaker": "春令使者",
          "text": "风偏林，烟会迷眼时改侧翼。"
        },
        {
          "speaker": "系统",
          "text": "出战「雾原初旗」。"
        }
      ]
    },
    {
      "id": "40.2",
      "title": "雾原浅滩",
      "battle": "ch40_ford",
      "unlock": [
        "ch40_ford_done"
      ],
      "next": "40.3",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "「雾原浅滩」——这里一仗，赢的不只是地，是旅馆墙上那一行字还改不改。 此地多水、桥。"
        },
        {
          "speaker": "斥候",
          "text": "治疗跟主旗三步内。落单的人我会点名。"
        },
        {
          "speaker": "老旗手",
          "text": "我把东翼探过了：有伏，但伏得不深。"
        },
        {
          "speaker": "系统",
          "text": "出战「雾原浅滩」。"
        }
      ]
    },
    {
      "id": "40.3",
      "title": "六卷可入",
      "unlock": [
        "chapter40_done",
        "volume6_open"
      ],
      "next": null,
      "lines": [
        {
          "speaker": "旁白",
          "text": "第四十章·雾原到了收束处。风停一刻，墨才能干。"
        },
        {
          "speaker": "春令使者",
          "text": "印若已落，便可回堡，也可继续下一章。灰旗的路，从来不是单行。"
        },
        {
          "speaker": "管事",
          "text": "银粮与声望已按章结算。旗手歇口气。"
        },
        {
          "speaker": "系统",
          "text": "第四十章完成。"
        }
      ]
    }
  ]
}
      "title": "长川令",
      "next": "37.1",
      "lines": [
        {
          "speaker": "旁白",
          "text": "长川把两岸拆开。拆开的不只是地，是契约的送达时间。"
        },
        {
          "speaker": "管事",
          "text": "渡川。桥口争夺。"
        },
        {
          "speaker": "系统",
          "text": "第三十七章·长川。"
        }
      ]
    },
    {
      "id": "37.1",
      "title": "长川平野",
      "battle": "ch37_plain",
      "unlock": [
        "ch37_plain_done"
      ],
      "next": "37.2",
      "lines": [
        {
          "speaker": "斥候",
          "text": "「长川平野」——有人要在这里把灰旗的名字换成税签。 此地多林、丘、垒。"
        },
        {
          "speaker": "管事",
          "text": "先清射界，再向心。侧翼留一个人专门喊风向。"
        },
        {
          "speaker": "管事",
          "text": "别砸民居与作坊。砸了要赔，也要写进手记。"
        },
        {
          "speaker": "系统",
          "text": "出战「长川平野」。"
        }
      ]
    },
    {
      "id": "37.2",
      "title": "长川脊垒",
      "battle": "ch37_ridge",
      "unlock": [
        "ch37_ridge_done"
      ],
      "next": "37.3",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "「长川脊垒」——打完要把活口留下一个——问清谁在出钱。 此地多林、丘、垒。"
        },
        {
          "speaker": "管事",
          "text": "夺林之后立刻成阵，别恋战收割。"
        },
        {
          "speaker": "斥候",
          "text": "旗在，名册在，人可以撤；三者丢一，这一仗就算白打。"
        },
        {
          "speaker": "系统",
          "text": "出战「长川脊垒」。"
        }
      ]
    },
    {
      "id": "37.3",
      "title": "可长川",
      "unlock": [
        "chapter37_done"
      ],
      "next": null,
      "lines": [
        {
          "speaker": "旁白",
          "text": "第三十七章·长川到了收束处。风停一刻，墨才能干。"
        },
        {
          "speaker": "春令使者",
          "text": "印若已落，便可回堡，也可继续下一章。灰旗的路，从来不是单行。"
        },
        {
          "speaker": "管事",
          "text": "银粮与声望已按章结算。旗手歇口气。"
        },
        {
          "speaker": "系统",
          "text": "第三十七章完成。"
        }
      ]
    }
  ]
}
      ],
      "next": "35.2",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "「晚钟城垣」——这里一仗，赢的不只是地，是旅馆墙上那一行字还改不改。 此地多丘、垒。"
        },
        {
          "speaker": "斥候",
          "text": "先清射界，再向心。侧翼留一个人专门喊风向。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "活口留一个。问清背后宅邸。"
        },
        {
          "speaker": "系统",
          "text": "出战「晚钟城垣」。"
        }
      ]
    },
    {
      "id": "35.2",
      "title": "晚钟内堡",
      "battle": "ch35_keep",
      "unlock": [
        "ch35_keep_done"
      ],
      "next": "35.3",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "「晚钟内堡」——打完要把活口留下一个——问清谁在出钱。 此地多林、垒。"
        },
        {
          "speaker": "管事",
          "text": "别在开阔地站成一排。弓手换位要快。"
        },
        {
          "speaker": "斥候",
          "text": "旗在，名册在，人可以撤；三者丢一，这一仗就算白打。"
        },
        {
          "speaker": "系统",
          "text": "出战「晚钟内堡」。"
        }
      ]
    },
    {
      "id": "35.3",
      "title": "钟印",
      "unlock": [
        "chapter35_done"
      ],
      "next": null,
      "lines": [
        {
          "speaker": "旁白",
          "text": "第三十五章·晚钟到了收束处。风停一刻，墨才能干。"
        },
        {
          "speaker": "春令使者",
          "text": "印若已落，便可回堡，也可继续下一章。灰旗的路，从来不是单行。"
        },
        {
          "speaker": "管事",
          "text": "银粮与声望已按章结算。旗手歇口气。"
        },
        {
          "speaker": "系统",
          "text": "第三十五章完成。"
        }
      ]
    }
  ]

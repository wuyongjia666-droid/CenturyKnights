{
  "id": "chapter200",
  "title": "第二百章·独影",
  "beats": [
    {
      "id": "200.0",
      "title": "独影令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可匣之后，独影与夜幕要验：灰旗敢不敢把刀放短、把影放稳——影歪了，幕会先从水里倒进空票。"
        },
        {
          "speaker": "管事",
          "text": "两场：独影、夜幕。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "独影水镜桥心。夜幕林环，内有心台。"
        },
        {
          "speaker": "老旗手",
          "text": "别踏碎镜水。碎了写进王朝手记——无镜之影等于无戏。"
        },
        {
          "speaker": "系统",
          "text": "第三十二卷后半。"
        }
      ],
      "next": "200.1"
    },
    {
      "id": "200.1",
      "title": "独影",
      "lines": [
        {
          "speaker": "斥候",
          "text": "独影水镜被拦，桥心有人。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "择桥夺心，别浪游深水。水镜会照出假旗。"
        },
        {
          "speaker": "管事",
          "text": "护桥清射，再夺心台。"
        },
        {
          "speaker": "系统",
          "text": "出战「独影」。"
        }
      ],
      "battle": "ch200_solo",
      "unlock": [
        "ch200_solo_done"
      ],
      "next": "200.2"
    },
    {
      "id": "200.2",
      "title": "夜幕",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "夜幕林环有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "外林内心，禁乱火，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清林再夺台。火不稳，席终盖不下。"
        },
        {
          "speaker": "春令使者",
          "text": "幕一散，满楼的影都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「夜幕」。"
        }
      ],
      "battle": "ch200_night",
      "unlock": [
        "ch200_night_done"
      ],
      "next": "200.3"
    },
    {
      "id": "200.3",
      "title": "可夜",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可夜』。下一章是席终——要把三十二卷真正收束。"
        },
        {
          "speaker": "春令使者",
          "text": "席终不是歇幕。是还敢不敢把姓配进最后一影。"
        },
        {
          "speaker": "系统",
          "text": "第二百章完成。"
        }
      ],

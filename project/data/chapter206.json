{
  "id": "chapter206",
  "title": "第二百零六章·独晒",
  "beats": [
    {
      "id": "206.0",
      "title": "独晒令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可架之后，独晒与夜卤要验：灰旗敢不敢把刀放短、把壳放稳。"
        },
        {
          "speaker": "管事",
          "text": "两场：独晒、夜卤。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "独晒水镜桥心。夜卤丘环，内有心台。"
        },
        {
          "speaker": "老旗手",
          "text": "别踏碎镜卤。碎了写进王朝手记——无镜之盐等于无滩。"
        },
        {
          "speaker": "系统",
          "text": "第三十三卷后半。"
        }
      ],
      "next": "206.1"
    },
    {
      "id": "206.1",
      "title": "独晒",
      "lines": [
        {
          "speaker": "斥候",
          "text": "独晒水镜被拦，桥心有人。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "择桥夺心，别浪游深卤。"
        },
        {
          "speaker": "管事",
          "text": "护桥清射，再夺心台。"
        },
        {
          "speaker": "系统",
          "text": "出战「独晒」。"
        }
      ],
      "battle": "ch206_solo",
      "unlock": [
        "ch206_solo_done"
      ],
      "next": "206.2"
    },
    {
      "id": "206.2",
      "title": "夜卤",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "夜卤丘环有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "外丘内心，禁乱踏，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清丘再夺台。卤不稳，席终盖不下。"
        },
        {
          "speaker": "春令使者",
          "text": "卤一散，满滩的盐都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「夜卤」。"
        }
      ],
      "battle": "ch206_night",
      "unlock": [
        "ch206_night_done"
      ],
      "next": "206.3"
    },
    {
      "id": "206.3",
      "title": "可夜",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可夜卤』。下一章是席终。"
        },
        {
          "speaker": "春令使者",
          "text": "席终不是歇卤。是还敢不敢把姓配进最后一壳。"
        },
        {
          "speaker": "系统",
          "text": "第二百零六章完成。"
        }
      ],

{
  "id": "chapter74",
  "title": "第七十四章·火塘",
  "beats": [
    {
      "id": "74.0",
      "title": "火塘令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可烟龛之后，火塘散布如星。星不是给人许愿的——是给人知道：哪一塘灭了，整排坯就会生裂。"
        },
        {
          "speaker": "管事",
          "text": "两场：火塘、冷却道。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "火塘多垒。冷却道中有竖水，桥三口。"
        },
        {
          "speaker": "老旗手",
          "text": "灭敌，别灭该留的火。"
        },
        {
          "speaker": "系统",
          "text": "第十一卷后半。"
        }
      ],
      "next": "74.1"
    },
    {
      "id": "74.1",
      "title": "火塘",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "「火塘」——这里一仗，赢的不只是地，是旅馆墙上那一行字还改不改。 此地多丘、垒。"
        },
        {
          "speaker": "斥候",
          "text": "治疗跟主旗三步内。落单的人我会点名。"
        },
        {
          "speaker": "管事",
          "text": "别砸民居与作坊。砸了要赔，也要写进手记。"
        },
        {
          "speaker": "系统",
          "text": "出战「火塘」。"
        }
      ],
      "battle": "ch74_hearth",
      "unlock": [
        "ch74_hearth_done"
      ],
      "next": "74.2"
    },
    {
      "id": "74.2",
      "title": "冷却道",
      "lines": [
        {
          "speaker": "苇原·灯影",
          "text": "「冷却道」——敌方不急着歼灭——他们急着让你们先乱。 此地多水、桥、垒。"
        },
        {
          "speaker": "管事",
          "text": "技能留给打开口的那一下，别打在空地上。"
        },
        {
          "speaker": "斥候",
          "text": "主旗居中，两翼用呼号，不靠眼神。"
        },
        {
          "speaker": "系统",
          "text": "出战「冷却道」。"
        }
      ],
      "battle": "ch74_cool",
      "unlock": [
        "ch74_cool_done"
      ],
      "next": "74.3"
    },
    {
      "id": "74.3",
      "title": "可火冷",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可火冷』。席终只剩窑席一场。"
        },
        {
          "speaker": "春令使者",
          "text": "下一章是十一卷席终。把能帶的都帶上。"
        },
        {
          "speaker": "系统",
          "text": "第七十四章完成。"
        }
      ],

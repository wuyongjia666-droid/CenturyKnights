{
  "id": "chapter98",
  "title": "第九十八章·医籍",
  "beats": [
    {
      "id": "98.0",
      "title": "医籍令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可煎穴之后，医籍库要验的是：灰旗敢不敢把方子留在纸上——纸被撕，口传就会变成谣言。"
        },
        {
          "speaker": "管事",
          "text": "两场：医籍、悬壶。"
        },
        {
          "speaker": "老旗手",
          "text": "籍库有林墙隔架。悬壶场靠林丘。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "别烧书。烧了要重抄，重抄要人命。"
        },
        {
          "speaker": "系统",
          "text": "第十五卷后半。"
        }
      ],
      "next": "98.1"
    },
    {
      "id": "98.1",
      "title": "医籍",
      "lines": [
        {
          "speaker": "斥候",
          "text": "林墙隔架，三口通行。有人撕页。"
        },
        {
          "speaker": "管事",
          "text": "护主架。撕页的人优先。禁火。"
        },
        {
          "speaker": "春令使者",
          "text": "孤本在北架第三格。"
        },
        {
          "speaker": "系统",
          "text": "出战「医籍」。"
        }
      ],
      "battle": "ch98_canon",
      "unlock": [
        "ch98_canon_done"
      ],
      "next": "98.2"
    },
    {
      "id": "98.2",
      "title": "悬壶",
      "lines": [
        {
          "speaker": "旁白",
          "text": "医籍既保，悬壶招牌却被人摘下——壶不挂，病家找不到门。"
        },
        {
          "speaker": "老旗手",
          "text": "夺回招牌位。清丘弓，护壶。"
        },
        {
          "speaker": "斥候",
          "text": "假壶诱敌。真壶在西垒。"
        },
        {
          "speaker": "系统",
          "text": "出战「悬壶」。"
        }
      ],
      "battle": "ch98_gourd",
      "unlock": [
        "ch98_gourd_done"
      ],
      "next": "98.3"
    },
    {
      "id": "98.3",
      "title": "可籍壶",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可籍壶』。席终只剩一场——把十五卷的方写进族谱边栏。"
        },
        {
          "speaker": "春令使者",
          "text": "下一章是十五卷席终。把能带的都带上，也带上能救人的人。"
        },
        {
          "speaker": "系统",
          "text": "第九十八章完成。"
        }
      ],

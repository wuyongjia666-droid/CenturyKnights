{
  "id": "chapter217",
  "title": "第二百一十七章·鼓市",
  "beats": [
    {
      "id": "217.0",
      "title": "鼓市令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "鼓印盖过之后，三十五卷后半要验鼓市与鼓架。"
        },
        {
          "speaker": "管事",
          "text": "两场：鼓市、鼓架。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "鼓市三列棚廊。鼓架竖廊夹中。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸架纽。砸了写进黑页——空架等于空鼓。"
        },
        {
          "speaker": "系统",
          "text": "第三十五卷后半。"
        }
      ],
      "next": "217.1"
    },
    {
      "id": "217.1",
      "title": "鼓市",
      "lines": [
        {
          "speaker": "斥候",
          "text": "鼓市棚廊被撬，好鼓堆在中廊。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护拍，别把战拖成哑场。"
        },
        {
          "speaker": "管事",
          "text": "清廊掩护，中廊夺鼓。"
        },
        {
          "speaker": "系统",
          "text": "出战「鼓市」。"
        }
      ],
      "battle": "ch217_fair",
      "unlock": [
        "ch217_fair_done"
      ],
      "next": "217.2"
    },
    {
      "id": "217.2",
      "title": "鼓架",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "鼓架竖廊有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "外廊内屉，禁乱砸，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清廊再夺架。拍不稳，独擂开不了。"
        },
        {
          "speaker": "春令使者",
          "text": "架一散，满市的鼓都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「鼓架」。"
        }
      ],
      "battle": "ch217_rack",
      "unlock": [
        "ch217_rack_done"
      ],
      "next": "217.3"
    },
    {
      "id": "217.3",
      "title": "可架",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可鼓架』。下一章是独擂。"
        },
        {
          "speaker": "春令使者",
          "text": "独擂不是歇拍。是还敢不敢一人成拍。"
        },
        {
          "speaker": "系统",
          "text": "第二百一十七章完成。"
        }
      ],

{
  "id": "chapter224",
  "title": "第二百二十四章·独香",
  "beats": [
    {
      "id": "224.0",
      "title": "独香令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可香架之后，独香与夜香要验：灰旗敢不敢把刀放短、把灰放稳。"
        },
        {
          "speaker": "管事",
          "text": "两场：独香、夜香。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "独香水镜桥心。夜香林环，内有心台。"
        },
        {
          "speaker": "老旗手",
          "text": "别踏碎镜水。碎了写进王朝手记——无镜之香等于无市。"
        },
        {
          "speaker": "系统",
          "text": "第三十六卷后半。"
        }
      ],
      "next": "224.1"
    },
    {
      "id": "224.1",
      "title": "独香",
      "lines": [
        {
          "speaker": "斥候",
          "text": "独香水镜被拦，桥心有人。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "择桥夺心，别浪游深水。"
        },
        {
          "speaker": "管事",
          "text": "护桥清射，再夺心台。"
        },
        {
          "speaker": "系统",
          "text": "出战「独香」。"
        }
      ],
      "battle": "ch224_solo",
      "unlock": [
        "ch224_solo_done"
      ],
      "next": "224.2"
    },
    {
      "id": "224.2",
      "title": "夜香",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "夜香林环有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "外林内心，禁乱翻，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清林再夺台。烟不稳，席终盖不下。"
        },
        {
          "speaker": "春令使者",
          "text": "烟一散，满市的香都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「夜香」。"
        }
      ],
      "battle": "ch224_night",
      "unlock": [
        "ch224_night_done"
      ],
      "next": "224.3"
    },
    {
      "id": "224.3",
      "title": "可夜",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可夜香』。下一章是席终。"
        },
        {
          "speaker": "春令使者",
          "text": "席终不是歇烟。是还敢不敢把姓配进最后一炷。"
        },
        {
          "speaker": "系统",
          "text": "第二百二十四章完成。"
        }
      ],

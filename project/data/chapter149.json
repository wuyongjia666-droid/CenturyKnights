{
  "id": "chapter149",
  "title": "第一百四十九章·冰窖",
  "beats": [
    {
      "id": "149.0",
      "title": "冰窖令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可入栈之后，冰窖要验的是：灰旗敢不敢把刀放短、把暖放稳——暖歪了，人会先从雪里倒进空票。"
        },
        {
          "speaker": "管事",
          "text": "两场：冰窖、暖棚。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "冰窖西水东垒。暖棚场心有小垒，开阔。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸窖门。砸了要写进王朝手记的黑页——无暖之栈等于无岭。"
        },
        {
          "speaker": "系统",
          "text": "第二十四卷中段。"
        }
      ],
      "next": "149.1"
    },
    {
      "id": "149.1",
      "title": "冰窖",
      "lines": [
        {
          "speaker": "斥候",
          "text": "冰窖被撬，好炭堆在东垒。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护暖火，别把战拖成埋雪。"
        },
        {
          "speaker": "管事",
          "text": "西桥掩护，东垒夺炭。"
        },
        {
          "speaker": "系统",
          "text": "出战「冰窖」。"
        }
      ],
      "battle": "ch149_icehouse",
      "unlock": [
        "ch149_icehouse_done"
      ],
      "next": "149.2"
    },
    {
      "id": "149.2",
      "title": "暖棚",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "暖棚场有人投冰折。"
        },
        {
          "speaker": "斥候",
          "text": "场心垒禁乱灭，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清折再守暖。火不稳，雪印盖不下。"
        },
        {
          "speaker": "春令使者",
          "text": "火一灭，满岭的夜都会冻。"
        },
        {
          "speaker": "系统",
          "text": "出战「暖棚」。"
        }
      ],
      "battle": "ch149_warm",
      "unlock": [

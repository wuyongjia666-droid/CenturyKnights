      ],
      "next": "43.2",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "「黑潮口」——打完要把活口留下一个——问清谁在出钱。 此地多林、丘、水。"
        },
        {
          "speaker": "管事",
          "text": "别在开阔地站成一排。弓手换位要快。"
        },
        {
          "speaker": "斥候",
          "text": "旗在，名册在，人可以撤；三者丢一，这一仗就算白打。"
        },
        {
          "speaker": "系统",
          "text": "出战「黑潮口」。"
        }
      ]
    },
    {
      "id": "43.2",
      "title": "黑潮暗礁",
      "battle": "ch43_reef",
      "unlock": [
        "ch43_reef_done"
      ],
      "next": "43.3",
      "lines": [
        {
          "speaker": "春令使者",
          "text": "「黑潮暗礁」——风从敌阵那边过来，带着金属味。 此地多林、丘、垒。"
        },
        {
          "speaker": "老旗手",
          "text": "两路：一路粘住正面，一路从林摸进去。"
        },
        {
          "speaker": "斥候",
          "text": "主旗居中，两翼用呼号，不靠眼神。"
        },
        {
          "speaker": "系统",
          "text": "出战「黑潮暗礁」。"
        }
      ]
    },
    {
      "id": "43.3",
      "title": "可黑潮",
      "unlock": [
        "chapter43_done"
      ],
      "next": null,
      "lines": [
        {
          "speaker": "旁白",
          "text": "第四十三章·黑潮到了收束处。风停一刻，墨才能干。"
        },
        {
          "speaker": "春令使者",
          "text": "印若已落，便可回堡，也可继续下一章。灰旗的路，从来不是单行。"
        },
        {
          "speaker": "管事",
          "text": "银粮与声望已按章结算。旗手歇口气。"
        },
        {
          "speaker": "系统",
          "text": "第四十三章完成。"
        }
      ]
    }
  ]

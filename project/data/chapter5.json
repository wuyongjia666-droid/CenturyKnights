{
  "id": "chapter5",
  "title": "第五章·王朝烽烟",
  "beats": [
    {
      "id": "5.0",
      "title": "百年写完之后",
      "next": "5.1",
      "lines": [
        {
          "speaker": "旁白",
          "text": "「百年」补上之后，王朝级的烽烟才肯承认灰旗。河、宴、桥——三场仗，像三枚印，盖在刚刚写完的两个字上。"
        },
        {
          "speaker": "管事",
          "text": "第五章三关：河汛、夜宴、断桥。带战技树二阶更稳。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "夜宴最脏。刀藏在敬酒里。"
        },
        {
          "speaker": "系统",
          "text": "第五章·王朝烽烟开启。"
        }
      ]
    },
    {
      "id": "5.1",
      "title": "河湾集结",
      "battle": "ch5_river",
      "unlock": [
        "ch5_river_done"
      ],
      "next": "5.2",
      "lines": [
        {
          "speaker": "斥候",
          "text": "河汛到膝。浅滩能过，深槽吞人。"
        },
        {
          "speaker": "管事",
          "text": "弓占高岸，步沿浅滩。下游还有夜宴，别恋战。"
        },
        {
          "speaker": "老旗手",
          "text": "湿旗进不了宴厅。"
        },
        {
          "speaker": "系统",
          "text": "出战「河汛」。"
        }
      ]
    },
    {
      "id": "5.2",
      "title": "夜宴杀机",
      "battle": "ch5_feast",
      "unlock": [
        "ch5_feast_done"
      ],
      "next": "5.25",
      "lines": [
        {
          "speaker": "斥候",
          "text": "灯笼后是弓。敬酒的左手端盏，右手按刀。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "别接第一巡。先清侧廊。"
        },
        {
          "speaker": "系统",
          "text": "出战「夜宴」。"
        }
      ]
    },
    {
      "id": "5.25",
      "title": "断桥守夜",
      "battle": "ch5_bridge",
      "unlock": [
        "ch5_bridge_done"
      ],
      "next": "5.3",
      "lines": [
        {
          "speaker": "旁白",
          "text": "断桥半幅。王朝说：过桥的人，才配谈烽烟。"
        },
        {
          "speaker": "老旗手",
          "text": "先射对岸，单列过。桥下留断后。"
        },
        {
          "speaker": "系统",
          "text": "出战「断桥」。"
        }
      ]
    },
    {
      "id": "5.3",
      "title": "烽烟未尽",
      "unlock": [
        "chapter5_done"
      ],
      "next": null,
      "lines": [
        {
          "speaker": "旁白",
          "text": "三印落下。王朝棋盘上，灰旗不再只是「能打的一团」——它是能在烽烟里留姓的团。"
        },
        {
          "speaker": "春令使者",
          "text": "可继续托孤之约。子嗣的路，要从这里开始写得更硬。"
        },
        {
          "speaker": "系统",
          "text": "第五章完成。"
        }
      ]
    }
  ]
}
{
  "id": "chapter58",
  "title": "第五十八章·余烬港",
  "beats": [
    {
      "id": "58.0",
      "title": "九卷令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "八卷席终之后，灰旗在旅馆墙上多了一行新字：九卷。九卷不从山来，从港来——余烬港的灯还亮着，潮却把旧盟约冲得发白。"
        },
        {
          "speaker": "管事",
          "text": "两场：余烬港、潮门。打完，旅馆写『可余烬』。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "潮门有桥。桥上别站成一排。"
        },
        {
          "speaker": "老旗手",
          "text": "八卷刚执，九卷就催。催的人，多半怕你歇够气。"
        },
        {
          "speaker": "系统",
          "text": "第九卷开启。"
        }
      ],
      "next": "58.1"
    },
    {
      "id": "58.1",
      "title": "余烬港",
      "lines": [
        {
          "speaker": "斥候",
          "text": "港湾被匪船占灯。余烬还热，人却冷。"
        },
        {
          "speaker": "管事",
          "text": "先夺港。潮门要有前线。"
        },
        {
          "speaker": "系统",
          "text": "出战「余烬港」。"
        }
      ],
      "battle": "ch58_ember",
      "unlock": [
        "ch58_ember_done"
      ],
      "next": "58.2"
    },
    {
      "id": "58.2",
      "title": "潮门",
      "lines": [
        {
          "speaker": "旁白",
          "text": "港灯既回，潮门仍封。桥下水声像有人在数灰旗欠的债。"
        },
        {
          "speaker": "老旗手",
          "text": "清桥两侧再过。别让弓手把桥面扫成白板。"
        },
        {
          "speaker": "系统",
          "text": "出战「潮门」。"
        }
      ],
      "battle": "ch58_tide",
      "unlock": [
        "ch58_tide_done"
      ],
      "next": "58.3"
    },
    {
      "id": "58.3",
      "title": "可余烬",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。陆桥旅馆写入『可余烬』。九卷的门，从港边打开。"
        },
        {
          "speaker": "春令使者",
          "text": "下一章是霜驿。夜驿会更脏。"
        },
        {
          "speaker": "系统",
          "text": "第五十八章完成。"
        }
      ],
      "unlock": [
        "chapter58_done",
        "volume9_open"
      ],
      "next": null
    }
  ]
}
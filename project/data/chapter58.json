{
  "id": "chapter58",
  "title": "第五十八章·余烬港",
  "beats": [
    {
      "id": "58.0",
      "title": "九卷令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "八卷席终之后，灰旗在旅馆墙上多了一行新字：九卷。九卷不从山来，从港来——余烬港的灯还亮着，潮却把旧盟约冲得发白。"
        },
        {
          "speaker": "管事",
          "text": "两场：余烬港、潮门。打完，旅馆写『可余烬』。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "潮门有桥。桥上别站成一排。"
        },
        {
          "speaker": "老旗手",
          "text": "八卷刚执，九卷就催。催的人，多半怕你歇够气。"
        },
        {
          "speaker": "系统",
          "text": "第九卷开启。"
        }
      ],
      "next": "58.1"
    },
    {
      "id": "58.1",
      "title": "余烬港",
      "lines": [
        {
          "speaker": "管事",
          "text": "目标「余烬港」。编制按我标的三路走，第二路拖时间。"
        },
        {
          "speaker": "老旗手",
          "text": "第一路见红再喊。别提前暴露旗。"
        },
        {
          "speaker": "系统",
          "text": "出战「余烬港」。"
        }
      ],
      "battle": "ch58_ember",
      "unlock": [
        "ch58_ember_done"
      ],
      "next": "58.2"
    },
    {
      "id": "58.2",
      "title": "潮门",
      "lines": [
        {
          "speaker": "斥候",
          "text": "「潮门」。北有丘，南有水，中间一块能站人的硬地——大家都想要。"
        },
        {
          "speaker": "老旗手",
          "text": "硬地让给弓手。步兵走侧。"
        },
        {
          "speaker": "系统",
          "text": "出战「潮门」。"
        }
      ],
      "battle": "ch58_tide",
      "unlock": [
        "ch58_tide_done"
      ],
      "next": "58.3"
    },
    {
      "id": "58.3",
      "title": "可余烬",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。陆桥旅馆写入『可余烬』。九卷的门，从港边打开。"
        },
        {
          "speaker": "春令使者",
          "text": "下一章是霜驿。夜驿会更脏。"
        },
        {
          "speaker": "系统",
          "text": "第五十八章完成。"
        }
      ],

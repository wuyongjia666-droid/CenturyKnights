              "beat": "ledger"
            }
          ]
        }
      ]
    },
    {
      "id": "ledger",
      "title": "并排",
      "lines": [
        {
          "id": "cs02_02_ledger_0",
          "speaker": "旁白",
          "text": "入谱。副笺与婚约并排进柜。",
          "stage": {
            "card": "六　并排",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_ledger_1",
          "speaker": "书记官",
          "text": "偏格有灯。灯不灭。",
          "stage": {
            "card": "六　并排",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_ledger_2",
          "speaker": "leader",
          "text": "我看见偏了。偏也在谱里。",
          "stage": {
            "card": "六　并排",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_ledger_3",
          "speaker": "岁吏",
          "text": "年迹末行写：副笺并排留。",
          "stage": {
            "card": "六　并排",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_ledger_4",
          "speaker": "老管事",
          "text": "催嗣锣再响，也撕不开柜门。",
          "stage": {
            "card": "六　并排",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_ledger_5",
          "speaker": "旁白",
          "text": "柜门一合。灯还在缝里·婚盏。",
          "stage": {
            "card": "六　并排",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_ledger_6",
          "speaker": "苇原·灯影",
          "text": "巡防收牌。牌上副笺两字还热。",
          "stage": {
            "card": "六　并排",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_ledger_7",
          "speaker": "书记官",
          "text": "整盏婚约，才算约。",
          "stage": {
            "card": "六　并排",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_ledger_8",
          "speaker": "leader",
          "text": "假嗣没进来。好。",
          "stage": {
            "card": "六　并排",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_ledger_9",
          "speaker": "岁吏",
          "text": "月结旁多一笔偏格。",
          "stage": {
            "card": "六　并排",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_ledger_10",
          "speaker": "老管事",
          "text": "催条叠在门外。谱在门内·婚盏。",
          "stage": {
            "card": "六　并排",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_ledger_11",
          "speaker": "旁白",
          "text": "印泥干。偏格的边也干了。",
          "stage": {
            "card": "六　并排",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_ledger_12",
          "speaker": "书记官",
          "text": "下次打开，偏格还在——带着灯。",
          "stage": {
            "card": "六　并排",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_ledger_13",
          "speaker": "leader",
          "text": "够了。去灰旗堡·婚盏。",
          "stage": {
            "card": "六　并排",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_ledger_14",
          "speaker": "苇原·灯影",
          "text": "堡门亮着。副笺灯跟着。",
          "stage": {
            "card": "六　并排",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_ledger_15",
          "speaker": "岁吏",
          "text": "年迹合上。字还在·婚盏。",
          "stage": {
            "card": "六　并排",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_ledger_16",
          "speaker": "老管事",
          "text": "婚厅可歇。谱不可假。",
          "stage": {
            "card": "六　并排",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_ledger_17",
          "speaker": "旁白",
          "text": "风停。笺平。",

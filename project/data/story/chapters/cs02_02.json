{
  "id": "cs02_02",
  "title": "副笺上的灯",
  "legacy_index": 412,
  "return_scene": "res://scenes/hub/castle_hub.tscn",
  "source": "docs/content-seasons/season-02/NOVEL.md",
  "beats": [
    {
      "id": "slip",
      "title": "副笺",
      "lines": [
        {
          "id": "cs02_02_slip_0",
          "speaker": "旁白",
          "text": "婚厅。上回婚约已入柜。副笺还空着偏格。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_1",
          "speaker": "书记官",
          "text": "正约写过了。副笺要能念，不能只剩印泥。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_2",
          "speaker": "leader",
          "text": "我要听偏格。空着也得说得出。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_3",
          "speaker": "旁白",
          "text": "柜门一响。婚约与副笺并排放上长桌。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_4",
          "speaker": "老管事",
          "text": "催嗣的人嗓门大。偏格的人说再等等。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_5",
          "speaker": "岁吏",
          "text": "年迹旁多了一行「副笺夜」。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_6",
          "speaker": "苇原·灯影",
          "text": "巡防不问谁嗣位。问今夜谁还空着偏。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_7",
          "speaker": "旁白",
          "text": "两行字第一次对视。正约亮，副笺暗。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_8",
          "speaker": "书记官",
          "text": "能念的字在正约。坐得住的偏在副笺等。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_9",
          "speaker": "leader",
          "text": "把偏格念给我听。别念催嗣。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_10",
          "speaker": "老管事",
          "text": "催嗣可以喊。副笺撕不得。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_11",
          "speaker": "旁白",
          "text": "灯矮了一寸。偏格反而更清楚。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_12",
          "speaker": "岁吏",
          "text": "婚约已记账。副笺记账才算整盏。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_13",
          "speaker": "书记官",
          "text": "并排不是拖。是让偏格也有灯。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_14",
          "speaker": "leader",
          "text": "我听懂了。偏着，也要并排。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_15",
          "speaker": "旁白",
          "text": "风从窗缝进来。笺角动，字不动。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_16",
          "speaker": "老管事",
          "text": "催嗣的锣在门外。锣响不进婚厅。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_y17",
          "speaker": "旁白",
          "text": "婚约笺角卷着。卷着，说明有人反复看。"
        },
        {
          "id": "cs02_02_slip_y18",
          "speaker": "石垒·晚担",
          "text": "反复看的，未必敢签。"
        },
        {
          "id": "cs02_02_slip_y19",
          "speaker": "leader",
          "text": "我敢签真的。"
        },
        {
          "id": "cs02_02_slip_17",
          "speaker": "槐里·青禾",
          "text": "副笺比婚约薄。薄的反而难装。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        }
      ],
      "next": "pulse"
    },
    {
      "id": "pulse",
      "title": "偏格",
      "lines": [
        {
          "id": "cs02_02_pulse_0",
          "speaker": "旁白",
          "text": "偏格摊开。脉上那格亮着，旁格还空。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_1",
          "speaker": "老管事",
          "text": "上回留并排的，偏格亮着空。催嗣的，栏上有字、偏仍空。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_2",
          "speaker": "旁白",
          "text": "两行字第二次吵架。回读逼它们对视·婚盏。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_3",
          "speaker": "苇原·灯影",
          "text": "巡防不问谁脉动。问今夜谁还空着偏。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_4",
          "speaker": "书记官",
          "text": "有字的格能念。偏格要人敢看。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_5",
          "speaker": "leader",
          "text": "偏格不是错。催满才是错。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_6",
          "speaker": "岁吏",
          "text": "年迹不改脉。只记你敢不敢对偏。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_7",
          "speaker": "旁白",
          "text": "印泥干了。偏格的边还潮。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_8",
          "speaker": "老管事",
          "text": "催嗣锣又响。响在门外，进不了偏。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_9",
          "speaker": "书记官",
          "text": "并排留偏，比硬填假嗣干净。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_10",
          "speaker": "leader",
          "text": "假嗣我不要。偏格我要听。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_11",
          "speaker": "旁白",
          "text": "灯把偏格照成浅坑。坑里没有字。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_12",
          "speaker": "岁吏",
          "text": "婚约上的印还在。副笺上的偏也在。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_13",
          "speaker": "苇原·灯影",
          "text": "带牌去。牌上写副笺，不写催。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_14",
          "speaker": "老管事",
          "text": "催嗣条叠得高。偏格叠不住。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_15",
          "speaker": "书记官",
          "text": "能念的在正约。敢留的在副笺。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_16",
          "speaker": "旁白",
          "text": "笺角又动。偏格仍空。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_y17",
          "speaker": "旁白",
          "text": "验盏水清。清里照得出假。"
        },
        {
          "id": "cs02_02_pulse_y18",
          "speaker": "石垒·晚担",
          "text": "假影一晃就散。"
        },
        {
          "id": "cs02_02_pulse_y19",
          "speaker": "leader",
          "text": "散的我不留。"
        },
        {
          "id": "cs02_02_pulse_17",
          "speaker": "老旗手",
          "text": "偏格灯还亮。亮着，才敢回读。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        }
      ],
      "next": "hourglass"
    },
    {
      "id": "hourglass",
      "title": "两行",
      "lines": [
        {
          "id": "cs02_02_hourglass_0",
          "speaker": "旁白",
          "text": "沙漏厅。上行婚约、下行副笺。回读把两行按住。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_1",
          "speaker": "老管事",
          "text": "月份往前走。回读不改月份，只改你敢不敢对偏。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_2",
          "speaker": "岁吏",
          "text": "年迹旁多了一行「副笺回读」。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_3",
          "speaker": "书记官",
          "text": "能念的字在上行。偏得住的格还在下行等。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_4",
          "speaker": "leader",
          "text": "两行都打开。我要听对看·婚盏。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_5",
          "speaker": "旁白",
          "text": "沙响。上行亮，下行仍暗·婚盏。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_6",
          "speaker": "苇原·灯影",
          "text": "巡防牌上写副笺。不写急锣。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_7",
          "speaker": "老管事",
          "text": "催嗣的人在门外跺脚。跺不进沙漏。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_8",
          "speaker": "书记官",
          "text": "并排不是拖月。是让偏格跟月份并排走。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_9",
          "speaker": "岁吏",
          "text": "月结不抹偏。偏也要入迹。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_10",
          "speaker": "leader",
          "text": "我听偏格。不听跺脚。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_11",
          "speaker": "旁白",
          "text": "沙又落一层。下行多了一点亮·婚盏。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_12",
          "speaker": "老管事",
          "text": "锣停了。偏格还在。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_13",
          "speaker": "书记官",
          "text": "回读夜的字，比催嗣长命。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_14",
          "speaker": "岁吏",
          "text": "带牌出去。沙漏还转·婚盏。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_15",
          "speaker": "旁白",
          "text": "两行终于对上。一对，就不敢假填·婚盏。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_16",
          "speaker": "老管事",
          "text": "假嗣进不了沙漏。偏格能。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_y17",
          "speaker": "旁白",
          "text": "婚约笺角卷着。卷着，说明有人反复看。"
        },
        {
          "id": "cs02_02_hourglass_y18",
          "speaker": "石垒·晚担",
          "text": "反复看的，未必敢签。"
        },
        {
          "id": "cs02_02_hourglass_y19",
          "speaker": "leader",
          "text": "我敢签真的。"
        },
        {
          "id": "cs02_02_hourglass_17",
          "speaker": "苇原·灯影",
          "text": "带牌去。牌上写副笺，不写急。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        }
      ],
      "next": "bridge",
      "actions": [
        {

          ]
        }
      ]
    },
    {
      "id": "tavern",
      "title": "选题",
      "lines": [
        {
          "id": "cs02_02_tavern_0",
          "speaker": "旁白",
          "text": "酒馆。板上两道题。手按上去·婚盏。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_1",
          "speaker": "掌柜",
          "text": "一道偏仍并排。一道先催嗣位。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_2",
          "speaker": "leader",
          "text": "我看题。不看谁嗓门大·婚盏。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_3",
          "speaker": "老管事",
          "text": "并排留真。催嗣快。快的未必真。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_4",
          "speaker": "书记官",
          "text": "偏格进谱，才算整盏婚约。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_5",
          "speaker": "岁吏",
          "text": "年迹听选择。不听锣·婚盏。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_6",
          "speaker": "旁白",
          "text": "酒气里笺更白。白得能看见偏。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_7",
          "speaker": "掌柜",
          "text": "选完入柜。副笺柜门会响。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_8",
          "speaker": "苇原·灯影",
          "text": "巡防在门外。门内只选题·婚盏。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_9",
          "speaker": "leader",
          "text": "偏仍并排——我手按这道。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_10",
          "speaker": "老管事",
          "text": "按实了。别悬着·婚盏。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_11",
          "speaker": "书记官",
          "text": "假嗣那道我划掉。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_12",
          "speaker": "旁白",
          "text": "板面一热。字进手心·婚盏。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_13",
          "speaker": "岁吏",
          "text": "选择入账。副笺夜可结。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_14",
          "speaker": "掌柜",
          "text": "另一道也在。你不选它·婚盏。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_15",
          "speaker": "老管事",
          "text": "催嗣的锣远了。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_16",
          "speaker": "旁白",
          "text": "两道题还在板上。只一道进柜·婚盏。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_y17",
          "speaker": "旁白",
          "text": "酒馆灯把副笺卷角烤得更翘，翘处没有新签名。"
        },
        {
          "id": "cs02_02_tavern_y18",
          "speaker": "石垒·晚担",
          "text": "烤翘了还没签，就是还在怕。怕可以，假签不行。"
        },
        {
          "id": "cs02_02_tavern_y19",
          "speaker": "leader",
          "text": "怕留下。真名今晚签在偏格上。"
        },
        {
          "id": "cs02_02_tavern_17",
          "speaker": "老管事",
          "text": "选完入柜。副笺柜门会响·婚盏。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs0202_ret_mv1",
          "speaker": "旁白",
          "text": "偏格笑话讲完，场子静了一息。"
        },
        {
          "id": "cs0202_ret_mv2",
          "speaker": "掌柜",
          "text": "静一息好。静完再挂。"
        },
        {
          "id": "cs0202_ret_mv3",
          "speaker": "岁吏",
          "text": "挂完回堡。堡里入谱。"
        },
        {
          "id": "cs0202_tvp1",
          "speaker": "旁白",
          "text": "副笺比正约短一寸，钉孔却对齐正约的第二孔。"
        },
        {
          "id": "cs0202_tvp2",
          "speaker": "掌柜",
          "text": "孔对齐，字才能并。并对了，嗣位才不像抢。"
        },
        {
          "id": "cs0202_tvp3",
          "speaker": "石垒·晚担",
          "text": "抢挂的人最快。最快的字，明年最先掉。"
        },
        {
          "id": "cs0202_tvp4",
          "speaker": "听回",
          "text": "掉字的板，我见过。见过就不劝你快。"
        },
        {
          "id": "cs0202_tvp5",
          "speaker": "书记官",
          "text": "副笺偏着挂也可以——偏要写明是偏。"
        },
        {
          "id": "cs0202_tvp6",
          "speaker": "leader",
          "text": "偏我认。催挂的话，今晚不听。"
        },
        {
          "id": "cs0202_tvn1",
          "speaker": "掌柜",
          "text": "护脉那一锋，酒要温——温着养。"
        },
        {
          "id": "cs0202_tvn2",
          "speaker": "石垒·晚担",
          "text": "抢脉的散了。散了，腕才听得见。"
        },
        {
          "id": "cs0202_tvn3",
          "speaker": "苇原·灯影",
          "text": "纸上那跳，桌上有人学着数。"
        },
        {
          "id": "cs0202_tvn4",
          "speaker": "leader",
          "text": "脉清。人齐。温酒，可以。"
        },
        {
          "id": "cs0202_ret_mv4",
          "speaker": "leader",
          "text": "回堡写偏格。"
        }
      ],
      "actions": [
        {

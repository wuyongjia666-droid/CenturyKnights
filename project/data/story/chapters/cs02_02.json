    {
      "id": "bridge",
      "title": "门廊",
      "lines": [
        {
          "id": "cs02_02_bridge_0",
          "speaker": "旁白",
          "text": "门廊。副笺灯还在身后。锋镝在桥上试。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_1",
          "speaker": "岁吏",
          "text": "试锋不改偏格。只问你手稳不稳。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_2",
          "speaker": "leader",
          "text": "先试一锋。赢了再谈催嗣。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_3",
          "speaker": "老旗手",
          "text": "锋收回来也行。偏格不靠锋填。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_4",
          "speaker": "旁白",
          "text": "桥风大。灯小。字还在·婚盏。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_5",
          "speaker": "书记官",
          "text": "催嗣可以喊。副笺本撕不得。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_6",
          "speaker": "苇原·灯影",
          "text": "巡防站桥侧。不问胜负，问你还回不回读·婚盏。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_7",
          "speaker": "老管事",
          "text": "锣在城门。桥上只听见水·婚盏。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_8",
          "speaker": "leader",
          "text": "锋出不出，偏格都在。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_9",
          "speaker": "岁吏",
          "text": "试锋得手，锋镝压下，并排笺可续。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_10",
          "speaker": "旁白",
          "text": "水声盖过远处锣·婚盏。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_11",
          "speaker": "老旗手",
          "text": "伤还在也行。先去酒馆选题·婚盏。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_12",
          "speaker": "书记官",
          "text": "选题在前。假嗣在后——后的不要。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_13",
          "speaker": "苇原·灯影",
          "text": "牌还在手里。牌上仍是副笺。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_14",
          "speaker": "老管事",
          "text": "催嗣的人等不及。你等得及。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_15",
          "speaker": "leader",
          "text": "我等偏格。不等锣。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_16",
          "speaker": "旁白",
          "text": "桥板一颤。灯不灭·婚盏。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_17",
          "speaker": "岁吏",
          "text": "未试锋——锋未出鞘，也可去酒馆·婚盏。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_18",
          "speaker": "老旗手",
          "text": "试锋未成——伤还在，先去酒馆·婚盏。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_y20",
          "speaker": "旁白",
          "text": "验盏水清。清里照得出假。"
        },
        {
          "id": "cs02_02_bridge_y21",
          "speaker": "石垒·晚担",
          "text": "假影一晃就散。"
        },
        {
          "id": "cs02_02_bridge_y22",
          "speaker": "leader",
          "text": "散的我不留。"
        },
        {
          "id": "cs02_02_bridge_19",
          "speaker": "岁吏",
          "text": "催嗣可以喊。副笺本撕不得·婚盏。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "speaker": "旁白",
          "text": "锋收回来。副笺纸还钉着。偏格旁那拨，没散。",
          "when": {
            "all": [
              {
                "flag": "cs02_02_mid_lost"
              },
              {
                "not_flag": "cs02_02_mid_fought"
              }
            ]
          },
          "id": "cs02b_br_lost"
        }
      ],

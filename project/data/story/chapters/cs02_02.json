{
  "id": "cs02_02",
  "title": "副笺上的灯",
  "legacy_index": 412,
  "return_scene": "res://scenes/hub/castle_hub.tscn",
  "source": "docs/content-seasons/season-02/NOVEL.md",
  "beats": [
    {
      "id": "slip",
      "title": "副笺",
      "lines": [
        {
          "id": "cs02_02_slip_0",
          "speaker": "旁白",
          "text": "婚厅。上回婚约已入柜。副笺还空着偏格。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_1",
          "speaker": "书记官",
          "text": "正约写过了。副笺要能念，不能只剩印泥。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_2",
          "speaker": "leader",
          "text": "我要听偏格。空着也得说得出。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_3",
          "speaker": "旁白",
          "text": "柜门一响。婚约与副笺并排放上长桌。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_4",
          "speaker": "老管事",
          "text": "催嗣的人嗓门大。偏格的人说再等等。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_5",
          "speaker": "岁吏",
          "text": "年迹旁多了一行「副笺夜」。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_6",
          "speaker": "苇原·灯影",
          "text": "巡防不问谁嗣位。问今夜谁还空着偏。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_7",
          "speaker": "旁白",
          "text": "两行字第一次对视。正约亮，副笺暗。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_8",
          "speaker": "书记官",
          "text": "能念的字在正约。坐得住的偏在副笺等。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_9",
          "speaker": "leader",
          "text": "把偏格念给我听。别念催嗣。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_10",
          "speaker": "老管事",
          "text": "催嗣可以喊。副笺撕不得。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_11",
          "speaker": "旁白",
          "text": "灯矮了一寸。偏格反而更清楚。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_12",
          "speaker": "岁吏",
          "text": "婚约已记账。副笺记账才算整盏。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_13",
          "speaker": "书记官",
          "text": "并排不是拖。是让偏格也有灯。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_14",
          "speaker": "leader",
          "text": "我听懂了。偏着，也要并排。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_15",
          "speaker": "旁白",
          "text": "风从窗缝进来。笺角动，字不动。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_16",
          "speaker": "老管事",
          "text": "催嗣的锣在门外。锣响不进婚厅。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_slip_y17",
          "speaker": "旁白",
          "text": "副笺角卷进脉纸缝，缝里那点蜡还软。"
        },
        {
          "id": "cs02_02_slip_y18",
          "speaker": "石垒·晚担",
          "text": "软蜡说明有人捏过。捏过不等于敢认嗣。"
        },
        {
          "id": "cs02_02_slip_y19",
          "speaker": "leader",
          "text": "软的我按实。假嗣不按。"
        },
        {
          "id": "cs0202_thm1",
          "speaker": "旁白",
          "text": "副笺压在正笺下。压处微潮。"
        },
        {
          "id": "cs0202_thm2",
          "speaker": "岁吏",
          "text": "偏栏不是错。偏栏是等人敢写正。"
        },
        {
          "id": "cs0202_thm3",
          "speaker": "石垒·晚担",
          "text": "潮处易糊。糊了就并不齐。"
        },
        {
          "id": "cs0202_thm4",
          "speaker": "槐里·青禾",
          "text": "偏仍并排。并排的灯，不替人点头。"
        },
        {
          "id": "cs0202_thm5",
          "speaker": "老旗手",
          "text": "旗穗别沾潮边。沾了，字会洇。"
        },
        {
          "id": "cs0202_thm6",
          "speaker": "leader",
          "text": "偏我认。并排我守。守完再往下走。"
        },
        {
          "id": "cs02_02_slip_17",
          "speaker": "槐里·青禾",
          "text": "副笺比婚约薄。薄的反而难装。",
          "stage": {
            "card": "一　副笺",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        }
      ],
      "next": "pulse"
    },
    {
      "id": "pulse",
      "title": "偏格",
      "lines": [
        {
          "id": "cs02_02_pulse_0",
          "speaker": "旁白",
          "text": "偏格摊开。脉上那格亮着，旁格还空。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_1",
          "speaker": "老管事",
          "text": "上回留并排的，偏格亮着空。催嗣的，栏上有字、偏仍空。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_2",
          "speaker": "旁白",
          "text": "两行字第二次吵架。回读逼它们对视·婚盏。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_3",
          "speaker": "苇原·灯影",
          "text": "巡防不问谁脉动。问今夜谁还空着偏。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_4",
          "speaker": "书记官",
          "text": "有字的格能念。偏格要人敢看。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_5",
          "speaker": "leader",
          "text": "偏格不是错。催满才是错。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_6",
          "speaker": "岁吏",
          "text": "年迹不改脉。只记你敢不敢对偏。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_7",
          "speaker": "旁白",
          "text": "印泥干了。偏格的边还潮。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_8",
          "speaker": "老管事",
          "text": "催嗣锣又响。响在门外，进不了偏。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_9",
          "speaker": "书记官",
          "text": "并排留偏，比硬填假嗣干净。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_10",
          "speaker": "leader",
          "text": "假嗣我不要。偏格我要听。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_11",
          "speaker": "旁白",
          "text": "灯把偏格照成浅坑。坑里没有字。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_12",
          "speaker": "岁吏",
          "text": "婚约上的印还在。副笺上的偏也在。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_13",
          "speaker": "苇原·灯影",
          "text": "带牌去。牌上写副笺，不写催。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_14",
          "speaker": "老管事",
          "text": "催嗣条叠得高。偏格叠不住。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_15",
          "speaker": "书记官",
          "text": "能念的在正约。敢留的在副笺。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_16",
          "speaker": "旁白",
          "text": "笺角又动。偏格仍空。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_pulse_y17",
          "speaker": "旁白",
          "text": "脉枕边验盏清得能数出偏格上的纤维。"
        },
        {
          "id": "cs02_02_pulse_y18",
          "speaker": "石垒·晚担",
          "text": "纤维影一晃就散。散的是灯，不是脉。"
        },
        {
          "id": "cs02_02_pulse_y19",
          "speaker": "leader",
          "text": "脉在的留下。散影倒掉。"
        },
        {
          "id": "cs02_02_pulse_17",
          "speaker": "老旗手",
          "text": "偏格灯还亮。亮着，才敢回读。",
          "stage": {
            "card": "二　偏格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        }
      ],
      "next": "hourglass"
    },
    {
      "id": "hourglass",
      "title": "两行",
      "lines": [
        {
          "id": "cs02_02_hourglass_0",
          "speaker": "旁白",
          "text": "沙漏厅。上行婚约、下行副笺。回读把两行按住。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_1",
          "speaker": "老管事",
          "text": "沙漏边上，回读只问一句：你敢不敢对偏。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_2",
          "speaker": "岁吏",
          "text": "年迹旁多了一行「副笺回读」。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_3",
          "speaker": "书记官",
          "text": "能念的字在上行。偏得住的格还在下行等。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_4",
          "speaker": "leader",
          "text": "两行都打开。我要听对看·婚盏。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_5",
          "speaker": "旁白",
          "text": "沙响。上行亮，下行仍暗·婚盏。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_6",
          "speaker": "苇原·灯影",
          "text": "巡防牌上写副笺。不写急锣。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_7",
          "speaker": "老管事",
          "text": "催嗣的人在门外跺脚。跺不进沙漏。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_8",
          "speaker": "书记官",
          "text": "并排不是拖月。是让偏格跟月份并排走。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_9",
          "speaker": "岁吏",
          "text": "月结不抹偏。偏也要入迹。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_10",
          "speaker": "leader",
          "text": "我听偏格。不听跺脚。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_11",
          "speaker": "旁白",
          "text": "沙又落一层。下行多了一点亮·婚盏。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_12",
          "speaker": "老管事",
          "text": "锣停了。偏格还在。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_13",
          "speaker": "书记官",
          "text": "回读夜的字，比催嗣长命。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_14",
          "speaker": "岁吏",
          "text": "带牌出去。沙漏还转·婚盏。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_15",
          "speaker": "旁白",
          "text": "两行对准了。一对上，假填就站不住·婚盏。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_16",
          "speaker": "老管事",
          "text": "假嗣进不了沙漏。偏格能。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_hourglass_y17",
          "speaker": "旁白",
          "text": "沙漏两行之间，婚约卷角卡住了一粒沙。"
        },
        {
          "id": "cs02_02_hourglass_y18",
          "speaker": "石垒·晚担",
          "text": "卡住的沙比催条诚实。不敢签的，让它卡着。"
        },
        {
          "id": "cs02_02_hourglass_y19",
          "speaker": "leader",
          "text": "沙卡住的地方，我签真名。"
        },
        {
          "id": "cs02_02_hourglass_17",
          "speaker": "苇原·灯影",
          "text": "带牌去。牌上写副笺，不写急。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs0202_vhg1",
          "speaker": "老管事",
          "text": "副笺比正笺薄。薄处更见字，也更见空。"
        },
        {
          "id": "cs0202_vhg2",
          "speaker": "书记官",
          "text": "对偏之前，先听沙。沙停，偏才露形。"
        },
        {
          "id": "cs0202_vhg3",
          "speaker": "leader",
          "text": "副笺空着偏栏。我敢对偏，才敢让月份记。"
        },
        {
          "id": "cs0202_vhg4",
          "speaker": "槐里·青禾",
          "text": "笺角卷了。卷处藏不住假填。"
        },
        {
          "id": "cs0202_vis_mv1",
          "speaker": "旁白",
          "text": "沙漏座下有一粒干梅核。不知谁垫的。"
        },
        {
          "id": "cs0202_vis_mv2",
          "speaker": "岁吏",
          "text": "垫核的人心思细。细心思要见光。"
        },
        {
          "id": "cs0202_vis_mv3",
          "speaker": "石垒·晚担",
          "text": "见光比藏着强。"
        },
        {
          "id": "cs0202_vst1",
          "speaker": "岁吏",
          "text": "月份从脉枕缝里渗出一息。息匀，月份才往前。"
        },
        {
          "id": "cs0202_vst2",
          "speaker": "书记官",
          "text": "脉录格最怕抢笔。"
        },
        {
          "id": "cs0202_vst3",
          "speaker": "leader",
          "text": "月份匀过。脉，我守。"
        },
        {
          "id": "cs0202_vis_mv4",
          "speaker": "leader",
          "text": "见光。去看月份。"
        }
      ],
      "next": "bridge",
      "actions": [
        {
          "id": "open_hourglass",
          "label": "去看月份怎么往前走",
          "do": [
            {
              "op": "visit",
              "path": "res://scenes/hub/hourglass.tscn"
            }
          ]
        },
        {
          "id": "continue_after_visit",
          "label": "继续，去门廊",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ]
    },
    {
      "id": "bridge",
      "title": "门廊",
      "lines": [
        {
          "id": "cs02_02_bridge_0",
          "speaker": "旁白",
          "text": "门廊。副笺灯还在身后。锋镝在桥上试。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_1",
          "speaker": "岁吏",
          "text": "试锋不改偏格。只问你手稳不稳。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_2",
          "speaker": "leader",
          "text": "先试一锋。赢了再谈催嗣。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_3",
          "speaker": "老旗手",
          "text": "锋收回来也行。偏格不靠锋填。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_4",
          "speaker": "旁白",
          "text": "桥风大。灯小。字还在·婚盏。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_5",
          "speaker": "书记官",
          "text": "催嗣可以喊。副笺本撕不得。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_6",
          "speaker": "苇原·灯影",
          "text": "巡防站桥侧。不问胜负，问你还回不回读·婚盏。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_7",
          "speaker": "老管事",
          "text": "锣在城门。桥上只听见水·婚盏。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_8",
          "speaker": "leader",
          "text": "锋出不出，偏格都在。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_9",
          "speaker": "岁吏",
          "text": "试锋得手，锋镝压下，并排笺可续。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_10",
          "speaker": "旁白",
          "text": "水声盖过远处锣·婚盏。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_11",
          "speaker": "老旗手",
          "text": "伤还在也行。先去酒馆选题·婚盏。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_12",
          "speaker": "书记官",
          "text": "选题在前。假嗣在后——后的不要。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_13",
          "speaker": "苇原·灯影",
          "text": "牌还在手里。牌上仍是副笺。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_14",
          "speaker": "老管事",
          "text": "催嗣的人等不及。你等得及。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_15",
          "speaker": "leader",
          "text": "我等偏格。不等锣。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_16",
          "speaker": "旁白",
          "text": "桥板一颤。灯不灭·婚盏。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_17",
          "speaker": "岁吏",
          "text": "未试锋——锋未出鞘，也可去酒馆·婚盏。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_18",
          "speaker": "老旗手",
          "text": "试锋未成——伤还在，先去酒馆·婚盏。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_02_bridge_y20",
          "speaker": "旁白",
          "text": "门廊风吹皱验盏，皱纹里偏格的字还直。"
        },
        {
          "id": "cs02_02_bridge_y21",
          "speaker": "石垒·晚担",
          "text": "皱的是水。字要是跟着皱，就是假影。"
        },
        {
          "id": "cs02_02_bridge_y22",
          "speaker": "leader",
          "text": "直的偏格我带走。皱影不带。"
        },
        {
          "id": "cs02_02_bridge_19",
          "speaker": "岁吏",
          "text": "催嗣可以喊。副笺本撕不得·婚盏。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs0202_mid_mv1",
          "speaker": "旁白",
          "text": "偏格纸被夜露打潮。墨晕开一线，像有人偷改。"
        },
        {
          "id": "cs0202_mid_mv2",
          "speaker": "岁吏",
          "text": "潮不是改。改是另一只手。"
        },
        {
          "id": "cs0202_mid_mv3",
          "speaker": "石垒·晚担",
          "text": "另一只手若在墙外，就该见面。"
        },
        {
          "id": "cs0202_mid_mv4",
          "speaker": "苇原·灯影",
          "text": "见面带锋。不带锋，只算路过。"
        },
        {
          "id": "cs0202_mid_mv5",
          "speaker": "老旗手",
          "text": "路过的不留名。试锋的要留名。"
        },
        {
          "id": "cs0202_mid_mv6",
          "speaker": "leader",
          "text": "名我留真。锋也真。"
        },
        {
          "id": "cs0202_win1",
          "speaker": "旁白",
          "text": "锋再定。脉纸边的手稳了，抢脉那拨散了。",
          "when": {
            "flag": "cs02_mid_fought"
          }
        },
        {
          "id": "cs0202_win2",
          "speaker": "老旗手",
          "text": "脉要静。静了，旗也不抖。",
          "when": {
            "flag": "cs02_mid_fought"
          }
        },
        {
          "id": "cs0202_win3",
          "speaker": "槐里·青禾",
          "text": "纸上那道跳，终于听得清。",
          "when": {
            "flag": "cs02_mid_fought"
          }
        },
        {
          "id": "cs0202_win4",
          "speaker": "leader",
          "text": "锋护过脉。纸，我按得。",
          "when": {
            "flag": "cs02_mid_fought"
          }
        },
        {
          "speaker": "旁白",
          "text": "锋收回来。副笺纸还钉着。偏格旁那拨，没散。",
          "when": {
            "all": [
              {
                "flag": "cs02_mid_lost"
              },
              {
                "not_flag": "cs02_mid_fought"
              }
            ]
          },
          "id": "cs02b_br_lost"
        }
      ],
      "next": "tavern",
      "actions": [

    {
      "id": "tavern",
      "title": "选题",
      "lines": [
        {
          "id": "cs02_02_tavern_0",
          "speaker": "旁白",
          "text": "酒馆。板上两道题。手按上去·婚盏。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_1",
          "speaker": "掌柜",
          "text": "一道偏仍并排。一道先催嗣位。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_2",
          "speaker": "leader",
          "text": "我看题。不看谁嗓门大·婚盏。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_3",
          "speaker": "老管事",
          "text": "并排留真。催嗣快。快的未必真。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_4",
          "speaker": "书记官",
          "text": "偏格进谱，才算整盏婚约。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_5",
          "speaker": "岁吏",
          "text": "年迹听选择。不听锣·婚盏。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_6",
          "speaker": "旁白",
          "text": "酒气里笺更白。白得能看见偏。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_7",
          "speaker": "掌柜",
          "text": "选完入柜。副笺柜门会响。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_8",
          "speaker": "苇原·灯影",
          "text": "巡防在门外。门内只选题·婚盏。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_9",
          "speaker": "leader",
          "text": "偏仍并排——我手按这道。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_10",
          "speaker": "老管事",
          "text": "按实了。别悬着·婚盏。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_11",
          "speaker": "书记官",
          "text": "假嗣那道我划掉。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_12",
          "speaker": "旁白",
          "text": "板面一热。字进手心·婚盏。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_13",
          "speaker": "岁吏",
          "text": "选择入账。副笺夜可结。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_14",
          "speaker": "掌柜",
          "text": "另一道也在。你不选它·婚盏。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_15",
          "speaker": "老管事",
          "text": "催嗣的锣远了。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_16",
          "speaker": "旁白",
          "text": "两道题还在板上。只一道进柜·婚盏。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs02_02_tavern_y17",
          "speaker": "旁白",
          "text": "婚约笺角卷着。卷着，说明有人反复看。"
        },
        {
          "id": "cs02_02_tavern_y18",
          "speaker": "石垒·晚担",
          "text": "反复看的，未必敢签。"
        },
        {
          "id": "cs02_02_tavern_y19",
          "speaker": "leader",
          "text": "我敢签真的。"
        },
        {
          "id": "cs02_02_tavern_17",
          "speaker": "老管事",
          "text": "选完入柜。副笺柜门会响·婚盏。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        }
      ],
      "actions": [

    {
      "id": "tavern",
      "title": "选题",
      "lines": [
        {
          "id": "cs09_tav_0",
          "speaker": "旁白",
          "text": "烽火酒馆。碗沿两个圈：并排记，先钉名。",
          "stage": {
            "bg": "tavern",
            "camera": "wide"
          }
        },
        {
          "id": "cs09_tav_1",
          "speaker": "掌柜",
          "text": "篇幅不够就钉墙。墙比名册宽。"
        },
        {
          "id": "cs09_tav_2",
          "speaker": "槐里·青禾",
          "text": "裁血验的人，先把剪刀放下。"
        },
        {
          "id": "cs09_tav_3",
          "speaker": "老管事",
          "text": "并排钉。谁撕血验抄本，谁结账。"
        },
        {
          "id": "cs09_tav_4",
          "speaker": "石垒·晚担",
          "text": "栏是念的，桩是站的。两样都要。"
        },
        {
          "id": "cs09_tav_5",
          "speaker": "苇原·灯影",
          "text": "沙漏还亮。谁买一行结论，带他去摸验灯。"
        },
        {
          "id": "cs09_tav_6",
          "speaker": "旁白",
          "text": "两张纸在风里响。你选怎么收这一季。"
        },
        {
          "id": "cs09_tavern_x0",
          "speaker": "旁白",
          "text": "碗沿两圈：并排记，先钉血名。"
        },
        {
          "id": "cs09_tavern_x1",
          "speaker": "掌柜",
          "text": "选完再喝。空喊嗣的，酒钱加倍。"
        },
        {
          "id": "cs09_tavern_x2",
          "speaker": "槐里·青禾",
          "text": "裁血验的人，先把剪刀放下。"
        },
        {
          "id": "cs09_tavern_x3",
          "speaker": "老管事",
          "text": "并排让空可见。可见才逼人来对。"
        },
        {
          "id": "cs09_tavern_x4",
          "speaker": "石垒·晚担",
          "text": "栏能念，验能对。少一样厅会晃。"
        },
        {
          "id": "cs09_tavern_x5",
          "speaker": "苇原·灯影",
          "text": "买一行结论，先摸罩。摸完再出价。"
        },
        {
          "id": "cs09_tavern_x6",
          "speaker": "岁吏",
          "text": "回执不认吆喝。认灯，认手，认边。"
        },
        {
          "id": "cs09_tavern_x7",
          "speaker": "书记官",
          "text": "两张纸响。风不替你选。"
        },
        {
          "id": "cs09_tavern_x8",
          "speaker": "老旗手",
          "text": "圈选偏，旗角先响。响了就停手。"
        },
        {
          "id": "cs09_tavern_y16",
          "speaker": "旁白",
          "text": "血验灯晃了一下。"
        },
        {
          "id": "cs09_tavern_y17",
          "speaker": "石垒·晚担",
          "text": "晃的是手，不是血。"
        },
        {
          "id": "cs09_tavern_y18",
          "speaker": "leader",
          "text": "血要稳。"
        },
        {
          "id": "cs09_tavern_x9",
          "speaker": "旁白",
          "text": "你还没选。没选时，罩边最清楚。"
        }
      ],

{
  "id": "cs09_01",
  "title": "血验上的灯",
  "legacy_index": 409,
  "return_scene": "res://scenes/hub/castle_hub.tscn",
  "source": "docs/content-seasons/season-09/NOVEL.md",
  "beats": [
    {
      "id": "yard",
      "title": "挂栏",
      "next": "blood",
      "lines": [
        {
          "id": "cs09_yd_0",
          "speaker": "旁白",
          "text": "血验。名册末行空着。血验上的灯还亮。",
          "stage": {
            "card": "一　挂栏",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs09_yd_1",
          "speaker": "书记官",
          "text": "议会要听念。栏要写得正，写得能念。"
        },
        {
          "id": "cs09_yd_2",
          "speaker": "leader",
          "text": "写验已写。"
        },
        {
          "id": "cs09_yd_3",
          "speaker": "旁白",
          "text": "笔尖停一下。末行落下「验已写」三字。"
        },
        {
          "id": "cs09_yd_4",
          "speaker": "老旗手",
          "text": "旗册誊栏。旗角不给人卖名。"
        },
        {
          "id": "cs09_yd_5",
          "speaker": "岁吏",
          "text": "谱可以进栏。血验是另一本账。"
        },
        {
          "id": "cs09_yd_6",
          "speaker": "石垒·晚担",
          "text": "写好看不难。站得住才难。"
        },
        {
          "id": "cs09_yd_7",
          "speaker": "leader",
          "text": "栏挂上了。去看血验。"
        }
      ]
    },
    {
      "id": "blood",
      "title": "血验",
      "next": "hourglass",
      "lines": [
        {
          "id": "cs09_bl_0",
          "speaker": "旁白",
          "text": "血验未结。灯照着验条上的白。",
          "stage": {
            "bg": "hall",
            "camera": "close"
          }
        },
        {
          "id": "cs09_bl_1",
          "speaker": "老管事",
          "text": "血验：对条已记，点验待对。血名栏仍空。"
        },
        {
          "id": "cs09_bl_2",
          "speaker": "旁白",
          "text": "名册说验已写。血验说还在对。两行字第一次吵架。"
        },
        {
          "id": "cs09_bl_3",
          "speaker": "苇原·灯影",
          "text": "巡防不问谁入验。问今夜谁还没对条。"
        },
        {
          "id": "cs09_bl_4",
          "speaker": "槐里·青禾",
          "text": "空着才诚实。写满却站不上去，才是骗人。"
        },
        {
          "id": "cs09_bl_5",
          "speaker": "老管事",
          "text": "还差两格。跳格的栏，桩会裂。"
        },
        {
          "id": "cs09_bl_6",
          "speaker": "leader",
          "text": "记下。去看沙漏。"
        }
      ]
    },
    {
      "id": "hourglass",
      "title": "两行",
      "next": "bridge",
      "lines": [
        {
          "id": "cs09_hg_0",
          "speaker": "旁白",
          "text": "沙漏多出两行：上行验已写，下行血验未结。",
          "stage": {
            "bg": "hall",
            "camera": "wide"
          }
        },
        {
          "id": "cs09_hg_1",
          "speaker": "老管事",
          "text": "并排钉。谁撕下行，谁结账。"
        },
        {
          "id": "cs09_hg_2",
          "speaker": "岁吏",
          "text": "回执在侧室。谱与验，两本账。"
        },
        {
          "id": "cs09_hg_3",
          "speaker": "书记官",
          "text": "议会爱一行。两行最好活。"
        },
        {
          "id": "cs09_hg_4",
          "speaker": "苇原·灯影",
          "text": "更还在交。下行先响。"
        },
        {
          "id": "cs09_hg_5",
          "speaker": "槐里·青禾",
          "text": "孩子要抄未结，不要只抄名。"
        },
        {
          "id": "cs09_hg_6",
          "speaker": "leader",
          "text": "两行都留。去门廊。"
        }
      ]
    },
    {
      "id": "bridge",
      "title": "门廊",
      "next": "tavern",
      "lines": [
        {
          "id": "cs09_br_0",
          "speaker": "旁白",
          "text": "门廊问谁入验。墙牌两行一起响。",
          "stage": {
            "bg": "hall",
            "camera": "wide"
          }
        },
        {
          "id": "cs09_br_1",
          "speaker": "石垒·晚担",
          "text": "牌比纸硬。纸比嘴硬。"
        },
        {
          "id": "cs09_br_2",
          "speaker": "老旗手",
          "text": "旗角给人核，不给人卖名。"
        },
        {
          "id": "cs09_br_3",
          "speaker": "苇原·灯影",
          "text": "桩空有下落，再谈名。"
        },
        {
          "id": "cs09_br_4",
          "speaker": "槐里·青禾",
          "text": "谎抄不住。孩子会问为什么空。"
        },
        {
          "id": "cs09_br_5",
          "speaker": "老管事",
          "text": "闲话快。对照慢。慢的留下。"
        },
        {
          "id": "cs09_br_6",
          "speaker": "岁吏",
          "text": "谱很长。血验很静。静是还在对。"
        },
        {
          "id": "cs09_br_7",
          "speaker": "leader",
          "text": "带牌。去酒馆。"
        }
      ]
    },
    {
      "id": "tavern",
      "title": "选题",
      "lines": [
        {
          "id": "cs09_tav_0",
          "speaker": "旁白",
          "text": "烽火酒馆。碗沿两个圈：并排记，先钉名。",
          "stage": {
            "bg": "tavern",
            "camera": "wide"
          }
        },
        {
          "id": "cs09_tav_1",
          "speaker": "掌柜",
          "text": "篇幅不够就钉墙。墙比名册宽。"
        },
        {
          "id": "cs09_tav_2",
          "speaker": "槐里·青禾",
          "text": "裁血验的人，先把剪刀放下。"
        },
        {
          "id": "cs09_tav_3",
          "speaker": "老管事",
          "text": "并排钉。谁撕血验抄本，谁结账。"
        },
        {
          "id": "cs09_tav_4",
          "speaker": "石垒·晚担",
          "text": "栏是念的，桩是站的。两样都要。"
        },
        {
          "id": "cs09_tav_5",
          "speaker": "苇原·灯影",
          "text": "沙漏还亮。谁买一行结论，带他去摸验灯。"
        },
        {
          "id": "cs09_tav_6",
          "speaker": "旁白",
          "text": "两张纸在风里响。你选怎么收这一季。"
        }
      ],
      "actions": [
        {

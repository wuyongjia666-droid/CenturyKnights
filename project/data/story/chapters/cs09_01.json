    {
      "id": "ledger",
      "title": "入册",
      "lines": [
        {
          "id": "cs09_led_0",
          "speaker": "旁白",
          "text": "旗册封面四个字：血验上的灯。末页已厚。柜上两把钥匙。",
          "stage": {
            "bg": "hall",
            "camera": "close"
          }
        },
        {
          "id": "cs09_led_par",
          "speaker": "旁白",
          "text": "你留下两行。议会仍爱一行。柜子认灯。",
          "when": {
            "flag": "cs09_kept_blood"
          }
        },
        {
          "id": "cs09_led_name",
          "speaker": "旁白",
          "text": "你先钉血名。沙漏仍在亮——月会替你写下行。",
          "when": {
            "flag": "cs09_name_blood"
          }
        },
        {
          "id": "cs09_led_1",
          "speaker": "老管事",
          "text": "存档不刊也行。不丢，就是缝。"
        },
        {
          "id": "cs09_led_2",
          "speaker": "槐里·青禾",
          "text": "孩子抄过血验，才配以后念栏。"
        },
        {
          "id": "cs09_led_3",
          "speaker": "老旗手",
          "text": "并排。不要裁。缝在名册与血验之间。"
        },
        {
          "id": "cs09_led_4",
          "speaker": "岁吏",
          "text": "回执在侧室。谱与验，两本账。"
        },
        {
          "id": "cs09_led_5",
          "speaker": "苇原·灯影",
          "text": "更还在交。下次挂嗣，下行先响。"
        },
        {
          "id": "cs09_ledger_x0",
          "speaker": "旁白",
          "text": "旗册封面：血验上的灯。钥匙两把。"
        },
        {
          "id": "cs09_ledger_x1",
          "speaker": "老管事",
          "text": "缝在名册与血验之间。缝要留。"
        },
        {
          "id": "cs09_ledger_x2",
          "speaker": "槐里·青禾",
          "text": "抄过空格，才配以后念栏。"
        },
        {
          "id": "cs09_ledger_x3",
          "speaker": "老旗手",
          "text": "并排入柜。裁半本的，我不收。"
        },
        {
          "id": "cs09_ledger_x4",
          "speaker": "岁吏",
          "text": "侧室回执还在。红脸还诚实。"
        },
        {
          "id": "cs09_ledger_x5",
          "speaker": "苇原·灯影",
          "text": "下次挂嗣，下行先响。"
        },
        {
          "id": "cs09_ledger_x6",
          "speaker": "书记官",
          "text": "催条再来，封面四个字压得住。"
        },
        {
          "id": "cs09_ledger_x7",
          "speaker": "石垒·晚担",
          "text": "桩在，血名才有地方站。"
        },
        {
          "id": "cs09_ledger_x8",
          "speaker": "掌柜",
          "text": "擦过急圈的墙，更值钱。"
        },
        {
          "id": "cs09_ledger_x9",
          "speaker": "旁白",
          "text": "灯还在。灯在，就还没骗完这一季。"
        },
        {
          "id": "cs09_led_6",
          "speaker": "leader",
          "text": "栏与验，并排。谁来认嗣位，先念完。"
        },
        {
          "id": "cs09_led_y19",
          "speaker": "旁白",
          "text": "册上旧渍沉底。"
        },
        {
          "id": "cs09_led_y20",
          "speaker": "石垒·晚担",
          "text": "沉底的不是新泼。"
        },
        {
          "id": "cs09_led_y21",
          "speaker": "leader",
          "text": "新泼的不认。"
        },
        {
          "id": "cs09_led_7",
          "speaker": "旁白",
          "text": "风动旗角时，验已写还在。两行之间的空，给人脸红。"
        }
      ],
      "actions": []
    }
  ]

{
  "id": "cs09_01",
  "title": "血验上的灯",
  "legacy_index": 409,
  "return_scene": "res://scenes/hub/castle_hub.tscn",
  "source": "docs/content-seasons/season-09/NOVEL.md",
  "beats": [
    {
      "id": "yard",
      "title": "挂栏",
      "next": "blood",
      "lines": [
        {
          "id": "cs09_yd_0",
          "speaker": "旁白",
          "text": "血验。名册末行空着。血验上的灯还亮。",
          "stage": {
            "card": "一　挂栏",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs09_yd_1",
          "speaker": "书记官",
          "text": "议会要听念。栏要写得正，写得能念。"
        },
        {
          "id": "cs09_yd_2",
          "speaker": "leader",
          "text": "写验已写。"
        },
        {
          "id": "cs09_yd_3",
          "speaker": "旁白",
          "text": "笔尖停一下。末行落下「验已写」三字。"
        },
        {
          "id": "cs09_yd_4",
          "speaker": "老旗手",
          "text": "旗册誊栏。旗角不给人卖名。"
        },
        {
          "id": "cs09_yd_5",
          "speaker": "岁吏",
          "text": "谱可以进栏。血验是另一本账。"
        },
        {
          "id": "cs09_yd_6",
          "speaker": "石垒·晚担",
          "text": "写好看不难。站得住才难。"
        },
        {
          "id": "cs09_yard_x0",
          "speaker": "旁白",
          "text": "验条右栏空着。空得像故意留给人问。"
        },
        {
          "id": "cs09_yard_x1",
          "speaker": "书记官",
          "text": "催条写「血验已记」。记在纸上，不在灯上。"
        },
        {
          "id": "cs09_yard_x2",
          "speaker": "老管事",
          "text": "纸暖，灯冷。冷的才是要你亲手对的。"
        },
        {
          "id": "cs09_yard_x3",
          "speaker": "槐里·青禾",
          "text": "孩子先看空栏。空栏比满栏更像家规。"
        },
        {
          "id": "cs09_yard_x4",
          "speaker": "苇原·灯影",
          "text": "巡走过东厢，先问今夜谁还没对条。"
        },
        {
          "id": "cs09_yard_x5",
          "speaker": "老旗手",
          "text": "旗角不卖名。验条也不给人跳格。"
        },
        {
          "id": "cs09_yard_x6",
          "speaker": "岁吏",
          "text": "谱进栏可以。血验另本账。账对不上就红脸。"
        },
        {
          "id": "cs09_yard_x7",
          "speaker": "石垒·晚担",
          "text": "写好看不难。验得住才难。"
        },
        {
          "id": "cs09_yard_x8",
          "speaker": "旁白",
          "text": "窗纸新，桌却旧。旧桌认手，不认催。"
        },
        {
          "id": "cs09_yard_x9",
          "speaker": "掌柜",
          "text": "酒馆圈等着血验选题。选题公开，扯皮少。"
        },
        {
          "id": "cs09_yd_y17",
          "speaker": "旁白",
          "text": "血验灯晃了一下。"
        },
        {
          "id": "cs09_yd_y18",
          "speaker": "石垒·晚担",
          "text": "晃的是手，不是血。"
        },
        {
          "id": "cs09_yd_y19",
          "speaker": "leader",
          "text": "血要稳。"
        },
        {
          "id": "cs09_yd_7",
          "speaker": "leader",
          "text": "栏挂上了。去看血验。"
        }
      ]
    },
    {
      "id": "blood",
      "title": "血验",
      "next": "hourglass",
      "lines": [
        {
          "id": "cs09_bl_0",
          "speaker": "旁白",
          "text": "血验未结。灯照着验条上的白。",
          "stage": {
            "bg": "hall",
            "camera": "close"
          }
        },
        {
          "id": "cs09_bl_1",
          "speaker": "老管事",
          "text": "血验：对条已记，点验待对。血名栏仍空。"
        },
        {
          "id": "cs09_bl_2",
          "speaker": "旁白",
          "text": "名册说验已写。血验说还在对。两行字第一次吵架。"
        },
        {
          "id": "cs09_bl_3",
          "speaker": "苇原·灯影",
          "text": "巡防不问谁入验。问今夜谁还没对条。"
        },
        {
          "id": "cs09_bl_4",
          "speaker": "槐里·青禾",
          "text": "空着才诚实。写满却站不上去，才是骗人。"
        },
        {
          "id": "cs09_bl_5",
          "speaker": "老管事",
          "text": "还差两格。跳格的栏，桩会裂。"
        },
        {
          "id": "cs09_blood_x0",
          "speaker": "旁白",
          "text": "验灯白得像旧伤。白光里，空格最清楚。"
        },
        {
          "id": "cs09_blood_x1",
          "speaker": "老管事",
          "text": "对条已记，点验待对。血名栏仍空。"
        },
        {
          "id": "cs09_blood_x2",
          "speaker": "石垒·晚担",
          "text": "影正再对。影偏就停手。"
        },
        {
          "id": "cs09_blood_x3",
          "speaker": "书记官",
          "text": "旁注写「血验未结」。旁注是缝，不是丢人。"
        },
        {
          "id": "cs09_blood_x4",
          "speaker": "岁吏",
          "text": "两本账。谱很长，血验很静。静是还在对。"
        },
        {
          "id": "cs09_blood_x5",
          "speaker": "苇原·灯影",
          "text": "摸过罩的手会黑。黑着手别喊已点。"
        },
        {
          "id": "cs09_blood_x6",
          "speaker": "槐里·青禾",
          "text": "空着诚实。写满却验不上，才是骗人。"
        },
        {
          "id": "cs09_blood_x7",
          "speaker": "老旗手",
          "text": "跳格的栏，桩会裂。裂了再补，更疼。"
        },
        {
          "id": "cs09_blood_x8",
          "speaker": "旁白",
          "text": "灯罩边毛还是齐，一眼能看出来。"
        },
        {
          "id": "cs09_blood_x9",
          "speaker": "老管事",
          "text": "边毛是急。急点进册，以后当众脸红。"
        },
        {
          "id": "cs09_bl_y16",
          "speaker": "旁白",
          "text": "册上旧渍沉底。"
        },
        {
          "id": "cs09_bl_y17",
          "speaker": "石垒·晚担",
          "text": "沉底的不是新泼。"
        },
        {
          "id": "cs09_bl_y18",
          "speaker": "leader",
          "text": "新泼的不认。"
        },
        {
          "id": "cs09_bl_6",
          "speaker": "leader",
          "text": "记下。去看沙漏。"
        }
      ]
    },
    {
      "id": "hourglass",
      "title": "两行",
      "next": "bridge",
      "lines": [
        {
          "id": "cs09_hg_0",
          "speaker": "旁白",
          "text": "沙漏多出两行：上行验已写，下行血验未结。",
          "stage": {
            "bg": "hall",
            "camera": "wide"
          }
        },
        {
          "id": "cs09_hg_1",
          "speaker": "老管事",
          "text": "并排钉。谁撕下行，谁结账。"
        },
        {
          "id": "cs09_hg_2",
          "speaker": "岁吏",
          "text": "回执在侧室。谱与验，两本账。"
        },
        {
          "id": "cs09_hg_3",
          "speaker": "书记官",
          "text": "议会爱一行。两行最好活。"
        },
        {
          "id": "cs09_hg_4",
          "speaker": "苇原·灯影",
          "text": "更还在交。下行先响。"
        },
        {
          "id": "cs09_hg_5",
          "speaker": "槐里·青禾",
          "text": "孩子要抄未结，不要只抄名。"
        },
        {
          "id": "cs09_hourglass_x0",
          "speaker": "旁白",
          "text": "上行血验已记，下行血验未结。细线钉死。"
        },
        {
          "id": "cs09_hourglass_x1",
          "speaker": "老管事",
          "text": "谁撕下行，谁去摸罩结账。"
        },
        {
          "id": "cs09_hourglass_x2",
          "speaker": "书记官",
          "text": "一行好念。两行好活。我们选活。"
        },
        {
          "id": "cs09_hourglass_x3",
          "speaker": "岁吏",
          "text": "回执认并排。并排认灯。灯不认抢跑。"
        },
        {
          "id": "cs09_hourglass_x4",
          "speaker": "苇原·灯影",
          "text": "更还在交。下行先响，上行后听。"
        },
        {
          "id": "cs09_hourglass_x5",
          "speaker": "槐里·青禾",
          "text": "孩子抄未结。抄名的时候，空要在。"
        },
        {
          "id": "cs09_hourglass_x6",
          "speaker": "石垒·晚担",
          "text": "间距够脸红。红完再谈点验。"
        },
        {
          "id": "cs09_hourglass_x7",
          "speaker": "老旗手",
          "text": "核的时候两行都在。少一行，角先裂。"
        },
        {
          "id": "cs09_hourglass_x8",
          "speaker": "旁白",
          "text": "沙子慢。慢着走，才像血验该有的速度。"
        },
        {
          "id": "cs09_hourglass_x9",
          "speaker": "掌柜",
          "text": "墙牌硬。硬牌撕起来，手会记得疼。"
        },
        {
          "id": "cs09_hg_y16",
          "speaker": "旁白",
          "text": "血验灯晃了一下。"
        },
        {
          "id": "cs09_hg_y17",
          "speaker": "石垒·晚担",
          "text": "晃的是手，不是血。"
        },
        {
          "id": "cs09_hg_y18",
          "speaker": "leader",
          "text": "血要稳。"
        },
        {
          "id": "cs09_hg_6",
          "speaker": "leader",
          "text": "两行都留。去门廊。"
        }
      ],
      "actions": [
        {
          "id": "open_hourglass",
          "label": "去看月份怎么往前走",
          "do": [
            {
              "op": "visit",
              "path": "res://scenes/hub/hourglass.tscn"
            }
          ]
        },
        {
          "id": "continue_after_visit",
          "label": "继续，去门廊",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ]
    },
    {
      "id": "bridge",
      "title": "门廊",
      "next": "tavern",
      "lines": [
        {
          "id": "cs09_br_0",
          "speaker": "旁白",
          "text": "门廊问谁入验。墙牌两行一起响。",
          "stage": {
            "bg": "hall",
            "camera": "wide"
          }
        },
        {
          "id": "cs09_br_1",
          "speaker": "石垒·晚担",
          "text": "牌比纸硬。纸比嘴硬。"
        },
        {
          "id": "cs09_br_2",
          "speaker": "老旗手",
          "text": "旗角给人核，不给人卖名。"
        },
        {
          "id": "cs09_br_3",
          "speaker": "苇原·灯影",
          "text": "桩空有下落，再谈名。"
        },
        {
          "id": "cs09_br_4",
          "speaker": "槐里·青禾",
          "text": "谎抄不住。孩子会问为什么空。"
        },
        {
          "id": "cs09_br_5",
          "speaker": "老管事",
          "text": "闲话快。对照慢。慢的留下。"
        },
        {
          "id": "cs09_br_6",
          "speaker": "岁吏",
          "text": "谱很长。血验很静。静是还在对。"
        },
        {
          "id": "cs09_br_7",
          "speaker": "leader",
          "text": "带牌。去酒馆。"
        },
        {
          "id": "cs09_bridge_x0",
          "speaker": "旁白",
          "text": "门廊问谁入验。墙牌两行一起响。"
        },
        {
          "id": "cs09_bridge_x1",
          "speaker": "石垒·晚担",
          "text": "牌比纸硬。绕牌的人，先撞桩。"
        },
        {
          "id": "cs09_bridge_x2",
          "speaker": "老旗手",
          "text": "旗角给人核。验给人站。两样并排。"
        },
        {
          "id": "cs09_bridge_x3",
          "speaker": "苇原·灯影",
          "text": "下落不清，验先别谈。谈了是吵。"
        },
        {
          "id": "cs09_bridge_x4",
          "speaker": "槐里·青禾",
          "text": "谎抄不住。孩子会指着空栏问。"
        },
        {
          "id": "cs09_bridge_x5",
          "speaker": "老管事",
          "text": "闲话快。对照慢。慢的留下。"
        },
        {
          "id": "cs09_bridge_x6",
          "speaker": "岁吏",
          "text": "谱很长。血验很静。静着对，才像真。"
        },
        {
          "id": "cs09_bridge_x7",
          "speaker": "书记官",
          "text": "记谁摸罩、谁短笑、谁催已点。"
        },
        {
          "id": "cs09_bridge_x8",
          "speaker": "旁白",
          "text": "短笑在牌旁散开。散开不像结论。"
        },
        {
          "id": "cs09_bridge_x9",
          "speaker": "掌柜",
          "text": "圈还在墙上。圈不等短笑落地。"
        },
        {
          "id": "cs09_mid_y18",
          "speaker": "旁白",
          "text": "册上旧渍沉底。"
        },
        {
          "id": "cs09_mid_y19",
          "speaker": "石垒·晚担",
          "text": "沉底的不是新泼。"
        },
        {
          "id": "cs09_mid_y20",
          "speaker": "leader",
          "text": "新泼的不认。"
        },
        {
          "id": "cs09_mid_lost",
          "speaker": "旁白",
          "text": "锋收回来。血验问声还在。墙牌旁那拨，没散。",
          "when": {
            "all": [
              {

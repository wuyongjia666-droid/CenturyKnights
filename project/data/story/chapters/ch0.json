{
  "id": "ch0",
  "title": "第零章·灰旗初升",
  "legacy_index": 0,
  "return_scene": "res://scenes/story/chapter0.tscn",
  "beats": [
    {
      "id": "0.0",
      "title": "破旗",
      "lines": [
        {
          "id": "ch0_0_0_l0",
          "speaker": "旁白",
          "text": "朔澜陆桥的夜贴着断杆。灰旗被血黏住，边熏得发黑。有人把「还在」按进最后一口气。"
        },
        {
          "id": "ch0_0_0_l1",
          "speaker": "旁白",
          "text": "你把它从杆上揭下来。不是为了哪扇城门。是因为旗下还有人：伤的、饿的，和不肯散的苇原·灯影。"
        },
        {
          "id": "ch0_0_0_l2",
          "speaker": "老旗手",
          "text": "扛杆的人不会再答应你。姓已经写下，色已经在布里。团长这个字，从你掌心的血算起。"
        },
        {
          "id": "ch0_0_0_l3",
          "speaker": "苇原·灯影",
          "text": "我跟着你不是为了姓。是为了隘口那条路还能走人。不过——姓也重要。没姓的旗，风一吹就散。"
        },
        {
          "id": "ch0_0_0_l4",
          "speaker": "老旗手",
          "text": "我听见姓了。北面还有火。火里要是还有我们的人，典礼就得等。你先把她活着带回来。"
        }
      ],
      "actions": [
        {
          "id": "enter_banner",
          "label": "踏入这面还渗着血的旗",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ],
      "next": "0.05"
    },
    {
      "id": "0.05",
      "title": "旗面初成",
      "lines": [
        {
          "id": "ch0_0_05_l0",
          "speaker": "旁白",
          "text": "布洗净、缝上，颜色吃进没干的血。老旗手的手在抖。他太久没碰过还能举起的东西。"
        },
        {
          "id": "ch0_0_05_l1",
          "speaker": "老旗手",
          "text": "有色，有姓。没有一场能让粮重新过桥的仗，这仍是丧布。我不会让灯影替你去死。"
        },
        {
          "id": "ch0_0_05_l2",
          "speaker": "斥候",
          "text": "北隘有烟。不是灶，是抢粮的火。窄路堵住了。堡里的嘴，撑不过几天。"
        },
        {
          "id": "ch0_0_05_l3",
          "speaker": "苇原·灯影",
          "text": "你选落点。我守你侧翼。先站住，再出手。你若倒在第一脚，这条路就只剩我一个人。"
        },
        {
          "id": "ch0_0_05_l4",
          "speaker": "苇原·灯影",
          "text": "进窄路之前看谁还站得住。撑着的不要排在前面。我的箭护得住你，护不住一排已经凉了的背。"
        }
      ],
      "actions": [
        {
          "id": "to_pass",
          "label": "去隘口把人接回来",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ],
      "next": "0.1"
    },
    {
      "id": "0.1",
      "title": "隘口之夜",
      "lines": [
        {
          "id": "ch0_0_1_l0",
          "speaker": "老旗手",
          "text": "烟压在窄路上。找能站住的地方，再让刀出去。挤成一团，她的箭就没有缝。"
        },
        {
          "id": "ch0_0_1_l1",
          "speaker": "斥候",
          "text": "对面人不多。路比人窄。你退的时候，别堵死她的退步。"
        },
        {
          "id": "ch0_0_1_l2",
          "speaker": "苇原·灯影",
          "text": "我在侧翼。你点谁，谁就走。这一仗若输，粮就进不了堡。我没办法向她交代。"
        }
      ],
      "actions": [
        {
          "id": "after_smoke",
          "label": "听烟散之后",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ],
          "when": {
            "flag": "battle_done"
          }
        },
        {
          "id": "start_battle",
          "label": "走进这场战斗",
          "do": [
            {
              "op": "battle",
              "map": "ch0_pass",
              "objective": "rout",
              "return": "res://scenes/story/chapter0.tscn"
            }
          ],
          "when": {
            "not_flag": "battle_done"
          }
        },
        {
          "id": "retry_note",
          "label": "人还在，路可以再走",
          "do": [],

          },
          "disabled": true
        }
      ],
      "next": "0.15"
    },
    {
      "id": "0.15",
      "title": "烟散之后",
      "lines": [
        {
          "id": "ch0_0_15_l0",
          "speaker": "旁白",
          "text": "还有人想爬。她的箭钉在他面前三寸的石头上。不是饶。她要那支没烧尽的签。"
        },
        {
          "id": "ch0_0_15_l1",
          "speaker": "苇原·灯影",
          "text": "活口说，背后有人收过路银。不是抢一袋粮。是有人在卖这条我还想走的路。"
        },
        {
          "id": "ch0_0_15_l2",
          "speaker": "老旗手",
          "text": "银有了。能喘气的人不够。空房间会把死人的声音放大。柜上今夜挂着还肯活的名字。"
        },
        {
          "id": "ch0_0_15_l3",
          "speaker": "斥候",
          "text": "签先收着。那个名字以后会自己回来。眼下先去带一个能站在她旁边的人。"
        }
      ],
      "actions": [
        {
          "id": "to_tavern_beat",
          "label": "前往烽火酒馆",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ],
      "next": "0.2"
    },
    {
      "id": "0.2",
      "title": "酒馆赊账",
      "lines": [
        {
          "id": "ch0_0_2_l0",
          "speaker": "旁白",
          "text": "门轴响了一声。不是鬼。是有人把命写成月饷，等一面还肯认他的旗。"
        },
        {
          "id": "ch0_0_2_l1",
          "speaker": "掌柜",
          "text": "不赊命，只认银。今夜三张脸。看眼睛，看他们要多少，看你让不让这张脸睡在她旁边。"
        },
        {
          "id": "ch0_0_2_l2",
          "speaker": "掌柜",
          "text": "陆桥怕两件事。团长改口。旗脏到城门不认。你们的旗有颜色。颜色底下有血。这是好消息。"
        },
        {
          "id": "ch0_0_2_l3",
          "speaker": "掌柜",
          "text": "至少带走一个。看走眼，下个月的饷会把那个人的名字念成一笔还不清的亏。"
        }
      ],
      "actions": [
        {
          "id": "sheathe",
          "label": "让这个人站到旗下",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ],
          "when": {
            "flag": "recruited"
          }
        },
        {
          "id": "open_tavern",
          "label": "去看今夜还肯留下的人",
          "do": [
            {
              "op": "scene",
              "path": "res://scenes/hub/tavern.tscn"
            }
          ],
          "when": {
            "not_flag": "recruited"
          }
        }
      ],
      "next": "0.25"
    },
    {
      "id": "0.25",
      "title": "新刃入鞘",
      "lines": [
        {
          "id": "ch0_0_25_l0",
          "speaker": "旁白",
          "text": "新人进队列，先看旗，再看她。旗一斜，人就会问自己是不是站错了人。"
        },
        {
          "id": "ch0_0_25_l1",
          "speaker": "苇原·灯影",
          "text": "今夜别把新人送回隘口。让他们看见哪扇窗还亮。人得知道自己在给谁守。"
        },
        {
          "id": "ch0_0_25_l2",
          "speaker": "老旗手",
          "text": "堡该点灯了。屋顶还漏风。漏风也比把名册铺在路边、让风去念死人强。"
        },
        {
          "id": "ch0_0_25_l3",
          "speaker": "管事",
          "text": "灯我来点。你认人：谁睡哪一间，谁明天还能出门。别的门，这一年用得上再开。"
        }
      ],
      "actions": [
        {
          "id": "enter_keep",
          "label": "去把堡里的灯点上",
          "do": [
            {
              "op": "set_flag",
              "flag": "hub_open",
              "value": true
            },
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ],
      "next": "0.3"
    },
    {
      "id": "0.3",
      "title": "灰旗堡灯火",
      "lines": [
        {
          "id": "ch0_0_3_l0",
          "speaker": "旁白",
          "text": "第一盏灯很小。柱上的刀痕被照清楚。有人在这里守过。有人吹灭灯之后，没再回来。"
        },
        {
          "id": "ch0_0_3_l1",
          "speaker": "管事",
          "text": "今晚只看名册。伤和还能不能站，写在名字旁边。这比头衔先决定明天谁出门。"
        },
        {
          "id": "ch0_0_3_l2",
          "speaker": "管事",
          "text": "传下去的位子空着。不是坏了。是还没有第二个人，能从你手里把这个姓接住。"
        },
        {
          "id": "ch0_0_3_l3",
          "speaker": "管事",
          "text": "你去看还活着的人。我等陆桥的信。信会说谎。空位子不会。它只问你怕不怕后继无人。"
        }
      ],
      "actions": [
        {
          "id": "open_hub",
          "label": "去看还活着的人",
          "do": [
            {
              "op": "set_flag",
              "flag": "hub_open",
              "value": true
            },
            {
              "op": "set_beat",
              "chapter": 0,
              "beat": "0.35"
            },
            {
              "op": "scene",
              "path": "res://scenes/hub/castle_hub.tscn"
            }
          ]
        },
        {
          "id": "hear_bridge",
          "label": "先听陆桥耳语",
          "do": [
            {
              "op": "set_flag",
              "flag": "hub_open",
              "value": true
            },
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ],
      "next": "0.35"
    },
    {
      "id": "0.35",
      "title": "陆桥耳语",
      "lines": [
        {
          "id": "ch0_0_35_l0",
          "speaker": "旁白",
          "text": "远处敲了一下锣。闲话跟着来：隘口赢了，旗是新的，团长还没有家。她还没有走。"
        },
        {
          "id": "ch0_0_35_l1",
          "speaker": "春令使者",
          "text": "信比我先到。春令将近。诸邦看旗，也看门里有没有人把命交给你。没有家的旗，只是过路的布。"
        },
        {
          "id": "ch0_0_35_l2",
          "speaker": "苇原·灯影",
          "text": "别让「百年」压住今夜。亲事是一步。迈错了，孩子的名字会被写在别人的城里，按别人的律。"
        },
        {
          "id": "ch0_0_35_l3",
          "speaker": "春令使者",
          "text": "帖我送到席上。灰烬的门我代你问过了。你进去，把名字说完。她不会替你向城门求饶。"
        }
      ],
      "actions": [
        {
          "id": "to_spring",
          "label": "去听春令怎么看这面旗",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        },
        {
          "id": "back_hub",
          "label": "先回堡看看她",
          "do": [
            {
              "op": "scene",
              "path": "res://scenes/hub/castle_hub.tscn"
            }
          ]
        }
      ],
      "next": "0.4"
    },
    {
      "id": "0.4",
      "title": "春令试婚",
      "lines": [
        {
          "id": "ch0_0_4_l0",
          "speaker": "春令使者",
          "text": "春令到了。席设在看得见旗的地方。声望不够的信，门槛都不给过。这封过得去。"
        },
        {
          "id": "ch0_0_4_l1",
          "speaker": "苇原·灯影",
          "text": "入席前，把期望那一行自己念完。孩子会带走什么，写在那里。你念不出口，就不要点头。"
        },
        {
          "id": "ch0_0_4_l2",
          "speaker": "旁白",
          "text": "厅外有人比旗的颜色。有人笑它太新。她没笑。她在听，会不会有人把两个姓写成一个可以涂改的姓。"
        },
        {
          "id": "ch0_0_4_l3",
          "speaker": "春令使者",
          "text": "帖递进去，人就要把话说完。孩子不来这一夜。孩子在后面的月份里来。来了，就有人要认这张脸。"
        }
      ],
      "actions": [
        {
          "id": "to_feast",
          "label": "赴这张托付人命的席",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ],
          "when": {
            "flag": "married"
          }
        },
        {

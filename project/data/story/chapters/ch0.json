    {
      "id": "0.25",
      "title": "新刃入鞘",
      "lines": [
        {
          "id": "ch0_0_25_l0",
          "speaker": "旁白",
          "text": "新人站进队列时，总会下意识看旗。旗稳，人就稳；旗歪，刀也会歪。"
        },
        {
          "id": "ch0_0_25_l1",
          "speaker": "苇原·灯影",
          "text": "别急着让新人上隘口。先让他们看见堡——大厅、委任榜、演武场。人要知道自己为谁守夜。"
        },
        {
          "id": "ch0_0_25_l2",
          "speaker": "老旗手",
          "text": "灰旗堡的灯，该亮了。破屋顶漏风，可漏风也比露宿强。走吧，团长。"
        },
        {
          "id": "ch0_0_25_l3",
          "speaker": "管事",
          "text": "灯可以亮了。大厅、委任、演武，每扇门后都是人。"
        }
      ],
      "actions": [
        {
          "id": "enter_keep",
          "label": "入驻灰旗堡",
          "do": [
            {
              "op": "set_flag",
              "flag": "hub_open",
              "value": true
            },
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ],
      "next": "0.3"
    },
    {
      "id": "0.3",
      "title": "灰旗堡灯火",
      "lines": [
        {
          "id": "ch0_0_3_l0",
          "speaker": "旁白",
          "text": "破堡亮起第一盏灯。光很小，却把大厅柱上的刀痕照得很清楚——前人在此守过，也败过。"
        },
        {
          "id": "ch0_0_3_l1",
          "speaker": "管事",
          "text": "花名册、酒馆、委任、演武、炉火、祠堂、族谱、联姻、岁月、商路、编队……名字又长又土，但每扇门后都是命。"
        },
        {
          "id": "ch0_0_3_l2",
          "speaker": "管事",
          "text": "传家宝槽还空着。完整版才会醒。眼下你要做的是：让旗下有粮、有银、有能打的人，还有——能把姓传下去的人。"
        },
        {
          "id": "ch0_0_3_l3",
          "speaker": "管事",
          "text": "先看花名册，再看委任榜。看完了，灯还在这里等你。"
        }
      ],
      "actions": [
        {
          "id": "open_hub",
          "label": "进入灰旗堡枢纽",
          "do": [
            {
              "op": "set_flag",
              "flag": "hub_open",
              "value": true
            },
            {
              "op": "set_beat",

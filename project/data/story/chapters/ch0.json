{
  "id": "ch0",
  "title": "第零章·灰旗初升",
  "legacy_index": 0,
  "return_scene": "res://scenes/story/chapter0.tscn",
  "beats": [
    {
      "id": "0.0",
      "title": "破旗",
      "lines": [
        {
          "id": "ch0_0_0_l0",
          "speaker": "旁白",
          "text": "朔澜陆桥的边境，夜风贴着断杆。撕破的灰旗还钉在上面，布边被烟熏得发黑——有人把「还在」按进了这块布里。"
        },
        {
          "id": "ch0_0_0_l1",
          "speaker": "旁白",
          "text": "你把它从杆上取下来。姓已经在。色也在。旗下的人还在：伤的、饿的、不肯把路让出去的。"
        },
        {
          "id": "ch0_0_0_l2",
          "speaker": "老旗手",
          "text": "团长。这个字从今夜起算。旗认你写下的姓，也认你选进布里的那种颜色。"
        },
        {
          "id": "ch0_0_0_l3",
          "speaker": "苇原·灯影",
          "text": "我跟着你不是为了姓。是为了隘口那条路还能走人。不过——姓也重要。没姓的旗，风一吹就散。"
        },
        {
          "id": "ch0_0_0_l4",
          "speaker": "老旗手",
          "text": "布认人了。北面已经有火。典礼留到火灭以后。"
        }
      ],
      "actions": [
        {
          "id": "enter_banner",
          "label": "踏入旗面初成",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ],
      "next": "0.05"
    },
    {
      "id": "0.05",
      "title": "旗面初成",
      "lines": [
        {
          "id": "ch0_0_05_l0",
          "speaker": "旁白",
          "text": "布被洗净、缝上，颜色重新吃进旗心。老旗手的手在抖。不是怕。是太久没碰过一块完整的布。"
        },
        {
          "id": "ch0_0_05_l1",
          "speaker": "老旗手",
          "text": "有色，有姓。没有一场能让商队重新过桥的仗，这块布仍然只是断杆上的补丁。"
        },
        {
          "id": "ch0_0_05_l2",
          "speaker": "斥候",
          "text": "北隘有烟。不是灶。是抢粮的火。窄路被堵住，商队停在桥这边。堡里的粮，撑不过几天。"
        },
        {
          "id": "ch0_0_05_l3",
          "speaker": "苇原·灯影",
          "text": "人站在格子上。你选落点，我守侧翼。先站住，再出手。路若断在这里，后面的城埠都不必谈。"
        },
        {
          "id": "ch0_0_05_l4",
          "speaker": "苇原·灯影",
          "text": "进窄路之前，看一眼花名册。谁还站得住，谁只是撑着。撑着的人不要排在前面。"
        }
      ],
      "actions": [
        {
          "id": "to_pass",
          "label": "前往隘口之夜",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ],
      "next": "0.1"
    },
    {
      "id": "0.1",
      "title": "隘口之夜",
      "lines": [
        {
          "id": "ch0_0_1_l0",
          "speaker": "老旗手",
          "text": "烟压在窄路上。找能站住的格子，再让刀出去。挤成一团，就是他们的靶。"
        },
        {
          "id": "ch0_0_1_l1",
          "speaker": "斥候",
          "text": "对面人不多。路比人窄。后排别堵死自己人的退步。"
        },
        {
          "id": "ch0_0_1_l2",
          "speaker": "苇原·灯影",
          "text": "我在侧翼。你点谁，谁就走。这一仗若赢，桥这边的粮才有人敢送过来。"
        }
      ],
      "actions": [
        {
          "id": "after_smoke",
          "label": "听烟散之后",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }

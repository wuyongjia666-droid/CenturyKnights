              "path": "res://scenes/hub/marriage.tscn"
            }
          ],
          "when": {
            "not_flag": "married"
          }
        }
      ],
      "next": "0.45",
      "prepare": [
        {
          "op": "ensure_reputation",
          "when": {
            "not_flag": "married"
          },
          "realm": "ashland",
          "below": 30,
          "set": 35,
          "also_if_tier": "none",
          "log": "春令使者代请：灰烬邦声望升至友善"
        }
      ]
    },
    {
      "id": "0.45",
      "title": "双姓共席",
      "lines": [
        {
          "id": "ch0_0_45_l0",
          "speaker": "旁白",
          "text": "酒是薄的。两姓落座时，老旗手把旗又升了一寸。他怕桥对面看不见你们刚刚托出去的那条命。"
        },
        {
          "id": "ch0_0_45_l1",
          "speaker": "盟友亲属",
          "text": "人是托给这面旗的，不是托给这一夜的酒。孩子若不敢认它，就是我们把人送错了地方。"
        },
        {
          "id": "ch0_0_45_l2",
          "speaker": "苇原·灯影",
          "text": "家有了。先别拿去路上显。族谱那一页还空着。空着就空着。别替我往上写。"
        },
        {
          "id": "ch0_0_45_l3",
          "speaker": "苇原·灯影",
          "text": "初啼还没来。我可以留在席外。你要是在这里等，等的是一声哭，不是一栏填好的字。"
        }
      ],
      "actions": [
        {
          "id": "wait_birth",
          "label": "留下等那一声哭",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ],
      "next": "0.5"
    },
    {
      "id": "0.5",
      "title": "初啼",
      "lines": [
        {
          "id": "ch0_0_5_l0",
          "speaker": "稳婆",
          "text": "落地了。哭声不好听。好听的是这只肺自己在干活。命先属于这个孩子。旗排在后面。"
        },
        {
          "id": "ch0_0_5_l1",
          "speaker": "稳婆",
          "text": "脸、脾气、能走多远，都在这具小身体上。你若只翻银和刀，这一页会被你翻过去，像翻过一个死人。"
        },
        {
          "id": "ch0_0_5_l2",
          "speaker": "旁白",
          "text": "两条血在旗下碰在一起。页上那一道不是花边。以后每座城门都拿它来认这个孩子。你也会。"
        },
        {
          "id": "ch0_0_5_l3",
          "speaker": "稳婆",
          "text": "去看这个人。看眼睛，看这张以后要被人认的脸。看完再回来。月份不因为你站在门口就走。"
        }
      ],
      "actions": [
        {
          "id": "open_page",
          "label": "去认这个孩子",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ],
          "when": {
            "flag": "child_born"
          }
        },
        {
          "id": "advance_birth",
          "label": "让这个月走到初啼",
          "do": [
            {
              "op": "advance",
              "months": 1
            }
          ],
          "when": {
            "not_flag": "child_born"
          }
        },
        {
          "id": "open_lineage",
          "label": "去看族谱上的这一行",
          "do": [
            {
              "op": "scene",
              "path": "res://scenes/hub/lineage_view.tscn"
            }
          ],
          "when": {
            "not_flag": "child_born"
          }
        }
      ],
      "next": "0.55"
    },
    {
      "id": "0.55",
      "title": "族谱新页",
      "lines": [
        {
          "id": "ch0_0_55_l0",
          "speaker": "管事",
          "text": "新的一行写下了。墨干得很快。陆桥的风不给字留情，也不给这么小的肺留情。"
        },
        {
          "id": "ch0_0_55_l1",
          "speaker": "老旗手",
          "text": "孩子还上不了阵。有一天这面旗要交到这只手里。那一下比任何胜仗都沉。沉的是你还在不在。"
        },
        {
          "id": "ch0_0_55_l2",
          "speaker": "苇原·灯影",
          "text": "丰收月快到了。簿子不认哭声。先看这个月会落下什么，再把时间往前拨。拨完，人老一岁，孩子要吃。你认。"
        },
        {
          "id": "ch0_0_55_l3",
          "speaker": "管事",
          "text": "墨还湿。看完那一行再去摊秋收的账。人会老。粮得有一笔。没有粮，你刚才听见的哭声活不过这个月。"
        }
      ],
      "actions": [
        {
          "id": "to_harvest",
          "label": "去摊开秋收的账",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        },
        {
          "id": "see_lineage",
          "label": "再看一眼这个孩子",
          "do": [
            {
              "op": "scene",
              "path": "res://scenes/hub/lineage_view.tscn"
            }
          ]
        }
      ],
      "next": "0.6"
    },
    {
      "id": "0.6",
      "title": "秋收簿",
      "lines": [
        {
          "id": "ch0_0_6_l0",
          "speaker": "管事",
          "text": "丰收月到了。工资、口粮、士气，这个月结清。孩子也在这笔里。结不清，旗还是那块带着血的布。"
        },
        {
          "id": "ch0_0_6_l1",
          "speaker": "旁白",
          "text": "时间往前倾了一下。镜子里多一道风霜。旗上的颜色还在。侧翼的人还在。人老了，路没有断。"
        },
        {
          "id": "ch0_0_6_l2",
          "speaker": "旁白",
          "text": "这一年站住了。一仗，一个留下的人，一张席，一声哭。城埠认旗号，不认嗓门。认的是你们还彼此留着名。"

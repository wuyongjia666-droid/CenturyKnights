{
  "id": "ch0",
  "title": "第零章·灰旗初升",
  "legacy_index": 0,
  "return_scene": "res://scenes/story/chapter0.tscn",
  "beats": [
    {
      "id": "0.0",
      "title": "田埂与断旗",
      "lines": [
        {
          "id": "ch0_0_0_l0",
          "speaker": "旁白",
          "text": "石垒坡的麦还没黄。你把石担搁在田埂上，看陆桥那边的烟。没有爵，也没有一扇肯为你开的门。"
        },
        {
          "id": "ch0_0_0_l1",
          "speaker": "旁白",
          "text": "你吃得下更长的路。你要挣一个称呼，立一个家，让别人不得不念你的姓。"
        },
        {
          "id": "ch0_0_0_l2",
          "speaker": "石垒·晚担",
          "text": "你又在看烟。去年你说要挣一个称呼。我还在。旗可以以后再有，人我现在就跟。"
        },
        {
          "id": "ch0_0_0_l3",
          "speaker": "旁白",
          "text": "隘口外，旗杆断着。灰布被烟熏黑，还钉在半截杆上。风比村里的风硬。"
        },
        {
          "id": "ch0_0_0_l4",
          "speaker": "老旗手",
          "text": "姓和颜色，你来之前已经写下了。布认字。今夜之后，石垒坡出来的人要被叫做团长。"
        },
        {
          "id": "ch0_0_0_l5",
          "speaker": "石垒·晚担",
          "text": "我跟的是你。旗若散了，我还认得田埂上那个人。别为了姓把那个人弄丢。"
        },
        {
          "id": "ch0_0_0_l6",
          "speaker": "苇原·灯影",
          "text": "我跟着你不是为了姓。是为了隘口那条路还能走人。不过——姓也重要。没姓的旗，风一吹就散。"
        },
        {
          "id": "ch0_0_0_l7",
          "speaker": "老旗手",
          "text": "一个跟的是人，一个跟的是路。布都收下。破旗从这一夜认这个姓。"
        }
      ],
      "actions": [
        {
          "id": "enter_banner",
          "label": "让这个颜色落进旗心",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ],
      "next": "0.05"
    },
    {
      "id": "0.05",
      "title": "旗面初成",
      "lines": [
        {
          "id": "ch0_0_05_l0",
          "speaker": "旁白",
          "text": "纹章色落进旗心。老旗手的手在抖。他太久没见过一整块还肯认人的布。"
        },
        {
          "id": "ch0_0_05_l1",
          "speaker": "斥候",
          "text": "北隘起了烽。不是炊烟。有人卡在窄路上，堡里的粮撑不了几顿。"
        },
        {
          "id": "ch0_0_05_l2",
          "speaker": "苇原·灯影",
          "text": "窄路只够你选一个落点。我守侧翼。人挤成一堆，火会把名字烧成同一块。"
        },
        {
          "id": "ch0_0_05_l3",
          "speaker": "石垒·晚担",
          "text": "烽火要的是一个名字。打赢了，陆桥才肯停下来问你姓什么。"
        }
      ],
      "actions": [
        {
          "id": "to_pass",
          "label": "走向已经亮起的烽",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ],
      "next": "0.1"
    },
    {
      "id": "0.1",
      "title": "隘口烽火",
      "lines": [
        {
          "id": "ch0_0_1_l0",
          "speaker": "老旗手",
          "text": "烽已经亮了。这一仗打完，姓才算被人听见。"
        },
        {
          "id": "ch0_0_1_l1",
          "speaker": "苇原·灯影",
          "text": "出战。落点你来定。侧翼有我。"
        }
      ],
      "actions": [
        {
          "id": "after_smoke",
          "label": "听烟散之后",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ],
          "when": {
            "flag": "battle_done"
          }
        },
        {
          "id": "start_battle",
          "label": "走进隘口",
          "do": [
            {
              "op": "battle",
              "map": "ch0_pass",
              "objective": "rout",
              "return": "res://scenes/story/chapter0.tscn"
            }
          ],
          "when": {
            "not_flag": "battle_done"
          }
        },
        {
          "id": "retry_note",
          "label": "这一仗可以再打。旗还在。",
          "do": [],
          "when": {
            "not_flag": "battle_done"
          },
          "disabled": true
        }
      ],
      "next": "0.15"
    },
    {
      "id": "0.15",
      "title": "烟散之后",
      "lines": [
        {
          "id": "ch0_0_15_l0",
          "speaker": "旁白",
          "text": "匪倒下去的时候还有人往前爬。灯影的箭钉在他面前三寸的石头上。"
        },
        {
          "id": "ch0_0_15_l1",
          "speaker": "苇原·灯影",
          "text": "活口说，背后有人收过路银。不是普通抢粮。名字他不肯吐。"
        },
        {
          "id": "ch0_0_15_l2",
          "speaker": "石垒·晚担",
          "text": "你的手在抖。抖完，姓还在。石垒坡只会听说隘口。抖留在你掌心里。"
        },
        {
          "id": "ch0_0_15_l3",
          "speaker": "老旗手",
          "text": "银有了，人数不够。烽火酒馆的柜上挂着愿意卖这个月的人。"
        }
      ],
      "actions": [
        {
          "id": "to_tavern_beat",
          "label": "前往烽火酒馆",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ],
      "next": "0.2"
    },
    {
      "id": "0.2",
      "title": "酒馆聚人",
      "lines": [
        {
          "id": "ch0_0_2_l0",
          "speaker": "旁白",
          "text": "门轴一响，响的是想把自己这个月卖出去的嘴。"
        },
        {
          "id": "ch0_0_2_l1",
          "speaker": "掌柜",
          "text": "这里不赊命，只赊月饷。看脸，看这个人肯不肯在空席上坐到发饷那天。"
        },
        {
          "id": "ch0_0_2_l2",
          "speaker": "掌柜",
          "text": "陆桥上的人怕两件事：团长说话不算，旗丑到不敢认。你们的颜色已经在布上。"
        },
        {
          "id": "ch0_0_2_l3",
          "speaker": "掌柜",
          "text": "至少带走一个。看走眼，月饷会回来找你。人能不能共事，看他坐不坐得住。"
        },
        {
          "id": "ch0_0_2_l4",
          "speaker": "石垒·晚担",
          "text": "我已经在队里。柜上这个是陌生人。陌生人跟的是银，不是田埂上的你。"
        }
      ],
      "actions": [
        {
          "id": "sheathe",
          "label": "让陌生人站进队列",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ],
          "when": {
            "flag": "recruited"
          }
        },
        {
          "id": "open_tavern",
          "label": "进烽火酒馆，至少带一个人回来",
          "do": [
            {
              "op": "scene",
              "path": "res://scenes/hub/tavern.tscn"
            }
          ],
          "when": {
            "not_flag": "recruited"
          }
        }
      ],
      "next": "0.25"
    },
    {
      "id": "0.25",
      "title": "陌生人进列",
      "lines": [
        {
          "id": "ch0_0_25_l0",
          "speaker": "旁白",
          "text": "新人进了队列，先抬头看旗。旗稳，刀才肯稳。"
        },
        {
          "id": "ch0_0_25_l1",
          "speaker": "苇原·灯影",
          "text": "别急着把新人再送回隘口。先让他们看见堡里的灯。人要知道自己在替谁守夜。"
        },
        {
          "id": "ch0_0_25_l2",
          "speaker": "石垒·晚担",
          "text": "空房间比露宿强。可名册若只有认得的名字，这就还是一伙人，不是一个家。"
        },
        {
          "id": "ch0_0_25_l3",
          "speaker": "管事",
          "text": "灯可以亮了。先去看那本名册。"
        }
      ],
      "actions": [
        {
          "id": "enter_keep",
          "label": "入驻灰旗堡",
          "do": [
            {
              "op": "set_flag",
              "flag": "hub_open",
              "value": true
            },
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ],
      "next": "0.3"
    },
    {
      "id": "0.3",
      "title": "名册空席",
      "lines": [
        {
          "id": "ch0_0_3_l0",
          "speaker": "旁白",
          "text": "破堡亮起第一盏灯。光很小，柱上的旧刀痕却很清楚。前人在这里守过，也败过。"
        },
        {
          "id": "ch0_0_3_l1",
          "speaker": "管事",
          "text": "花名册翻开了。写上的人很少，空席很多。空席是还没人肯把命放进来。"
        },
        {
          "id": "ch0_0_3_l2",
          "speaker": "管事",
          "text": "今晚先看这本名册。伤和士气决定明天谁还能出门。"
        },
        {
          "id": "ch0_0_3_l3",
          "speaker": "石垒·晚担",
          "text": "你要的家，现在就是这些空椅子。椅子不会因为你想立家，就自己坐上人。"
        },
        {
          "id": "ch0_0_3_l4",
          "speaker": "苇原·灯影",
          "text": "坐满之前，隘口那条路还得有人走。"
        }
      ],
      "actions": [
        {
          "id": "open_hub",
          "label": "去看名册上的空席",
          "do": [
            {
              "op": "set_flag",
              "flag": "hub_open",
              "value": true
            },
            {
              "op": "set_beat",
              "chapter": 0,
              "beat": "0.35"
            },
            {
              "op": "scene",
              "path": "res://scenes/hub/castle_hub.tscn"
            }
          ]
        },
        {
          "id": "hear_bridge",
          "label": "先听陆桥耳语",
          "do": [
            {
              "op": "set_flag",
              "flag": "hub_open",
              "value": true
            },
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ],
      "next": "0.35"
    },
    {
      "id": "0.35",
      "title": "陆桥耳语",
      "lines": [
        {
          "id": "ch0_0_35_l0",
          "speaker": "旁白",
          "text": "夜里商队在远处敲锣。锣声里夹着闲话：隘口打赢了，旗是新的，团长还没成亲，也还没有爵。"
        },
        {
          "id": "ch0_0_35_l1",
          "speaker": "春令使者",
          "text": "春令将近。诸邦看旗，也看家。无家之旗，高门不收帖。这是试你能不能当一个家。"
        },
        {
          "id": "ch0_0_35_l2",
          "speaker": "苇原·灯影",
          "text": "别被百年吓住。先过完这一年。联姻是城门认不认这个姓，心可以以后再谈。"
        },
        {
          "id": "ch0_0_35_l3",
          "speaker": "石垒·晚担",
          "text": "你若喜欢谁，以后再说。他们今晚要试的，是这个姓扛不扛得住另一个人。"
        }
      ],
      "actions": [
        {
          "id": "to_spring",
          "label": "进入春令试婚",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        },
        {
          "id": "back_hub",
          "label": "先回灰旗堡",
          "do": [
            {
              "op": "scene",
              "path": "res://scenes/hub/castle_hub.tscn"
            }
          ]
        }
      ],
      "next": "0.4"
    },
    {
      "id": "0.4",
      "title": "春令试婚",
      "lines": [
        {
          "id": "ch0_0_4_l0",
          "speaker": "春令使者",
          "text": "春令到了。联姻看勋，也看诸邦肯不肯认你。声望不够，连门都不让进。"
        },
        {
          "id": "ch0_0_4_l1",
          "speaker": "春令使者",
          "text": "灰烬这边的门，我代你问过了。进门是试婚。人先入席，情爱不在这一季结算。"
        },
        {
          "id": "ch0_0_4_l2",
          "speaker": "春令使者",
          "text": "入席之前，把期望那一行自己念完。念不下去，就不要点头。孩子不来今夜。"
        },
        {
          "id": "ch0_0_4_l3",
          "speaker": "旁白",
          "text": "厅外有人比旗色。有人笑新旗太亮。亮，至少比把野心咽回石垒坡强。"
        }
      ],
      "actions": [
        {
          "id": "to_feast",
          "label": "赴双姓共席",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ],
          "when": {
            "flag": "married"
          }
        },
        {
          "id": "open_marriage",
          "label": "前往联姻廷",
          "do": [
            {
              "op": "scene",
              "path": "res://scenes/hub/marriage.tscn"
            }
          ],
          "when": {
            "not_flag": "married"
          }
        }
      ],
      "next": "0.45",
      "prepare": [
        {
          "op": "ensure_reputation",
          "when": {
            "not_flag": "married"
          },
          "realm": "ashland",
          "below": 30,
          "set": 35,
          "also_if_tier": "none",
          "log": "春令使者代请：灰烬邦声望升至友善"
        }
      ]
    },
    {
      "id": "0.45",
      "title": "双姓共席",
      "lines": [
        {
          "id": "ch0_0_45_l0",
          "speaker": "旁白",
          "text": "酒是薄的，誓是重的。老旗手把旗又升高一寸，像是怕风看不见。"
        },
        {
          "id": "ch0_0_45_l1",
          "speaker": "盟友亲属",
          "text": "我们把人托付给这面旗，不是托付给一夜的喜欢。请让孩子将来敢承认它。"
        },
        {
          "id": "ch0_0_45_l2",
          "speaker": "石垒·晚担",
          "text": "你没有把喜欢说出口。这样也好。喜欢若拿来当今晚的借口，这席就是空的。"
        },
        {
          "id": "ch0_0_45_l3",
          "speaker": "苇原·灯影",
          "text": "家有了。初啼还没到。族谱那一页还空着。你可以回堡，也可以在这里等。"
        }
      ],
      "actions": [
        {
          "id": "wait_birth",
          "label": "等待初啼",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ],
      "next": "0.5"
    },
    {
      "id": "0.5",
      "title": "初啼",
      "lines": [
        {
          "id": "ch0_0_5_l0",
          "speaker": "稳婆",
          "text": "旗下有了哭声。不好听。肺是孩子自己的，命也是。旗排在这声哭的后面。"
        },
        {
          "id": "ch0_0_5_l1",
          "speaker": "稳婆",
          "text": "去看那一页。以后的城门认这个孩子，认的是这一页，不是你的野心。"
        },
        {
          "id": "ch0_0_5_l2",
          "speaker": "旁白",
          "text": "你站在门外，先听见人，然后听见稳婆把你的姓念得很轻。"
        },
        {
          "id": "ch0_0_5_l3",
          "speaker": "石垒·晚担",
          "text": "石垒坡没有给这种哭声留座位。你要的家，从这一声开始算人数。"
        }
      ],
      "actions": [
        {
          "id": "open_page",
          "label": "翻开族谱新页",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ],
          "when": {
            "flag": "child_born"
          }
        },
        {
          "id": "advance_birth",
          "label": "让月份走到孩子落地",
          "do": [
            {
              "op": "advance",
              "months": 1
            }
          ],
          "when": {
            "not_flag": "child_born"
          }
        },
        {
          "id": "open_lineage",
          "label": "去看族谱上那一页",
          "do": [
            {
              "op": "scene",
              "path": "res://scenes/hub/lineage_view.tscn"
            }
          ],
          "when": {
            "not_flag": "child_born"
          }
        }
      ],
      "next": "0.55"
    },
    {
      "id": "0.55",
      "title": "族谱新页",
      "lines": [
        {
          "id": "ch0_0_55_l0",
          "speaker": "管事",
          "text": "族谱上新写了一行。墨干得很快。边境的风一向不客气。"
        },
        {
          "id": "ch0_0_55_l1",
          "speaker": "老旗手",
          "text": "孩子还上不了阵。有一天授旗会比任何胜仗都沉。今天还不是那天。"
        },
        {
          "id": "ch0_0_55_l2",
          "speaker": "苇原·灯影",
          "text": "丰收月快到了。粮饷簿不认眼泪，也不认初啼。"
        },
        {
          "id": "ch0_0_55_l3",
          "speaker": "石垒·晚担",
          "text": "看完那一页再去结账。账若结不清，刚才的哭声就只是又一个故事。"
        }
      ],
      "actions": [
        {
          "id": "to_harvest",
          "label": "去把粮饷结清",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        },
        {
          "id": "see_lineage",
          "label": "再看一眼族谱",
          "do": [
            {
              "op": "scene",
              "path": "res://scenes/hub/lineage_view.tscn"
            }
          ]
        }
      ],
      "next": "0.6"
    },
    {
      "id": "0.6",
      "title": "结清与上路",
      "lines": [
        {
          "id": "ch0_0_6_l0",
          "speaker": "管事",
          "text": "丰收月到了。工资、口粮、士气要结清。孩子也跟着吃。灯要是养得住，粮会多一点。"
        },
        {
          "id": "ch0_0_6_l1",
          "speaker": "旁白",
          "text": "沙漏一倾，你老了一岁。镜子里多一道风霜。旗上的颜色还没有褪。"
        },
        {
          "id": "ch0_0_6_l2",
          "speaker": "旁白",
          "text": "这一年把一个平民做成了一个姓。有战，有跟着的人，有试过的婚，有孩子，有一本结清的簿。"
        },
        {
          "id": "ch0_0_6_l3",
          "speaker": "石垒·晚担",
          "text": "饷清了。我跟的那个人还在。等城埠开始认旗号，你再开口也不迟。"
        },
        {
          "id": "ch0_0_6_l4",
          "speaker": "管事",

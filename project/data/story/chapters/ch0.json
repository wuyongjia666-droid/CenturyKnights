{
  "id": "ch0",
  "title": "第零章·那个字",
  "legacy_index": 0,
  "return_scene": "res://scenes/story/chapter0.tscn",
  "source": "docs/story/prologue-novella.md",
  "beats": [
    {
      "id": "0.0",
      "title": "麦未黄",
      "lines": [
        {
          "id": "ch0_0_0_l0",
          "speaker": "旁白",
          "text": "石垒坡的麦要到月底才黄。你把石担卸在田埂上，麻绳在肩上勒出两道暗红的沟。",
          "stage": {
            "music": "castle",
            "camera": "wide",
            "pace": "slow"
          }
        },
        {
          "id": "ch0_0_0_l1",
          "speaker": "旁白",
          "text": "东边是朔澜陆桥。北隘那个缺口上立着一根烟，细，直，风吹不弯。"
        },
        {
          "id": "ch0_0_0_l2",
          "speaker": "石垒·晚担",
          "text": "又在看烟。去年你说要挣一个称呼，说了三遍。第三遍你没看我，看的是桥。"
        },
        {
          "id": "ch0_0_0_l3",
          "speaker": "旁白",
          "text": "坡下，弟弟小粟赶着驴车往北走。车上是交给槐里家的粮，要过隘口那条窄路。"
        },
        {
          "id": "ch0_0_0_l4",
          "speaker": "石垒·荞娘",
          "text": "北边有槐里家的骑哨。是他们的路，他们会管。"
        },
        {
          "id": "ch0_0_0_l5",
          "speaker": "旁白",
          "text": "傍晚，烟变成了两根。小粟没有回来。",
          "stage": {
            "pace": "beat",
            "tension": 0.3
          }
        },
        {
          "id": "ch0_0_0_l6",
          "speaker": "老旗手",
          "text": "我找丰年的儿子。二十年前他给灰旗打过一个铁箍。杆断了，箍还在。",
          "stage": {
            "camera": "close"
          }
        },
        {
          "id": "ch0_0_0_l7",
          "speaker": "老旗手",
          "text": "窄路上有人卡着收过路银。灰旗名下有一张北隘护路契，二十年没人认。"
        },
        {
          "id": "ch0_0_0_l8",
          "speaker": "老旗手",
          "text": "今夜有人把这块布扛进隘口，契就活了。打输了，布就盖在扛布的人身上。"
        },
        {
          "id": "ch0_0_0_l9",
          "speaker": "石垒·荞娘",
          "text": "你要的那个字，你爹也想要过。他想要的时候已经有了你，他没去。",
          "expression": "sorrow"
        },
        {
          "id": "ch0_0_0_l10",
          "speaker": "石垒·荞娘",
          "text": "你去吧。把小粟带回来。"
        },
        {
          "id": "ch0_0_0_l11",
          "speaker": "旁白",
          "text": "坡顶的老槐树下，你在灰布上写下那个字。起笔太重，收笔有点歪。",
          "stage": {
            "camera": "banner",
            "pace": "slow"
          }
        },
        {
          "id": "ch0_0_0_l12",
          "speaker": "老旗手",
          "text": "姓和颜色，你已经写下了。布认字。今夜之后，石垒坡出来的人要被叫做团长。"
        },
        {
          "id": "ch0_0_0_l13",
          "speaker": "石垒·晚担",
          "text": "我跟的是你。旗若散了，我还认得田埂上那个人。别为了姓把那个人弄丢。"
        },
        {
          "id": "ch0_0_0_l14",
          "speaker": "旁白",
          "text": "槐树另一侧有人笑了一声。河卫打扮，背一张长弓，下巴上有护颈的晒痕。"
        },
        {
          "id": "ch0_0_0_l15",
          "speaker": "苇原·灯影",
          "text": "我跟着你不是为了姓。是为了隘口那条路还能走人。不过——姓也重要。没姓的旗，风一吹就散。"
        },
        {
          "id": "ch0_0_0_l16",
          "speaker": "老旗手",
          "text": "一个跟的是人，一个跟的是路。布都收下。"
        }
      ],
      "actions": [
        {
          "id": "enter_banner",
          "label": "让这个颜色落进旗心",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        },
        {
          "id": "guides_brief",
          "label": "（我玩过战棋：教学从简，可直接结算）",
          "do": [
            {
              "op": "set_flag",
              "flag": "pro_guides_brief",
              "value": true
            },
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ],
      "next": "0.05"
    },
    {
      "id": "0.05",
      "title": "旗面初成",
      "lines": [
        {
          "id": "ch0_0_05_l0",
          "speaker": "旁白",
          "text": "老旗手把颜色抹进旗心，用手掌压平。他的手在抖。",
          "stage": {
            "camera": "banner"
          }
        },
        {
          "id": "ch0_0_05_l1",
          "speaker": "石垒·晚担",
          "text": "你手抖什么？"
        },
        {
          "id": "ch0_0_05_l2",
          "speaker": "老旗手",
          "text": "太久了。太久没见过一整块还肯认人的布。"
        },
        {
          "id": "ch0_0_05_l3",
          "speaker": "老旗手",
          "text": "底是灰，是邦给的，谁都一样。旗心这一块是你。陆桥上的人先认这块颜色。"
        },
        {
          "id": "ch0_0_05_l4",
          "speaker": "老旗手",
          "text": "中间那道叫带，堡里有了功往上加。边上一圈叫缘，是堡的墙。这布跟堡走，不跟人走。"
        },
        {
          "id": "ch0_0_05_l5",
          "speaker": "老旗手",
          "text": "人会老，会嫁娶，会死。堡还在，布就还挂着，一年比一年重。",
          "stage": {
            "camera": "wide"
          }
        },
        {
          "id": "ch0_0_05_l6",
          "speaker": "斥候",
          "text": "北隘起了烽。不是炊烟。七辆车卡在窄路上，堡里的粮撑不了几顿。",
          "stage": {
            "tension": 0.5
          }
        },
        {
          "id": "ch0_0_05_l7",
          "speaker": "苇原·灯影",
          "text": "窄路只够你选一个落点。我守侧翼。人挤成一堆，火会把名字烧成同一块。"
        },
        {
          "id": "ch0_0_05_l8",
          "speaker": "石垒·晚担",
          "text": "烽火要的是一个名字。打赢了，陆桥才肯停下来问你姓什么。"
        }
      ],
      "actions": [
        {
          "id": "to_pass",
          "label": "走向已经亮起的烽",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ],
      "next": "0.1"
    },
    {
      "id": "0.1",
      "title": "窄路",
      "lines": [
        {
          "id": "ch0_0_1_l0",
          "speaker": "旁白",
          "text": "窄路两边是湿石壁，只容两辆车。卡路的人把粮袋垒成墙，在墙后生火。",
          "stage": {
            "music": "tension",
            "tension": 0.6
          }
        },
        {
          "id": "ch0_0_1_l1",
          "speaker": "苇原·灯影",
          "text": "先选落点。选了就站住，别追。追出第二辆车，就是他们的地形了。"
        },
        {
          "id": "ch0_0_1_l2",
          "speaker": "苇原·灯影",
          "text": "上面那块岩台归我。有弓，我先压弓。你们往前推，推到第二辆车就停。"
        },
        {
          "id": "ch0_0_1_l3",
          "speaker": "石垒·晚担",
          "text": "小粟在第二辆车后面。别急。你急了，他也跟着急。"
        },
        {
          "id": "ch0_0_1_l4",
          "speaker": "老旗手",
          "text": "烽已经亮了。这一仗打完，姓才算被人听见。"
        }
      ],
      "actions": [
        {
          "id": "after_smoke",
          "label": "听烟散之后",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ],
          "when": {
            "flag": "battle_done"
          }
        },
        {
          "id": "start_battle",
          "label": "走进隘口",
          "do": [
            {
              "op": "battle",
              "map": "ch0_pass",
              "objective": "rout",
              "return": "res://scenes/story/chapter0.tscn"
            }
          ],
          "when": {
            "not_flag": "battle_done"
          }
        },
        {
          "id": "skip_battle",
          "label": "（教学从简）这一仗按胜记，直接听烟散",
          "do": [
            {
              "op": "skip_battle"
            },
            {
              "op": "goto",
              "beat": "next"
            }
          ],
          "when": {
            "all": [
              {
                "flag": "pro_guides_brief"
              },
              {
                "not_flag": "battle_done"
              }
            ]
          }
        },
        {
          "id": "retry_note",
          "label": "这一仗可以再打。旗还在。",
          "do": [],
          "when": {
            "not_flag": "battle_done"
          },
          "disabled": true
        }
      ],
      "next": "0.15"
    },
    {
      "id": "0.15",
      "title": "烟散之后",
      "lines": [
        {
          "id": "ch0_0_15_l0",
          "speaker": "旁白",
          "text": "烟散了。有人还在往前爬。灯影的箭钉在他面前三寸的石头上，箭尾还在颤。",
          "stage": {
            "music": "castle",
            "tension": 0.2,
            "camera": "close"
          }
        },
        {
          "id": "ch0_0_15_l1",
          "speaker": "旁白",
          "text": "第二辆车后面，小粟抱着驴的脖子。驴在抖，他也在抖。"
        },
        {
          "id": "ch0_0_15_l2",
          "speaker": "苇原·灯影",
          "text": "活口说，背后有人收过路银。不是普通抢粮。名字他不肯吐。"
        },
        {
          "id": "ch0_0_15_l3",
          "speaker": "石垒·晚担",
          "text": "你的手在抖。抖完，姓还在。石垒坡只会听说隘口。抖留在你掌心里。"
        },
        {
          "id": "ch0_0_15_l4",
          "speaker": "苇原·灯影",
          "text": "你可以把他交给哨堡，也可以让他跟着粮车走。"
        },
        {
          "id": "ch0_0_15_l5",
          "speaker": "苇原·灯影",
          "text": "交给哨堡，他大概活不过这个月。留着他，他就吃我们的粮。"
        }
      ],
      "actions": [
        {
          "id": "keep_survivor",
          "label": "让他跟着粮车走。他见过收银的人，我没有",
          "do": [
            {
              "op": "set_flag",
              "flag": "pro_survivor_kept",
              "value": true
            },
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        },
        {
          "id": "hand_survivor",
          "label": "把他交给哨堡，按规矩办",
          "do": [
            {
              "op": "set_flag",
              "flag": "pro_survivor_handed",
              "value": true
            },
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ],
      "next": "0.17"
    },
    {
      "id": "0.17",
      "title": "功劳簿",
      "lines": [
        {
          "id": "ch0_0_17_l0",
          "speaker": "旁白",
          "text": "第二天中午，哨堡的人来了。马车窗上嵌着磨砂玻璃，玻璃后挂着一盏霜灯。",
          "stage": {
            "pace": "beat"
          }
        },
        {
          "id": "ch0_0_17_l1",
          "speaker": "鸦渡·衡舟",
          "text": "灰旗？我以为这东西早烂了。"
        },
        {
          "id": "ch0_0_17_l2",
          "speaker": "槐里·景伯",
          "text": "我认得这块布。我年轻的时候，它还是一整面。你是丰年的儿子。"
        },
        {
          "id": "ch0_0_17_l3",
          "speaker": "槐里·景伯",
          "text": "北隘烽起，槐里家骑哨统领衡舟率众击退流匪，救回粮车七辆。簿子上这么写。"
        },
        {
          "id": "ch0_0_17_l4",
          "speaker": "石垒·晚担",
          "text": "骑哨在哨堡里，一夜没出来。",
          "expression": "anger"
        },
        {
          "id": "ch0_0_17_l5",
          "speaker": "槐里·景伯",
          "text": "我知道是谁打的。这本簿子不是写给我看的，是写给白垣议会看的。"
        },
        {
          "id": "ch0_0_17_l6",
          "speaker": "槐里·景伯",
          "text": "我孙女青禾脖子上有河图，不亮。立一场当众的功，议会唱了票，才算点亮。"
        },
        {
          "id": "ch0_0_17_l7",
          "speaker": "槐里·景伯",
          "text": "这一仗记在她名下。灰旗堡的地契送你，这一季的饷我出。你要的不就是这些？"
        },
        {
          "id": "ch0_0_17_l8",
          "speaker": "槐里·青禾",
          "text": "记在我名下，脖子上还是一样，只是簿子上多一行。我不要一盏借来的灯。",
          "stage": {
            "camera": "close"
          }
        },
        {
          "id": "ch0_0_17_l9",
          "speaker": "槐里·景伯",
          "text": "青禾。借来的灯也是灯。没有灯的人，在白垣连门都进不去。"
        },
        {
          "id": "ch0_0_17_l10",
          "speaker": "苇原·灯影",
          "text": "衡舟经过空车时看了活口一眼。活口也看着他。他们认识。",
          "when": {
            "flag": "pro_survivor_kept"
          }
        },
        {
          "id": "ch0_0_17_l11",
          "speaker": "苇原·灯影",
          "text": "活口被骑哨押走时没挣。押他的人，像是早就认得他。",
          "when": {
            "flag": "pro_survivor_handed"
          }
        }
      ],
      "actions": [
        {
          "id": "merit_own",
          "label": "不换。仗是灰旗打的，簿子上写什么我管不着",
          "do": [
            {
              "op": "set_flag",
              "flag": "pro_merit_own",
              "value": true
            },
            {
              "op": "adjust",
              "reputation": {
                "ashland": 5
              },
              "log": "隘口之功不让：陆桥商队开始传灰旗的名"
            },
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        },
        {
          "id": "merit_patron",
          "label": "收下地契和饷银，让这一仗记在槐里家",
          "do": [
            {
              "op": "set_flag",
              "flag": "pro_merit_patron",
              "value": true
            },
            {
              "op": "adjust",
              "silver": 80,
              "log": "槐里家送来地契与一季饷银（+80 银）"
            },
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ],
      "next": "0.18"
    },
    {
      "id": "0.18",
      "title": "押契",
      "when": {
        "flag": "pro_merit_own"
      },
      "lines": [
        {
          "id": "ch0_0_18_l0",
          "speaker": "旁白",
          "text": "不收地契，就没有饷银。你在陆桥驿外的石阶上数碎银，数了三遍。"
        },
        {
          "id": "ch0_0_18_l1",
          "speaker": "石垒·晚担",
          "text": "人不够。四个人守不了一个堡，也护不了一条路。"
        },
        {
          "id": "ch0_0_18_l2",
          "speaker": "旁白",
          "text": "傍晚，娘从石垒坡走来，鞋底磨薄了。她从布包最里层拿出一张折了四折的纸。",
          "stage": {
            "pace": "slow"
          }
        },
        {
          "id": "ch0_0_18_l3",
          "speaker": "石垒·荞娘",
          "text": "采石坡那块的租契。你爹拿命换的，换来一行小字。押出去，能换三个月的饷。"
        },
        {
          "id": "ch0_0_18_l4",
          "speaker": "石垒·荞娘",
          "text": "赎不回来就不赎。我老了，不想再看那行小字。",
          "expression": "sorrow"
        }
      ],
      "actions": [
        {
          "id": "pawn_lease",
          "label": "收下租契，押给账房",
          "do": [
            {
              "op": "set_flag",
              "flag": "pro_lease_pawned",
              "value": true
            },
            {
              "op": "adjust",
              "silver": 90,
              "log": "押出采石坡租契（+90 银）"
            },
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        },
        {
          "id": "keep_lease",
          "label": "把契还给娘。饷我去委托板上挣",
          "do": [
            {
              "op": "set_flag",
              "flag": "pro_lease_kept",
              "value": true
            },
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ],
      "next": "0.2"
    },
    {
      "id": "0.2",
      "title": "烽火酒馆",
      "lines": [
        {
          "id": "ch0_0_2_l0",
          "speaker": "旁白",
          "text": "烽火酒馆的门轴一响，响的是想把自己这个月卖出去的嘴。",
          "stage": {
            "music": "hub"
          }
        },
        {
          "id": "ch0_0_2_l1",
          "speaker": "掌柜",
          "text": "隘口那一仗，有人说是槐里家打的，有人说是一面破旗打的。我不管是谁打的。"
        },
        {
          "id": "ch0_0_2_l2",
          "speaker": "掌柜",
          "text": "这里不赊命，只赊月饷。看脸，看这个人肯不肯在空席上坐到发饷那天。"
        },
        {
          "id": "ch0_0_2_l3",
          "speaker": "掌柜",
          "text": "至少带走一个。看走眼，月饷会回来找你。每到发饷那天，堡里的银就少一截。"
        },
        {
          "id": "ch0_0_2_l4",
          "speaker": "石垒·晚担",
          "text": "我已经在队里。柜上这个是陌生人。陌生人跟的是银，不是田埂上的你。"
        },
        {
          "id": "ch0_0_2_l5",
          "speaker": "苇原·灯影",
          "text": "槐里家的银在你袋里。花的时候记着，那一仗也在他们簿子上。",
          "when": {
            "flag": "pro_merit_patron"
          }
        },
        {
          "id": "ch0_0_2_l6",
          "speaker": "苇原·灯影",
          "text": "你娘的契换的银。挑人别挑贵的，挑坐得住的。",
          "when": {
            "flag": "pro_lease_pawned"
          }
        },
        {
          "id": "ch0_0_2_l7",
          "speaker": "苇原·灯影",
          "text": "银只够一个人。挑一个肯早点告诉你走不走的人。",
          "when": {
            "flag": "pro_lease_kept"
          }
        }
      ],
      "actions": [
        {
          "id": "sheathe",
          "label": "让陌生人站进队列",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ],
          "when": {
            "flag": "recruited"
          }
        },
        {
          "id": "open_tavern",
          "label": "进烽火酒馆，至少带一个人回来",
          "do": [
            {
              "op": "scene",
              "path": "res://scenes/hub/tavern.tscn"
            }
          ],
          "when": {
            "not_flag": "recruited"
          }
        },
        {
          "id": "auto_recruit",
          "label": "（教学从简）按银挑一个，直接进列",
          "do": [
            {
              "op": "auto_recruit"
            },
            {
              "op": "goto",
              "beat": "next"
            }
          ],
          "when": {
            "all": [
              {
                "flag": "pro_guides_brief"
              },
              {
                "not_flag": "recruited"
              }
            ]
          }
        }
      ],
      "next": "0.25"
    },
    {
      "id": "0.25",
      "title": "陌生人进列",
      "lines": [
        {
          "id": "ch0_0_25_l0",
          "speaker": "旁白",
          "text": "有人进门先看旗，有人先看账。先看账的那个，翻开一页给你看。"
        },
        {
          "id": "ch0_0_25_l1",
          "speaker": "旁白",
          "text": "那一页记着上一个雇主的饷。最后三个月，发饷的日子画着空圈。"
        },
        {
          "id": "ch0_0_25_l2",
          "speaker": "苇原·灯影",
          "text": "跟银的人不坏。月饷按日子给，他们比谁都坐得住。晚一天，就当你是上一个。"
        },
        {
          "id": "ch0_0_25_l3",
          "speaker": "石垒·晚担",
          "text": "空房间比露宿强。可名册若只有认得的名字，这就还是一伙人，不是一个家。"
        },
        {
          "id": "ch0_0_25_l4",
          "speaker": "管事",
          "text": "灯可以亮了。先去看那本名册。"
        }
      ],
      "actions": [
        {
          "id": "enter_keep",
          "label": "入驻灰旗堡",
          "do": [
            {
              "op": "set_flag",
              "flag": "hub_open",
              "value": true
            },
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ],
      "next": "0.3"
    },
    {
      "id": "0.3",
      "title": "名册空席",
      "lines": [
        {
          "id": "ch0_0_3_l0",
          "speaker": "旁白",
          "text": "破堡亮起第一盏灯。光很小，柱上的旧刀痕却很清楚。前人在这里守过，也败过。",
          "stage": {
            "music": "castle",
            "pace": "slow"
          }
        },
        {
          "id": "ch0_0_3_l1",
          "speaker": "管事",
          "text": "花名册翻开了。写上的人很少，空席很多。空席是还没人肯把命放进来。"
        },
        {
          "id": "ch0_0_3_l2",
          "speaker": "石垒·晚担",
          "text": "你要的家，现在就是这些空椅子。椅子不会因为你想立家，就自己坐上人。"
        },
        {
          "id": "ch0_0_3_l3",
          "speaker": "老旗手",
          "text": "第一行，我求你一件事。空着，留给灰旗以前的人。北隘那夜的人，我记不全。",
          "expression": "sorrow",
          "stage": {
            "camera": "close"
          }
        }
      ],
      "actions": [
        {
          "id": "roster_wantan",
          "label": "第一行写石垒·晚担。旧人写在封二，比第一行还前",
          "do": [
            {
              "op": "set_flag",
              "flag": "pro_roster_wantan",
              "value": true
            },
            {
              "op": "set_flag",
              "flag": "hub_open",
              "value": true
            },
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        },
        {
          "id": "roster_blank",
          "label": "第一行空着，留给灰旗旧人",
          "do": [
            {
              "op": "set_flag",
              "flag": "pro_roster_blank",
              "value": true
            },
            {
              "op": "set_flag",
              "flag": "hub_open",
              "value": true
            },
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ],
      "next": "0.32"
    },
    {
      "id": "0.32",
      "title": "门楼上的纸",
      "lines": [
        {
          "id": "ch0_0_32_l0",
          "speaker": "老旗手",
          "text": "册子是活人用的。你说得对。旧人在最前面，我看得见。",
          "when": {
            "flag": "pro_roster_wantan"
          }
        },
        {
          "id": "ch0_0_32_l1",
          "speaker": "旁白",
          "text": "晚担走过来，伸出那只虎口裂开的手，在自己的名字上按了一下。",
          "when": {
            "flag": "pro_roster_wantan"
          }
        },
        {
          "id": "ch0_0_32_l2",
          "speaker": "老旗手",
          "text": "空着一行，就当他们都在。",
          "when": {
            "flag": "pro_roster_blank"
          }
        },
        {
          "id": "ch0_0_32_l3",
          "speaker": "石垒·晚担",
          "text": "第二行也行。我跟的是人，不是行数。",
          "when": {
            "flag": "pro_roster_blank"
          }
        },
        {
          "id": "ch0_0_32_l4",
          "speaker": "管事",
          "text": "门楼木板墙上钉着委托。找羊，找人，护货，清狼窝，修路。每张下面写着酬金。"
        },
        {
          "id": "ch0_0_32_l5",
          "speaker": "管事",
          "text": "灰旗在的时候，这块板子比堡门还重要。堡里的饷，一半是从这上面揭下来的。"
        },
        {
          "id": "ch0_0_32_l6",
          "speaker": "管事",
          "text": "这块板子不会让你出名。它让你活到出名那一天。"
        },
        {
          "id": "ch0_0_32_l7",
          "speaker": "苇原·灯影",
          "text": "你没押你娘的契。那这块板子，就是你娘的契。",
          "when": {
            "flag": "pro_lease_kept"
          }
        }
      ],
      "actions": [
        {
          "id": "open_quests",
          "label": "去门楼看委托板",
          "do": [
            {
              "op": "visit",
              "path": "res://scenes/hub/quests.tscn"
            }
          ]
        },
        {
          "id": "take_escort",
          "label": "揭一张陆桥驿的护送，先看路",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        },
        {
          "id": "open_hub",
          "label": "去看名册上的空席",
          "do": [
            {
              "op": "set_flag",
              "flag": "hub_open",
              "value": true
            },
            {
              "op": "scene",
              "path": "res://scenes/hub/castle_hub.tscn"
            }
          ]
        }
      ],
      "next": "0.33"
    },
    {
      "id": "0.33",
      "title": "舆图",
      "lines": [
        {
          "id": "ch0_0_33_l0",
          "speaker": "旁白",
          "text": "那晚老旗手在大厅里铺开一张旧舆图，边缘已经脆了，四角压着镇纸。",
          "stage": {
            "music": "atlas",
            "camera": "wide"
          }
        },
        {
          "id": "ch0_0_33_l1",
          "speaker": "老旗手",
          "text": "这是灰烬，这是陆桥。桥东是灯市、霜冕、星津，桥西是朔影、清河。"
        },
        {
          "id": "ch0_0_33_l2",
          "speaker": "老旗手",
          "text": "十个国，十种认人的办法。每一种都觉得自己对，都在等一面旗过去替它说话。"
        },
        {
          "id": "ch0_0_33_l3",
          "speaker": "老旗手",
          "text": "路是连着的。你护住一段，就有人请你护下一段。那个字会走得比你远。"
        },
        {
          "id": "ch0_0_33_l4",
          "speaker": "苇原·灯影",
          "text": "桥上的路看着近，每一段都要交钱、都要等。日子按驿站算，不按眼睛算。"
        },
        {
          "id": "ch0_0_33_l5",
          "speaker": "石垒·晚担",
          "text": "粮带少了，回程就饿着走。我小时候以为石垒坡就是全天下。"
        }
      ],
      "actions": [
        {
          "id": "open_atlas",
          "label": "摊开舆图，走一趟陆桥驿",
          "do": [
            {
              "op": "visit",
              "path": "res://scenes/hub/atlas_view.tscn"
            }
          ]
        },
        {
          "id": "hear_bridge",
          "label": "先听陆桥耳语",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ],
      "next": "0.35"
    },
    {
      "id": "0.35",
      "title": "陆桥耳语",
      "lines": [
        {
          "id": "ch0_0_35_l0",
          "speaker": "旁白",
          "text": "西桥头堡的税吏在收据抬头写下「{surname}」。写对了。你把收据折好，贴身放着。",
          "stage": {
            "pace": "beat"
          }
        },
        {
          "id": "ch0_0_35_l1",
          "speaker": "旁白",
          "text": "夜里商队在远处敲锣。锣声里夹着闲话：隘口打赢了，旗是新的，团长还没成亲。"
        },
        {
          "id": "ch0_0_35_l2",
          "speaker": "春令使者",
          "text": "春令将近。诸邦看旗，也看家。无家之旗，高门不收帖。"
        },
        {
          "id": "ch0_0_35_l3",
          "speaker": "鸦渡·衡舟",
          "text": "春令的帖，我也有一张。我在槐里家马棚睡了三年，换一个村名錾在铜牌上。",
          "stage": {
            "camera": "close"
          }
        },
        {
          "id": "ch0_0_35_l4",
          "speaker": "鸦渡·衡舟",
          "text": "你一夜就有了。一块破布，一截断杆，一个老头子。"
        },
        {
          "id": "ch0_0_35_l5",
          "speaker": "鸦渡·衡舟",
          "text": "春令那天，你有证据就拿出来。拿出来我就完了，不拿你就完了。"
        },
        {
          "id": "ch0_0_35_l6",
          "speaker": "鸦渡·衡舟",
          "text": "我们两个没有姓的人，只能活一个。桥上只记得一个。",
          "stage": {
            "tension": 0.4
          }
        },
        {
          "id": "ch0_0_35_l7",
          "speaker": "槐里·青禾",
          "text": "祖父想让我嫁他。功是衡舟的，衡舟是槐里家的，那一仗就名正言顺了。"
        },
        {
          "id": "ch0_0_35_l8",
          "speaker": "槐里·青禾",
          "text": "我想让河图自己亮，或者不亮。借来的灯，我的孩子也得接着借。"
        },
        {
          "id": "ch0_0_35_l9",
          "speaker": "石垒·晚担",
          "text": "他说错了一件事。哪一件，得你自己去找。"
        }
      ],
      "actions": [
        {
          "id": "to_spring",
          "label": "去春令那张桌子",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        },
        {
          "id": "back_hub",
          "label": "先回灰旗堡",
          "do": [
            {
              "op": "scene",
              "path": "res://scenes/hub/castle_hub.tscn"
            }
          ]
        }
      ],
      "next": "0.38"
    },
    {
      "id": "0.38",
      "title": "香盏",
      "lines": [
        {
          "id": "ch0_0_38_l0",
          "speaker": "旁白",
          "text": "春令那天，大厅长桌两边坐了三家。桌中间放着一只空的玻璃香盏。",
          "stage": {
            "music": "tension",
            "tension": 0.7,
            "pace": "slow"
          }
        },
        {
          "id": "ch0_0_38_l1",
          "speaker": "鸦渡·衡舟",
          "text": "灰旗的帖我有异议。隘口是槐里骑哨打的。灰旗不过是碰巧在那里的流民。"
        },
        {
          "id": "ch0_0_38_l2",
          "speaker": "活口",
          "text": "过路银交到哨堡后面的马棚。收银的人骑灰马，三成留哨堡，剩下的往东送。",
          "when": {
            "flag": "pro_survivor_kept"
          }
        },
        {
          "id": "ch0_0_38_l3",
          "speaker": "活口",
          "text": "东边的人我没见过，只见过他们的签，签上有半个环。灰马是他的。",
          "when": {
            "flag": "pro_survivor_kept"
          }
        },
        {
          "id": "ch0_0_38_l4",
          "speaker": "苇原·灯影",
          "text": "活口押进哨堡第三天就死了。我只留下他靴筒里这支签，签上有半个环。",
          "when": {
            "flag": "pro_survivor_handed"
          }
        },
        {
          "id": "ch0_0_38_l5",
          "speaker": "苇原·灯影",
          "text": "签是从哨堡后面的马棚流出来的。那里只拴着一匹灰马。",
          "when": {
            "flag": "pro_survivor_handed"
          }
        },
        {
          "id": "ch0_0_38_l6",
          "speaker": "旁白",
          "text": "衡舟的手按在了刀上。没有人动。景伯慢慢把手从玻璃帖上拿开了。",
          "stage": {
            "camera": "shake"
          }
        },
        {
          "id": "ch0_0_38_l7",
          "speaker": "石垒·晚担",
          "text": "别为了姓把那个人弄丢。我说的不只是你。"
        }
      ],
      "actions": [
        {
          "id": "expose_rival",
          "label": "当众请使者带走衡舟，让陆桥都听见",
          "do": [
            {
              "op": "set_flag",
              "flag": "pro_rival_exposed",
              "value": true
            },
            {
              "op": "adjust",
              "reputation": {
                "ashland": 10
              },
              "log": "春令席上揭出过路银：灰旗之名传遍陆桥"
            },
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        },
        {
          "id": "spare_rival",
          "label": "过路银写进护路呈报。桌上只说灰旗的事，给衡舟留一行",
          "do": [
            {
              "op": "set_flag",
              "flag": "pro_rival_spared",
              "value": true
            },
            {
              "op": "adjust",
              "morale": 5,
              "log": "春令席上留了余地：名册末行空着一席"
            },
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ],
      "next": "0.39"
    },
    {
      "id": "0.39",
      "title": "身后站着谁",
      "lines": [
        {
          "id": "ch0_0_39_l0",
          "speaker": "旁白",
          "text": "使者的人带走了衡舟。门口，老旗手没有让路，断杆的影子落在他背上。",
          "when": {
            "flag": "pro_rival_exposed"
          }
        },
        {
          "id": "ch0_0_39_l1",
          "speaker": "槐里·青禾",
          "text": "祖父一句话没说。陆桥明天会念你的姓，念得很响。也会念槐里家。",
          "when": {
            "flag": "pro_rival_exposed"
          }
        },
        {
          "id": "ch0_0_39_l2",
          "speaker": "旁白",
          "text": "你叫住要走的衡舟：名册还有空席，从最后一行写起。他没有回头。",
          "when": {
            "flag": "pro_rival_spared"
          }
        },
        {
          "id": "ch0_0_39_l3",
          "speaker": "槐里·青禾",
          "text": "你本可以让陆桥念得更响。祖父看见了。他会记得这一桌是谁留了余地。",
          "when": {
            "flag": "pro_rival_spared"
          }
        },
        {
          "id": "ch0_0_39_l4",
          "speaker": "旁白",
          "text": "你把手按在香盏的玻璃上。玻璃是凉的。旗誓是站着说的。",
          "stage": {
            "music": "dynasty:inheritance",
            "camera": "close",
            "pace": "slow"
          }
        },
        {
          "id": "ch0_0_39_l5",
          "speaker": "老旗手",
          "text": "说吧。说你身后站着谁。"
        },
        {
          "id": "ch0_0_39_l6",
          "speaker": "旁白",
          "text": "名册第一行，跟银的人，为路留下的人，扛杆的人。堡是租的，饷撑不了几个月。",
          "when": {
            "not_flag": "pro_merit_patron"
          }
        },
        {
          "id": "ch0_0_39_l7",
          "speaker": "旁白",
          "text": "名册第一行，跟银的人，为路留下的人，扛杆的人。地契是槐里家给的，那一仗在别人簿子上。",
          "when": {
            "flag": "pro_merit_patron"
          }
        },
        {
          "id": "ch0_0_39_l8",
          "speaker": "旁白",
          "text": "你要一个划不掉的字。今天你知道了：字划得掉。划不掉的，是写字时身后站着谁。"
        },
        {
          "id": "ch0_0_39_l9",
          "speaker": "春令使者",
          "text": "春令认了。灰烬这边的门，开到能递帖。"
        }
      ],
      "actions": [
        {
          "id": "to_seat",
          "label": "入席",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ],
      "next": "0.4"
    },
    {
      "id": "0.4",
      "title": "春令试婚",
      "prepare": [
        {
          "op": "ensure_reputation",
          "when": {
            "not_flag": "married"
          },
          "realm": "ashland",
          "below": 30,
          "set": 35,
          "also_if_tier": "none",
          "log": "春令使者代请：灰烬邦声望升至友善"
        }
      ],
      "lines": [
        {
          "id": "ch0_0_4_l0",
          "speaker": "春令使者",
          "text": "隘口一仗，槐里家的呈报议会收了。旗帅的名字不在上面。",
          "when": {
            "flag": "pro_merit_patron"
          }
        },
        {
          "id": "ch0_0_4_l1",
          "speaker": "春令使者",
          "text": "隘口一仗，议会收到两份呈报：槐里家一份，商队联名一份。还没唱票。",
          "when": {
            "flag": "pro_merit_own"
          }
        },
        {
          "id": "ch0_0_4_l2",
          "speaker": "春令使者",
          "text": "灰烬这边的门，我代你问过了。进门是试婚。人先入席，情爱不在这一季结算。"
        },
        {
          "id": "ch0_0_4_l3",
          "speaker": "春令使者",
          "text": "入席之前，把期望那一行自己念完。念不下去，就不要点头。孩子不来今夜。"
        },
        {
          "id": "ch0_0_4_l4",
          "speaker": "槐里·青禾",
          "text": "入谁的席，是你在联姻廷里定。我只求一件事：别把谁的河图写成借来的。"
        },
        {
          "id": "ch0_0_4_l5",
          "speaker": "苇原·灯影",
          "text": "别被百年吓住。先过完这一年。联姻是城门认不认这个姓，心可以以后再谈。"
        }
      ],
      "actions": [
        {
          "id": "to_feast",
          "label": "赴双姓共席",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ],
          "when": {
            "flag": "married"
          }
        },
        {
          "id": "open_marriage",
          "label": "前往联姻廷",
          "do": [
            {
              "op": "scene",
              "path": "res://scenes/hub/marriage.tscn"
            }
          ],
          "when": {
            "not_flag": "married"
          }
        },
        {
          "id": "auto_marry",
          "label": "（教学从简）请使者择一席，直接入席",
          "do": [
            {
              "op": "auto_marry"
            },
            {
              "op": "goto",
              "beat": "0.4"
            }
          ],
          "when": {
            "all": [
              {
                "flag": "pro_guides_brief"
              },
              {
                "not_flag": "married"
              }
            ]
          }
        }
      ],
      "next": "0.45"
    },
    {
      "id": "0.45",
      "title": "双姓共席",
      "lines": [
        {
          "id": "ch0_0_45_l0",
          "speaker": "旁白",
          "text": "酒是薄的，誓是重的。老旗手把旗又升高一寸，像是怕风看不见。",
          "stage": {
            "music": "dynasty:marriage"
          }
        },
        {
          "id": "ch0_0_45_l1",
          "speaker": "盟友亲属",
          "text": "我们把人托付给这面旗，不是托付给一夜的喜欢。请让孩子将来敢承认它。"
        },
        {
          "id": "ch0_0_45_l2",
          "speaker": "石垒·晚担",
          "text": "你没有把喜欢说出口。这样也好。喜欢若拿来当今晚的借口，这席就是空的。"
        },
        {
          "id": "ch0_0_45_l3",
          "speaker": "苇原·灯影",
          "text": "我只会在一种条件下成婚：对方在名册上留着我的姓。我的姓被涂过一次。"
        },
        {
          "id": "ch0_0_45_l4",
          "speaker": "苇原·灯影",
          "text": "家有了。初啼还没到。族谱那一页还空着。孩子不按你的日子来。"
        }
      ],
      "actions": [
        {
          "id": "wait_birth",
          "label": "等待初啼",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ],
      "next": "0.5"
    },
    {
      "id": "0.5",
      "title": "月份",
      "lines": [
        {
          "id": "ch0_0_5_l0",
          "speaker": "旁白",
          "text": "席散以后，日子照常走。灰旗揭委托板上的纸，护陆桥驿的路，发饷。",
          "stage": {
            "music": "castle"
          }
        },
        {
          "id": "ch0_0_5_l1",
          "speaker": "管事",
          "text": "孩子要等的月份，一个都省不了。每过一个月，饷照发，粮照吃。"
        },
        {
          "id": "ch0_0_5_l2",
          "speaker": "石垒·晚担",
          "text": "小粟来过两回，送粮，送你娘做的鞋。他长高了，不用再抱驴脖子。"
        }
      ],
      "actions": [
        {
          "id": "advance_birth",
          "label": "让月份走到孩子落地",
          "do": [
            {
              "op": "advance",
              "until_flag": "child_born",
              "max": 14
            }
          ],
          "when": {
            "not_flag": "child_born"
          }
        },
        {
          "id": "open_page",
          "label": "去听那一声哭",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ],
          "when": {
            "flag": "child_born"
          }
        }
      ],
      "next": "0.55"
    },
    {
      "id": "0.55",
      "title": "初啼",
      "lines": [
        {
          "id": "ch0_0_55_l0",
          "speaker": "稳婆",
          "text": "旗下有了哭声。不好听。肺是孩子自己的，命也是。旗排在这声哭的后面。",
          "stage": {
            "music": "dynasty:birth",
            "pace": "slow"
          }
        },
        {
          "id": "ch0_0_55_l1",
          "speaker": "旁白",
          "text": "稳婆在门里叫了你一声。叫的是「{surname}」。这是第一次有人这样叫你。"
        },
        {
          "id": "ch0_0_55_l2",
          "speaker": "石垒·晚担",
          "text": "石垒坡没有给这种哭声留座位。你要的家，从这一声开始算人数。"
        },
        {
          "id": "ch0_0_55_l3",
          "speaker": "稳婆",
          "text": "去看那一页。以后的城门认这个孩子，认的是这一页，不是你的野心。"
        },
        {
          "id": "ch0_0_55_l4",
          "speaker": "管事",
          "text": "族谱上新写了一行。墨干得很快。边境的风一向不客气。"
        },
        {
          "id": "ch0_0_55_l5",
          "speaker": "老旗手",
          "text": "孩子还上不了阵。有一天授旗会比任何胜仗都沉。今天还不是那天。"
        }
      ],
      "actions": [
        {
          "id": "see_lineage",
          "label": "去看族谱上那一页",
          "do": [
            {
              "op": "scene",
              "path": "res://scenes/hub/lineage_view.tscn"
            }
          ]
        },
        {
          "id": "to_harvest",
          "label": "去把粮饷结清",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ],
      "next": "0.6"
    },
    {
      "id": "0.6",
      "title": "结清与上路",
      "lines": [
        {
          "id": "ch0_0_6_l0",
          "speaker": "管事",
          "text": "丰收月到了。工资、口粮、士气要结清。孩子也跟着吃。"
        },
        {
          "id": "ch0_0_6_l1",
          "speaker": "苇原·灯影",
          "text": "粮饷簿不认眼泪，也不认初啼。"
        },
        {
          "id": "ch0_0_6_l2",
          "speaker": "旁白",
          "text": "采石坡那块插上了槐里家的界桩，白生生的。娘的契赎不回来了。",
          "when": {
            "flag": "pro_lease_pawned"
          }
        },
        {
          "id": "ch0_0_6_l3",
          "speaker": "旁白",
          "text": "娘的契还在石垒坡的柜子里。这一年的饷，是从门楼上一张一张揭下来的。",
          "when": {
            "flag": "pro_lease_kept"
          }
        },
        {
          "id": "ch0_0_6_l4",
          "speaker": "旁白",
          "text": "槐里家的饷花完了。簿子上那一仗还在别人名下，堡的地契在你手里。",
          "when": {
            "flag": "pro_merit_patron"
          }
        },
        {
          "id": "ch0_0_6_l5",
          "speaker": "旁白",
          "text": "小粟捎来一双小鞋，鞋面绣着那个字，比你写的还歪。娘照着旗描了三天。",
          "stage": {
            "pace": "slow"
          }
        },
        {
          "id": "ch0_0_6_l6",
          "speaker": "石垒·晚担",
          "text": "把账结清。结清了，我跟的那个人还在。"
        },
        {
          "id": "ch0_0_6_l7",
          "speaker": "管事",
          "text": "手记等账清了再写。写完，才算上路。陆桥会重复这个姓，你得在场。"
        }
      ],
      "actions": [
        {
          "id": "write_journal",
          "label": "写下这一年",
          "do": [
            {
              "op": "journal"
            }
          ],
          "when": {
            "any_flag": [
              "harvest_done",
              "chapter0_done"
            ]
          }
        },
        {
          "id": "free_play",
          "label": "先回堡里",
          "do": [
            {
              "op": "set_flag",
              "flag": "chapter0_done",
              "value": true
            },
            {
              "op": "scene",
              "path": "res://scenes/hub/castle_hub.tscn"
            }
          ],
          "when": {
            "any_flag": [
              "harvest_done",
              "chapter0_done"
            ]
          }
        },
        {
          "id": "old_volume",
          "label": "踏上第一卷·过路银的收据",
          "do": [
            {
              "op": "set_flag",
              "flag": "chapter0_done",
              "value": true
            },
            {
              "op": "open_chapter",
              "id": "e1_01"
            }
          ],
          "when": {
            "any_flag": [
              "harvest_done",
              "chapter0_done"
            ]
          }
        },
        {
          "id": "fast_harvest",
          "label": "把月份推到丰收，结清这一笔",
          "do": [
            {
              "op": "fast_harvest"
            }
          ],
          "when": {
            "not_any_flag": [
              "harvest_done",
              "chapter0_done"
            ]
          }
        },
        {
          "id": "open_hourglass",
          "label": "去看月份怎么往前走",
          "do": [
            {
              "op": "visit",
              "path": "res://scenes/hub/hourglass.tscn"
            }
          ],
          "when": {
            "not_any_flag": [
              "harvest_done",
              "chapter0_done"
            ]
          }
        }
      ],
      "next": null
    }
  ]
}

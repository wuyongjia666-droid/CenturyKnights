          "op": "ensure_reputation",
          "when": {
            "not_flag": "married"
          },
          "realm": "ashland",
          "below": 30,
          "set": 35,
          "also_if_tier": "none",
          "log": "春令使者代请：灰烬邦声望升至友善"
        }
      ]
    },
    {
      "id": "0.45",
      "title": "双姓共席",
      "lines": [
        {
          "id": "ch0_0_45_l0",
          "speaker": "旁白",
          "text": "酒是薄的。两姓坐到一张席上时，老旗手把旗又升了一寸。像是怕桥对面看不见。"
        },
        {
          "id": "ch0_0_45_l1",
          "speaker": "盟友亲属",
          "text": "人是托给这面旗的，不是托给这一夜的酒。孩子若不敢认它，就是我们把人送错了地方。"
        },
        {
          "id": "ch0_0_45_l2",
          "speaker": "苇原·灯影",
          "text": "家有了。先别拿去路上给人看。族谱那一页还空着。空着的时候，别说百年已经开始。"
        },
        {
          "id": "ch0_0_45_l3",
          "speaker": "苇原·灯影",
          "text": "初啼还没来。灯可以留在堡里。你也可以就在这张席上，等那一声。"
        }
      ],
      "actions": [
        {
          "id": "wait_birth",
          "label": "在席上等候初啼",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ],
      "next": "0.5"
    },
    {
      "id": "0.5",
      "title": "初啼",
      "lines": [
        {
          "id": "ch0_0_5_l0",
          "speaker": "稳婆",
          "text": "落地了。哭声不好听。好听的是这只肺在自己干活。命也是自己的。"
        },
        {
          "id": "ch0_0_5_l1",
          "speaker": "稳婆",
          "text": "脸、脾气、能走多远，都在这个孩子身上，也在那一页上。你若只翻银和刀，这一页会被你翻过去。"
        },
        {
          "id": "ch0_0_5_l2",
          "speaker": "旁白",
          "text": "两条血在旗下碰在一起。页上那一道，不是花边。是以后每个城门拿来认这个孩子的东西。"
        },
        {
          "id": "ch0_0_5_l3",
          "speaker": "稳婆",
          "text": "去看这个人。看完再回来。月份不会因为你站在门口，就自己往前走。"
        }
      ],
      "actions": [
        {
          "id": "open_page",
          "label": "翻开族谱新页",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ],
          "when": {
            "flag": "child_born"
          }
        },
        {
          "id": "advance_birth",
          "label": "让这个月走到初啼",
          "do": [
            {
              "op": "advance",
              "months": 1
            }
          ],
          "when": {
            "not_flag": "child_born"
          }
        },
        {
          "id": "open_lineage",
          "label": "去看族谱上的这一行",
          "do": [
            {
              "op": "scene",
              "path": "res://scenes/hub/lineage_view.tscn"
            }
          ],
          "when": {
            "not_flag": "child_born"
          }
        }
      ],
      "next": "0.55"
    },
    {
      "id": "0.55",
      "title": "族谱新页",
      "lines": [
        {
          "id": "ch0_0_55_l0",
          "speaker": "管事",
          "text": "新的一行写上了。墨干得很快。陆桥的风不给字留情面。"
        },
        {
          "id": "ch0_0_55_l1",
          "speaker": "老旗手",
          "text": "孩子还上不了阵。有一天旗要交到这只手里。那一下，比今晚任何胜仗都沉。"
        },
        {
          "id": "ch0_0_55_l2",
          "speaker": "苇原·灯影",
          "text": "丰收月快到了。簿子不认哭声。先看这个月会落下什么，再把时间往前拨。拨了，就要认。"
        },
        {
          "id": "ch0_0_55_l3",
          "speaker": "管事",
          "text": "墨还湿。看完那一行，再去把秋收的账摊开。人会老一岁。粮也得有一笔。"
        }
      ],
      "actions": [
        {
          "id": "to_harvest",
          "label": "进入秋收簿",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        },
        {
          "id": "see_lineage",
          "label": "再看一眼族谱",
          "do": [
            {
              "op": "scene",
              "path": "res://scenes/hub/lineage_view.tscn"
            }
          ]
        }
      ],
      "next": "0.6"
    },
    {
      "id": "0.6",
      "title": "秋收簿",
      "lines": [
        {
          "id": "ch0_0_6_l0",
          "speaker": "管事",
          "text": "丰收月到了。工资、口粮、士气，这个月要结清。孩子也在这笔里。结不清，旗就只是一块好看的布。"
        },
        {
          "id": "ch0_0_6_l1",
          "speaker": "旁白",
          "text": "时间往前倾了一下。镜子里多出一道风霜。旗上的颜色还在。人老了，路没有。"
        },
        {
          "id": "ch0_0_6_l2",
          "speaker": "旁白",
          "text": "这一年站住了。一仗，一个新来的人，一张席，一声哭。陆桥还在前面。城埠认旗号，不认嗓门。"
        },
        {
          "id": "ch0_0_6_l3",
          "speaker": "管事",
          "text": "先把这一笔拨完。手记现在就能写。写完，旗该上路。桥对面的城，不会自己过来认你。"
        }
      ],
      "actions": [
        {

          ]
        }
      ]
    },
    {
      "id": "ledger",
      "title": "入册",
      "lines": [
        {
          "id": "cs06_led_0",
          "speaker": "旁白",
          "text": "旗册封面四个字：校场上的灯。末页已厚。柜上两把钥匙。",
          "stage": {
            "bg": "hall",
            "camera": "close"
          }
        },
        {
          "id": "cs06_led_par",
          "speaker": "旁白",
          "text": "你留下两行。议会仍爱一行。柜子认灯。",
          "when": {
            "flag": "cs06_kept_yard"
          }
        },
        {
          "id": "cs06_led_name",
          "speaker": "旁白",
          "text": "你先钉胜者名。沙漏仍在亮——月会替你写下行。",
          "when": {
            "flag": "cs06_name_victor"
          }
        },
        {
          "id": "cs06_led_1",
          "speaker": "老管事",
          "text": "存档不刊也行。不丢，就是缝。"
        },
        {
          "id": "cs06_led_2",
          "speaker": "槐里·青禾",
          "text": "孩子抄过校场，才配以后念栏。"
        },
        {
          "id": "cs06_led_3",
          "speaker": "老旗手",
          "text": "并排。不要裁。缝在名册与校场之间。"
        },
        {
          "id": "cs06_led_4",
          "speaker": "岁吏",
          "text": "回执在侧室。谱与场，两本账。"
        },
        {
          "id": "cs06_led_5",
          "speaker": "苇原·灯影",
          "text": "更还在交。下次挂嗣，下行先响。"
        },
        {
          "id": "cs06_led_6",
          "speaker": "leader",
          "text": "栏与场，并排。谁来认嗣位，先念完。"
        },
        {
          "id": "cs06_led_7",
          "speaker": "旁白",
          "text": "风动旗角时，可比试还在。两行之间的空，给人脸红。"
        }
      ],
      "actions": []
    }
  ]
}

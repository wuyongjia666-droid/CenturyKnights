              "beat": "next"
            }
          ]
        }
      ]
    },
    {
      "id": "bridge",
      "title": "门廊",
      "next": "tavern",
      "lines": [
        {
          "id": "cs06_br_0",
          "speaker": "旁白",
          "text": "门廊问谁站。墙牌两行一起响。",
          "stage": {
            "bg": "hall",
            "camera": "wide"
          }
        },
        {
          "id": "cs06_br_1",
          "speaker": "石垒·晚担",
          "text": "牌比纸硬。纸比嘴硬。"
        },
        {
          "id": "cs06_br_2",
          "speaker": "老旗手",
          "text": "旗角给人核，不给人卖名。"
        },
        {
          "id": "cs06_br_3",
          "speaker": "苇原·灯影",
          "text": "桩空有下落，再谈名。"
        },
        {
          "id": "cs06_br_4",
          "speaker": "槐里·青禾",
          "text": "谎抄不住。孩子会问为什么空。"
        },
        {
          "id": "cs06_br_5",
          "speaker": "老管事",
          "text": "闲话快。对照慢。慢的留下。"
        },
        {
          "id": "cs06_br_6",
          "speaker": "岁吏",
          "text": "谱很长。校场很吵。吵是还在打。"
        },
        {
          "id": "cs06_br_7",
          "speaker": "leader",
          "text": "带牌。去酒馆。"
        },
        {
          "id": "cs06_bridge_x0",
          "speaker": "旁白",
          "text": "门廊问谁入圈。墙牌两行一起响。"
        },
        {
          "id": "cs06_bridge_x1",
          "speaker": "石垒·晚担",
          "text": "牌比纸硬。绕牌先撞桩。"
        },
        {
          "id": "cs06_bridge_x2",
          "speaker": "老旗手",
          "text": "旗角给人核。疤给人对。"
        },
        {
          "id": "cs06_bridge_x3",
          "speaker": "苇原·灯影",
          "text": "站位不清，胜先别谈。"
        },
        {
          "id": "cs06_bridge_x4",
          "speaker": "槐里·青禾",
          "text": "谎抄不住。孩子会指着湿沙问。"
        },
        {
          "id": "cs06_bridge_x5",
          "speaker": "老管事",
          "text": "闲话快。对照慢。慢的留下。"
        },
        {
          "id": "cs06_bridge_x6",
          "speaker": "岁吏",
          "text": "谱很长。校场很静。静着对疤。"
        },
        {
          "id": "cs06_bridge_x7",
          "speaker": "书记官",
          "text": "记谁圈外站、谁短笑、谁催已胜。"
        },
        {
          "id": "cs06_bridge_x8",
          "speaker": "旁白",
          "text": "短笑散开。散开不是结案。"
        },
        {
          "id": "cs06_bridge_x9",
          "speaker": "掌柜",
          "text": "圈还在墙上。圈不等短笑。"
        },
        {
          "id": "cs06_mid_lost",
          "speaker": "旁白",
          "text": "锋收回来。校场问声还在。墙牌旁那拨，没散。",
          "when": {
            "all": [
              {
                "flag": "cs06_mid_lost"
              },
              {
                "not_flag": "cs06_mid_fought"
              }
            ]
          }
        }
      ],

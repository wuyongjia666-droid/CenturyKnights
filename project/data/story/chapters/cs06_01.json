{
  "id": "cs06_01",
  "title": "校场上的灯",
  "legacy_index": 406,
  "return_scene": "res://scenes/hub/castle_hub.tscn",
  "source": "docs/content-seasons/season-06/NOVEL.md",
  "beats": [
    {
      "id": "yard",
      "title": "挂栏",
      "next": "spar",
      "lines": [
        {
          "id": "cs06_yd_0",
          "speaker": "旁白",
          "text": "嗣位校场。名册末行空着。校场上的灯还亮。",
          "stage": {
            "card": "一　挂栏",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs06_yd_1",
          "speaker": "书记官",
          "text": "议会要听念。栏要写得正，写得能念。"
        },
        {
          "id": "cs06_yd_2",
          "speaker": "leader",
          "text": "写可比试。"
        },
        {
          "id": "cs06_yd_3",
          "speaker": "旁白",
          "text": "笔尖停一下。末行落下「可比试」三字。"
        },
        {
          "id": "cs06_yd_4",
          "speaker": "老旗手",
          "text": "旗册誊栏。旗角不给人卖名。"
        },
        {
          "id": "cs06_yd_5",
          "speaker": "岁吏",
          "text": "谱可以进栏。校场是另一本账。"
        },
        {
          "id": "cs06_yd_6",
          "speaker": "石垒·晚担",
          "text": "写好看不难。站得住才难。"
        },
        {
          "id": "cs06_yard_x0",
          "speaker": "旁白",
          "text": "校场门开。沙味先进来，催条后到。"
        },
        {
          "id": "cs06_yard_x1",
          "speaker": "书记官",
          "text": "栏上「可比试」三个字，比沙圈更急。"
        },
        {
          "id": "cs06_yard_x2",
          "speaker": "老管事",
          "text": "急可以写在纸上。不能写进未结的疤。"
        },
        {
          "id": "cs06_yard_x3",
          "speaker": "槐里·青禾",
          "text": "我在场边纳鞋。看得懂急，看不懂装胜。"
        },
        {
          "id": "cs06_yard_x4",
          "speaker": "苇原·灯影",
          "text": "巡问今夜谁还没对疤，不问谁喊已胜。"
        },
        {
          "id": "cs06_yard_x5",
          "speaker": "老旗手",
          "text": "旗角不卖名。疤未对，针先停。"
        },
        {
          "id": "cs06_yard_x6",
          "speaker": "岁吏",
          "text": "胜可感。疤未对。红脸过夜。"
        },
        {
          "id": "cs06_yard_x7",
          "speaker": "石垒·晚担",
          "text": "沙圈歪半指，我重画了。歪胜不收。"
        },
        {
          "id": "cs06_yard_x8",
          "speaker": "旁白",
          "text": "木尺靠在门边。尺比嘴硬。"
        },
        {
          "id": "cs06_yard_x9",
          "speaker": "掌柜",
          "text": "酒馆圈等校场选题。公开选，少扯皮。"
        },
        {
          "id": "cs06_yd_7",
          "speaker": "leader",
          "text": "栏挂上了。去看校场。"
        }
      ]
    },
    {
      "id": "spar",
      "title": "校场",
      "next": "hourglass",
      "lines": [
        {
          "id": "cs06_sp_0",
          "speaker": "旁白",
          "text": "沙圈未结。灯照着护腕上的灰。",
          "stage": {
            "bg": "hall",
            "camera": "close"
          }
        },
        {
          "id": "cs06_sp_1",
          "speaker": "老管事",
          "text": "校场：对打已记，疤待对。胜者栏仍空。"
        },
        {
          "id": "cs06_sp_2",
          "speaker": "旁白",
          "text": "名册说可比试。沙圈说还在打。两行字第一次吵架。"
        },
        {
          "id": "cs06_sp_3",
          "speaker": "苇原·灯影",
          "text": "巡防不问谁胜。问今夜谁还站不稳。"
        },
        {
          "id": "cs06_sp_4",
          "speaker": "槐里·青禾",
          "text": "空着才诚实。写满却站不上去，才是骗人。"
        },
        {
          "id": "cs06_sp_5",
          "speaker": "老管事",
          "text": "还差两场。跳步的栏，桩会裂。"
        },
        {
          "id": "cs06_spar_x0",
          "speaker": "旁白",
          "text": "沙圈湿痕还在。湿痕是雨写的，比催条诚实。"
        },
        {
          "id": "cs06_spar_x1",
          "speaker": "老管事",
          "text": "可比试已挂。疤待对，站位未核。"
        },
        {
          "id": "cs06_spar_x2",
          "speaker": "石垒·晚担",
          "text": "脚在圈外一掌，别谈胜。先站。"
        },
        {
          "id": "cs06_spar_x3",
          "speaker": "书记官",
          "text": "旁注「疤待对」。旁注是缝。"
        },
        {
          "id": "cs06_spar_x4",
          "speaker": "岁吏",
          "text": "假绿进年迹，比红脸难看。"
        },
        {
          "id": "cs06_spar_x5",
          "speaker": "苇原·灯影",
          "text": "装胜的人，带到圈里重来。"
        },
        {
          "id": "cs06_spar_x6",
          "speaker": "槐里·青禾",
          "text": "急的人手会结。手结了，刀也会结。"
        },
        {
          "id": "cs06_spar_x7",
          "speaker": "老旗手",
          "text": "跳格绣胜，角会裂。裂了再补更疼。"
        },
        {
          "id": "cs06_spar_x8",
          "speaker": "旁白",
          "text": "刀还在架上。架上的刀，比嘴里的胜干净。"
        },
        {
          "id": "cs06_spar_x9",
          "speaker": "老管事",
          "text": "对完疤，再谈名。名在过程里，不在吆喝里。"
        },
        {
          "id": "cs06_sp_6",
          "speaker": "leader",
          "text": "记下。去看沙漏。"
        }
      ]
    },
    {
      "id": "hourglass",
      "title": "两行",
      "next": "bridge",
      "lines": [
        {
          "id": "cs06_hg_0",
          "speaker": "旁白",
          "text": "沙漏多出两行：上行可比试，下行校场未结。",
          "stage": {
            "bg": "hall",
            "camera": "wide"
          }
        },
        {
          "id": "cs06_hg_1",
          "speaker": "老管事",
          "text": "并排钉。谁撕下行，谁结账。"
        },
        {
          "id": "cs06_hg_2",
          "speaker": "岁吏",
          "text": "回执在侧室。谱与场，两本账。"
        },
        {
          "id": "cs06_hg_3",
          "speaker": "书记官",
          "text": "议会爱一行。两行最好活。"
        },
        {
          "id": "cs06_hg_4",
          "speaker": "苇原·灯影",
          "text": "更还在交。下行先响。"
        },
        {
          "id": "cs06_hg_5",
          "speaker": "槐里·青禾",
          "text": "孩子要抄未结，不要只抄名。"
        },
        {
          "id": "cs06_hourglass_x0",
          "speaker": "旁白",
          "text": "上行可比试，下行疤待对。细线钉死。"
        },
        {
          "id": "cs06_hourglass_x1",
          "speaker": "老管事",
          "text": "撕下行的人，先去沙圈重站。"
        },
        {
          "id": "cs06_hourglass_x2",
          "speaker": "书记官",
          "text": "一行好念。两行好活。我们选活。"
        },
        {
          "id": "cs06_hourglass_x3",
          "speaker": "岁吏",
          "text": "回执认并排。并排认疤。疤不认抢跑。"
        },
        {
          "id": "cs06_hourglass_x4",
          "speaker": "苇原·灯影",
          "text": "更还在交。下行先响。"
        },
        {
          "id": "cs06_hourglass_x5",
          "speaker": "槐里·青禾",
          "text": "孩子抄未结。抄胜的时候，疤要在。"
        },
        {
          "id": "cs06_hourglass_x6",
          "speaker": "石垒·晚担",
          "text": "间距够脸红。红完再谈钉胜。"
        },
        {
          "id": "cs06_hourglass_x7",
          "speaker": "老旗手",
          "text": "核时两行都在。少一行角先裂。"
        },
        {
          "id": "cs06_hourglass_x8",
          "speaker": "旁白",
          "text": "沙子慢。慢着对，才像校场该有的速度。"
        },
        {
          "id": "cs06_hourglass_x9",
          "speaker": "掌柜",
          "text": "墙牌硬。撕牌的手会记得疼。"
        },
        {
          "id": "cs06_hg_6",
          "speaker": "leader",
          "text": "两行都留。去门廊。"
        }
      ],
      "actions": [
        {
          "id": "open_hourglass",
          "label": "去看月份怎么往前走",
          "do": [

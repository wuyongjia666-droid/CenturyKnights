{
  "id": "cs10_01",
  "title": "印上的灯",
  "legacy_index": 410,
  "return_scene": "res://scenes/hub/castle_hub.tscn",
  "source": "docs/content-seasons/season-10/NOVEL.md",
  "beats": [
    {
      "id": "yard",
      "title": "挂栏",
      "next": "affairs",
      "lines": [
        {
          "id": "cs10_yd_0",
          "speaker": "旁白",
          "text": "职印。旗册末行空着。印上的灯还亮。",
          "stage": {
            "card": "一　挂栏",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs10_yd_1",
          "speaker": "书记官",
          "text": "议会要绣「城印已盖」的姓。栏要写得正。"
        },
        {
          "id": "cs10_yd_2",
          "speaker": "leader",
          "text": "写印已挂。"
        },
        {
          "id": "cs10_yd_3",
          "speaker": "旁白",
          "text": "笔尖停一下。末行落下「印已挂」三字。"
        },
        {
          "id": "cs10_yd_4",
          "speaker": "老旗手",
          "text": "旗册誊栏。旗角不给人空盖印。"
        },
        {
          "id": "cs10_yd_5",
          "speaker": "岁吏",
          "text": "谱可以进栏。职印是另一本账。"
        },
        {
          "id": "cs10_yd_6",
          "speaker": "石垒·晚担",
          "text": "挂好看不难。盖得住才难。"
        },
        {
          "id": "cs10_yd_7",
          "speaker": "leader",
          "text": "栏挂上了。去看本城之事。"
        }
      ]
    },
    {
      "id": "affairs",
      "title": "本城之事",
      "next": "seal",
      "lines": [
        {
          "id": "cs10_af_0",
          "speaker": "旁白",
          "text": "本城之事未办。灯照着城门白边。",
          "stage": {
            "bg": "hall",
            "camera": "close"
          }
        },
        {
          "id": "cs10_af_1",
          "speaker": "老管事",
          "text": "本城之事：事条已记，办结待签。声望栏仍浅。"
        },
        {
          "id": "cs10_af_2",
          "speaker": "旁白",
          "text": "名册说印已挂。城门说还在办。两行字第一次吵架。"
        },
        {
          "id": "cs10_af_3",
          "speaker": "苇原·灯影",
          "text": "巡防不问谁想盖印。问今夜谁还没办事。"
        },
        {
          "id": "cs10_af_4",
          "speaker": "槐里·青禾",
          "text": "空着才诚实。写满却盖不上去，才是骗人。"
        },
        {
          "id": "cs10_af_5",
          "speaker": "老管事",
          "text": "声望不够。跳格的栏，印泥会裂。"
        },
        {
          "id": "cs10_af_6",
          "speaker": "leader",
          "text": "记下。去看盖印厅。"
        }
      ]
    },
    {
      "id": "seal",
      "title": "盖印",
      "next": "hourglass",
      "lines": [
        {
          "id": "cs10_sl_0",
          "speaker": "旁白",
          "text": "盖印厅六门印：验盏、桥税骑、录外生、霜候、盐引、锻眉。",
          "stage": {
            "bg": "hall",
            "camera": "wide"
          }
        },
        {
          "id": "cs10_sl_1",
          "speaker": "老管事",
          "text": "印未盖。档案先红脸。沙漏也红。"
        },
        {
          "id": "cs10_sl_2",
          "speaker": "岁吏",
          "text": "回执在侧室。谱与印，两本账。"
        },
        {
          "id": "cs10_sl_3",
          "speaker": "书记官",
          "text": "议会爱「城印已盖」一行。两行最好活。"
        },
        {
          "id": "cs10_sl_4",
          "speaker": "石垒·晚担",
          "text": "泥比纸硬。纸比嘴硬。"
        },
        {
          "id": "cs10_sl_5",
          "speaker": "苇原·灯影",
          "text": "更还在交。下行先响。"
        },
        {
          "id": "cs10_sl_6",
          "speaker": "leader",
          "text": "六门都记。去看沙漏。"
        }
      ]
    },
    {
      "id": "hourglass",
      "title": "两行",
      "next": "bridge",
      "lines": [
        {
          "id": "cs10_hg_0",
          "speaker": "旁白",
          "text": "沙漏多出两行：上行印已挂，下行职印未盖。",
          "stage": {
            "bg": "hall",
            "camera": "wide"
          }
        },
        {
          "id": "cs10_hg_1",
          "speaker": "老管事",
          "text": "并排钉。谁撕下行，谁结账。"
        },
        {
          "id": "cs10_hg_2",
          "speaker": "岁吏",
          "text": "回执在侧室。谱与印，两本账。"
        },
        {
          "id": "cs10_hg_3",
          "speaker": "书记官",
          "text": "议会爱一行。两行最好活。"
        },
        {
          "id": "cs10_hg_4",
          "speaker": "苇原·灯影",
          "text": "更还在交。下行先响。"
        },
        {
          "id": "cs10_hg_5",
          "speaker": "槐里·青禾",
          "text": "孩子要抄未盖，不要只抄名。"
        },
        {
          "id": "cs10_hg_6",
          "speaker": "leader",
          "text": "两行都留。去门廊。"
        }
      ],
      "actions": [
        {
          "id": "open_hourglass",
          "label": "去看月份怎么往前走",
          "do": [
            {
              "op": "visit",
              "path": "res://scenes/hub/hourglass.tscn"
            }
          ]
        },
        {
          "id": "continue_after_visit",
          "label": "继续，去门廊",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ]
    },
    {
      "id": "bridge",
      "title": "门廊",
      "next": "tavern",
      "lines": [
        {
          "id": "cs10_br_0",
          "speaker": "旁白",
          "text": "门廊问谁盖印。墙牌两行一起响。",
          "stage": {
            "bg": "hall",
            "camera": "wide"
          }
        },
        {
          "id": "cs10_br_1",
          "speaker": "石垒·晚担",
          "text": "牌比纸硬。纸比嘴硬。"
        },
        {
          "id": "cs10_br_2",
          "speaker": "老旗手",
          "text": "旗角给人核，不给人空盖。"
        },
        {
          "id": "cs10_br_3",
          "speaker": "苇原·灯影",
          "text": "事空有下落，再谈印。"
        },
        {
          "id": "cs10_br_4",
          "speaker": "槐里·青禾",
          "text": "谎抄不住。孩子会问为什么空。"
        },
        {
          "id": "cs10_br_5",
          "speaker": "老管事",
          "text": "闲话快。对照慢。慢的留下。"
        },
        {
          "id": "cs10_br_6",
          "speaker": "岁吏",
          "text": "谱很长。职印很静。静是还在办。"
        },
        {
          "id": "cs10_br_7",
          "speaker": "leader",
          "text": "带牌。去酒馆。"
        },
        {
          "id": "cs10_mid_lost",
          "speaker": "旁白",
          "text": "锋收回来。盖印问声还在。墙牌旁那拨，没散。",
          "when": {
            "all": [
              {
                "flag": "cs10_mid_lost"
              },
              {
                "not_flag": "cs10_mid_fought"
              }
            ]
          }
        }
      ],

    {
      "id": "tavern",
      "title": "选题",
      "lines": [
        {
          "id": "cs10_tav_0",
          "speaker": "旁白",
          "text": "烽火酒馆。碗沿两个圈：并排记，先钉印。",
          "stage": {
            "bg": "tavern",
            "camera": "wide"
          }
        },
        {
          "id": "cs10_tav_1",
          "speaker": "掌柜",
          "text": "篇幅不够就钉墙。墙比名册宽。"
        },
        {
          "id": "cs10_tav_2",
          "speaker": "槐里·青禾",
          "text": "裁职印的人，先把剪刀放下。"
        },
        {
          "id": "cs10_tav_3",
          "speaker": "老管事",
          "text": "并排钉。谁撕职印抄本，谁结账。"
        },
        {
          "id": "cs10_tav_4",
          "speaker": "石垒·晚担",
          "text": "栏是念的，印是盖的。两样都要。"
        },
        {
          "id": "cs10_tav_5",
          "speaker": "苇原·灯影",
          "text": "沙漏还亮。谁买一行结论，带他去摸印灯。"
        },
        {
          "id": "cs10_tav_6",
          "speaker": "旁白",
          "text": "两张纸在风里响。你选怎么收这一季。"
        }
      ],
      "actions": [
        {
          "id": "keep_seal",
          "label": "城印并排记",
          "do": [

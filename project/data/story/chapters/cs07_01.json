          ]
        }
      ]
    },
    {
      "id": "ledger",
      "title": "入册",
      "lines": [
        {
          "id": "cs07_led_0",
          "speaker": "旁白",
          "text": "旗册封面四个字：仪典上的灯。末页已厚。柜上两把钥匙。",
          "stage": {
            "bg": "hall",
            "camera": "close"
          }
        },
        {
          "id": "cs07_led_par",
          "speaker": "旁白",
          "text": "你留下两行。议会仍爱一行。柜子认灯。",
          "when": {
            "flag": "cs07_kept_rite"
          }
        },
        {
          "id": "cs07_led_name",
          "speaker": "旁白",
          "text": "你先钉路名。沙漏仍在亮——月会替你写下行。",
          "when": {
            "flag": "cs07_name_path"
          }
        },
        {
          "id": "cs07_led_1",
          "speaker": "老管事",
          "text": "存档不刊也行。不丢，就是缝。"
        },
        {
          "id": "cs07_led_2",
          "speaker": "槐里·青禾",
          "text": "孩子抄过仪典，才配以后念栏。"
        },
        {
          "id": "cs07_led_3",
          "speaker": "老旗手",
          "text": "并排。不要裁。缝在名册与仪典之间。"
        },
        {
          "id": "cs07_led_4",
          "speaker": "岁吏",
          "text": "回执在侧室。谱与仪，两本账。"
        },
        {
          "id": "cs07_led_5",
          "speaker": "苇原·灯影",
          "text": "更还在交。下次挂嗣，下行先响。"
        },
        {
          "id": "cs07_led_6",
          "speaker": "leader",
          "text": "栏与仪，并排。谁来认嗣位，先念完。"
        },
        {
          "id": "cs07_led_7",
          "speaker": "旁白",
          "text": "风动旗角时，路已选还在。两行之间的空，给人脸红。"
        }
      ],
      "actions": []
    }
  ]
}

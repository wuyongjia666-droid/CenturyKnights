        {
          "id": "doctrine_only",
          "label": "先只留训条",
          "do": [
            {
              "op": "set_flag",
              "flag": "cs04_doctrine_only",
              "value": true
            },
            {
              "op": "season_ledger",
              "chapter": "cs04_01",
              "choice": "doctrine_only",
              "title": "家训上的灯",
              "outcome": "先只留训条，行条暂空",
              "yeartrace": true
            },
            {

            }
          ]
        }
      ]
    },
    {
      "id": "ledger",
      "title": "入册",
      "lines": [
        {
          "id": "cs04_led_0",
          "speaker": "旁白",
          "text": "旗册封面四个字：家训上的灯。末页已厚。柜上两把钥匙。",
          "stage": {
            "bg": "hall",
            "camera": "close"
          }
        },
        {
          "id": "cs04_led_par",
          "speaker": "旁白",
          "text": "你留下两行。议会仍爱一行。柜子认灯。",
          "when": {
            "flag": "cs04_kept_parallel"
          }
        },
        {
          "id": "cs04_led_only",
          "speaker": "旁白",
          "text": "你先只留训条。沙漏仍在亮——月会替你写下行。",
          "when": {
            "flag": "cs04_doctrine_only"
          }
        },
        {
          "id": "cs04_led_1",
          "speaker": "老管事",
          "text": "存档不刊也行。不丢，就是缝。"
        },
        {
          "id": "cs04_led_2",
          "speaker": "槐里·青禾",
          "text": "孩子抄过加零，才配以后念绣词。"
        },
        {
          "id": "cs04_led_3",
          "speaker": "老旗手",
          "text": "并排。不要裁。缝在旗角内侧。"
        },
        {
          "id": "cs04_led_4",
          "speaker": "石垒·晚担",
          "text": "粮还在库。勺空了也能记。"
        },
        {
          "id": "cs04_led_5",
          "speaker": "苇原·灯影",
          "text": "更还在交。下次挂训，下行先响。"
        },
        {
          "id": "cs04_led_6",
          "speaker": "leader",
          "text": "训与行，并排。谁来认家训，先念完。"
        },
        {
          "id": "cs04_led_7",
          "speaker": "旁白",
          "text": "风动旗角时，绣词还在。两行之间的空，给人脸红。"
        }
      ],
      "actions": []
    }
  ]
}

{
  "id": "cs05_02",
  "title": "回读上的灯",
  "legacy_index": 415,
  "return_scene": "res://scenes/hub/castle_hub.tscn",
  "source": "docs/content-seasons/season-05/NOVEL.md",
  "beats": [
    {
      "id": "reread",
      "title": "回读",
      "lines": [
        {
          "id": "cs05b_ct_0",
          "speaker": "旁白",
          "text": "嗣位庭。上回的选择已入柜。名册末行还在发光。",
          "stage": {
            "card": "一　回读",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs05b_ct_1",
          "speaker": "书记官",
          "text": "并排的人说空椅还空。钉名的人说栏已能念。"
        },
        {
          "id": "cs05b_ct_2",
          "speaker": "leader",
          "text": "两本都打开。我要听回读。"
        },
        {
          "id": "cs05b_ct_3",
          "speaker": "旁白",
          "text": "柜门一响。并排纸与钉名条并排放上长桌。"
        },
        {
          "id": "cs05b_ct_4",
          "speaker": "老管事",
          "text": "回读不是翻旧账。是看链有没有骗人。"
        },
        {
          "id": "cs05b_ct_5",
          "speaker": "岁吏",
          "text": "谱上的字会老。椅腿上的灰不会替人撒谎。"
        },
        {
          "id": "cs05b_ct_6",
          "speaker": "槐里·青禾",
          "text": "孩子抄过空。今天抄回读。抄假的手会抖。"
        },
        {
          "id": "cs05b_ct_7",
          "speaker": "石垒·晚担",
          "text": "坐得住才算坐。写得好看不算。"
        },
        {
          "id": "cs05b_ct_8",
          "speaker": "苇原·灯影",
          "text": "巡夜只问谁还空着。回读夜也一样。"
        },
        {
          "id": "cs05b_ct_9",
          "speaker": "老旗手",
          "text": "旗角给人核。核时把回读本也递过去。"
        },
        {
          "id": "cs05b_ct_10",
          "speaker": "掌柜",
          "text": "酒馆墙上那圈还在。圈等回读，不等喊坐满。"
        },
        {
          "id": "cs05b_ct_11",
          "speaker": "旁白",
          "text": "厅风比上回小。风小，字更清楚。"
        },
        {
          "id": "cs05b_ct_12",
          "speaker": "书记官",
          "text": "急字好念。回读难受。难受就对。"
        },
        {
          "id": "cs05b_ct_13",
          "speaker": "老管事",
          "text": "难受说明链还没骗过人。"
        },
        {
          "id": "cs05b_ct_14",
          "speaker": "岁吏",
          "text": "链未到的格，绿栏仍不收。"
        },
        {
          "id": "cs05b_ct_15",
          "speaker": "leader",
          "text": "柜开了。去看链格。"
        },
        {
          "id": "cs05b_ct_16",
          "speaker": "旁白",
          "text": "名册旁多了一本薄册。封皮写「回读」。"
        },
        {
          "id": "cs05b_ct_17",
          "speaker": "槐里·青禾",
          "text": "薄册比名册轻。轻的反而难装。"
        }
      ],
      "next": "chain"
    },
    {
      "id": "chain",
      "title": "链格",
      "lines": [
        {
          "id": "cs05b_ch_0",
          "speaker": "旁白",
          "text": "联姻链摊开。婚仪已记，诞育待对，继承人栏仍空。",
          "stage": {
            "bg": "hall",
            "camera": "close"
          }
        },
        {
          "id": "cs05b_ch_1",
          "speaker": "老管事",
          "text": "上回选并排的，链格亮着空。选钉名的，栏上有字、椅仍空。"
        },
        {
          "id": "cs05b_ch_2",
          "speaker": "旁白",
          "text": "两行字第二次吵架。回读逼它们对视。"
        },
        {
          "id": "cs05b_ch_3",
          "speaker": "苇原·灯影",
          "text": "巡防不问谁坐。问今夜谁还空着。"
        },
        {
          "id": "cs05b_ch_4",
          "speaker": "槐里·青禾",
          "text": "空着才诚实。写满却坐不上去，才是骗人。"
        },
        {
          "id": "cs05b_ch_5",
          "speaker": "石垒·晚担",
          "text": "垫再厚，脚够不着也别先写满。"
        },
        {
          "id": "cs05b_ch_6",
          "speaker": "岁吏",
          "text": "年迹进谱可以。落座另算。"
        },
        {
          "id": "cs05b_ch_7",
          "speaker": "书记官",
          "text": "议会要听念。回读要听空。"
        },
        {
          "id": "cs05b_ch_8",
          "speaker": "老旗手",
          "text": "旗布完整。旗角不绣假名。"
        },
        {
          "id": "cs05b_ch_9",
          "speaker": "掌柜",
          "text": "花生壳票还夹在并排纸里。谁撕谁留痕。"
        },
        {
          "id": "cs05b_ch_10",
          "speaker": "旁白",
          "text": "侧室回执条压在婚约匣下。匣比嘴硬。"
        },
        {
          "id": "cs05b_ch_11",
          "speaker": "老管事",
          "text": "匣上的印对得上联姻回响，对不上抢来的名。"
        },
        {
          "id": "cs05b_ch_12",
          "speaker": "leader",
          "text": "链格看见了。去沙漏对两行。"
        },
        {
          "id": "cs05b_ch_13",
          "speaker": "旁白",
          "text": "薄册翻到「待对」。墨干了，字还烫。"
        },
        {
          "id": "cs05b_ch_14",
          "speaker": "槐里·青禾",
          "text": "烫说明有人刚摸过。摸过就要回读。"
        },
        {
          "id": "cs05b_ch_15",
          "speaker": "石垒·晚担",
          "text": "摸亮的名册最怕假亮。"
        },
        {
          "id": "cs05b_ch_16",
          "speaker": "苇原·灯影",
          "text": "交更过庭。空名单短，我反而警惕。"
        },
        {
          "id": "cs05b_ch_17",
          "speaker": "旁白",
          "text": "空椅灯还亮。亮着，才敢回读。"
        }
      ],
      "next": "hourglass"
    },
    {
      "id": "hourglass",
      "title": "两行",
      "lines": [
        {
          "id": "cs05b_hg_0",
          "speaker": "旁白",
          "text": "沙漏厅。上行栏、下行空。回读把两行按住。",
          "stage": {
            "bg": "hall",
            "camera": "wide"
          }
        },
        {
          "id": "cs05b_hg_1",
          "speaker": "老管事",
          "text": "月份往前走。回读不改月份，只改你敢不敢对看。"
        },
        {
          "id": "cs05b_hg_2",
          "speaker": "岁吏",
          "text": "年迹旁多了一行「回读夜」。"
        },
        {
          "id": "cs05b_hg_3",
          "speaker": "书记官",
          "text": "能念的字在上行。坐得住的人还在下行等。"
        },
        {
          "id": "cs05b_hg_4",
          "speaker": "苇原·灯影",
          "text": "沙漏不催坐。沙漏只记谁空。"
        },
        {
          "id": "cs05b_hg_5",
          "speaker": "槐里·青禾",
          "text": "孩子问：回读是不是考试。我说是对账。"
        },
        {
          "id": "cs05b_hg_6",
          "speaker": "石垒·晚担",
          "text": "对账比考试狠。考试能抄，账抄不住。"
        },
        {
          "id": "cs05b_hg_7",
          "speaker": "老旗手",
          "text": "旗角在风里响。响的是核，不是卖名。"
        },
        {
          "id": "cs05b_hg_8",
          "speaker": "掌柜",
          "text": "酒馆圈旁写了「回读后再选」。"
        },
        {
          "id": "cs05b_hg_9",
          "speaker": "旁白",
          "text": "两根木条并排。你按住它们，像按住两句半截话。"
        },
        {
          "id": "cs05b_hg_10",
          "speaker": "leader",
          "text": "两行都在。去门廊问谁坐。"
        },
        {
          "id": "cs05b_hg_11",
          "speaker": "老管事",
          "text": "门廊不问你选过什么。问你今晚还空谁。"
        },
        {
          "id": "cs05b_hg_12",
          "speaker": "岁吏",
          "text": "空名单短，催条反而多。"
        },
        {
          "id": "cs05b_hg_13",
          "speaker": "书记官",
          "text": "催条爱写「已有嗣」。回读爱写「仍空」。"
        },
        {
          "id": "cs05b_hg_14",
          "speaker": "旁白",
          "text": "厅灯照着沙漏腰。腰细的地方，字最清楚。"
        },
        {
          "id": "cs05b_hg_15",
          "speaker": "槐里·青禾",
          "text": "清楚才像椅。糊了就像没回读。"
        },
        {
          "id": "cs05b_hg_16",
          "speaker": "石垒·晚担",
          "text": "我不糊。脚够不着就说够不着。"
        },
        {
          "id": "cs05b_hg_17",
          "speaker": "苇原·灯影",
          "text": "带牌去。牌上写回读，不写急。"
        }
      ],
      "next": "bridge",
      "actions": [
        {
          "id": "open_hourglass",
          "label": "去看月份怎么往前走",
          "do": [
            {
              "op": "visit",
              "path": "res://scenes/hub/hourglass.tscn"
            }
          ]
        },
        {
          "id": "continue_after_visit",
          "label": "继续，去门廊",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ]
    },
    {
      "id": "bridge",
      "title": "门廊",
      "lines": [
        {
          "id": "cs05b_br_0",
          "speaker": "旁白",
          "text": "门廊风大。牌上「回读」两字被吹得发白。",
          "stage": {
            "bg": "hall",
            "camera": "wide"
          }
        },
        {
          "id": "cs05b_br_1",
          "speaker": "石垒·晚担",
          "text": "谁坐？先看牌，再看脚。"
        },
        {
          "id": "cs05b_br_lost",
          "speaker": "旁白",
          "text": "锋收回来。回读纸还钉着。椅旁那拨，没散。",
          "when": {
            "all": [
              {
                "flag": "cs05_02_mid_lost"
              },
              {
                "not_flag": "cs05_02_mid_fought"
              }
            ]
          }
        },
        {
          "id": "cs05b_br_2",
          "speaker": "苇原·灯影",
          "text": "巡防交更。空椅还在名单上。"
        },
        {
          "id": "cs05b_br_3",
          "speaker": "旁白",
          "text": "有人来劝：栏已能念，何必回读。"
        },
        {
          "id": "cs05b_br_4",
          "speaker": "leader",
          "text": "能念不等于能坐。回读就是问坐。"
        },
        {
          "id": "cs05b_br_5",
          "speaker": "老旗手",
          "text": "旗角给人核。核完再谈催坐。"
        },
        {
          "id": "cs05b_br_6",
          "speaker": "槐里·青禾",
          "text": "劝钉名的札又来了。札比人急。"
        },
        {
          "id": "cs05b_br_7",
          "speaker": "岁吏",
          "text": "急字过夜会褪。空椅过夜更清楚。"
        },
        {
          "id": "cs05b_br_8",
          "speaker": "书记官",
          "text": "议会廊外有人等听念。我们先听空。"
        },
        {
          "id": "cs05b_br_9",
          "speaker": "老管事",
          "text": "带牌去酒馆。回读圈还在墙上。"
        },
        {
          "id": "cs05b_br_10",
          "speaker": "掌柜",
          "text": "圈等选题。回读后的题更沉。"
        },
        {
          "id": "cs05b_br_11",
          "speaker": "旁白",
          "text": "桥木响。响的是鞋，不是假名。"
        },
        {
          "id": "cs05b_br_12",
          "speaker": "石垒·晚担",
          "text": "干净靴也留痕。痕留给回读的人。"
        },
        {
          "id": "cs05b_br_13",
          "speaker": "苇原·灯影",
          "text": "锋镝先试一试。试完再去回读圈前。"
        },
        {
          "id": "cs05b_br_14",
          "speaker": "leader",
          "text": "门廊问过了。去酒馆看回读。"
        },
        {
          "id": "cs05b_br_15",
          "speaker": "旁白",
          "text": "牌收回来。回读两字没有被风吹掉。"
        },
        {
          "id": "cs05b_br_16",
          "speaker": "槐里·青禾",
          "text": "吹不掉才像回读。"
        },
        {
          "id": "cs05b_br_17",
          "speaker": "老旗手",
          "text": "旗布没破。破的是催坐条。"
        },
        {
          "id": "cs05b_br_18",
          "speaker": "岁吏",
          "text": "催条可以撕。回读本撕不得。"
        }
      ],

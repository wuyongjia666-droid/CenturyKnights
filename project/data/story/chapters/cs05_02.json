    {
      "id": "ledger",
      "title": "入册",
      "lines": [
        {
          "id": "cs05b_ld_0",
          "speaker": "旁白",
          "text": "西阁。回读本与名册并排入柜。",
          "stage": {
            "bg": "hall",
            "camera": "close"
          }
        },
        {
          "id": "cs05b_ld_1",
          "speaker": "旁白",
          "text": "你留链并排。空椅仍空，栏不骗人。"
        },
        {
          "id": "cs05b_ld_2",
          "speaker": "旁白",
          "text": "你催栏优先。字能念，沙漏下行仍亮着空。"
        },
        {
          "id": "cs05b_ld_3",
          "speaker": "老管事",
          "text": "柜门一响。四字落款：回读已记。"
        },
        {
          "id": "cs05b_ld_4",
          "speaker": "岁吏",
          "text": "年迹旁补回读一行。不改前季。"
        },
        {
          "id": "cs05b_ld_5",
          "speaker": "书记官",
          "text": "议会要听念，就念回读本。"
        },
        {
          "id": "cs05b_ld_6",
          "speaker": "槐里·青禾",
          "text": "孩子抄完空椅。说手不抖了。"
        },
        {
          "id": "cs05b_ld_7",
          "speaker": "石垒·晚担",
          "text": "不抖说明没装坐。"
        },
        {
          "id": "cs05b_ld_8",
          "speaker": "苇原·灯影",
          "text": "巡夜名单还短。短着也好过假坐。"
        },
        {
          "id": "cs05b_ld_9",
          "speaker": "老旗手",
          "text": "旗角给人核。核完空椅旗还在。"
        },
        {
          "id": "cs05b_ld_10",
          "speaker": "掌柜",
          "text": "回读圈可以擦。柜里回读本擦不掉。"
        },
        {
          "id": "cs05b_ld_11",
          "speaker": "leader",
          "text": "回读记了。灯还亮。"
        },
        {
          "id": "cs05b_ld_12",
          "speaker": "旁白",
          "text": "空椅灯照着椅腿灰。灰还在，人还诚实。"
        },
        {
          "id": "cs05b_ld_13",
          "speaker": "老管事",
          "text": "诚实比能念的栏贵。"
        },
        {
          "id": "cs05b_ld_14",
          "speaker": "岁吏",
          "text": "贵的账才值得回读。"
        },
        {
          "id": "cs05b_ld_15",
          "speaker": "书记官",
          "text": "嗓子轻一点。轻着念回读，字更真。"
        },
        {
          "id": "cs05b_ld_16",
          "speaker": "旁白",
          "text": "柜锁落下。回读第二可玩章收束。"
        },
        {
          "id": "cs05b_ld_17",
          "speaker": "槐里·青禾",
          "text": "收束不是结束。是敢把空椅留下。"
        },
        {
          "id": "cs05b_ld_18",
          "speaker": "石垒·晚担",
          "text": "留下空，才有人坐得住。"
        },
        {
          "id": "cs05b_ld_19",
          "speaker": "leader",
          "text": "灯不灭。回读本在柜里。"
        }
      ],
      "actions": []
    }
  ],
  "title_en": "The Lamp on the Reread"
}

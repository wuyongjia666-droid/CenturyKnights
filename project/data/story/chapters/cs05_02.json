    {
      "id": "tavern",
      "title": "选题",
      "lines": [
        {
          "id": "cs05b_tv_0",
          "speaker": "旁白",
          "text": "酒馆板上钉着回读摘抄。空与栏并排。",
          "stage": {
            "bg": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs05b_tv_1",
          "speaker": "掌柜",
          "text": "不是我要钉回读。有人出酒钱。挂不挂你们裁。"
        },
        {
          "id": "cs05b_tv_2",
          "speaker": "leader",
          "text": "挂回读。挂三天。谁加字，我认指甲。"
        },
        {
          "id": "cs05b_tv_3",
          "speaker": "石垒·晚担",
          "text": "挂着才像回读账。藏起来才像骗。"
        },
        {
          "id": "cs05b_tv_4",
          "speaker": "槐里·青禾",
          "text": "孩子来抄回读板。抄到空字会停一下。"
        },
        {
          "id": "cs05b_tv_5",
          "speaker": "苇原·灯影",
          "text": "停一下好。不停着抄栏最危险。"
        },
        {
          "id": "cs05b_tv_6",
          "speaker": "老管事",
          "text": "回读后的选择：链仍并排，或栏优先催坐。"
        },
        {
          "id": "cs05b_tv_7",
          "speaker": "岁吏",
          "text": "并排是认空。催坐是认急。"
        },
        {
          "id": "cs05b_tv_8",
          "speaker": "书记官",
          "text": "急好念。空椅难受。难受就对。"
        },
        {
          "id": "cs05b_tv_9",
          "speaker": "老旗手",
          "text": "旗角在门外。核的人能看见回读板。"
        },
        {
          "id": "cs05b_tv_10",
          "speaker": "旁白",
          "text": "花生壳圈还在。圈心写「回读选题」。"
        },
        {
          "id": "cs05b_tv_11",
          "speaker": "掌柜",
          "text": "回读圈心比酒醒。醒着才选得动。"
        },
        {
          "id": "cs05b_tv_12",
          "speaker": "leader",
          "text": "栏与空都看见了。选。"
        },
        {
          "id": "cs05b_tv_13",
          "speaker": "石垒·晚担",
          "text": "我站回读圈外。站着也算见证。"
        },
        {
          "id": "cs05b_tv_14",
          "speaker": "槐里·青禾",
          "text": "见证要写进薄册。不写等于没来。"
        },
        {
          "id": "cs05b_tv_15",
          "speaker": "苇原·灯影",
          "text": "薄册比嘴硬。嘴会改口。"
        },
        {
          "id": "cs05b_tv_16",
          "speaker": "旁白",
          "text": "回读板前安静。安静里只剩两道选择题。"
        },
        {
          "id": "cs05b_tv_17",
          "speaker": "老管事",
          "text": "选完入柜。回读柜门会响。"
        }
      ],
      "actions": [
        {
          "id": "keep_reread",
          "label": "链仍并排",
          "do": [
            {
              "op": "set_flag",
              "flag": "cs05_reread_parallel",

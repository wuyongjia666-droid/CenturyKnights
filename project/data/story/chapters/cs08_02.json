    {
      "id": "ledger",
      "title": "入册",
      "lines": [
        {
          "id": "cs08b_le_1",
          "speaker": "旁白",
          "text": "柜锁落下。碑阴第二可玩章收束。"
        },
        {
          "id": "cs08b_le_2",
          "speaker": "老管事",
          "text": "收束不是结束。是敢把空行留下。"
        },
        {
          "id": "cs08b_le_3",
          "speaker": "书记官",
          "text": "空行进谱。正面一字不改。"
        },
        {
          "id": "cs08b_le_4",
          "speaker": "岁吏",
          "text": "年迹旁已有碑阴一行。"
        },
        {
          "id": "cs08b_le_5",
          "speaker": "leader",
          "text": "我认碑阴这行。认完出门。"
        },
        {
          "id": "cs08b_le_6",
          "speaker": "槐里·青禾",
          "text": "孩子抄完空行。说手不抖了。"
        },
        {
          "id": "cs08b_le_7",
          "speaker": "石垒·晚担",
          "text": "不抖说明没装刻。"
        },
        {
          "id": "cs08b_le_8",
          "speaker": "苇原·灯影",
          "text": "巡夜名单还短。短着也好过假碑。"
        },
        {
          "id": "cs08b_le_9",
          "speaker": "老旗手",
          "text": "旗角给人核。核完祖祠旗还在。"
        },
        {
          "id": "cs08b_le_10",
          "speaker": "掌柜",
          "text": "碑阴圈可以擦。柜里碑阴本擦不掉。"
        },
        {
          "id": "cs08b_le_11",
          "speaker": "老管事",
          "text": "诚实比能念的碑名贵。"
        },
        {
          "id": "cs08b_le_12",
          "speaker": "书记官",
          "text": "入柜时嗓子轻一点。轻着念碑阴，字更真。"
        },
        {
          "id": "cs08b_le_13",
          "speaker": "岁吏",
          "text": "入柜的碑阴第二页比嘴硬。嘴会改口。"
        },
        {
          "id": "cs08b_le_14",
          "speaker": "leader",
          "text": "硬碑留下。软催撕掉。"
        },
        {
          "id": "cs08b_le_15",
          "speaker": "槐里·青禾",
          "text": "撕掉的是催碑条。不是空行。"
        },
        {
          "id": "cs08b_le_16",
          "speaker": "石垒·晚担",
          "text": "碑阴空行过夜。明天还在。"
        },
        {
          "id": "cs08b_le_17",
          "speaker": "苇原·灯影",
          "text": "在就好。在才像碑阴回读。"
        },
        {
          "id": "cs08b_le_18",
          "speaker": "旁白",
          "text": "厅灯灭一盏。碑阴小灯还亮。"
        }
      ]
    }
  ]
}

{
  "id": "cs08_02",
  "title": "碑阴上的灯",
  "title_en": "The Lamp on the Stele Back",
  "legacy_index": 418,
  "return_scene": "res://scenes/hub/castle_hub.tscn",
  "source": "docs/content-seasons/season-08/NOVEL.md",
  "beats": [
    {
      "id": "yard",
      "title": "院门",
      "lines": [
        {
          "id": "cs08b_ya_1",
          "speaker": "旁白",
          "text": "院门还开着。碑阴那面没人站。"
        },
        {
          "id": "cs08b_ya_2",
          "speaker": "老管事",
          "text": "正面念过了。阴面还空着一行。"
        },
        {
          "id": "cs08b_ya_3",
          "speaker": "书记官",
          "text": "空行不是忘。是等回读的人。"
        },
        {
          "id": "cs08b_ya_4",
          "speaker": "leader",
          "text": "我来回读。碑阴也要能念。"
        },
        {
          "id": "cs08b_ya_5",
          "speaker": "岁吏",
          "text": "年迹旁可以补碑阴。不改正面。"
        },
        {
          "id": "cs08b_ya_6",
          "speaker": "槐里·青禾",
          "text": "孩子抄正面会快。抄碑阴会停。"
        },
        {
          "id": "cs08b_ya_7",
          "speaker": "石垒·晚担",
          "text": "停一下好。不停着刻名最危险。"
        },
        {
          "id": "cs08b_ya_8",
          "speaker": "苇原·灯影",
          "text": "灯照碑阴比照正面淡。淡着才看得清空。"
        },
        {
          "id": "cs08b_ya_9",
          "speaker": "老旗手",
          "text": "旗角给人核。核完再谈催碑。"
        },
        {
          "id": "cs08b_ya_10",
          "speaker": "掌柜",
          "text": "酒馆墙上也挂过碑名。挂三天就有人加字。"
        },
        {
          "id": "cs08b_ya_11",
          "speaker": "旁白",
          "text": "院风从碑缝过来。缝里没有急。"
        },
        {
          "id": "cs08b_ya_12",
          "speaker": "老管事",
          "text": "急字过夜会褪。碑阴空行过夜更清楚。"
        },
        {
          "id": "cs08b_ya_13",
          "speaker": "书记官",
          "text": "清楚才像碑。糊了就像没回读。"
        },
        {
          "id": "cs08b_ya_14",
          "speaker": "leader",
          "text": "带我去碑阴。先看空行。"
        },
        {
          "id": "cs08b_ya_15",
          "speaker": "岁吏",
          "text": "空行比满碑诚实。"
        },
        {
          "id": "cs08b_ya_16",
          "speaker": "槐里·青禾",
          "text": "诚实比能喊的碑名贵。"
        },
        {
          "id": "cs08b_ya_17",
          "speaker": "石垒·晚担",
          "text": "我站祠院外。站着也算见证。"
        },
        {
          "id": "cs08b_ya_18",
          "speaker": "旁白",
          "text": "院灯一盏。碑阴第二可玩章起。"
        }
      ],
      "next": "stele"
    },
    {
      "id": "stele",
      "title": "碑阴",
      "lines": [
        {
          "id": "cs08b_st_1",
          "speaker": "旁白",
          "text": "碑阴凉。字的影子比正面短。"
        },
        {
          "id": "cs08b_st_2",
          "speaker": "老管事",
          "text": "这一行空着。空着才像回读位。"
        },
        {
          "id": "cs08b_st_3",
          "speaker": "书记官",
          "text": "正面写满的人，最怕看阴面。"
        },
        {
          "id": "cs08b_st_4",
          "speaker": "leader",
          "text": "我不怕。空行写进今晚。"
        },
        {
          "id": "cs08b_st_5",
          "speaker": "岁吏",
          "text": "写进今晚可以。改正面不行。"
        },
        {
          "id": "cs08b_st_6",
          "speaker": "槐里·青禾",
          "text": "孩子伸手指空行。问谁的名。"
        },
        {
          "id": "cs08b_st_7",
          "speaker": "石垒·晚担",
          "text": "还没有碑名。有名就不叫回读。"
        },
        {
          "id": "cs08b_st_8",
          "speaker": "苇原·灯影",
          "text": "回读不是补喊。是敢把碑阴空留下。"
        },
        {
          "id": "cs08b_st_9",
          "speaker": "老旗手",
          "text": "旗布完整。旗角不绣喊出来的碑名。"
        },
        {
          "id": "cs08b_st_10",
          "speaker": "掌柜",
          "text": "酒钱能买挂板。买不了碑阴的空。"
        },
        {
          "id": "cs08b_st_11",
          "speaker": "旁白",
          "text": "指腹按在空行上。石不烫。"
        },
        {
          "id": "cs08b_st_12",
          "speaker": "老管事",
          "text": "烫的是催碑条。催条可以撕。"
        },
        {
          "id": "cs08b_st_13",
          "speaker": "书记官",
          "text": "碑阴撕不得。撕了正面也假。"
        },
        {
          "id": "cs08b_st_14",
          "speaker": "leader",
          "text": "空行看见了。去沙漏对两行。"
        },
        {
          "id": "cs08b_st_15",
          "speaker": "岁吏",
          "text": "沙漏上行碑名、下行空。并排。"
        },
        {
          "id": "cs08b_st_16",
          "speaker": "槐里·青禾",
          "text": "并排才像碑账。藏起来才像骗。"
        },
        {
          "id": "cs08b_st_17",
          "speaker": "石垒·晚担",
          "text": "骗不过抄碑阴的停顿。"
        },
        {
          "id": "cs08b_st_18",
          "speaker": "旁白",
          "text": "碑阴灯一晃。去沙漏。"
        }
      ],
      "next": "hourglass"
    },
    {
      "id": "hourglass",
      "title": "两行",
      "lines": [
        {
          "id": "cs08b_ho_1",
          "speaker": "旁白",
          "text": "厅灯照着沙漏腰。碑字最清楚。"
        },
        {
          "id": "cs08b_ho_2",
          "speaker": "老管事",
          "text": "两根木条并排。你按住碑名与空行。"
        },
        {
          "id": "cs08b_ho_3",
          "speaker": "书记官",
          "text": "急字在上头跳。空行在下头稳。"
        },
        {
          "id": "cs08b_ho_4",
          "speaker": "leader",
          "text": "我按住碑名。谁也别先催。"
        },
        {
          "id": "cs08b_ho_5",
          "speaker": "岁吏",
          "text": "年迹旁已留位。位给碑阴第二页。"
        },
        {
          "id": "cs08b_ho_6",
          "speaker": "槐里·青禾",
          "text": "孩子说空行像椅子。还没人坐。"
        },
        {
          "id": "cs08b_ho_7",
          "speaker": "石垒·晚担",
          "text": "椅子空着也好过假坐。"
        },
        {
          "id": "cs08b_ho_8",
          "speaker": "苇原·灯影",
          "text": "假坐一夜，碑阴就脏。"
        },
        {
          "id": "cs08b_ho_9",
          "speaker": "老旗手",
          "text": "旗角在风里响。响的是碑核。"
        },
        {
          "id": "cs08b_ho_10",
          "speaker": "掌柜",
          "text": "核完再谈碑酒。酒醒着才选得动。"
        },
        {
          "id": "cs08b_ho_11",
          "speaker": "旁白",
          "text": "沙声很轻。轻着像不敢催碑。"
        },
        {
          "id": "cs08b_ho_12",
          "speaker": "老管事",
          "text": "催碑条可以进酒馆。沙漏不进催条。"
        },
        {
          "id": "cs08b_ho_13",
          "speaker": "书记官",
          "text": "嗓子轻一点。轻着念碑阴，字更真。"
        },
        {
          "id": "cs08b_ho_14",
          "speaker": "leader",
          "text": "碑阴两行对过了。去门廊。"
        },
        {
          "id": "cs08b_ho_15",
          "speaker": "岁吏",
          "text": "门廊问谁加碑字。加字要认指甲。"
        },
        {
          "id": "cs08b_ho_16",
          "speaker": "槐里·青禾",
          "text": "吹不掉才像碑阴。"
        },
        {
          "id": "cs08b_ho_17",
          "speaker": "石垒·晚担",
          "text": "碑痕看见了。去门廊留痕。"
        },
        {
          "id": "cs08b_ho_18",
          "speaker": "旁白",
          "text": "沙漏腰一亮。碑廊在外。"
        }
      ],
      "next": "bridge",
      "actions": [
        {
          "id": "open_hourglass",
          "label": "去看月份怎么往前走",
          "do": [
            {
              "op": "visit",
              "path": "res://scenes/hub/hourglass.tscn"
            }
          ]
        },
        {
          "id": "continue_after_visit",
          "label": "继续，去门廊",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ]
    },
    {
      "id": "bridge",
      "title": "门廊",
      "lines": [
        {
          "id": "cs08b_br_1",
          "speaker": "旁白",
          "text": "桥木响。响的是鞋，不是喊碑名。"
        },
        {
          "id": "cs08b_br_2",
          "speaker": "老旗手",
          "text": "旗角在桥头给人核。核完再谈催碑。"
        },
        {
          "id": "cs08b_br_lost",
          "speaker": "旁白",
          "text": "锋收回来。碑阴纸还钉着。祠旁那拨，没散。",
          "when": {
            "all": [
              {
                "flag": "cs08_02_mid_lost"
              },
              {
                "not_flag": "cs08_02_mid_fought"
              }
            ]
          }
        },
        {
          "id": "cs08b_br_3",
          "speaker": "岁吏",
          "text": "急字在桥风里会褪。碑阴空行过夜更清楚。"
        },
        {
          "id": "cs08b_br_4",
          "speaker": "老管事",
          "text": "带牌去酒馆。碑阴圈还在墙上。"
        },
        {
          "id": "cs08b_br_5",
          "speaker": "书记官",
          "text": "碑圈心比酒醒。醒着才选得动。"
        },
        {
          "id": "cs08b_br_6",
          "speaker": "leader",
          "text": "碑廊问过了。先试锋，再去酒馆。"
        },
        {
          "id": "cs08b_br_7",
          "speaker": "槐里·青禾",
          "text": "锋镝先试一试。试完再去碑阴圈前。"
        },
        {
          "id": "cs08b_br_8",
          "speaker": "石垒·晚担",
          "text": "干净靴也留痕。痕留给碑阴的人。"
        },
        {
          "id": "cs08b_br_9",
          "speaker": "苇原·灯影",
          "text": "牌收回来。碑阴两字没有被风吹掉。"
        },
        {
          "id": "cs08b_br_10",
          "speaker": "掌柜",
          "text": "挂碑阴。挂三天。谁加字，我认指甲。"
        },
        {
          "id": "cs08b_br_11",
          "speaker": "旁白",
          "text": "风从桥下上来。催碑条在风里抖。"
        },
        {
          "id": "cs08b_br_12",
          "speaker": "老旗手",
          "text": "旗布没破。破的是催碑条。"
        },
        {
          "id": "cs08b_br_13",
          "speaker": "岁吏",
          "text": "催条可以撕。碑阴第二页撕不得。"
        },
        {
          "id": "cs08b_br_14",
          "speaker": "老管事",
          "text": "选完入柜。碑阴柜门会响。"
        },
        {
          "id": "cs08b_br_15",
          "speaker": "leader",
          "text": "锋试过或跳过都行。去酒馆看碑阴。"
        },
        {
          "id": "cs08b_br_16",
          "speaker": "槐里·青禾",
          "text": "孩子来抄碑阴板。抄到空行会停一下。"
        },
        {
          "id": "cs08b_br_17",
          "speaker": "石垒·晚担",
          "text": "停一下好。不停着抄碑名最危险。"
        },
        {
          "id": "cs08b_br_18",
          "speaker": "旁白",
          "text": "桥灯一盏。碑酒门开。"
        }
      ],

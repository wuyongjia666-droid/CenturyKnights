    },
    {
      "id": "tavern",
      "title": "选题",
      "lines": [
        {
          "id": "cs09b_ta_1",
          "speaker": "掌柜",
          "text": "不是我要钉验册。有人出酒钱。挂不挂你们裁。"
        },
        {
          "id": "cs09b_ta_2",
          "speaker": "leader",
          "text": "酒馆里先说挂验册。挂三天。谁加字，我认指甲。"
        },
        {
          "id": "cs09b_ta_3",
          "speaker": "石垒·晚担",
          "text": "挂着才像验账。藏起来才像骗。"
        },
        {
          "id": "cs09b_ta_4",
          "speaker": "槐里·青禾",
          "text": "酒桌上孩子来抄验册板。抄到空格会停一下。"
        },
        {
          "id": "cs09b_ta_5",
          "speaker": "苇原·灯影",
          "text": "酒边停一下好。不停着抄血名最危险。"
        },
        {
          "id": "cs09b_ta_6",
          "speaker": "书记官",
          "text": "急好念。空格难受。难受就对。"
        },
        {
          "id": "cs09b_ta_7",
          "speaker": "老旗手",
          "text": "旗角在门外。核的人能看见验册板。"
        },
        {
          "id": "cs09b_ta_8",
          "speaker": "岁吏",
          "text": "年迹旁补验册一行。不改血栏。"
        },
        {
          "id": "cs09b_ta_9",
          "speaker": "老管事",
          "text": "验册圈心比酒醒。醒着才选得动。"
        },
        {
          "id": "cs09b_ta_10",
          "speaker": "leader",
          "text": "血名与空格都看见了。选。"
        },
        {
          "id": "cs09b_ta_11",
          "speaker": "石垒·晚担",
          "text": "我站验册圈外。站着也算见证。"
        },
        {
          "id": "cs09b_ta_12",
          "speaker": "旁白",
          "text": "验册板前安静。安静里只剩两道选择题。"
        },
        {
          "id": "cs09b_ta_13",
          "speaker": "苇原·灯影",
          "text": "验册第二页比嘴硬。嘴会改口。"
        },
        {
          "id": "cs09b_ta_14",
          "speaker": "掌柜",
          "text": "选完入验柜。柜门一响，酒也凉。"
        },
        {
          "id": "cs09b_ta_15",
          "speaker": "书记官",
          "text": "凉着好。烫着容易假验。"
        },
        {
          "id": "cs09b_ta_16",
          "speaker": "槐里·青禾",
          "text": "假血一夜，孩子明天还会停。"
        },
        {
          "id": "cs09b_ta_17",
          "speaker": "老旗手",
          "text": "血验旗还在。旗不替你们选。"
        },
        {
          "id": "cs09b_ta_18",
          "speaker": "旁白",
          "text": "两道验题在板上。手按上去。"
        }
      ],
      "next": "ledger",

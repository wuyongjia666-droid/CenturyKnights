{
  "id": "cs09_02",
  "title": "验册上的灯",
  "title_en": "The Lamp on the Blood Book",
  "legacy_index": 419,
  "return_scene": "res://scenes/hub/castle_hub.tscn",
  "source": "docs/content-seasons/season-09/NOVEL.md",
  "beats": [
    {
      "id": "yard",
      "title": "院门",
      "lines": [
        {
          "id": "cs09b_ya_1",
          "speaker": "旁白",
          "text": "院门半掩。验册桌还摆着。"
        },
        {
          "id": "cs09b_ya_2",
          "speaker": "老管事",
          "text": "血验正面看过了。册脊还空着一格。"
        },
        {
          "id": "cs09b_ya_3",
          "speaker": "书记官",
          "text": "空格不是漏。是等回读的人。"
        },
        {
          "id": "cs09b_ya_4",
          "speaker": "leader",
          "text": "我来回读。验册也要能对。"
        },
        {
          "id": "cs09b_ya_5",
          "speaker": "岁吏",
          "text": "年迹旁可以补验册。不改血栏。"
        },
        {
          "id": "cs09b_ya_6",
          "speaker": "槐里·青禾",
          "text": "孩子不敢碰册脊。说红还在。"
        },
        {
          "id": "cs09b_ya_7",
          "speaker": "石垒·晚担",
          "text": "红在纸上。不在手上。"
        },
        {
          "id": "cs09b_ya_8",
          "speaker": "苇原·灯影",
          "text": "灯照册脊比照血栏淡。淡着才看得清空格。"
        },
        {
          "id": "cs09b_ya_9",
          "speaker": "老旗手",
          "text": "旗角给人核。核完再谈催血。"
        },
        {
          "id": "cs09b_ya_10",
          "speaker": "掌柜",
          "text": "酒馆挂过血名。挂三天就有人描深。"
        },
        {
          "id": "cs09b_ya_11",
          "speaker": "旁白",
          "text": "院风从册页缝过来。缝里没有急。"
        },
        {
          "id": "cs09b_ya_12",
          "speaker": "老管事",
          "text": "急字过夜会褪。验册空格过夜更清楚。"
        },
        {
          "id": "cs09b_ya_13",
          "speaker": "书记官",
          "text": "清楚才像验。糊了就像没回读。"
        },
        {
          "id": "cs09b_ya_14",
          "speaker": "leader",
          "text": "带我去验册。先看空格。"
        },
        {
          "id": "cs09b_ya_15",
          "speaker": "岁吏",
          "text": "空格比满栏诚实。"
        },
        {
          "id": "cs09b_ya_16",
          "speaker": "槐里·青禾",
          "text": "诚实比能喊的血名贵。"
        },
        {
          "id": "cs09b_ya_17",
          "speaker": "石垒·晚担",
          "text": "我站血院外。站着也算见证。"
        },
        {
          "id": "cs09b_ya_18",
          "speaker": "旁白",
          "text": "院灯一盏。验册第二可玩章起。"
        }
      ],
      "next": "blood"
    },
    {
      "id": "blood",
      "title": "验册",
      "lines": [
        {
          "id": "cs09b_bl_1",
          "speaker": "旁白",
          "text": "验册凉。红的影子比栏短。"
        },
        {
          "id": "cs09b_bl_2",
          "speaker": "老管事",
          "text": "这一格空着。空着才像回读位。"
        },
        {
          "id": "cs09b_bl_3",
          "speaker": "书记官",
          "text": "血栏写满的人，最怕看册脊。"
        },
        {
          "id": "cs09b_bl_4",
          "speaker": "leader",
          "text": "我不怕。空格写进今晚。"
        },
        {
          "id": "cs09b_bl_5",
          "speaker": "岁吏",
          "text": "写进今晚可以。改血栏不行。"
        },
        {
          "id": "cs09b_bl_6",
          "speaker": "槐里·青禾",
          "text": "孩子伸手指空格。问谁的血。"
        },
        {
          "id": "cs09b_bl_7",
          "speaker": "石垒·晚担",
          "text": "还没有血名。有名就不叫回读。"
        },
        {
          "id": "cs09b_bl_8",
          "speaker": "苇原·灯影",
          "text": "回读不是补喊。是敢把验空留下。"
        },
        {
          "id": "cs09b_bl_9",
          "speaker": "老旗手",
          "text": "旗布完整。旗角不绣喊出来的血名。"
        },
        {
          "id": "cs09b_bl_10",
          "speaker": "掌柜",
          "text": "酒钱能买挂板。买不了验册的空。"
        },
        {
          "id": "cs09b_bl_11",
          "speaker": "旁白",
          "text": "指腹按在空格上。纸不烫。"
        },
        {
          "id": "cs09b_bl_12",
          "speaker": "老管事",
          "text": "烫的是催血条。催条可以撕。"
        },
        {
          "id": "cs09b_bl_13",
          "speaker": "书记官",
          "text": "验册撕不得。撕了血栏也假。"
        },
        {
          "id": "cs09b_bl_14",
          "speaker": "leader",
          "text": "空格看见了。去沙漏对两行。"
        },
        {
          "id": "cs09b_bl_15",
          "speaker": "岁吏",
          "text": "沙漏上行血名、下行空。并排。"
        },
        {
          "id": "cs09b_bl_16",
          "speaker": "槐里·青禾",
          "text": "并排才像验账。藏起来才像骗。"
        },
        {
          "id": "cs09b_bl_17",
          "speaker": "石垒·晚担",
          "text": "骗不过抄验册的停顿。"
        },
        {
          "id": "cs09b_bl_18",
          "speaker": "旁白",
          "text": "验册灯一晃。去沙漏。"
        }
      ],
      "next": "hourglass"
    },
    {
      "id": "hourglass",
      "title": "两行",
      "lines": [
        {
          "id": "cs09b_ho_1",
          "speaker": "旁白",
          "text": "厅灯照着沙漏腰。血字最清楚。"
        },
        {
          "id": "cs09b_ho_2",
          "speaker": "老管事",
          "text": "两根木条并排。你按住血名与空格。"
        },
        {
          "id": "cs09b_ho_3",
          "speaker": "书记官",
          "text": "急字在上头跳。空格在下头稳。"
        },
        {
          "id": "cs09b_ho_4",
          "speaker": "leader",
          "text": "我按住血名。谁也别先催。"
        },
        {
          "id": "cs09b_ho_5",
          "speaker": "岁吏",
          "text": "年迹旁已留位。位给验册第二页。"
        },
        {
          "id": "cs09b_ho_6",
          "speaker": "槐里·青禾",
          "text": "孩子说空格像碗。还没人盛。"
        },
        {
          "id": "cs09b_ho_7",
          "speaker": "石垒·晚担",
          "text": "碗空着也好过假血。"
        },
        {
          "id": "cs09b_ho_8",
          "speaker": "苇原·灯影",
          "text": "假血一夜，验册就脏。"
        },
        {
          "id": "cs09b_ho_9",
          "speaker": "老旗手",
          "text": "旗角在风里响。响的是验核。"
        },
        {
          "id": "cs09b_ho_10",
          "speaker": "掌柜",
          "text": "核完再谈验酒。酒醒着才选得动。"
        },
        {
          "id": "cs09b_ho_11",
          "speaker": "旁白",
          "text": "沙声很轻。轻着像不敢催血。"
        },
        {
          "id": "cs09b_ho_12",
          "speaker": "老管事",
          "text": "催血条可以进酒馆。沙漏不进催条。"
        },
        {
          "id": "cs09b_ho_13",
          "speaker": "书记官",
          "text": "嗓子轻一点。轻着念验册，字更真。"
        },
        {
          "id": "cs09b_ho_14",
          "speaker": "leader",
          "text": "验册两行对过了。去门廊。"
        },
        {
          "id": "cs09b_ho_15",
          "speaker": "岁吏",
          "text": "门廊问谁加血字。加字要认指甲。"
        },
        {
          "id": "cs09b_ho_16",
          "speaker": "槐里·青禾",
          "text": "吹不掉才像验册。"
        },
        {
          "id": "cs09b_ho_17",
          "speaker": "石垒·晚担",
          "text": "验痕看见了。去门廊留痕。"
        },
        {
          "id": "cs09b_ho_18",
          "speaker": "旁白",
          "text": "沙漏腰一亮。验廊在外。"
        }
      ],
      "next": "bridge",
      "actions": [
        {
          "id": "open_hourglass",
          "label": "去看月份怎么往前走",
          "do": [
            {
              "op": "visit",
              "path": "res://scenes/hub/hourglass.tscn"
            }
          ]
        },
        {
          "id": "continue_after_visit",
          "label": "继续，去门廊",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ]
    },
    {
      "id": "bridge",
      "title": "门廊",
      "lines": [
        {
          "id": "cs09b_br_1",
          "speaker": "旁白",
          "text": "桥木响。响的是鞋，不是喊血名。"
        },
        {
          "id": "cs09b_br_2",
          "speaker": "老旗手",
          "text": "旗角在桥头给人核。核完再谈催血。"
        },
        {
          "id": "cs09b_br_lost",
          "speaker": "旁白",
          "text": "锋收回来。验册纸还钉着。血旁那拨，没散。",
          "when": {
            "all": [
              {
                "flag": "cs09_02_mid_lost"
              },
              {
                "not_flag": "cs09_02_mid_fought"
              }
            ]
          }
        },
        {
          "id": "cs09b_br_3",
          "speaker": "岁吏",
          "text": "急字在桥风里会褪。验册空格过夜更清楚。"
        },
        {
          "id": "cs09b_br_4",
          "speaker": "老管事",
          "text": "带牌去酒馆。验册圈还在墙上。"
        },
        {
          "id": "cs09b_br_5",
          "speaker": "书记官",
          "text": "验圈心比酒醒。醒着才选得动。"
        },
        {
          "id": "cs09b_br_6",
          "speaker": "leader",
          "text": "验廊问过了。先试锋，再去酒馆。"
        },
        {
          "id": "cs09b_br_7",
          "speaker": "槐里·青禾",
          "text": "锋镝先试一试。试完再去验册圈前。"
        },
        {
          "id": "cs09b_br_8",
          "speaker": "石垒·晚担",
          "text": "干净靴也留痕。痕留给验册的人。"
        },
        {
          "id": "cs09b_br_9",
          "speaker": "苇原·灯影",
          "text": "牌收回来。验册两字没有被风吹掉。"
        },
        {
          "id": "cs09b_br_10",
          "speaker": "掌柜",
          "text": "挂验册。挂三天。谁加字，我认指甲。"
        },
        {
          "id": "cs09b_br_11",
          "speaker": "旁白",
          "text": "风从桥下上来。催血条在风里抖。"
        },
        {
          "id": "cs09b_br_12",
          "speaker": "老旗手",
          "text": "旗布没破。破的是催血条。"
        },
        {
          "id": "cs09b_br_13",
          "speaker": "岁吏",
          "text": "催条可以撕。验册第二页撕不得。"
        },
        {
          "id": "cs09b_br_14",
          "speaker": "老管事",
          "text": "选完入柜。验册柜门会响。"
        },
        {
          "id": "cs09b_br_15",
          "speaker": "leader",
          "text": "锋试过或跳过都行。去酒馆看验册。"
        },
        {
          "id": "cs09b_br_16",
          "speaker": "槐里·青禾",
          "text": "孩子来抄验册板。抄到空格会停一下。"
        },
        {
          "id": "cs09b_br_17",
          "speaker": "石垒·晚担",
          "text": "停一下好。不停着抄血名最危险。"
        },
        {
          "id": "cs09b_br_18",
          "speaker": "旁白",
          "text": "桥灯一盏。验酒门开。"
        }
      ],

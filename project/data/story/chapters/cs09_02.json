    {
      "id": "ledger",
      "title": "入册",
      "lines": [
        {
          "id": "cs09b_le_1",
          "speaker": "旁白",
          "text": "柜锁落下。验册第二可玩章收束。"
        },
        {
          "id": "cs09b_le_2",
          "speaker": "老管事",
          "text": "收束不是结束。是敢把空格留下。"
        },
        {
          "id": "cs09b_le_3",
          "speaker": "书记官",
          "text": "空格进谱。血栏一字不改。"
        },
        {
          "id": "cs09b_le_4",
          "speaker": "岁吏",
          "text": "年迹旁已有验册一行。"
        },
        {
          "id": "cs09b_le_5",
          "speaker": "leader",
          "text": "我认验册这行。认完出门。"
        },
        {
          "id": "cs09b_le_6",
          "speaker": "槐里·青禾",
          "text": "孩子抄完空格。说手不抖了。"
        },
        {
          "id": "cs09b_le_7",
          "speaker": "石垒·晚担",
          "text": "不抖说明没装血。"
        },
        {
          "id": "cs09b_le_8",
          "speaker": "苇原·灯影",
          "text": "巡夜名单还短。短着也好过假验。"
        },
        {
          "id": "cs09b_le_9",
          "speaker": "老旗手",
          "text": "旗角给人核。核完血验旗还在。"
        },
        {
          "id": "cs09b_le_10",
          "speaker": "掌柜",
          "text": "验册圈可以擦。柜里验册本擦不掉。"
        },
        {
          "id": "cs09b_le_11",
          "speaker": "老管事",
          "text": "诚实比能念的血名贵。"
        },
        {
          "id": "cs09b_le_12",
          "speaker": "书记官",
          "text": "入柜时嗓子轻一点。轻着念验册，字更真。"
        },
        {
          "id": "cs09b_le_13",
          "speaker": "岁吏",
          "text": "入柜的验册第二页比嘴硬。嘴会改口。"
        },
        {
          "id": "cs09b_le_14",
          "speaker": "leader",
          "text": "硬验留下。软催撕掉。"
        },
        {
          "id": "cs09b_le_15",
          "speaker": "槐里·青禾",
          "text": "撕掉的是催血条。不是空格。"
        },
        {
          "id": "cs09b_le_16",
          "speaker": "石垒·晚担",
          "text": "验册空格过夜。明天还在。"
        },
        {
          "id": "cs09b_le_17",
          "speaker": "苇原·灯影",
          "text": "在就好。在才像验册回读。"
        },
        {
          "id": "cs09b_le_18",
          "speaker": "旁白",
          "text": "厅灯灭一盏。验册小灯还亮。"
        }
      ]
    }
  ]
}

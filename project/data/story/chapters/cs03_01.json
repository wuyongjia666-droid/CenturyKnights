    {
      "id": "ledger",
      "title": "入册",
      "lines": [
        {
          "id": "cs03_led_0",
          "speaker": "旁白",
          "text": "对照册封面四个字：榜上的收成。柜上两把钥匙。",
          "stage": {
            "bg": "hall",
            "camera": "close"
          }
        },
        {
          "id": "cs03_led_par",
          "speaker": "旁白",
          "text": "你留下两行。朝报仍爱一行。柜子认灯。",
          "when": {
            "flag": "cs03_kept_parallel"
          }
        },
        {
          "id": "cs03_led_merit",
          "speaker": "旁白",
          "text": "你先只留功。黄纸仍在墙上——风会替你念下行。",
          "when": {
            "flag": "cs03_merit_only"
          }
        },
        {
          "id": "cs03_led_1",
          "speaker": "老管事",
          "text": "存档不刊也行。不丢，就是缝。"
        },
        {
          "id": "cs03_led_2",
          "speaker": "槐里·青禾",
          "text": "孩子摸过亏，才配以后夸功。"
        },
        {
          "id": "cs03_led_3",
          "speaker": "老旗手",
          "text": "并排。不要裁。缝在旗角内侧。"
        },
        {
          "id": "cs03_led_4",
          "speaker": "石垒·晚担",
          "text": "田还在。泥洗了也能吃。"
        },
        {
          "id": "cs03_led_5",
          "speaker": "苇原·灯影",
          "text": "弓还在。下次抽工，下行先响。"
        },
        {
          "id": "cs03_led_6",
          "speaker": "leader",
          "text": "功与粮，并排。谁来认收成，先念完。"
        },
        {
          "id": "cs03_ledger_x0",
          "speaker": "旁白",
          "text": "对照册入柜。柜门响，像同意。"
        },
        {
          "id": "cs03_ledger_x1",
          "speaker": "老管事",
          "text": "每月敲。飘就是想裁。"
        },
        {
          "id": "cs03_ledger_x2",
          "speaker": "槐里·青禾",
          "text": "奖状是上行的瘾。门口有泥就行。"
        },
        {
          "id": "cs03_ledger_x3",
          "speaker": "石垒·晚担",
          "text": "泥说明人还从田里回来。"
        },
        {
          "id": "cs03_ledger_x4",
          "speaker": "苇原·灯影",
          "text": "页眉下留两行空白。空白是诚实位子。"
        },
        {
          "id": "cs03_ledger_x5",
          "speaker": "掌柜",
          "text": "田情投票：黄纸先于白纸。"
        },
        {
          "id": "cs03_ledger_x6",
          "speaker": "老旗手",
          "text": "密针还在。不解释。"
        },
        {
          "id": "cs03_ledger_x7",
          "speaker": "书记官",
          "text": "册首短戒，执行才长。"
        },
        {
          "id": "cs03_ledger_x8",
          "speaker": "旁白",
          "text": "开春第一笔工进下行。上行仍可空。"
        },
        {
          "id": "cs03_ledger_y0",
          "speaker": "旁白",
          "text": "柜里潮气护着对照。"
        },
        {
          "id": "cs03_ledger_y1",
          "speaker": "槐里·青禾",
          "text": "空白位子还在，就还诚实。"
        },
        {
          "id": "cs03_ledger_y20",
          "speaker": "旁白",
          "text": "仓门风从缝里进。"
        },
        {
          "id": "cs03_ledger_y21",
          "speaker": "石垒·晚担",
          "text": "风进得去，假数进不去。"
        },
        {
          "id": "cs03_ledger_y22",
          "speaker": "leader",
          "text": "数要真。"
        },
        {
          "id": "cs03_ledger_x9",
          "speaker": "leader",
          "text": "功与粮，并排。谁来谈收成，先念完。"
        }
      ],
      "actions": []
    }

    {
      "id": "tavern",
      "title": "钉墙",
      "lines": [
        {
          "id": "cs03_tav_0",
          "speaker": "旁白",
          "text": "烽火酒馆墙上，白纸摘要旁钉着黄纸月结。",
          "stage": {
            "bg": "tavern",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_tav_1",
          "speaker": "掌柜",
          "text": "篇幅不够就钉墙。墙比朝报宽。"
        },
        {
          "id": "cs03_tav_2",
          "speaker": "槐里·青禾",
          "text": "裁亏的人，先把剪刀放下。"
        },
        {
          "id": "cs03_tav_3",
          "speaker": "老管事",
          "text": "并排钉。谁撕黄纸，谁结账。"
        },
        {
          "id": "cs03_tav_4",
          "speaker": "石垒·晚担",
          "text": "功是看的，粮是吃的。两样都要。"
        },
        {
          "id": "cs03_tav_5",
          "speaker": "苇原·灯影",
          "text": "路还通。谁买一行结论，带他去摸木条。"
        },
        {
          "id": "cs03_tavern_x0",
          "speaker": "旁白",
          "text": "白纸黄纸并排。钉子一高一低。"
        },
        {
          "id": "cs03_tavern_x1",
          "speaker": "掌柜",
          "text": "齐了像广告。不齐像日子。"
        },
        {
          "id": "cs03_tavern_x2",
          "speaker": "槐里·青禾",
          "text": "先藏黄纸的人，明年还刺。"
        },
        {
          "id": "cs03_tavern_x3",
          "speaker": "石垒·晚担",
          "text": "刺在明处，人手才进田。"
        },
        {
          "id": "cs03_tavern_x4",
          "speaker": "苇原·灯影",
          "text": "稳钉不晃。晃的是还想盖住的人。"
        },
        {
          "id": "cs03_tavern_x5",
          "speaker": "老旗手",
          "text": "倒下时看不见朝报，看得见内侧。"
        },
        {
          "id": "cs03_tavern_x6",
          "speaker": "书记官",
          "text": "新摘要是旧病。"
        },
        {
          "id": "cs03_tavern_x7",
          "speaker": "旁白",
          "text": "圈画在墙上，脏着看得见。"
        },
        {
          "id": "cs03_tavern_x8",
          "speaker": "掌柜",
          "text": "选题：并排，或先只留功。"
        },
        {
          "id": "cs03_tavern_y0",
          "speaker": "旁白",
          "text": "黄纸边有泥指印。"
        },
        {
          "id": "cs03_tavern_y1",
          "speaker": "掌柜",
          "text": "泥指印是投票。"
        },
        {
          "id": "cs03_tavern_y17",
          "speaker": "旁白",
          "text": "功簿墨干得慢。慢干的字沉。"
        },
        {
          "id": "cs03_tavern_y18",
          "speaker": "石垒·晚担",
          "text": "沉字扛得住粮。"
        },
        {
          "id": "cs03_tavern_y19",
          "speaker": "leader",
          "text": "功与粮并排。"
        },
        {
          "id": "cs03_tavern_x9",
          "speaker": "旁白",
          "text": "你得选。选完进对照册。"
        }
      ],

              "beat": "ledger"
            }
          ]
        },
        {
          "id": "merit_only",
          "label": "先只留功",
          "do": [
            {
              "op": "set_flag",
              "flag": "cs03_merit_only",
              "value": true
            },
            {
              "op": "season_ledger",
              "chapter": "cs03_01",
              "choice": "merit_only",
              "title": "榜上的收成",
              "outcome": "先只留功，粮行暂空",
              "yeartrace": true
            },
            {
              "op": "goto",
              "beat": "ledger"
            }
          ]
        }
      ]
    },
    {
      "id": "ledger",
      "title": "入册",
      "lines": [
        {
          "id": "cs03_led_0",
          "speaker": "旁白",
          "text": "对照册封面四个字：榜上的收成。柜上两把钥匙。",
          "stage": {
            "bg": "hall",
            "camera": "close"
          }
        },
        {
          "id": "cs03_led_par",
          "speaker": "旁白",
          "text": "你留下两行。朝报仍爱一行。柜子认灯。",
          "when": {
            "flag": "cs03_kept_parallel"
          }
        },
        {
          "id": "cs03_led_merit",
          "speaker": "旁白",
          "text": "你先只留功。黄纸仍在墙上——风会替你念下行。",
          "when": {
            "flag": "cs03_merit_only"
          }
        },
        {
          "id": "cs03_led_1",
          "speaker": "老管事",
          "text": "存档不刊也行。不丢，就是缝。"
        },
        {
          "id": "cs03_led_2",
          "speaker": "槐里·青禾",
          "text": "孩子摸过亏，才配以后夸功。"
        },
        {
          "id": "cs03_led_3",
          "speaker": "老旗手",
          "text": "并排。不要裁。缝在旗角内侧。"
        },
        {
          "id": "cs03_led_4",
          "speaker": "石垒·晚担",
          "text": "田还在。泥洗了也能吃。"
        },
        {
          "id": "cs03_led_5",
          "speaker": "苇原·灯影",
          "text": "弓还在。下次抽工，下行先响。"
        },
        {
          "id": "cs03_led_6",
          "speaker": "leader",
          "text": "功与粮，并排。谁来认收成，先念完。"
        },
        {
          "id": "cs03_led_7",
          "speaker": "旁白",
          "text": "雪盖陆桥时，拓片还在。两行之间的空，给人脸红。"
        }
      ],
      "actions": []
    }
  ]
}

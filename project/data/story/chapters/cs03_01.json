{
  "id": "cs03_01",
  "title": "榜上的收成",
  "legacy_index": 403,
  "return_scene": "res://scenes/hub/castle_hub.tscn",
  "source": "docs/content-seasons/season-03/NOVEL.md",
  "beats": [
    {
      "id": "merit",
      "title": "记功",
      "next": "estate",
      "lines": [
        {
          "id": "cs03_merit_0",
          "speaker": "旁白",
          "text": "议会侧厅灯短。朝报军功栏摊开，印泥还新。",
          "stage": {
            "card": "一　记功",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_merit_1",
          "speaker": "书记官",
          "text": "委托交差了。朝报这一栏，写你们的功。"
        },
        {
          "id": "cs03_merit_2",
          "speaker": "leader",
          "text": "写。"
        },
        {
          "id": "cs03_merit_3",
          "speaker": "旁白",
          "text": "印章按下。摘要只留交付两字，像刚擦过的刀。"
        },
        {
          "id": "cs03_merit_4",
          "speaker": "书记官",
          "text": "重大军功月份才抄附录。平常只留摘要。"
        },
        {
          "id": "cs03_merit_5",
          "speaker": "石垒·晚担",
          "text": "摘要里没有田。田在不在，谁管？"
        },
        {
          "id": "cs03_merit_6",
          "speaker": "苇原·灯影",
          "text": "管的人在属地。先去对月结。"
        },
        {
          "id": "cs03_merit_x0",
          "speaker": "旁白",
          "text": "朝报墨香刺鼻。刺鼻的功，要拿田情对。"
        },
        {
          "id": "cs03_merit_x1",
          "speaker": "书记官",
          "text": "交付入栏。入栏不是收成。"
        },
        {
          "id": "cs03_merit_x2",
          "speaker": "老旗手",
          "text": "功章边齐。齐边好看，不认泥。"
        },
        {
          "id": "cs03_merit_x3",
          "speaker": "槐里·青禾",
          "text": "好看留给外人。泥留给自己。"
        },
        {
          "id": "cs03_merit_x4",
          "speaker": "石垒·晚担",
          "text": "功可以小写。粮不能假写。"
        },
        {
          "id": "cs03_merit_x5",
          "speaker": "苇原·灯影",
          "text": "北隘有人卖齐边拓片。香是急。"
        },
        {
          "id": "cs03_merit_x6",
          "speaker": "掌柜",
          "text": "白纸我钉高一点。故意不齐。"
        },
        {
          "id": "cs03_merit_x7",
          "speaker": "老管事",
          "text": "核条敲两下：功，粮。"
        },
        {
          "id": "cs03_merit_x8",
          "speaker": "旁白",
          "text": "栏里功名新，地里工还空着。"
        },
        {
          "id": "cs03_merit_y0",
          "speaker": "旁白",
          "text": "功章复印件边齐得过分。"
        },
        {
          "id": "cs03_merit_y1",
          "speaker": "石垒·晚担",
          "text": "过分的齐，称起来轻。"
        },
        {
          "id": "cs03_merit_y18",
          "speaker": "旁白",
          "text": "功簿墨干得慢。慢干的字沉。"
        },
        {
          "id": "cs03_merit_y19",
          "speaker": "石垒·晚担",
          "text": "沉字扛得住粮。"
        },
        {
          "id": "cs03_merit_y20",
          "speaker": "leader",
          "text": "功与粮并排。"
        },
        {
          "id": "cs03_merit_x9",
          "speaker": "leader",
          "text": "先记功。记下，去对月结。"
        }
      ]
    },
    {
      "id": "estate",
      "title": "月结",
      "next": "hourglass",
      "lines": [
        {
          "id": "cs03_est_0",
          "speaker": "旁白",
          "text": "属地厢房桌上，月结黄纸压着泥印。数比摘要刺眼。",
          "stage": {
            "bg": "hall",
            "camera": "close"
          }
        },
        {
          "id": "cs03_est_1",
          "speaker": "老管事",
          "text": "属地月结出来了。炭笔点过三下。"
        },
        {
          "id": "cs03_est_2",
          "speaker": "leader",
          "text": "和朝报对过吗？"
        },
        {
          "id": "cs03_est_3",
          "speaker": "老管事",
          "text": "对过。对不上。工被抽去护粮，穗少了。"
        },
        {
          "id": "cs03_est_4",
          "speaker": "槐里·青禾",
          "text": "功很大，田很小。这句别只在嘴里转。"
        },
        {
          "id": "cs03_est_5",
          "speaker": "老管事",
          "text": "沙漏厅有两行空木条。上行等功，下行等粮。"
        },
        {
          "id": "cs03_est_6",
          "speaker": "石垒·晚担",
          "text": "并排才算数。单行是骗人。"
        },
        {
          "id": "cs03_estate_x0",
          "speaker": "旁白",
          "text": "属地月结摊开。损耗那行扎眼。"
        },
        {
          "id": "cs03_estate_x1",
          "speaker": "老管事",
          "text": "对不上就写对不上。别改成调度中。"
        },
        {
          "id": "cs03_estate_x2",
          "speaker": "槐里·青禾",
          "text": "调度中是雾。名字是路。"
        },
        {
          "id": "cs03_estate_x3",
          "speaker": "石垒·晚担",
          "text": "病、渠、丧——三个名字比雾硬。"
        },
        {
          "id": "cs03_estate_x4",
          "speaker": "苇原·灯影",
          "text": "逾期抄到墙侧。逾期不是丢人。"
        },
        {
          "id": "cs03_estate_x5",
          "speaker": "掌柜",
          "text": "黄纸先更新。地里的数不等人盖印。"
        },
        {
          "id": "cs03_estate_x6",
          "speaker": "老旗手",
          "text": "内侧那句还在：并排，不要裁。"
        },
        {
          "id": "cs03_estate_x7",
          "speaker": "书记官",
          "text": "朝报不爱逾期。属地爱真。"
        },
        {
          "id": "cs03_estate_x8",
          "speaker": "旁白",
          "text": "抽屉潮。潮着的条更像月。"
        },
        {
          "id": "cs03_estate_y0",
          "speaker": "旁白",
          "text": "损耗行的墨比功栏深。"
        },
        {
          "id": "cs03_estate_y1",
          "speaker": "老管事",
          "text": "深的是地。"
        },
        {
          "id": "cs03_estate_y18",
          "speaker": "旁白",
          "text": "仓门风从缝里进。"
        },
        {
          "id": "cs03_estate_y19",
          "speaker": "石垒·晚担",
          "text": "风进得去，假数进不去。"
        },
        {
          "id": "cs03_estate_y20",
          "speaker": "leader",
          "text": "数要真。"
        },
        {
          "id": "cs03_estate_x9",
          "speaker": "leader",
          "text": "月结收下。去沙漏看两行。"
        }
      ]
    },
    {
      "id": "hourglass",
      "title": "两行",
      "next": "bridge",
      "lines": [
        {
          "id": "cs03_hg_0",
          "speaker": "旁白",
          "text": "沙漏厅里，上行刻交付，下行刻不足。凹槽深浅不同。",
          "stage": {
            "bg": "hall",
            "camera": "close"
          }
        },
        {
          "id": "cs03_hg_1",
          "speaker": "老旗手",
          "text": "一行是功，一行是粮。您看哪一行？"
        },
        {
          "id": "cs03_hg_2",
          "speaker": "leader",
          "text": "都看。并排。"
        },
        {
          "id": "cs03_hg_3",
          "speaker": "老管事",
          "text": "每月来摸。跳行的人，不配谈收成。"
        },
        {
          "id": "cs03_hg_4",
          "speaker": "槐里·青禾",
          "text": "摸过亏的人，才配夸功。"
        },
        {
          "id": "cs03_hg_5",
          "speaker": "苇原·灯影",
          "text": "陆桥有人问粮价。带拓片去。"
        },
        {
          "id": "cs03_hourglass_x0",
          "speaker": "旁白",
          "text": "沙漏上行功、下行粮。铜珠认格不认夸。"
        },
        {
          "id": "cs03_hourglass_x1",
          "speaker": "老管事",
          "text": "并排刻。裁一行，另一行会报复。"
        },
        {
          "id": "cs03_hourglass_x2",
          "speaker": "石垒·晚担",
          "text": "空窗月上行空着也好。空着提醒春从渠口开始。"
        },
        {
          "id": "cs03_hourglass_x3",
          "speaker": "苇原·灯影",
          "text": "有人要第三行写闲话。拒绝。"
        },
        {
          "id": "cs03_hourglass_x4",
          "speaker": "槐里·青禾",
          "text": "闲话转正，地会渴。"
        },
        {
          "id": "cs03_hourglass_x5",
          "speaker": "书记官",
          "text": "术语页只留短戒：田情≈下行。"
        },
        {
          "id": "cs03_hourglass_x6",
          "speaker": "掌柜",
          "text": "日子不齐。不齐像对照。"
        },
        {
          "id": "cs03_hourglass_x7",
          "speaker": "老旗手",
          "text": "旗角内侧陪过空窗。"
        },
        {
          "id": "cs03_hourglass_x8",
          "speaker": "旁白",
          "text": "两行影子叠在桌上，谁也不盖谁。"
        },
        {
          "id": "cs03_hourglass_y0",
          "speaker": "旁白",
          "text": "砂落声细。细声里两行都不躲。"
        },
        {
          "id": "cs03_hourglass_y1",
          "speaker": "书记官",
          "text": "躲的摘要，我拒抄。"
        },
        {
          "id": "cs03_hourglass_y17",
          "speaker": "旁白",
          "text": "功簿墨干得慢。慢干的字沉。"
        },
        {
          "id": "cs03_hourglass_y18",
          "speaker": "石垒·晚担",
          "text": "沉字扛得住粮。"
        },
        {
          "id": "cs03_hourglass_y19",
          "speaker": "leader",
          "text": "功与粮并排。"
        },
        {
          "id": "cs03_hourglass_x9",
          "speaker": "leader",
          "text": "两行都亮。去门廊。"
        }
      ],
      "actions": [
        {
          "id": "open_hourglass",
          "label": "去看月份怎么往前走",
          "do": [
            {
              "op": "visit",
              "path": "res://scenes/hub/hourglass.tscn"
            }
          ]
        },
        {
          "id": "continue_after_visit",
          "label": "继续，去门廊",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ]
    },
    {
      "id": "bridge",
      "title": "桥上",
      "next": "tavern",
      "lines": [
        {
          "id": "cs03_br_0",
          "speaker": "旁白",
          "text": "朔澜陆桥铃响。商队围着拓片，有人伸手摸凹槽。",
          "stage": {
            "bg": "tavern",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_br_1",
          "speaker": "掌柜",
          "text": "北隘粮怎么贵了？酒馆也在问。"
        },
        {
          "id": "cs03_br_2",
          "speaker": "leader",
          "text": "贵在工被功抽走了。榜上的功，先把下行念完。"
        },
        {
          "id": "cs03_br_3",
          "speaker": "石垒·晚担",
          "text": "有人只爱听上行。听完就去借我们的功。"
        },
        {
          "id": "cs03_br_4",
          "speaker": "苇原·灯影",
          "text": "借得了功，借不走泥。泥还在南田。"
        },
        {
          "id": "cs03_br_5",
          "speaker": "老旗手",
          "text": "铃停了也要留字。字在，对照就还活着。"
        },
        {
          "id": "cs03_bridge_x0",
          "speaker": "旁白",
          "text": "陆桥风硬。拓片边毛，泥点还在。"
        },
        {
          "id": "cs03_bridge_x1",
          "speaker": "石垒·晚担",
          "text": "边毛是真。香是急。"
        },
        {
          "id": "cs03_bridge_x2",
          "speaker": "苇原·灯影",
          "text": "假拓片揉碎的声音，像短促认错。"
        },
        {
          "id": "cs03_bridge_x3",
          "speaker": "槐里·青禾",
          "text": "粮价问下行。不问印章热不热。"
        },
        {
          "id": "cs03_bridge_x4",
          "speaker": "老管事",
          "text": "轴响比铃响真。轴要载得动。"
        },
        {
          "id": "cs03_bridge_x5",
          "speaker": "掌柜",
          "text": "功价？功不卖。粮换盐走下行。"
        },
        {
          "id": "cs03_bridge_x6",
          "speaker": "老旗手",
          "text": "同盟先对田情。对不上只是酒。"
        },
        {
          "id": "cs03_bridge_x7",
          "speaker": "书记官",
          "text": "抄件边齐的，称起来轻。"
        },
        {
          "id": "cs03_bridge_x8",
          "speaker": "旁白",
          "text": "桥板下南田泥色还留着。"
        },
        {
          "id": "cs03_bridge_y0",
          "speaker": "旁白",
          "text": "桥风把假拓片吹歪。"
        },
        {
          "id": "cs03_bridge_y1",
          "speaker": "苇原·灯影",
          "text": "歪了正好。真的不怕歪。"
        },
        {
          "id": "cs03_bridge_x9",
          "speaker": "leader",
          "text": "看完拓片。去酒馆选题。"
        },
        {
          "id": "cs03_mid_y18",
          "speaker": "旁白",
          "text": "仓门风从缝里进。"
        },
        {
          "id": "cs03_mid_y19",
          "speaker": "石垒·晚担",
          "text": "风进得去，假数进不去。"
        },
        {
          "id": "cs03_mid_y20",
          "speaker": "leader",
          "text": "数要真。"
        },
        {
          "id": "cs03_mid_lost",
          "speaker": "旁白",
          "text": "锋收回来。桥铃还响。拓片旁那拨，没散。",
          "when": {
            "all": [
              {
                "flag": "cs03_mid_lost"
              },
              {
                "not_flag": "cs03_mid_fought"
              }
            ]
          }
        }
      ],

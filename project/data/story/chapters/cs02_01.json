{
  "id": "cs02_01",
  "title": "婚约上的灯",
  "legacy_index": 402,
  "return_scene": "res://scenes/hub/castle_hub.tscn",
  "source": "docs/content-seasons/season-02/NOVEL.md",
  "beats": [
    {
      "id": "seal",
      "title": "落印",
      "next": "estate",
      "lines": [
        {
          "id": "cs02_seal_0",
          "speaker": "旁白",
          "text": "议会侧厅没有窗。灯芯剪得短，只够照名册那一栏。",
          "stage": {
            "card": "一　落印",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs02_seal_1",
          "speaker": "书记官",
          "text": "写你们要的姓。写完改不了。议会按这一栏认嗣。"
        },
        {
          "id": "cs02_seal_2",
          "speaker": "leader",
          "text": "写。"
        },
        {
          "id": "cs02_seal_3",
          "speaker": "旁白",
          "text": "铜印按下去，蜡油滋地一声。那个字慢慢干。"
        },
        {
          "id": "cs02_seal_4",
          "speaker": "书记官",
          "text": "婚仪记入本月。属地会收到条。沙漏也会多一行。"
        },
        {
          "id": "cs02_seal_5",
          "speaker": "槐里·青禾",
          "text": "盖印之前问价钱。盖印之后，问的是灯。"
        },
        {
          "id": "cs02_seal_6",
          "speaker": "老旗手",
          "text": "落下就重。别指望风帮你吹轻。"
        },
        {
          "id": "cs02_seal_7",
          "speaker": "leader",
          "text": "印落下了。我们去对条。"
        }
      ]
    },
    {
      "id": "estate",
      "title": "属地条",
      "next": "birth",
      "lines": [
        {
          "id": "cs02_est_0",
          "speaker": "旁白",
          "text": "属地厢房桌上，月回响条按月叠。最上头一张还新。",
          "stage": {
            "bg": "hall",
            "camera": "close"
          }
        },
        {
          "id": "cs02_est_1",
          "speaker": "老管事",
          "text": "上月婚仪。银两、酒、证人，三栏齐。沙漏同步。"
        },
        {
          "id": "cs02_est_2",
          "speaker": "老管事",
          "text": "细注写：联姻落定——待诞育回执。"
        },
        {
          "id": "cs02_est_3",
          "speaker": "槐里·青禾",
          "text": "待？"
        },
        {
          "id": "cs02_est_4",
          "speaker": "老管事",
          "text": "婚约是旗。孩子是灯。灯没亮，名册只认婚，不认脉。"
        },
        {
          "id": "cs02_est_5",
          "speaker": "石垒·晚担",
          "text": "空也比假好。别先替它填字。"
        },
        {
          "id": "cs02_est_6",
          "speaker": "苇原·灯影",
          "text": "急去酒馆听。酒馆比属地快。"
        },
        {
          "id": "cs02_est_7",
          "speaker": "旁白",
          "text": "沙漏厅里，铜珠滚过婚仪那一格，轻轻一响。"
        },
        {
          "id": "cs02_est_8",
          "speaker": "leader",
          "text": "记了不等于认了。等回执。"
        },
        {
          "id": "cs02_mid_lost",
          "speaker": "旁白",
          "text": "锋收回来。院墙外的影子还在。婚约灯还没点。",
          "when": {
            "all": [
              {
                "flag": "cs02_mid_lost"
              },
              {
                "not_flag": "cs02_mid_fought"
              }
            ]
          }
        }
      ],

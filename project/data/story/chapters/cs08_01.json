{
  "id": "cs08_01",
  "title": "祖祠上的灯",
  "legacy_index": 408,
  "return_scene": "res://scenes/hub/castle_hub.tscn",
  "source": "docs/content-seasons/season-08/NOVEL.md",
  "beats": [
    {
      "id": "yard",
      "title": "挂栏",
      "next": "stele",
      "lines": [
        {
          "id": "cs08_yd_0",
          "speaker": "旁白",
          "text": "祖祠。名册末行空着。祖祠上的灯还亮。",
          "stage": {
            "card": "一　挂栏",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs08_yd_1",
          "speaker": "书记官",
          "text": "议会要听念。栏要写得正，写得能念。"
        },
        {
          "id": "cs08_yd_2",
          "speaker": "leader",
          "text": "写碑已写。"
        },
        {
          "id": "cs08_yd_3",
          "speaker": "旁白",
          "text": "笔尖停一下。末行落下「碑已写」三字。"
        },
        {
          "id": "cs08_yd_4",
          "speaker": "老旗手",
          "text": "旗册誊栏。旗角不给人卖名。"
        },
        {
          "id": "cs08_yd_5",
          "speaker": "岁吏",
          "text": "谱可以进栏。祖祠是另一本账。"
        },
        {
          "id": "cs08_yd_6",
          "speaker": "石垒·晚担",
          "text": "写好看不难。站得住才难。"
        },
        {
          "id": "cs08_yard_x0",
          "speaker": "旁白",
          "text": "笔搁在边上。墨还没干，催条已经又来一张。"
        },
        {
          "id": "cs08_yard_x1",
          "speaker": "书记官",
          "text": "催条爱写「已」。已字一多，空格就难受。"
        },
        {
          "id": "cs08_yard_x2",
          "speaker": "老管事",
          "text": "难受就对。难受说明栏还没骗过人。"
        },
        {
          "id": "cs08_yard_x3",
          "speaker": "槐里·青禾",
          "text": "孩子以后抄名册，先抄空，再抄满。"
        },
        {
          "id": "cs08_yard_x4",
          "speaker": "苇原·灯影",
          "text": "巡防夜里走过，看见空格，才肯信这灯。"
        },
        {
          "id": "cs08_yard_x5",
          "speaker": "老旗手",
          "text": "旗角给人核。核的时候，空比满更像真。"
        },
        {
          "id": "cs08_yard_x6",
          "speaker": "岁吏",
          "text": "年迹匣认空。空着，红脸少记一笔。"
        },
        {
          "id": "cs08_yard_x7",
          "speaker": "石垒·晚担",
          "text": "桩要站。站之前，别先把名字钉死。"
        },
        {
          "id": "cs08_yard_x8",
          "speaker": "旁白",
          "text": "厅里风小。风小的时候，人更容易听见自己的急。"
        },
        {
          "id": "cs08_yard_x9",
          "speaker": "掌柜",
          "text": "酒馆墙上有圈。圈等选题，不等人喊已经。"
        },
        {
          "id": "cs08_yd_y17",
          "speaker": "旁白",
          "text": "碑阴潮。潮处字口更深。"
        },
        {
          "id": "cs08_yd_y18",
          "speaker": "石垒·晚担",
          "text": "深的才经年。"
        },
        {
          "id": "cs08_yd_y19",
          "speaker": "leader",
          "text": "我认深刻。"
        },
        {
          "id": "cs08_yd_7",
          "speaker": "leader",
          "text": "栏挂上了。去看祖祠。"
        }
      ]
    },
    {
      "id": "stele",
      "title": "祖祠",
      "next": "hourglass",
      "lines": [
        {
          "id": "cs08_st_0",
          "speaker": "旁白",
          "text": "祖祠未结。灯照着香灰上的白。",
          "stage": {
            "bg": "hall",
            "camera": "close"
          }
        },
        {
          "id": "cs08_st_1",
          "speaker": "老管事",
          "text": "祖祠：对碑已记，点灯待对。碑名栏仍空。"
        },
        {
          "id": "cs08_st_2",
          "speaker": "旁白",
          "text": "名册说碑已写。祖祠说还在对。两行字第一次吵架。"
        },
        {
          "id": "cs08_st_3",
          "speaker": "苇原·灯影",
          "text": "巡防不问谁入祠。问今夜谁还没对碑。"
        },
        {
          "id": "cs08_st_4",
          "speaker": "槐里·青禾",
          "text": "空着才诚实。写满却站不上去，才是骗人。"
        },
        {
          "id": "cs08_st_5",
          "speaker": "老管事",
          "text": "还差两格。跳格的栏，桩会裂。"
        },
        {
          "id": "cs08_stele_x0",
          "speaker": "旁白",
          "text": "香灰白一层。白得像还没人敢踩上去。"
        },
        {
          "id": "cs08_stele_x1",
          "speaker": "老管事",
          "text": "对碑是手活。手活不能靠嘴快。"
        },
        {
          "id": "cs08_stele_x2",
          "speaker": "石垒·晚担",
          "text": "影正了再动手。影偏就等。"
        },
        {
          "id": "cs08_stele_x3",
          "speaker": "书记官",
          "text": "小字写「未结」。小字不抢正文，正文才站得住。"
        },
        {
          "id": "cs08_stele_x4",
          "speaker": "岁吏",
          "text": "回执在侧室。侧室不闹，闹的是正厅。"
        },
        {
          "id": "cs08_stele_x5",
          "speaker": "苇原·灯影",
          "text": "谁摸过灰，手会黑。黑着手别卖「已点」。"
        },
        {
          "id": "cs08_stele_x6",
          "speaker": "槐里·青禾",
          "text": "空格问人。问得出口，姓才像能传。"
        },
        {
          "id": "cs08_stele_x7",
          "speaker": "老旗手",
          "text": "旗断口还在。断口提醒：未完不是丢人。"
        },
        {
          "id": "cs08_stele_x8",
          "speaker": "旁白",
          "text": "灯芯跳一下。跳完又稳。稳比旺好。"
        },
        {
          "id": "cs08_stele_x9",
          "speaker": "老管事",
          "text": "旺晃眼。晃眼就看不清空格边齐不齐。"
        },
        {
          "id": "cs08_st_y16",
          "speaker": "旁白",
          "text": "香灰落在碑座。"
        },
        {
          "id": "cs08_st_y17",
          "speaker": "石垒·晚担",
          "text": "灰轻，碑重。"
        },
        {
          "id": "cs08_st_y18",
          "speaker": "leader",
          "text": "碑阴并排留。"
        },
        {
          "id": "cs08_st_6",
          "speaker": "leader",
          "text": "记下。去看沙漏。"
        }
      ]
    },
    {
      "id": "hourglass",
      "title": "两行",
      "next": "bridge",
      "lines": [
        {
          "id": "cs08_hg_0",
          "speaker": "旁白",
          "text": "沙漏多出两行：上行碑已写，下行祖祠未结。",
          "stage": {
            "bg": "hall",
            "camera": "wide"
          }
        },
        {
          "id": "cs08_hg_1",
          "speaker": "老管事",
          "text": "并排钉。谁撕下行，谁结账。"
        },
        {
          "id": "cs08_hg_2",
          "speaker": "岁吏",
          "text": "回执在侧室。谱与祠，两本账。"
        },
        {
          "id": "cs08_hg_3",
          "speaker": "书记官",
          "text": "议会爱一行。两行最好活。"
        },
        {
          "id": "cs08_hg_4",
          "speaker": "苇原·灯影",
          "text": "更还在交。下行先响。"
        },
        {
          "id": "cs08_hg_5",
          "speaker": "槐里·青禾",
          "text": "孩子要抄未结，不要只抄名。"
        },
        {
          "id": "cs08_hourglass_x0",
          "speaker": "旁白",
          "text": "细线钉住两行。拔线要带木茬，扎手。"
        },
        {
          "id": "cs08_hourglass_x1",
          "speaker": "老管事",
          "text": "扎手正好。不疼的「已」，多半是假的。"
        },
        {
          "id": "cs08_hourglass_x2",
          "speaker": "书记官",
          "text": "议会摘要爱一行。我们给两行。给完不改。"
        },
        {
          "id": "cs08_hourglass_x3",
          "speaker": "岁吏",
          "text": "红脸可以过夜。假绿进匣，我半夜也醒。"
        },
        {
          "id": "cs08_hourglass_x4",
          "speaker": "苇原·灯影",
          "text": "更次还在交。交更的人先看下行。"
        },
        {
          "id": "cs08_hourglass_x5",
          "speaker": "槐里·青禾",
          "text": "抄未结的孩子，长大才敢问空。"
        },
        {
          "id": "cs08_hourglass_x6",
          "speaker": "石垒·晚担",
          "text": "两行间距够一张脸红。红完再谈钉。"
        },
        {
          "id": "cs08_hourglass_x7",
          "speaker": "老旗手",
          "text": "核旗的时候，两行都要在。少一行，角先裂。"
        },
        {
          "id": "cs08_hourglass_x8",
          "speaker": "旁白",
          "text": "沙漏沙子慢。慢不是停。慢是还在走。"
        },
        {
          "id": "cs08_hourglass_x9",
          "speaker": "掌柜",
          "text": "墙牌比纸硬。硬的东西，撕起来才有账。"
        },
        {
          "id": "cs08_hg_y16",
          "speaker": "旁白",
          "text": "碑阴潮。潮处字口更深。"
        },
        {
          "id": "cs08_hg_y17",
          "speaker": "石垒·晚担",
          "text": "深的才经年。"
        },
        {
          "id": "cs08_hg_y18",
          "speaker": "leader",
          "text": "我认深刻。"
        },
        {
          "id": "cs08_hg_6",
          "speaker": "leader",
          "text": "两行都留。去门廊。"
        }
      ],
      "actions": [
        {
          "id": "open_hourglass",
          "label": "去看月份怎么往前走",
          "do": [

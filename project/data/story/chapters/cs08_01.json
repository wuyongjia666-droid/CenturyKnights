              "beat": "next"
            }
          ]
        }
      ]
    },
    {
      "id": "bridge",
      "title": "门廊",
      "next": "tavern",
      "lines": [
        {
          "id": "cs08_br_0",
          "speaker": "旁白",
          "text": "门廊问谁入祠。墙牌两行一起响。",
          "stage": {
            "bg": "hall",
            "camera": "wide"
          }
        },
        {
          "id": "cs08_br_1",
          "speaker": "石垒·晚担",
          "text": "牌比纸硬。纸比嘴硬。"
        },
        {
          "id": "cs08_br_2",
          "speaker": "老旗手",
          "text": "旗角给人核，不给人卖名。"
        },
        {
          "id": "cs08_br_3",
          "speaker": "苇原·灯影",
          "text": "桩空有下落，再谈名。"
        },
        {
          "id": "cs08_br_4",
          "speaker": "槐里·青禾",
          "text": "谎抄不住。孩子会问为什么空。"
        },
        {
          "id": "cs08_br_5",
          "speaker": "老管事",
          "text": "闲话快。对照慢。慢的留下。"
        },
        {
          "id": "cs08_br_6",
          "speaker": "岁吏",
          "text": "谱很长。祖祠很静。静是还在对。"
        },
        {
          "id": "cs08_br_7",
          "speaker": "leader",
          "text": "带牌。去酒馆。"
        },
        {
          "id": "cs08_bridge_x0",
          "speaker": "旁白",
          "text": "门廊风大。风把闲话吹薄，把牌沿吹响。"
        },
        {
          "id": "cs08_bridge_x1",
          "speaker": "石垒·晚担",
          "text": "有人想绕牌。绕得过纸，绕不过桩。"
        },
        {
          "id": "cs08_bridge_x2",
          "speaker": "老旗手",
          "text": "卖名的人爱绕。核角的人站着不让。"
        },
        {
          "id": "cs08_bridge_x3",
          "speaker": "苇原·灯影",
          "text": "下落不清，名先别谈。谈了也是吵。"
        },
        {
          "id": "cs08_bridge_x4",
          "speaker": "槐里·青禾",
          "text": "孩子问空，比大人喊满更难挡。"
        },
        {
          "id": "cs08_bridge_x5",
          "speaker": "老管事",
          "text": "慢的对照留下。快的闲话过夜就散。"
        },
        {
          "id": "cs08_bridge_x6",
          "speaker": "岁吏",
          "text": "谱很长。长的东西，更要静着对。"
        },
        {
          "id": "cs08_bridge_x7",
          "speaker": "书记官",
          "text": "门廊记事：谁来问，谁摸过灰，谁短笑。"
        },
        {
          "id": "cs08_bridge_x8",
          "speaker": "旁白",
          "text": "墙牌旁有人短笑。短笑像试探，不像结论。"
        },
        {
          "id": "cs08_bridge_x9",
          "speaker": "掌柜",
          "text": "酒馆等着。圈还在。圈不等短笑。"
        },
        {
          "id": "cs08_mid_y18",
          "speaker": "旁白",
          "text": "香灰落在碑座。"
        },
        {
          "id": "cs08_mid_y19",
          "speaker": "石垒·晚担",
          "text": "灰轻，碑重。"
        },
        {
          "id": "cs08_mid_y20",
          "speaker": "leader",
          "text": "碑阴并排留。"
        },
        {
          "id": "cs08_mid_lost",
          "speaker": "旁白",
          "text": "锋收回来。祖祠问声还在。墙牌旁那拨，没散。",
          "when": {

    {
      "id": "tavern",
      "title": "选题",
      "lines": [
        {
          "id": "cs08_tav_0",
          "speaker": "旁白",
          "text": "烽火酒馆。碗沿两个圈：并排记，先钉名。",
          "stage": {
            "bg": "tavern",
            "camera": "wide"
          }
        },
        {
          "id": "cs08_tav_1",
          "speaker": "掌柜",
          "text": "篇幅不够就钉墙。墙比名册宽。"
        },
        {
          "id": "cs08_tav_2",
          "speaker": "槐里·青禾",
          "text": "裁祖祠的人，先把剪刀放下。"
        },
        {
          "id": "cs08_tav_3",
          "speaker": "老管事",
          "text": "并排钉。谁撕祖祠抄本，谁结账。"
        },
        {
          "id": "cs08_tav_4",
          "speaker": "石垒·晚担",
          "text": "栏是念的，桩是站的。两样都要。"
        },
        {
          "id": "cs08_tav_5",
          "speaker": "苇原·灯影",
          "text": "沙漏还亮。谁买一行结论，带他去摸灰。"
        },
        {
          "id": "cs08_tav_6",
          "speaker": "旁白",
          "text": "两张纸在风里响。你选怎么收这一季。"
        },
        {
          "id": "cs08_tavern_x0",
          "speaker": "旁白",
          "text": "花生壳轻了。轻的时候，人反而听得见自己的选。"
        },
        {
          "id": "cs08_tavern_x1",
          "speaker": "掌柜",
          "text": "圈是选题。选完再喝。空喊的，酒钱加倍。"
        },
        {
          "id": "cs08_tavern_x2",
          "speaker": "槐里·青禾",
          "text": "裁祖祠像裁布。布裁错了，鞋也穿不成。"
        },
        {
          "id": "cs08_tavern_x3",
          "speaker": "老管事",
          "text": "并排不是怕事。并排是让事看得见。"
        },
        {
          "id": "cs08_tavern_x4",
          "speaker": "石垒·晚担",
          "text": "栏能念，桩能站。少一样，厅会晃。"
        },
        {
          "id": "cs08_tavern_x5",
          "speaker": "苇原·灯影",
          "text": "买一行结论的人，先去摸灰。摸完再出价。"
        },
        {
          "id": "cs08_tavern_x6",
          "speaker": "岁吏",
          "text": "回执不认吆喝。认并排，认灯，认手。"
        },
        {
          "id": "cs08_tavern_x7",
          "speaker": "书记官",
          "text": "两张纸都在风里。风不会替你选。"
        },
        {
          "id": "cs08_tavern_x8",
          "speaker": "老旗手",
          "text": "旗角听得到圈。圈选偏了，角会先响。"
        },
        {
          "id": "cs08_tavern_y16",
          "speaker": "旁白",
          "text": "碑阴潮。潮处字口更深。"
        },
        {
          "id": "cs08_tavern_y17",
          "speaker": "石垒·晚担",
          "text": "深的才经年。"
        },
        {
          "id": "cs08_tavern_y18",
          "speaker": "leader",
          "text": "我认深刻。"
        },
        {
          "id": "cs08_tavern_x9",
          "speaker": "旁白",
          "text": "你还没开口。没开口的时候，空格最清楚。"
        }
      ],
      "actions": [
        {

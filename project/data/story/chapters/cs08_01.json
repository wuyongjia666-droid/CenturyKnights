    {
      "id": "ledger",
      "title": "入册",
      "lines": [
        {
          "id": "cs08_led_0",
          "speaker": "旁白",
          "text": "旗册封面四个字：祖祠上的灯。末页已厚。柜上两把钥匙。",
          "stage": {
            "bg": "hall",
            "camera": "close"
          }
        },
        {
          "id": "cs08_led_par",
          "speaker": "旁白",
          "text": "你留下两行。议会仍爱一行。柜子认灯。",
          "when": {
            "flag": "cs08_kept_stele"
          }
        },
        {
          "id": "cs08_led_name",
          "speaker": "旁白",
          "text": "你先钉碑名。沙漏仍在亮——月会替你写下行。",
          "when": {
            "flag": "cs08_name_stele"
          }
        },
        {
          "id": "cs08_led_1",
          "speaker": "老管事",
          "text": "存档不刊也行。不丢，就是缝。"
        },
        {
          "id": "cs08_led_2",
          "speaker": "槐里·青禾",
          "text": "孩子抄过祖祠，才配以后念栏。"
        },
        {
          "id": "cs08_led_3",
          "speaker": "老旗手",
          "text": "并排。不要裁。缝在名册与祖祠之间。"
        },
        {
          "id": "cs08_led_4",
          "speaker": "岁吏",
          "text": "回执在侧室。谱与祠，两本账。"
        },
        {
          "id": "cs08_led_5",
          "speaker": "苇原·灯影",
          "text": "更还在交。下次挂嗣，下行先响。"
        },
        {
          "id": "cs08_ledger_x0",
          "speaker": "旁白",
          "text": "钥匙冰手。冰手提醒：柜不是广告栏。"
        },
        {
          "id": "cs08_ledger_x1",
          "speaker": "老管事",
          "text": "缝留着。缝不是裂。缝是还能补的地方。"
        },
        {
          "id": "cs08_ledger_x2",
          "speaker": "槐里·青禾",
          "text": "抄过未结，才配念栏。这句留给以后。"
        },
        {
          "id": "cs08_ledger_x3",
          "speaker": "老旗手",
          "text": "并排入柜。裁掉的半本，我不收。"
        },
        {
          "id": "cs08_ledger_x4",
          "speaker": "岁吏",
          "text": "侧室回执还在。还在，红脸就还诚实。"
        },
        {
          "id": "cs08_ledger_x5",
          "speaker": "苇原·灯影",
          "text": "下次挂嗣，下行先响。响了再谈名。"
        },
        {
          "id": "cs08_ledger_x6",
          "speaker": "书记官",
          "text": "封面四个字压住催条。催条再来，也压得住。"
        },
        {
          "id": "cs08_ledger_x7",
          "speaker": "石垒·晚担",
          "text": "桩还在。桩在，名才有地方站。"
        },
        {
          "id": "cs08_ledger_x8",
          "speaker": "掌柜",
          "text": "圈可以擦。擦过的墙，比从没画过更值钱。"
        },
        {
          "id": "cs08_ledger_x9",
          "speaker": "旁白",
          "text": "灯还在。灯在，这一季就还没把人骗完。"
        },
        {
          "id": "cs08_led_6",
          "speaker": "leader",
          "text": "栏与祠，并排。谁来认嗣位，先念完。"
        },
        {
          "id": "cs08_led_y19",
          "speaker": "旁白",
          "text": "香灰落在碑座。"
        },
        {
          "id": "cs08_led_y20",
          "speaker": "石垒·晚担",
          "text": "灰轻，碑重。"
        },
        {
          "id": "cs08_led_y21",
          "speaker": "leader",
          "text": "碑阴并排留。"
        },
        {
          "id": "cs08_led_7",
          "speaker": "旁白",
          "text": "风动旗角时，碑已写还在。两行之间的空，给人脸红。"
        }
      ],
      "actions": []
    }
  ]

    {
      "id": "ledger",
      "title": "入册",
      "lines": [
        {
          "id": "cs04_02_ledger_0",
          "speaker": "旁白",
          "text": "入册。训阴与家训并排进柜。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_ledger_1",
          "speaker": "书记官",
          "text": "行迹有灯。灯不灭。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_ledger_2",
          "speaker": "leader",
          "text": "我看见空了。空也在谱里·家训。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_ledger_3",
          "speaker": "岁吏",
          "text": "年迹末行写：训阴并排留。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_ledger_4",
          "speaker": "老管事",
          "text": "催绣锣再响，也撕不开柜门。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_ledger_5",
          "speaker": "旁白",
          "text": "柜门一合。灯还在缝里·家训。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_ledger_6",
          "speaker": "苇原·灯影",
          "text": "巡防收牌。牌上训阴两字还热。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_ledger_7",
          "speaker": "书记官",
          "text": "整幅家训，才算训。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_ledger_8",
          "speaker": "leader",
          "text": "假训没进来。好。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_ledger_9",
          "speaker": "岁吏",
          "text": "月结旁多一笔行迹。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_ledger_10",
          "speaker": "老管事",
          "text": "催条叠在门外。谱在门内·家训。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_ledger_11",
          "speaker": "旁白",
          "text": "绣线干。行迹的边也干了。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_ledger_12",
          "speaker": "书记官",
          "text": "下次打开，行迹还在——带着灯。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_ledger_13",
          "speaker": "leader",
          "text": "够了。去灰旗堡·家训。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_ledger_14",
          "speaker": "苇原·灯影",
          "text": "堡门亮着。训阴灯跟着。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_ledger_15",
          "speaker": "岁吏",
          "text": "年迹合上。字还在·家训。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_ledger_16",
          "speaker": "老管事",
          "text": "训堂可歇。谱不可假。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_ledger_17",
          "speaker": "旁白",
          "text": "风停。训平。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_ledger_18",
          "speaker": "书记官",
          "text": "并排不是拖。是完整·家训。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_ledger_y19",
          "speaker": "旁白",
          "text": "脚步声比口号响。"
        },
        {
          "id": "cs04_02_ledger_y20",
          "speaker": "石垒·晚担",
          "text": "响的是走出来的。"
        },
        {
          "id": "cs04_02_ledger_y21",
          "speaker": "leader",
          "text": "我走实步。"
        },
        {
          "id": "cs0402_ldg1",
          "speaker": "岁吏",
          "text": "契缝与训阴并排，墨干才算自己的字。"
        },
        {
          "id": "cs0402_ldg2",
          "speaker": "书记官",
          "text": "抢契的风，掀不进录。"
        },
        {
          "id": "cs0402_ldg3",
          "speaker": "老旗手",
          "text": "旗在契案立过——字有根。"
        },
        {
          "id": "cs0402_ldg4",
          "speaker": "leader",
          "text": "契压住。灯不灭，训阴在柜。"
        },
        {
          "id": "cs0402_ldg_end",
          "speaker": "leader",
          "text": "契角压平处，灰旗堡训阴柜等签字。"
        }
      ],
      "actions": []
    }
  ],
  "title_en": "Lamp on the Doctrine Back"
}

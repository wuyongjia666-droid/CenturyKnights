    {
      "id": "tavern",
      "title": "选题",
      "lines": [
        {
          "id": "cs04_02_tavern_0",
          "speaker": "旁白",
          "text": "酒馆。板上两道题。手按上去·家训。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_tavern_1",
          "speaker": "掌柜",
          "text": "一道训行仍并。一道先催绣词。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_tavern_2",
          "speaker": "leader",
          "text": "我看题。不看谁嗓门大·家训。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_tavern_3",
          "speaker": "老管事",
          "text": "并排留真。催绣快。快的未必真。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_tavern_4",
          "speaker": "书记官",
          "text": "行迹进谱，才算整幅家训。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_tavern_5",
          "speaker": "岁吏",
          "text": "年迹听选择。不听锣·家训。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_tavern_6",
          "speaker": "旁白",
          "text": "酒气里训更白。白得能看见行。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_tavern_7",
          "speaker": "掌柜",
          "text": "选完入柜。训阴柜门会响。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_tavern_8",
          "speaker": "苇原·灯影",
          "text": "巡防在门外。门内只选题·家训。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_tavern_9",
          "speaker": "leader",
          "text": "训行仍并——我手按这道。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_tavern_10",
          "speaker": "老管事",
          "text": "按实了。别悬着·家训。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_tavern_11",
          "speaker": "书记官",
          "text": "假训那道我划掉。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_tavern_12",
          "speaker": "旁白",
          "text": "板面一热。字进手心·家训。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_tavern_13",
          "speaker": "岁吏",
          "text": "选择入账。训阴夜可结。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_tavern_14",
          "speaker": "掌柜",
          "text": "另一道也在。你不选它·家训。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_tavern_15",
          "speaker": "老管事",
          "text": "催绣的锣远了。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_tavern_16",
          "speaker": "旁白",
          "text": "两道题还在板上。只一道进柜·家训。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_tavern_y17",
          "speaker": "旁白",
          "text": "酒旗后训阴墙皮又壳了一块，块下字还全。"
        },
        {
          "id": "cs04_02_tavern_y18",
          "speaker": "石垒·晚担",
          "text": "字全，壳掉也没关系。字缺了，酒也不配喝。"
        },
        {
          "id": "cs04_02_tavern_y19",
          "speaker": "leader",
          "text": "字全的训阴带回。缺的留下补走。"
        },
        {
          "id": "cs04_02_tavern_17",
          "speaker": "老管事",
          "text": "选完入柜。训阴柜门会响·家训。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs0402_ret_mv1",
          "speaker": "旁白",
          "text": "训阴笑话停在半句。半句比整句危险。"
        },
        {
          "id": "cs0402_ret_mv2",
          "speaker": "掌柜",
          "text": "半句补全再挂。"
        },
        {
          "id": "cs0402_ret_mv3",
          "speaker": "岁吏",
          "text": "挂完回。"
        },
        {
          "id": "cs0402_tvn1",
          "speaker": "掌柜",
          "text": "护契那一锋，酒要稳——稳着配字。"
        },
        {
          "id": "cs0402_tvn2",
          "speaker": "石垒·晚担",
          "text": "廊外那拨退了。退了，墨才干得成。"
        },
        {
          "id": "cs0402_tvn3",
          "speaker": "老旗手",
          "text": "旗在契案旁立过。立过，字有根。"
        },
        {
          "id": "cs0402_tvn4",
          "speaker": "leader",
          "text": "契在。墨干。酒，稳着。"
        },
        {
          "id": "cs0402_ret_mv4",
          "speaker": "leader",
          "text": "回堡入训阴。"
        }
      ],

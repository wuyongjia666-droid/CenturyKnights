{
  "id": "cs04_02",
  "title": "训阴上的灯",
  "legacy_index": 414,
  "return_scene": "res://scenes/hub/castle_hub.tscn",
  "source": "docs/content-seasons/season-04/NOVEL.md",
  "beats": [
    {
      "id": "back",
      "title": "训阴",
      "lines": [
        {
          "id": "cs04_02_back_0",
          "speaker": "旁白",
          "text": "训堂。上回家训已入柜。训阴还空着行迹。",
          "stage": {
            "card": "一　训阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_back_1",
          "speaker": "书记官",
          "text": "正面训写过了。训阴要能念，不能只剩绣线。",
          "stage": {
            "card": "一　训阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_back_2",
          "speaker": "leader",
          "text": "我要听行迹。空着也得说得出。",
          "stage": {
            "card": "一　训阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_back_3",
          "speaker": "旁白",
          "text": "柜门一响。家训与训阴并排放上长桌。",
          "stage": {
            "card": "一　训阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_back_4",
          "speaker": "老管事",
          "text": "催绣的人嗓门大。行迹的人说再等等。",
          "stage": {
            "card": "一　训阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_back_5",
          "speaker": "岁吏",
          "text": "年迹旁多了一行「训阴夜」。",
          "stage": {
            "card": "一　训阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_back_6",
          "speaker": "苇原·灯影",
          "text": "巡防不问谁挂训。问今夜谁还空着行。",
          "stage": {
            "card": "一　训阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_back_7",
          "speaker": "旁白",
          "text": "两行字第一次对视。训面亮，训阴暗。",
          "stage": {
            "card": "一　训阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_back_8",
          "speaker": "书记官",
          "text": "能念的字在训面。坐得住的行在训阴等。",
          "stage": {
            "card": "一　训阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_back_9",
          "speaker": "leader",
          "text": "把行迹念给我听。别念催绣。",
          "stage": {
            "card": "一　训阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_back_10",
          "speaker": "老管事",
          "text": "催绣可以喊。训阴撕不得。",
          "stage": {
            "card": "一　训阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_back_11",
          "speaker": "旁白",
          "text": "灯矮了一寸。行迹反而更清楚。",
          "stage": {
            "card": "一　训阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_back_12",
          "speaker": "岁吏",
          "text": "家训已记账。训阴记账才算整幅。",
          "stage": {
            "card": "一　训阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_back_13",
          "speaker": "书记官",
          "text": "并排不是拖。是让行迹也有灯。",
          "stage": {
            "card": "一　训阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_back_14",
          "speaker": "leader",
          "text": "我听懂了。空着，也要并排·家训。",
          "stage": {
            "card": "一　训阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_back_15",
          "speaker": "旁白",
          "text": "风从窗缝进来。训角动，字不动。",
          "stage": {
            "card": "一　训阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_back_16",
          "speaker": "老管事",
          "text": "催绣的锣在门外。锣响不进训堂。",
          "stage": {
            "card": "一　训阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_back_y17",
          "speaker": "旁白",
          "text": "训阴页贴着墙，墙皮壳落在「行」字上。"
        },
        {
          "id": "cs04_02_back_y18",
          "speaker": "石垒·晚担",
          "text": "壳落在行上。行还在，训才算没白贴。"
        },
        {
          "id": "cs04_02_back_y19",
          "speaker": "leader",
          "text": "训阴与行并排。壳掉了也并着。"
        },
        {
          "id": "cs04_02_back_17",
          "speaker": "槐里·青禾",
          "text": "训阴比训面薄。薄的反而难装。",
          "stage": {
            "card": "一　训阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        }
      ],
      "next": "deed"
    },
    {
      "id": "deed",
      "title": "行迹",
      "lines": [
        {
          "id": "cs04_02_deed_0",
          "speaker": "旁白",
          "text": "行迹摊开。做过的那格亮着，旁格还空。",
          "stage": {
            "card": "二　行迹",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_deed_1",
          "speaker": "老管事",
          "text": "上回留并排的，行迹亮着空。只留训的，栏上有字、行仍空。",
          "stage": {
            "card": "二　行迹",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_deed_2",
          "speaker": "旁白",
          "text": "两行字第二次吵架。回读逼它们对视·家训。",
          "stage": {
            "card": "二　行迹",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_deed_3",
          "speaker": "苇原·灯影",
          "text": "巡防不问谁绣词。问今夜谁还空着行。",
          "stage": {
            "card": "二　行迹",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_deed_4",
          "speaker": "书记官",
          "text": "有字的格能念。行迹要人敢看。",
          "stage": {
            "card": "二　行迹",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_deed_5",
          "speaker": "leader",
          "text": "行空不是错。催满才是错。",
          "stage": {
            "card": "二　行迹",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_deed_6",
          "speaker": "岁吏",
          "text": "年迹不改行。只记你敢不敢对空。",
          "stage": {
            "card": "二　行迹",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_deed_7",
          "speaker": "旁白",
          "text": "绣线干了。行迹的边还潮。",
          "stage": {
            "card": "二　行迹",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_deed_8",
          "speaker": "老管事",
          "text": "催绣锣又响。响在门外，进不了行。",
          "stage": {
            "card": "二　行迹",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_deed_9",
          "speaker": "书记官",
          "text": "并排留行，比硬填假训干净。",
          "stage": {
            "card": "二　行迹",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_deed_10",
          "speaker": "leader",
          "text": "假训我不要。行迹我要听。",
          "stage": {
            "card": "二　行迹",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_deed_11",
          "speaker": "旁白",
          "text": "灯把行迹照成浅坑。坑里没有字。",
          "stage": {
            "card": "二　行迹",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_deed_12",
          "speaker": "岁吏",
          "text": "家训上的字还在。训阴上的空也在。",
          "stage": {
            "card": "二　行迹",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_deed_13",
          "speaker": "苇原·灯影",
          "text": "带牌去。牌上写训阴，不写催。",
          "stage": {
            "card": "二　行迹",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_deed_14",
          "speaker": "老管事",
          "text": "催绣条叠得高。行迹叠不住。",
          "stage": {
            "card": "二　行迹",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_deed_15",
          "speaker": "书记官",
          "text": "能念的在训面。敢留的在训阴。",
          "stage": {
            "card": "二　行迹",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_deed_16",
          "speaker": "旁白",
          "text": "训角又动。行迹仍空。",
          "stage": {
            "card": "二　行迹",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs04_02_deed_y17",
          "speaker": "旁白",
          "text": "行迹页上脚步声压过绣出来的口号。"
        },
        {
          "id": "cs04_02_deed_y18",
          "speaker": "石垒·晚担",
          "text": "压过去的是走出来的。绣出来的，针脚会谎。"
        },
        {
          "id": "cs04_02_deed_y19",
          "speaker": "leader",
          "text": "我按走出来的步填行迹。绣词靠后。"
        },
        {
          "id": "cs04_02_deed_17",
          "speaker": "老旗手",
          "text": "行迹灯还亮。亮着，才敢回读。",
          "stage": {
            "card": "二　行迹",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        }
      ],
      "next": "hourglass"
    },
    {
      "id": "hourglass",
      "title": "两行",
      "lines": [
        {
          "id": "cs04_02_hourglass_0",
          "speaker": "旁白",
          "text": "沙漏厅。上行家训、下行训阴。回读把两行按住。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_hourglass_1",
          "speaker": "老管事",
          "text": "月份往前走。回读不改月份，只改你敢不敢对行。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_hourglass_2",
          "speaker": "岁吏",
          "text": "年迹旁多了一行「训阴回读」。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_hourglass_3",
          "speaker": "书记官",
          "text": "能念的字在上行。空得住的行还在下行等。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_hourglass_4",
          "speaker": "leader",
          "text": "两行都打开。我要听对看·家训。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_hourglass_5",
          "speaker": "旁白",
          "text": "沙响。上行亮，下行仍暗·家训。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_hourglass_6",
          "speaker": "苇原·灯影",
          "text": "巡防牌上写训阴。不写急锣。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_hourglass_7",
          "speaker": "老管事",
          "text": "催绣的人在门外跺脚。跺不进沙漏。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_hourglass_8",
          "speaker": "书记官",
          "text": "并排不是拖月。是让行迹跟月份并排走。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_hourglass_9",
          "speaker": "岁吏",
          "text": "月结不抹行。行也要入迹。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_hourglass_10",
          "speaker": "leader",
          "text": "我听行迹。不听跺脚。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_hourglass_11",
          "speaker": "旁白",
          "text": "沙又落一层。下行多了一点亮·家训。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_hourglass_12",
          "speaker": "老管事",
          "text": "锣停了。行迹还在。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_hourglass_13",
          "speaker": "书记官",
          "text": "回读夜的字，比催绣长命。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_hourglass_14",
          "speaker": "岁吏",
          "text": "带牌出去。沙漏还转·家训。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_hourglass_15",
          "speaker": "旁白",
          "text": "两行终于对上。一对，就不敢假填·家训。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_hourglass_16",
          "speaker": "老管事",
          "text": "假训进不了沙漏。行迹能。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_hourglass_y17",
          "speaker": "旁白",
          "text": "沙漏旁边训阴起壳，壳里夹着一条没干的针脚。"
        },
        {
          "id": "cs04_02_hourglass_y18",
          "speaker": "石垒·晚担",
          "text": "针脚没干，说明训还在被走过，不是被念过。"
        },
        {
          "id": "cs04_02_hourglass_y19",
          "speaker": "leader",
          "text": "走过的训与行并着。念过的放下。"
        },
        {
          "id": "cs04_02_hourglass_17",
          "speaker": "苇原·灯影",
          "text": "带牌去。牌上写训阴，不写急。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs0402_vis_mv1",
          "speaker": "旁白",
          "text": "时漏里沙色偏深。深沙走得更慢。"
        },
        {
          "id": "cs0402_vis_mv2",
          "speaker": "岁吏",
          "text": "慢正好。训阴不怕慢。"
        },
        {
          "id": "cs0402_vis_mv3",
          "speaker": "苇原·灯影",
          "text": "慢着看，折痕藏不住。"
        },
        {
          "id": "cs0402_vst1",
          "speaker": "岁吏",
          "text": "月份从契缝里挤进一丝。丝细，却把年月钉住。"
        },
        {
          "id": "cs0402_vst2",
          "speaker": "书记官",
          "text": "契录旁沙漏，最怕风掀。"
        },
        {
          "id": "cs0402_vst3",
          "speaker": "leader",
          "text": "月份钉过。契，我压。"
        },
        {
          "id": "cs0402_vis_mv4",
          "speaker": "leader",
          "text": "慢看。去月份。"
        }
      ],
      "next": "bridge",
      "actions": [
        {
          "id": "open_hourglass",
          "label": "去看月份怎么往前走",
          "do": [
            {

          ]
        }
      ]
    },
    {
      "id": "bridge",
      "title": "门廊",
      "lines": [
        {
          "id": "cs04_02_bridge_0",
          "speaker": "旁白",
          "text": "门廊。训阴灯还在身后。锋镝在桥上试。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_bridge_1",
          "speaker": "岁吏",
          "text": "试锋不改行迹。只问你手稳不稳。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_bridge_2",
          "speaker": "leader",
          "text": "先试一锋。赢了再谈催绣。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_bridge_3",
          "speaker": "老旗手",
          "text": "锋收回来也行。行迹不靠锋填。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_bridge_4",
          "speaker": "旁白",
          "text": "桥风大。灯小。字还在·家训。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_bridge_5",
          "speaker": "书记官",
          "text": "催绣可以喊。训阴本撕不得。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_bridge_6",
          "speaker": "苇原·灯影",
          "text": "巡防站桥侧。不问胜负，问你还回不回读·家训。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_bridge_7",
          "speaker": "老管事",
          "text": "锣在城门。桥上只听见水·家训。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_bridge_8",
          "speaker": "leader",
          "text": "锋出不出，行迹都在。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_bridge_9",
          "speaker": "岁吏",
          "text": "试锋得手，锋镝压下，并排训可续。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_bridge_10",
          "speaker": "旁白",
          "text": "水声盖过远处锣·家训。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_bridge_11",
          "speaker": "老旗手",
          "text": "伤还在也行。先去酒馆选题·家训。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_bridge_12",
          "speaker": "书记官",
          "text": "选题在前。假训在后——后的不要。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_bridge_13",
          "speaker": "苇原·灯影",
          "text": "牌还在手里。牌上仍是训阴。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_bridge_14",
          "speaker": "老管事",
          "text": "催绣的人等不及。你等得及。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_bridge_15",
          "speaker": "leader",
          "text": "我等行迹。不等锣。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_bridge_16",
          "speaker": "旁白",
          "text": "桥板一颤。灯不灭·家训。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_bridge_17",
          "speaker": "岁吏",
          "text": "未试锋——锋未出鞘，也可去酒馆·家训。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_bridge_18",
          "speaker": "老旗手",
          "text": "试锋未成——伤还在，先去酒馆·家训。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs04_02_bridge_y20",
          "speaker": "旁白",
          "text": "门廊石上脚步比训阴里的口号更清楚。"
        },
        {
          "id": "cs04_02_bridge_y21",
          "speaker": "石垒·晚担",
          "text": "清楚的是鞋底。口号在风里，站不住。"
        },
        {
          "id": "cs04_02_bridge_y22",
          "speaker": "leader",
          "text": "鞋底算数。门廊不收口号。"
        },
        {
          "id": "cs04_02_bridge_19",
          "speaker": "岁吏",
          "text": "催绣可以喊。训阴本撕不得·家训。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs0402_mid_mv1",
          "speaker": "旁白",
          "text": "训阴纸上有新折痕。折痕像被人当枕头枕过。"
        },
        {
          "id": "cs0402_mid_mv2",
          "speaker": "岁吏",
          "text": "枕过的纸，边毛。边毛要验。"
        },
        {
          "id": "cs0402_mid_mv3",
          "speaker": "石垒·晚担",
          "text": "边毛的人，行迹里爱插队。"
        },
        {
          "id": "cs0402_mid_mv4",
          "speaker": "苇原·灯影",
          "text": "插队的，锋一横就老实。"
        },
        {
          "id": "cs0402_mid_mv5",
          "speaker": "老旗手",
          "text": "老实不是吓出来的。是试出来的。"
        },
        {
          "id": "cs0402_mid_mv6",
          "speaker": "leader",
          "text": "试。步实锋实。"
        },
        {
          "id": "cs0402_win1",
          "speaker": "旁白",
          "text": "锋再定。契纸角压住，抢契那拨退到廊外。",
          "when": {
            "flag": "cs04_mid_fought"
          }
        },
        {
          "id": "cs0402_win2",
          "speaker": "掌柜",
          "text": "契要压。压住，才不像飞的。",
          "when": {
            "flag": "cs04_mid_fought"
          }
        },
        {
          "id": "cs0402_win3",
          "speaker": "槐里·青禾",
          "text": "墨干了。干了，字才是自己的。",
          "when": {
            "flag": "cs04_mid_fought"
          }
        },
        {
          "id": "cs0402_win4",
          "speaker": "leader",
          "text": "锋护过契。字，我签得。",
          "when": {
            "flag": "cs04_mid_fought"
          }
        },
        {
          "speaker": "旁白",
          "text": "锋收回来。训阴纸还钉着。行迹旁那拨，没散。",
          "when": {
            "all": [
              {
                "flag": "cs04_mid_lost"
              },
              {
                "not_flag": "cs04_mid_fought"
              }
            ]
          },
          "id": "cs04b_br_lost"
        }
      ],

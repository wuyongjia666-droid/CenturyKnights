{
  "id": "cs01_02",
  "title": "副页上的灯",
  "legacy_index": 411,
  "return_scene": "res://scenes/hub/castle_hub.tscn",
  "source": "docs/content-seasons/season-01/NOVEL.md",
  "beats": [
    {
      "id": "slip",
      "title": "副页",
      "lines": [
        {
          "id": "cs01_02_slip_0",
          "speaker": "旁白",
          "text": "账房。上回回执已入柜。副页还空着一格。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_1",
          "speaker": "书记官",
          "text": "正面写过了。副页要能念，不能只剩墨味。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_2",
          "speaker": "leader",
          "text": "我要听空格。空着也得说得出。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_3",
          "speaker": "旁白",
          "text": "柜门一响。回执与副页并排放上长桌。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_4",
          "speaker": "老管事",
          "text": "挂板的人催得急。空格的人说再等等。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_5",
          "speaker": "岁吏",
          "text": "年迹旁多了一行「副页夜」。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_6",
          "speaker": "苇原·灯影",
          "text": "巡防不问谁挂板。问今夜谁还空着格。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_7",
          "speaker": "旁白",
          "text": "两行字第一次对视。正面亮，副页暗。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_8",
          "speaker": "书记官",
          "text": "能念的字在正面。坐得住的空在副页等。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_9",
          "speaker": "leader",
          "text": "把空格念给我听。别念催条。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_10",
          "speaker": "老管事",
          "text": "催条可以撕。副页撕不得。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_11",
          "speaker": "旁白",
          "text": "灯矮了一寸。空格反而更清楚。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_12",
          "speaker": "岁吏",
          "text": "回执已记账。副页记账才算整张。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_13",
          "speaker": "书记官",
          "text": "并排不是拖。是让空格也有灯。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_14",
          "speaker": "leader",
          "text": "我听懂了。空着，也要并排。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_15",
          "speaker": "旁白",
          "text": "风从窗缝进来。纸角动，字不动。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_16",
          "speaker": "老管事",
          "text": "挂板的锣在门外。锣响不进账房。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_y17",
          "speaker": "旁白",
          "text": "副页灯花爆在空格外，爆完纸上多了一粒烫点。"
        },
        {
          "id": "cs01_02_slip_y18",
          "speaker": "石垒·晚担",
          "text": "烫点不在字上。字还没写，别捂。"
        },
        {
          "id": "cs01_02_slip_y19",
          "speaker": "leader",
          "text": "副页先留烫点。假名不往上凑。"
        },
        {
          "id": "cs0102_thm1",
          "speaker": "旁白",
          "text": "副页比正页薄一指。薄处先透灯。"
        },
        {
          "id": "cs0102_thm2",
          "speaker": "岁吏",
          "text": "正页有字。副页空着，像并排的两盏。"
        },
        {
          "id": "cs0102_thm3",
          "speaker": "石垒·晚担",
          "text": "薄页更容易皱。皱了就难并排。"
        },
        {
          "id": "cs0102_thm4",
          "speaker": "槐里·青禾",
          "text": "副页不装假名。假名装上去，灯会偏。"
        },
        {
          "id": "cs0102_thm5",
          "speaker": "老旗手",
          "text": "旗杆靠副页半寸。靠近了，风会掀角。"
        },
        {
          "id": "cs0102_thm6",
          "speaker": "leader",
          "text": "副页我按平。空行我留。留完再往下走。"
        },
        {
          "id": "cs01_02_slip_17",
          "speaker": "槐里·青禾",
          "text": "副页比回执薄。薄的反而难装。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        }
      ],
      "next": "wu"
    },
    {
      "id": "wu",
      "title": "空格",
      "lines": [
        {
          "id": "cs01_02_wu_0",
          "speaker": "旁白",
          "text": "空格摊开。吴姓那格亮着，旁格还空。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_1",
          "speaker": "老管事",
          "text": "上回写吴的，格里有字。压下的，格仍空。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_2",
          "speaker": "旁白",
          "text": "两行字第二次吵架。回读逼它们对视·回执。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_3",
          "speaker": "苇原·灯影",
          "text": "巡防不问谁姓吴。问今夜谁还空着格。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_4",
          "speaker": "书记官",
          "text": "有字的格能念。空格要人敢看。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_5",
          "speaker": "leader",
          "text": "空格不是错。催满才是错。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_6",
          "speaker": "岁吏",
          "text": "年迹不改姓。只记你敢不敢对空。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_7",
          "speaker": "旁白",
          "text": "墨干了。空格的边还潮。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_8",
          "speaker": "老管事",
          "text": "挂板锣又响。响在门外，进不了格。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_9",
          "speaker": "书记官",
          "text": "并排留空，比硬填假名干净。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_10",
          "speaker": "leader",
          "text": "假名我不要。空格我要听。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_11",
          "speaker": "旁白",
          "text": "灯把空格照成浅坑。坑里没有字。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_12",
          "speaker": "岁吏",
          "text": "回执上的吴还在。副页上的空也在。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_13",
          "speaker": "苇原·灯影",
          "text": "带牌去。牌上写副页，不写催。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_14",
          "speaker": "老管事",
          "text": "催条叠得高。空格叠不住。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_15",
          "speaker": "书记官",
          "text": "能念的在正面。敢留的在副页。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_16",
          "speaker": "旁白",
          "text": "纸角又动。空格仍空。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_y17",
          "speaker": "旁白",
          "text": "空格四边都起毛，毛比副页上的泥印老实。"
        },
        {
          "id": "cs01_02_wu_y18",
          "speaker": "石垒·晚担",
          "text": "泥印会干。毛边干了还扎手，才算数。"
        },
        {
          "id": "cs01_02_wu_y19",
          "speaker": "leader",
          "text": "空格留着扎手的。催出来的不留。"
        },
        {
          "id": "cs0102_sec1",
          "speaker": "旁白",
          "text": "无字还烫。烫处像刚熄的灯芯。"
        },
        {
          "id": "cs0102_sec2",
          "speaker": "听回",
          "text": "无不是空。无是敢写上去的那一笔。"
        },
        {
          "id": "cs0102_sec3",
          "speaker": "石垒·晚担",
          "text": "烫散了再念。念早了，字会跳。"
        },
        {
          "id": "cs0102_sec4",
          "speaker": "槐里·青禾",
          "text": "副页上的无，要比正页更稳。"
        },
        {
          "id": "cs0102_sec5",
          "speaker": "老旗手",
          "text": "旗杆离无字半寸。近了，风掀角。"
        },
        {
          "id": "cs0102_sec6",
          "speaker": "leader",
          "text": "无我验。烫我认。认完再往沙漏。"
        },
        {
          "id": "cs01_02_wu_17",
          "speaker": "老旗手",
          "text": "空格灯还亮。亮着，才敢回读。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        }
      ],
      "next": "hourglass"
    },
    {
      "id": "hourglass",
      "title": "两行",
      "lines": [
        {
          "id": "cs0102_vop1",
          "speaker": "旁白",
          "text": "沙漏座旁多了一页副笺。笺角翘着，像等人按。"
        },
        {
          "id": "cs0102_vop2",
          "speaker": "岁吏",
          "text": "副页先别摊满案。摊满，沙影会花。"
        },
        {
          "id": "cs0102_vop3",
          "speaker": "石垒·晚担",
          "text": "靴灰磕在漏座外。灰落沙上，像掺假。"
        },
        {
          "id": "cs0102_vop4",
          "speaker": "槐里·青禾",
          "text": "袖上酒气晾过廊。晾尽，再近漏腰。"
        },
        {
          "id": "cs0102_vop5",
          "speaker": "书记官",
          "text": "底联我压肘下。肘稳，月份才走得直。"
        },
        {
          "id": "cs0102_vop6",
          "speaker": "leader",
          "text": "我到漏前。副页在，沙未走乱，我先站稳。"
        },
        {
          "id": "cs01_02_hourglass_0",
          "speaker": "旁白",
          "text": "沙漏厅。上行回执、下行副页。回读把两行按住。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_1",
          "speaker": "老管事",
          "text": "沙漏边上，回读只问一句：你敢不敢对空。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_2",
          "speaker": "岁吏",
          "text": "年迹旁多了一行「副页回读」。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_3",
          "speaker": "书记官",
          "text": "能念的字在上行。空得住的格还在下行等。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_4",
          "speaker": "leader",
          "text": "两行都打开。我要听对看。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_5",
          "speaker": "旁白",
          "text": "沙响。上行亮，下行仍暗。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_6",
          "speaker": "苇原·灯影",
          "text": "巡防牌上写副页。不写急锣。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_7",
          "speaker": "老管事",
          "text": "催挂板的人在门外跺脚。跺不进沙漏。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_8",
          "speaker": "书记官",
          "text": "并排不是拖月。是让空格跟月份并排走。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_9",
          "speaker": "岁吏",
          "text": "月结不抹空。空也要入迹。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_10",
          "speaker": "leader",
          "text": "我听空格。不听跺脚。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_11",
          "speaker": "旁白",
          "text": "沙又落一层。下行多了一点亮。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_12",
          "speaker": "老管事",
          "text": "锣停了。空格还在。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_13",
          "speaker": "书记官",
          "text": "回读夜的字，比催条长命。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_14",
          "speaker": "岁吏",
          "text": "带牌出去。沙漏还转。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_15",
          "speaker": "旁白",
          "text": "两行对准了。一对上，假填就站不住。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_16",
          "speaker": "老管事",
          "text": "假名进不了沙漏。空格能。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_y17",
          "speaker": "旁白",
          "text": "沙漏座边灯花又爆，爆完上行的无还在。"
        },
        {
          "id": "cs01_02_hourglass_y18",
          "speaker": "石垒·晚担",
          "text": "沙盖住假亮。盖不住的，才是这格的字。"
        },
        {
          "id": "cs01_02_hourglass_y19",
          "speaker": "leader",
          "text": "两行里只留盖不住的。"
        },
        {
          "id": "cs01_02_hourglass_17",
          "speaker": "苇原·灯影",
          "text": "带牌去。牌上写副页，不写急。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs0102_vhg1",
          "speaker": "岁吏",
          "text": "副页压在正页下。正页有字，副页空行，像并排的两盏。"
        },
        {
          "id": "cs0102_vhg2",
          "speaker": "书记官",
          "text": "回读不改月份。改的是你敢不敢把空行念出声。"
        },
        {
          "id": "cs0102_vhg3",
          "speaker": "leader",
          "text": "副页空着。我对着空行，不拿正页的字去糊。"
        },
        {
          "id": "cs0102_vhg4",
          "speaker": "苇原·灯影",
          "text": "两页中间夹着沙。沙响，空行更清楚。"
        },
                  {
            "id": "cs0102_msr1",
            "speaker": "旁白",
            "text": "副页折进怀里。折痕对齐靴跟，像两行并排。"
          },
          {
            "id": "cs0102_msr2",
            "speaker": "老管事",
            "text": "空格念过了。念过再系甲，甲才不虚。"
          },
          {
            "id": "cs0102_msr3",
            "speaker": "岁吏",
            "text": "沙声停在耳后。耳后清，桥才听得见。"
          },
          {
            "id": "cs0102_msr4",
            "speaker": "苇原·灯影",
            "text": "牌上副页二字朝外。朝外是提醒，不是炫耀。"
          },
          {
            "id": "cs0102_msr5",
            "speaker": "槐里·青禾",
            "text": "灯油再添半指。半指够走到门廊。"
          },
          {
            "id": "cs0102_msr6",
            "speaker": "leader",
            "text": "副页我贴身。整装完，去门廊。"
          },
{
          "id": "cs0102_vis_mv1",
          "speaker": "旁白",
          "text": "时漏沙声细。细到能听见自己的呼吸。"
        },
        {
          "id": "cs0102_vis_mv2",
          "speaker": "岁吏",
          "text": "呼吸稳，沙才听得进。"
        },
        {
          "id": "cs0102_vis_mv3",
          "speaker": "槐里·青禾",
          "text": "沙漏不问空格急不急。"
        },
        {
          "id": "cs0102_vst1",
          "speaker": "岁吏",
          "text": "月份从泥印边沿挪开。挪开，才看见真沙漏。"
        },
        {
          "id": "cs0102_vst2",
          "speaker": "书记官",
          "text": "补欠那格，要等桥泥干。"
        },
        {
          "id": "cs0102_vst3",
          "speaker": "leader",
          "text": "月份挪过。欠，我补。"
        },
        {
          "id": "cs0102_vis_mv4",
          "speaker": "leader",
          "text": "不急。去看月份怎么走。"
        }
      ],
      "next": "bridge",
      "actions": [
        {
          "id": "open_hourglass",
          "label": "去看月份怎么往前走",
          "do": [
            {
              "op": "visit",
              "path": "res://scenes/hub/hourglass.tscn"
            }
          ]
        },
        {
          "id": "continue_after_visit",
          "label": "继续，去门廊",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ]
    },
    {
      "id": "bridge",
      "title": "门廊",
      "lines": [
        {
          "id": "cs01_02_bridge_0",
          "speaker": "旁白",
          "text": "门廊石缝里卡着半张副页，风扯不动那条边。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_1",
          "speaker": "岁吏",
          "text": "空格还空着。你先稳住手，别拿刀去填字。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_2",
          "speaker": "leader",
          "text": "手稳了才出锋。赢了也不许把空格写成有。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_3",
          "speaker": "老旗手",
          "text": "这一锋你可以收回袖里。收回去，空格照样不许借字。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_4",
          "speaker": "旁白",
          "text": "桥下水很急。副页灯只照到纸边，照不到对岸的锣。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_5",
          "speaker": "书记官",
          "text": "催条我可以撕。副页这一本，谁伸手谁留下指纹。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_6",
          "speaker": "苇原·灯影",
          "text": "我站桥侧。不问你赢没赢，问你还肯不肯回去对那一格。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_7",
          "speaker": "老管事",
          "text": "城门锣响是催人。桥上只该听见自己的呼吸。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_8",
          "speaker": "leader",
          "text": "出鞘不出鞘，空格都钉在门边。钉着，就不归别人填。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_9",
          "speaker": "岁吏",
          "text": "得手了，把锋放低。并排的纸还要接着读，别抬头看锣。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_10",
          "speaker": "旁白",
          "text": "远处锣声被水声切成一段一段，切不断副页上的空。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_11",
          "speaker": "老旗手",
          "text": "身上有伤也先去酒馆。选题用嘴，不用血去填格。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_12",
          "speaker": "书记官",
          "text": "先把题选了。假名排在后头，后头的今晚不要。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_13",
          "speaker": "苇原·灯影",
          "text": "牌在你手里。牌面还是副页，没有换成捷报。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_14",
          "speaker": "老管事",
          "text": "挂板的人脚尖已经点地。你要是等空格，就让他们点着。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_15",
          "speaker": "leader",
          "text": "我等这一格空着被看见。锣可以先响。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_16",
          "speaker": "旁白",
          "text": "桥板颤了一下。灯芯没跳，副页的毛边还立着。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_17",
          "speaker": "岁吏",
          "text": "你要是不出鞘，也可以去酒馆。空格不会因为你没打就自己长字。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_18",
          "speaker": "老旗手",
          "text": "打输了就把伤留在袖里。先去把题选了，别站在桥上改口。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_y20",
          "speaker": "旁白",
          "text": "门廊风把副页毛边吹立起来，立着比印清楚。"
        },
        {
          "id": "cs01_02_bridge_y21",
          "speaker": "石垒·晚担",
          "text": "立起来的毛，刀风吹不倒。倒的是假页。"
        },
        {
          "id": "cs01_02_bridge_y22",
          "speaker": "leader",
          "text": "毛边还立着。真的，并排带去。"
        },
        {
          "id": "cs01_02_bridge_19",
          "speaker": "岁吏",
          "text": "催条撕了就撕了。副页这一回，撕口我认得出。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs0102_mid_mv1",
          "speaker": "旁白",
          "text": "副页钉在门边。风一过，纸角翘起来像招手。"
        },
        {
          "id": "cs0102_mid_mv2",
          "speaker": "岁吏",
          "text": "副页招手，不等于让你空着手出去。"
        },
        {
          "id": "cs0102_mid_mv3",
          "speaker": "石垒·晚担",
          "text": "空着手出去，回来只配写半行。"
        },
        {
          "id": "cs0102_mid_mv4",
          "speaker": "槐里·青禾",
          "text": "半行也比假满强。假满见光就灰。"
        },
        {
          "id": "cs0102_mid_mv5",
          "speaker": "老旗手",
          "text": "门外那拨盯着空格。空格不是给他们填的。"
        },
        {
          "id": "cs0102_mid_mv6",
          "speaker": "leader",
          "text": "空格我守。锋先问清楚。"
        },
        {
          "id": "cs0102_bpl1",
          "speaker": "旁白",
          "text": "副页的钉松了一颗，钉帽在石上滚到靴边停住。"
        },
        {
          "id": "cs0102_bpl2",
          "speaker": "岁吏",
          "text": "钉帽滚了，页还在。页在，就不许空手过桥。"
        },
        {
          "id": "cs0102_bpl3",
          "speaker": "石垒·晚担",
          "text": "桥对面有人伸手，像要接这页。手伸得太长。"
        },
        {
          "id": "cs0102_bpl4",
          "speaker": "槐里·青禾",
          "text": "接页的人最会说「我帮你填」。帮字后面是假。"
        },
        {
          "id": "cs0102_bpl5",
          "speaker": "老旗手",
          "text": "旗角压住那颗钉。钉不归他们捡。"
        },
        {
          "id": "cs0102_bpl6",
          "speaker": "leader",
          "text": "页我自己带过桥。锋先把那只手问回去。"
        },
        {
          "id": "cs0102_win1",
          "speaker": "旁白",
          "text": "锋再定。桥侧泥印浅了，滑步那拨退到芦里。",
          "when": {
            "flag": "cs01_mid_fought"
          }
        },
        {
          "id": "cs0102_win2",
          "speaker": "老旗手",
          "text": "泥里的脚窝，比刀痕好认。",
          "when": {
            "flag": "cs01_mid_fought"
          }
        },
        {
          "id": "cs0102_win3",
          "speaker": "苇原·灯影",
          "text": "吴钩的影短了。短了，才敢回头。",
          "when": {
            "flag": "cs01_mid_fought"
          }
        },
        {
          "id": "cs0102_win4",
          "speaker": "leader",
          "text": "这一锋补上月的欠。桥，我还过。",
          "when": {
            "flag": "cs01_mid_fought"
          }
        },
        {
          "speaker": "旁白",
          "text": "锋收回来。副页纸还钉着。空格旁那拨，没散。",
          "when": {
            "all": [
              {
                "flag": "cs01_mid_lost"
              },
              {
                "not_flag": "cs01_mid_fought"
              }
            ]
          },
          "id": "cs01b_br_lost"
        }
      ],
      "next": "tavern",
      "actions": [

    {
      "id": "ledger",
      "title": "入谱",
      "lines": [
        {
          "id": "cs01_02_ledger_0",
          "speaker": "旁白",
          "text": "入谱。副页与回执并排进柜。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_1",
          "speaker": "书记官",
          "text": "空格有灯。灯不灭。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_2",
          "speaker": "leader",
          "text": "我看见空了。空也在谱里。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_3",
          "speaker": "岁吏",
          "text": "年迹末行写：副页并排留。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_4",
          "speaker": "老管事",
          "text": "挂板锣再响，也撕不开柜门。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_5",
          "speaker": "旁白",
          "text": "柜门一合。灯还在缝里。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_6",
          "speaker": "苇原·灯影",
          "text": "巡防收牌。牌上副页两字还热。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_7",
          "speaker": "书记官",
          "text": "整张回执，才算回。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_8",
          "speaker": "leader",
          "text": "假名没进来。好。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_9",
          "speaker": "岁吏",
          "text": "月结旁多一笔空格。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_10",
          "speaker": "老管事",
          "text": "催条叠在门外。谱在门内。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_11",
          "speaker": "旁白",
          "text": "墨干。空格的边也干了。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_12",
          "speaker": "书记官",
          "text": "下次打开，空格还在——带着灯。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_13",
          "speaker": "leader",
          "text": "够了。去灰旗堡。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_14",
          "speaker": "苇原·灯影",
          "text": "堡门亮着。副页灯跟着。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_15",
          "speaker": "岁吏",
          "text": "年迹合上。字还在。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_16",
          "speaker": "老管事",
          "text": "账房可歇。谱不可假。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_17",
          "speaker": "旁白",
          "text": "风停。纸平。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_18",
          "speaker": "书记官",
          "text": "并排不是拖。是完整。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_y19",
          "speaker": "旁白",
          "text": "册边起毛。毛边比印鉴老实。"
        },
        {
          "id": "cs01_02_ledger_y20",
          "speaker": "石垒·晚担",
          "text": "老实的才并排。"
        },
        {
          "id": "cs01_02_ledger_y21",
          "speaker": "leader",
          "text": "并排留真。"
        },
        {
          "id": "cs01_02_ledger_19",
          "speaker": "leader",
          "text": "灯不灭。副页本在柜里。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        }
      ],
      "actions": []
    }
  ],
  "title_en": "Lamp on the Slip Page"
}

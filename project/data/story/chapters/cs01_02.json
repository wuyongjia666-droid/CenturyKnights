{
  "id": "cs01_02",
  "title": "副页上的灯",
  "legacy_index": 411,
  "return_scene": "res://scenes/hub/castle_hub.tscn",
  "source": "docs/content-seasons/season-01/NOVEL.md",
  "beats": [
    {
      "id": "slip",
      "title": "副页",
      "lines": [
        {
          "id": "cs01_02_slip_0",
          "speaker": "旁白",
          "text": "账房。上回回执已入柜。副页还空着一格。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_1",
          "speaker": "书记官",
          "text": "正面写过了。副页要能念，不能只剩墨味。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_2",
          "speaker": "leader",
          "text": "我要听空格。空着也得说得出。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_3",
          "speaker": "旁白",
          "text": "柜门一响。回执与副页并排放上长桌。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_4",
          "speaker": "老管事",
          "text": "挂板的人催得急。空格的人说再等等。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_5",
          "speaker": "岁吏",
          "text": "年迹旁多了一行「副页夜」。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_6",
          "speaker": "苇原·灯影",
          "text": "巡防不问谁挂板。问今夜谁还空着格。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_7",
          "speaker": "旁白",
          "text": "两行字第一次对视。正面亮，副页暗。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_8",
          "speaker": "书记官",
          "text": "能念的字在正面。坐得住的空在副页等。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_9",
          "speaker": "leader",
          "text": "把空格念给我听。别念催条。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_10",
          "speaker": "老管事",
          "text": "催条可以撕。副页撕不得。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_11",
          "speaker": "旁白",
          "text": "灯矮了一寸。空格反而更清楚。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_12",
          "speaker": "岁吏",
          "text": "回执已记账。副页记账才算整张。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_13",
          "speaker": "书记官",
          "text": "并排不是拖。是让空格也有灯。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_14",
          "speaker": "leader",
          "text": "我听懂了。空着，也要并排。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_15",
          "speaker": "旁白",
          "text": "风从窗缝进来。纸角动，字不动。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_16",
          "speaker": "老管事",
          "text": "挂板的锣在门外。锣响不进账房。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_slip_y17",
          "speaker": "旁白",
          "text": "灯花爆了一下。爆完，字才肯站住。"
        },
        {
          "id": "cs01_02_slip_y18",
          "speaker": "石垒·晚担",
          "text": "假亮捂不热。这格只留真。"
        },
        {
          "id": "cs01_02_slip_y19",
          "speaker": "leader",
          "text": "记下。不催假名。"
        },
        {
          "id": "cs01_02_slip_17",
          "speaker": "槐里·青禾",
          "text": "副页比回执薄。薄的反而难装。",
          "stage": {
            "card": "一　副页",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        }
      ],
      "next": "wu"
    },
    {
      "id": "wu",
      "title": "空格",
      "lines": [
        {
          "id": "cs01_02_wu_0",
          "speaker": "旁白",
          "text": "空格摊开。吴姓那格亮着，旁格还空。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_1",
          "speaker": "老管事",
          "text": "上回写吴的，格里有字。压下的，格仍空。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_2",
          "speaker": "旁白",
          "text": "两行字第二次吵架。回读逼它们对视·回执。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_3",
          "speaker": "苇原·灯影",
          "text": "巡防不问谁姓吴。问今夜谁还空着格。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_4",
          "speaker": "书记官",
          "text": "有字的格能念。空格要人敢看。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_5",
          "speaker": "leader",
          "text": "空格不是错。催满才是错。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_6",
          "speaker": "岁吏",
          "text": "年迹不改姓。只记你敢不敢对空。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_7",
          "speaker": "旁白",
          "text": "墨干了。空格的边还潮。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_8",
          "speaker": "老管事",
          "text": "挂板锣又响。响在门外，进不了格。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_9",
          "speaker": "书记官",
          "text": "并排留空，比硬填假名干净。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_10",
          "speaker": "leader",
          "text": "假名我不要。空格我要听。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_11",
          "speaker": "旁白",
          "text": "灯把空格照成浅坑。坑里没有字。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_12",
          "speaker": "岁吏",
          "text": "回执上的吴还在。副页上的空也在。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_13",
          "speaker": "苇原·灯影",
          "text": "带牌去。牌上写副页，不写催。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_14",
          "speaker": "老管事",
          "text": "催条叠得高。空格叠不住。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_15",
          "speaker": "书记官",
          "text": "能念的在正面。敢留的在副页。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_16",
          "speaker": "旁白",
          "text": "纸角又动。空格仍空。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_wu_y17",
          "speaker": "旁白",
          "text": "册边起毛。毛边比印鉴老实。"
        },
        {
          "id": "cs01_02_wu_y18",
          "speaker": "石垒·晚担",
          "text": "老实的才并排。"
        },
        {
          "id": "cs01_02_wu_y19",
          "speaker": "leader",
          "text": "并排留真。"
        },
        {
          "id": "cs01_02_wu_17",
          "speaker": "老旗手",
          "text": "空格灯还亮。亮着，才敢回读。",
          "stage": {
            "card": "二　空格",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        }
      ],
      "next": "hourglass"
    },
    {
      "id": "hourglass",
      "title": "两行",
      "lines": [
        {
          "id": "cs01_02_hourglass_0",
          "speaker": "旁白",
          "text": "沙漏厅。上行回执、下行副页。回读把两行按住。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_1",
          "speaker": "老管事",
          "text": "月份往前走。回读不改月份，只改你敢不敢对空。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_2",
          "speaker": "岁吏",
          "text": "年迹旁多了一行「副页回读」。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_3",
          "speaker": "书记官",
          "text": "能念的字在上行。空得住的格还在下行等。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_4",
          "speaker": "leader",
          "text": "两行都打开。我要听对看。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_5",
          "speaker": "旁白",
          "text": "沙响。上行亮，下行仍暗。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_6",
          "speaker": "苇原·灯影",
          "text": "巡防牌上写副页。不写急锣。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_7",
          "speaker": "老管事",
          "text": "催挂板的人在门外跺脚。跺不进沙漏。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_8",
          "speaker": "书记官",
          "text": "并排不是拖月。是让空格跟月份并排走。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_9",
          "speaker": "岁吏",
          "text": "月结不抹空。空也要入迹。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_10",
          "speaker": "leader",
          "text": "我听空格。不听跺脚。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_11",
          "speaker": "旁白",
          "text": "沙又落一层。下行多了一点亮。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_12",
          "speaker": "老管事",
          "text": "锣停了。空格还在。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_13",
          "speaker": "书记官",
          "text": "回读夜的字，比催条长命。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_14",
          "speaker": "岁吏",
          "text": "带牌出去。沙漏还转。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_15",
          "speaker": "旁白",
          "text": "两行终于对上。一对，就不敢假填。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_16",
          "speaker": "老管事",
          "text": "假名进不了沙漏。空格能。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_hourglass_y17",
          "speaker": "旁白",
          "text": "灯花爆了一下。爆完，字才肯站住。"
        },
        {
          "id": "cs01_02_hourglass_y18",
          "speaker": "石垒·晚担",
          "text": "假亮捂不热。这格只留真。"
        },
        {
          "id": "cs01_02_hourglass_y19",
          "speaker": "leader",
          "text": "记下。不催假名。"
        },
        {
          "id": "cs01_02_hourglass_17",
          "speaker": "苇原·灯影",
          "text": "带牌去。牌上写副页，不写急。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs0102_vis_mv1",
          "speaker": "旁白",
          "text": "时漏沙声细。细到能听见自己的呼吸。"
        },
        {
          "id": "cs0102_vis_mv2",
          "speaker": "岁吏",
          "text": "呼吸稳，沙才听得进。"
        },
        {
          "id": "cs0102_vis_mv3",
          "speaker": "槐里·青禾",
          "text": "沙漏不问空格急不急。"
        },
        {
          "id": "cs0102_vst1",
          "speaker": "岁吏",
          "text": "月份从泥印边沿挪开。挪开，才看见真沙漏。"
        },
        {
          "id": "cs0102_vst2",
          "speaker": "书记官",
          "text": "补欠那格，要等桥泥干。"
        },
        {
          "id": "cs0102_vst3",
          "speaker": "leader",
          "text": "月份挪过。欠，我补。"
        },
        {
          "id": "cs0102_vis_mv4",
          "speaker": "leader",
          "text": "不急。去看月份怎么走。"
        }
      ],
      "next": "bridge",
      "actions": [
        {
          "id": "open_hourglass",
          "label": "去看月份怎么往前走",
          "do": [
            {
              "op": "visit",
              "path": "res://scenes/hub/hourglass.tscn"
            }
          ]
        },
        {
          "id": "continue_after_visit",
          "label": "继续，去门廊",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ]
    },
    {
      "id": "bridge",
      "title": "门廊",
      "lines": [
        {
          "id": "cs01_02_bridge_0",
          "speaker": "旁白",
          "text": "门廊。副页灯还在身后。锋镝在桥上试。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_1",
          "speaker": "岁吏",
          "text": "试锋不改空格。只问你手稳不稳。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_2",
          "speaker": "leader",
          "text": "先试一锋。赢了再谈挂板。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_3",
          "speaker": "老旗手",
          "text": "锋收回来也行。空格不靠锋填。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_4",
          "speaker": "旁白",
          "text": "桥风大。灯小。字还在。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_5",
          "speaker": "书记官",
          "text": "催条可以撕。副页本撕不得。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_6",
          "speaker": "苇原·灯影",
          "text": "巡防站桥侧。不问胜负，问你还回不回读。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_7",
          "speaker": "老管事",
          "text": "锣在城门。桥上只听见水。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_8",
          "speaker": "leader",
          "text": "锋出不出，空格都在。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_9",
          "speaker": "岁吏",
          "text": "试锋得手，锋镝压下，并排纸可续。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_10",
          "speaker": "旁白",
          "text": "水声盖过远处锣。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_11",
          "speaker": "老旗手",
          "text": "伤还在也行。先去酒馆选题。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_12",
          "speaker": "书记官",
          "text": "选题在前。假名在后——后的不要。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_13",
          "speaker": "苇原·灯影",
          "text": "牌还在手里。牌上仍是副页。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_14",
          "speaker": "老管事",
          "text": "挂板的人等不及。你等得及。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_15",
          "speaker": "leader",
          "text": "我等空格。不等锣。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_16",
          "speaker": "旁白",
          "text": "桥板一颤。灯不灭。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_17",
          "speaker": "岁吏",
          "text": "未试锋——锋未出鞘，也可去酒馆。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_18",
          "speaker": "老旗手",
          "text": "试锋未成——伤还在，先去酒馆。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_bridge_y20",
          "speaker": "旁白",
          "text": "册边起毛。毛边比印鉴老实。"
        },
        {
          "id": "cs01_02_bridge_y21",
          "speaker": "石垒·晚担",
          "text": "老实的才并排。"
        },
        {
          "id": "cs01_02_bridge_y22",
          "speaker": "leader",
          "text": "并排留真。"
        },
        {
          "id": "cs01_02_bridge_19",
          "speaker": "岁吏",
          "text": "催条可以撕。副页本撕不得·回执。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs0102_mid_mv1",
          "speaker": "旁白",
          "text": "副页钉在门边。风一过，纸角翘起来像招手。"
        },
        {
          "id": "cs0102_mid_mv2",
          "speaker": "岁吏",
          "text": "副页招手，不等于让你空着手出去。"
        },
        {
          "id": "cs0102_mid_mv3",
          "speaker": "石垒·晚担",
          "text": "空着手出去，回来只配写半行。"
        },
        {
          "id": "cs0102_mid_mv4",
          "speaker": "槐里·青禾",
          "text": "半行也比假满强。假满见光就灰。"
        },
        {
          "id": "cs0102_mid_mv5",
          "speaker": "老旗手",
          "text": "门外那拨盯着空格。空格不是给他们填的。"
        },
        {
          "id": "cs0102_mid_mv6",
          "speaker": "leader",
          "text": "空格我守。锋先问清楚。"
        },
        {
          "id": "cs0102_win1",
          "speaker": "旁白",
          "text": "锋再定。桥侧泥印浅了，滑步那拨退到芦里。",
          "when": {
            "flag": "cs01_mid_fought"
          }
        },
        {
          "id": "cs0102_win2",
          "speaker": "老旗手",
          "text": "泥里的脚窝，比刀痕好认。",
          "when": {
            "flag": "cs01_mid_fought"
          }
        },
        {
          "id": "cs0102_win3",
          "speaker": "苇原·灯影",
          "text": "吴钩的影短了。短了，才敢回头。",
          "when": {
            "flag": "cs01_mid_fought"
          }
        },
        {
          "id": "cs0102_win4",
          "speaker": "leader",
          "text": "这一锋补上月的欠。桥，我还过。",
          "when": {
            "flag": "cs01_mid_fought"
          }
        },
        {
          "speaker": "旁白",
          "text": "锋收回来。副页纸还钉着。空格旁那拨，没散。",
          "when": {
            "all": [
              {
                "flag": "cs01_02_mid_lost"
              },
              {
                "not_flag": "cs01_02_mid_fought"
              }
            ]
          },
          "id": "cs01b_br_lost"
        }
      ],
      "next": "tavern",

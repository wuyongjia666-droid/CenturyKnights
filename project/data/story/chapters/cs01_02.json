          ]
        }
      ]
    },
    {
      "id": "tavern",
      "title": "选题",
      "lines": [
                  {
            "id": "cs0102_arr1",
            "speaker": "旁白",
            "text": "门帘一掀，酒气先到。板在气后头。"
          },
          {
            "id": "cs0102_arr2",
            "speaker": "掌柜",
            "text": "气散开再钉。钉早了，字会吸潮。"
          },
          {
            "id": "cs0102_arr3",
            "speaker": "老管事",
            "text": "副页在袖。袖不敞，进店不丢字。"
          },
          {
            "id": "cs0102_arr4",
            "speaker": "槐里·青禾",
            "text": "灯花先掐。掐完，板上的灯才是真灯。"
          },
          {
            "id": "cs0102_arr5",
            "speaker": "岁吏",
            "text": "沙声留在门外。门内只留板声。"
          },
          {
            "id": "cs0102_arr6",
            "speaker": "leader",
            "text": "我到店。气匀了，再认挂板。"
          },
{
          "id": "cs01_02_tavern_0",
          "speaker": "旁白",
          "text": "酒馆。板上两道题。手按上去。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_1",
          "speaker": "掌柜",
          "text": "一道空格并排留。一道先催挂板。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_2",
          "speaker": "leader",
          "text": "我看题。不看谁嗓门大。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_3",
          "speaker": "老管事",
          "text": "并排留真。催挂板快。快的未必真。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_4",
          "speaker": "书记官",
          "text": "空格进谱，才算整张回执。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_5",
          "speaker": "岁吏",
          "text": "年迹听选择。不听锣。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_6",
          "speaker": "旁白",
          "text": "酒气里纸更白。白得能看见空。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_7",
          "speaker": "掌柜",
          "text": "选完入柜。副页柜门会响。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_8",
          "speaker": "苇原·灯影",
          "text": "巡防在门外。门内只选题。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_9",
          "speaker": "leader",
          "text": "空格并排留——我手按这道。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_10",
          "speaker": "老管事",
          "text": "按实了。别悬着。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_11",
          "speaker": "书记官",
          "text": "假名那道我划掉。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_12",
          "speaker": "旁白",
          "text": "板面一热。字进手心。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_13",
          "speaker": "岁吏",
          "text": "选择入账。副页夜可结。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_14",
          "speaker": "掌柜",
          "text": "另一道也在。你不选它。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_15",
          "speaker": "老管事",
          "text": "催挂板的锣远了。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_16",
          "speaker": "旁白",
          "text": "两道题还在板上。只一道进柜。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_y17",
          "speaker": "旁白",
          "text": "酒馆灯花爆在副页夹缝，缝里有一点没干的油。"
        },
        {
          "id": "cs01_02_tavern_y18",
          "speaker": "石垒·晚担",
          "text": "油还黏。黏的不是假名，是刚核对过。"
        },
        {
          "id": "cs01_02_tavern_y19",
          "speaker": "leader",
          "text": "黏着的副页带回。假名留在柜外。"
        },
        {
          "id": "cs01_02_tavern_17",
          "speaker": "老管事",
          "text": "选完入柜。副页柜门会响·回执。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs0102_ret_mv1",
          "speaker": "旁白",
          "text": "副页话题在酒桌上滚了一圈，又滚回来。"
        },
        {
          "id": "cs0102_ret_mv2",
          "speaker": "掌柜",
          "text": "滚回来的话，要过板。"
        },
        {
          "id": "cs0102_ret_mv3",
          "speaker": "岁吏",
          "text": "过板的才配回读。"
        },
        {
          "id": "cs0102_tvp1",
          "speaker": "旁白",
          "text": "副页从袖里抽出时，折痕正对挂板的空格。"
        },
        {
          "id": "cs0102_tvp2",
          "speaker": "掌柜",
          "text": "空格等副页，不等闲话。闲话占格，格就废。"
        },
        {
          "id": "cs0102_tvp3",
          "speaker": "岁吏",
          "text": "废格明年还在。在的是空，不是你的借口。"
        },
        {
          "id": "cs0102_tvp4",
          "speaker": "石垒·晚担",
          "text": "副页薄。薄页上钉，钉要轻，字要重。"
        },
        {
          "id": "cs0102_tvp5",
          "speaker": "书记官",
          "text": "重字才配并排。轻字像偷挂。"
        },
        {
          "id": "cs0102_tvp6",
          "speaker": "leader",
          "text": "副页我按进空格。挂之前，先问自己一句。"
        },
        {
          "id": "cs0102_tvn1",
          "speaker": "掌柜",
          "text": "桥泥那一锋，靴底还潮。"
        },
        {
          "id": "cs0102_tvn2",
          "speaker": "石垒·晚担",
          "text": "芦里那拨退了。退了才配要酒。"
        },
        {
          "id": "cs0102_tvn3",
          "speaker": "听回",
          "text": "吴钩影短的事，桌上有人传。"
        },
        {
          "id": "cs0102_tvn4",
          "speaker": "leader",
          "text": "泥干。人在。补欠，算数。"
        },
          {
            "id": "cs0102_tvx1",
            "speaker": "旁白",
            "text": "挂绳松半扣。松了，板还在，人可以走。"
          },
          {
            "id": "cs0102_tvx2",
            "speaker": "掌柜",
            "text": "温酒收壶。收了，夜才算过完。"
          },
          {
            "id": "cs0102_tvx3",
            "speaker": "听回",
            "text": "盏扣进柜。扣进，店里少一响。"
          },
          {
            "id": "cs0102_tvx4",
            "speaker": "苇原·灯影",
            "text": "弓从墙边取回。取回，手不再空着认字。"
          },
          {
            "id": "cs0102_tvx5",
            "speaker": "岁吏",
            "text": "沙声从门外接上。接上，月份继续走。"
          },
          {
            "id": "cs0102_tvx6",
            "speaker": "leader",
            "text": "挂完了。我掀帘，路回堡。"
          },

        {
          "id": "cs0102_ret_mv4",
          "speaker": "leader",
          "text": "过板。回堡入谱。"
        }
      ],
      "actions": [

              "title": "副页上的灯",
              "outcome": "未试锋——锋未出鞘，径去酒馆",
              "yeartrace": true
            },
            {
              "op": "season_ledger",
              "when": {
                "all": [
                  {
                    "not_flag": "cs01_mid_fought"
                  },
                  {
                    "flag": "cs01_mid_lost"
                  }
                ]
              },
              "chapter": "cs01_02",

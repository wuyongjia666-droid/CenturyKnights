    },
    {
      "id": "ledger",
      "title": "入谱",
      "lines": [
        {
          "id": "cs01_02_ledger_0",
          "speaker": "旁白",
          "text": "入谱。副页与回执并排进柜。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_1",
          "speaker": "书记官",
          "text": "空格有灯。灯不灭。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_2",
          "speaker": "leader",
          "text": "我看见空了。空也在谱里。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_3",
          "speaker": "岁吏",
          "text": "年迹末行写：副页并排留。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_4",
          "speaker": "老管事",
          "text": "挂板锣再响，也撕不开柜门。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_5",
          "speaker": "旁白",
          "text": "柜门一合。灯还在缝里。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_6",
          "speaker": "苇原·灯影",
          "text": "巡防收牌。牌上副页两字还热。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_7",
          "speaker": "书记官",
          "text": "整张回执，才算回。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_8",
          "speaker": "leader",
          "text": "假名没进来。好。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_9",
          "speaker": "岁吏",
          "text": "月结旁多一笔空格。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_10",
          "speaker": "老管事",
          "text": "催条叠在门外。谱在门内。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_11",
          "speaker": "旁白",
          "text": "墨干。空格的边也干了。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_12",
          "speaker": "书记官",
          "text": "下次打开，空格还在——带着灯。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_13",
          "speaker": "leader",
          "text": "够了。去灰旗堡。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_14",
          "speaker": "苇原·灯影",
          "text": "堡门亮着。副页灯跟着。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_15",
          "speaker": "岁吏",
          "text": "年迹合上。字还在。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_16",
          "speaker": "老管事",
          "text": "账房可歇。谱不可假。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_17",
          "speaker": "旁白",
          "text": "风停。纸平。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_18",
          "speaker": "书记官",
          "text": "并排不是拖。是完整。",
          "stage": {
            "card": "六　入谱",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs01_02_ledger_y19",
          "speaker": "旁白",
          "text": "册边起毛。毛边比印鉴老实。"
        },
        {
          "id": "cs01_02_ledger_y20",
          "speaker": "石垒·晚担",
          "text": "老实的才并排。"
        },
        {
          "id": "cs01_02_ledger_y21",
          "speaker": "leader",
          "text": "并排留真。"
        },
        {
          "id": "cs0102_ldg1",
          "speaker": "岁吏",
          "text": "副页空格与泥印并排，补欠才像真的。"
        },
        {
          "id": "cs0102_ldg2",
          "speaker": "书记官",
          "text": "滑步那拨的脚窝，只进旁注不进正格。"
        },
        {
          "id": "cs0102_ldg3",
          "speaker": "槐里·青禾",
          "text": "薄页难装——装下的，才是补上的欠。"
        },
        {
          "id": "cs0102_ldg4",
          "speaker": "leader",
          "text": "空格并排留。灯不灭，副页在柜。"
        },
        {
          "id": "cs0102_ldg_end",
          "speaker": "leader",
          "text": "桥泥干处，灰旗堡副页柜等补欠入谱。"
        },
        {
          "id": "cs0102_cls1",
          "speaker": "旁白",
          "text": "桥上的锋停了。吴钩的影子缩回桥栏。"
        },
        {
          "id": "cs0102_cls2",
          "speaker": "老旗手",
          "text": "旗从桥头收回来。副页夹在肘弯里，风没把角掀开。"
        },
        {
          "id": "cs0102_cls3",
          "speaker": "石垒·晚担",
          "text": "靴跟上的泥干了一层。干了再进门，柜里才不脏。"
        },
        {
          "id": "cs0102_cls4",
          "speaker": "槐里·青禾",
          "text": "空格并排留在薄页上。薄页不喊，喊的是那些厚纸。"
        },
        {
          "id": "cs0102_cls5",
          "speaker": "老管事",
          "text": "补欠记在边角。边角比封面老实，我把它收进柜。"
        },
        {
          "id": "cs0102_cls6",
          "speaker": "岁吏",
          "text": "边上的字我按岁课收。功劳那一栏，今天空着。"
        },
        {
          "id": "cs0102_cls7",
          "speaker": "苇原·灯影",
          "text": "副页柜里的灯只照空行。空行亮着，功名就挤不进来。"
        },
        {
          "id": "cs0102_cls8",
          "speaker": "leader",
          "text": "副页进柜。桥上的欠，今天补到边角为止。"
        }
      ],
      "actions": []
    }
  ],
  "title_en": "Lamp on the Slip Page"
}

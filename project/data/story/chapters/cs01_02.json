    {
      "id": "tavern",
      "title": "选题",
      "lines": [
        {
          "id": "cs01_02_tavern_0",
          "speaker": "旁白",
          "text": "酒馆。板上两道题。手按上去。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_1",
          "speaker": "掌柜",
          "text": "一道空格并排留。一道先催挂板。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_2",
          "speaker": "leader",
          "text": "我看题。不看谁嗓门大。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_3",
          "speaker": "老管事",
          "text": "并排留真。催挂板快。快的未必真。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_4",
          "speaker": "书记官",
          "text": "空格进谱，才算整张回执。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_5",
          "speaker": "岁吏",
          "text": "年迹听选择。不听锣。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_6",
          "speaker": "旁白",
          "text": "酒气里纸更白。白得能看见空。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_7",
          "speaker": "掌柜",
          "text": "选完入柜。副页柜门会响。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_8",
          "speaker": "苇原·灯影",
          "text": "巡防在门外。门内只选题。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_9",
          "speaker": "leader",
          "text": "空格并排留——我手按这道。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_10",
          "speaker": "老管事",
          "text": "按实了。别悬着。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_11",
          "speaker": "书记官",
          "text": "假名那道我划掉。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_12",
          "speaker": "旁白",
          "text": "板面一热。字进手心。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_13",
          "speaker": "岁吏",
          "text": "选择入账。副页夜可结。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_14",
          "speaker": "掌柜",
          "text": "另一道也在。你不选它。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_15",
          "speaker": "老管事",
          "text": "催挂板的锣远了。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_16",
          "speaker": "旁白",
          "text": "两道题还在板上。只一道进柜。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs01_02_tavern_y17",
          "speaker": "旁白",
          "text": "灯花爆了一下。爆完，字才肯站住。"
        },
        {
          "id": "cs01_02_tavern_y18",
          "speaker": "石垒·晚担",
          "text": "假亮捂不热。这格只留真。"
        },
        {
          "id": "cs01_02_tavern_y19",
          "speaker": "leader",
          "text": "记下。不催假名。"
        },
        {
          "id": "cs01_02_tavern_17",
          "speaker": "老管事",
          "text": "选完入柜。副页柜门会响·回执。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs0102_ret_mv1",
          "speaker": "旁白",
          "text": "副页话题在酒桌上滚了一圈，又滚回来。"
        },
        {
          "id": "cs0102_ret_mv2",
          "speaker": "掌柜",
          "text": "滚回来的话，要过板。"
        },
        {
          "id": "cs0102_ret_mv3",
          "speaker": "岁吏",
          "text": "过板的才配回读。"
        },
        {
          "id": "cs0102_tvn1",
          "speaker": "掌柜",
          "text": "桥泥那一锋，靴底还潮。"
        },
        {
          "id": "cs0102_tvn2",
          "speaker": "石垒·晚担",
          "text": "芦里那拨退了。退了才配要酒。"
        },
        {
          "id": "cs0102_tvn3",
          "speaker": "听回",
          "text": "吴钩影短的事，桌上有人传。"
        },
        {
          "id": "cs0102_tvn4",
          "speaker": "leader",
          "text": "泥干。人在。补欠，算数。"
        },
        {
          "id": "cs0102_ret_mv4",
          "speaker": "leader",
          "text": "过板。回堡入谱。"
        }
      ],
      "actions": [

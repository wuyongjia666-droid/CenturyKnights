    },
    {
      "id": "ledger",
      "title": "入册",
      "lines": [
        {
          "id": "cs03_02_ledger_0",
          "speaker": "旁白",
          "text": "入册。榜阴与功榜并排进柜。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_ledger_1",
          "speaker": "书记官",
          "text": "粮行有灯。灯不灭。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_ledger_2",
          "speaker": "leader",
          "text": "我看见空了。空也在谱里·朝报。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_ledger_3",
          "speaker": "岁吏",
          "text": "年迹末行写：榜阴并排留。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_ledger_4",
          "speaker": "老管事",
          "text": "催功锣再响，也撕不开柜门。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_ledger_5",
          "speaker": "旁白",
          "text": "柜门一合。灯还在缝里·朝报。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_ledger_6",
          "speaker": "苇原·灯影",
          "text": "巡防收牌。牌上榜阴两字还热。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_ledger_7",
          "speaker": "书记官",
          "text": "整张功榜，才算功。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_ledger_8",
          "speaker": "leader",
          "text": "假功没进来。好。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_ledger_9",
          "speaker": "岁吏",
          "text": "月结旁多一笔粮行。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_ledger_10",
          "speaker": "老管事",
          "text": "催条叠在门外。谱在门内·朝报。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_ledger_11",
          "speaker": "旁白",
          "text": "朱印干。粮行的边也干了。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_ledger_12",
          "speaker": "书记官",
          "text": "下次打开，粮行还在——带着灯。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_ledger_13",
          "speaker": "leader",
          "text": "够了。去灰旗堡·朝报。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_ledger_14",
          "speaker": "苇原·灯影",
          "text": "堡门亮着。榜阴灯跟着。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_ledger_15",
          "speaker": "岁吏",
          "text": "年迹合上。字还在·朝报。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_ledger_16",
          "speaker": "老管事",
          "text": "功厅可歇。谱不可假。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_ledger_17",
          "speaker": "旁白",
          "text": "风停。榜平。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_ledger_18",
          "speaker": "书记官",
          "text": "并排不是拖。是完整·朝报。",
          "stage": {
            "card": "六　入册",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_ledger_y19",
          "speaker": "旁白",
          "text": "仓门风从缝里进。"
        },
        {
          "id": "cs03_02_ledger_y20",
          "speaker": "石垒·晚担",
          "text": "风进得去，假数进不去。"
        },
        {
          "id": "cs03_02_ledger_y21",
          "speaker": "leader",
          "text": "数要真。"
        },
        {
          "id": "cs0302_ldg1",
          "speaker": "岁吏",
          "text": "回粮与功阴并排，袋口扎紧才进册。"
        },
        {
          "id": "cs0302_ldg2",
          "speaker": "书记官",
          "text": "抢粮的影，只记埂下不记正行。"
        },
        {
          "id": "cs0302_ldg3",
          "speaker": "石垒·晚担",
          "text": "谷壳香还在袖里——香在，粮就在。"
        },
        {
          "id": "cs0302_ldg4",
          "speaker": "leader",
          "text": "回粮并排。灯不灭，榜阴在柜。"
        },
        {
          "id": "cs0302_ldg_end",
          "speaker": "leader",
          "text": "粮秤星旁，灰旗堡榜阴柜等回粮数。"
        }
      ],
      "actions": []
    }
  ],
  "title_en": "Lamp on the Merit Back"
}

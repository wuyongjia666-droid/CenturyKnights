          ]
        }
      ]
    },
    {
      "id": "tavern",
      "title": "选题",
      "lines": [
                  {
            "id": "cs0302_arr1",
            "speaker": "旁白",
            "text": "穗壳从袖口抖落门外。门外落，门内净。"
          },
          {
            "id": "cs0302_arr2",
            "speaker": "掌柜",
            "text": "空仓话先别喊。喊完再看板，板会笑你。"
          },
          {
            "id": "cs0302_arr3",
            "speaker": "岁吏",
            "text": "沙漏影留在身后。身后影，不进酒碗。"
          },
          {
            "id": "cs0302_arr4",
            "speaker": "苇原·灯影",
            "text": "田埂泥磕尽。磕尽，才踏上店板。"
          },
          {
            "id": "cs0302_arr5",
            "speaker": "槐里·青禾",
            "text": "穗香还在指。指净了，再摸绳。"
          },
          {
            "id": "cs0302_arr6",
            "speaker": "leader",
            "text": "我到店。仓事放下，再认板。"
          },
{
          "id": "cs03_02_tavern_0",
          "speaker": "旁白",
          "text": "酒馆。板上两道题。手按上去·朝报。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_1",
          "speaker": "掌柜",
          "text": "一道功粮仍并。一道先催功栏。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_2",
          "speaker": "leader",
          "text": "我看题。不看谁嗓门大·朝报。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_3",
          "speaker": "老管事",
          "text": "并排留真。催功快。快的未必真。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_4",
          "speaker": "书记官",
          "text": "粮行进谱，才算整张功榜。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_5",
          "speaker": "岁吏",
          "text": "年迹听选择。不听锣·朝报。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_6",
          "speaker": "旁白",
          "text": "酒气里榜更白。白得能看见粮。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_7",
          "speaker": "掌柜",
          "text": "选完入柜。榜阴柜门会响。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_8",
          "speaker": "苇原·灯影",
          "text": "巡防在门外。门内只选题·朝报。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_9",
          "speaker": "leader",
          "text": "功粮仍并——我手按这道。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_10",
          "speaker": "老管事",
          "text": "按实了。别悬着·朝报。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_11",
          "speaker": "书记官",
          "text": "假功那道我划掉。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_12",
          "speaker": "旁白",
          "text": "板面一热。字进手心·朝报。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_13",
          "speaker": "岁吏",
          "text": "选择入账。榜阴夜可结。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_14",
          "speaker": "掌柜",
          "text": "另一道也在。你不选它·朝报。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_15",
          "speaker": "老管事",
          "text": "催功的锣远了。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_16",
          "speaker": "旁白",
          "text": "两道题还在板上。只一道进柜·朝报。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_y17",
          "speaker": "旁白",
          "text": "酒气熏不干榜阴那行慢墨，熏干的是空话。"
        },
        {
          "id": "cs03_02_tavern_y18",
          "speaker": "石垒·晚担",
          "text": "空话干得快。扛粮的字，还黏在纸上。"
        },
        {
          "id": "cs03_02_tavern_y19",
          "speaker": "leader",
          "text": "黏着的功粮带回堡。酒账另算。"
        },
        {
          "id": "cs03_02_tavern_17",
          "speaker": "老管事",
          "text": "选完入柜。榜阴柜门会响·朝报。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs0302_ret_mv1",
          "speaker": "旁白",
          "text": "榜阴话题被劝酒按下去，又浮上来。"
        },
        {
          "id": "cs0302_ret_mv2",
          "speaker": "掌柜",
          "text": "浮上来就钉。钉不住别喝。"
        },
        {
          "id": "cs0302_ret_mv3",
          "speaker": "岁吏",
          "text": "钉住回堡。"
        },
        {
          "id": "cs0302_tvp1",
          "speaker": "旁白",
          "text": "榜阴拓本反着光，字像从板背透出来。"
        },
        {
          "id": "cs0302_tvp2",
          "speaker": "掌柜",
          "text": "阴面的字，挂正面也藏不住。藏不住才真。"
        },
        {
          "id": "cs0302_tvp3",
          "speaker": "岁吏",
          "text": "真功不怕阴。怕阴的，是只写了阳面的人。"
        },
        {
          "id": "cs0302_tvp4",
          "speaker": "老旗手",
          "text": "旗在榜下站过。站过，阴面也有根。"
        },
        {
          "id": "cs0302_tvp5",
          "speaker": "石垒·晚担",
          "text": "根在，并排才稳。稳了再喝酒。"
        },
        {
          "id": "cs0302_tvp6",
          "speaker": "leader",
          "text": "阴面我留。催功栏的话，先过我这一盏。"
        },
        {
          "id": "cs0302_tvn1",
          "speaker": "掌柜",
          "text": "护粮那一锋，酒里有谷壳香。"
        },
        {
          "id": "cs0302_tvn2",
          "speaker": "石垒·晚担",
          "text": "埂下那拨退了。退了才敢开坛。"
        },
        {
          "id": "cs0302_tvn3",
          "speaker": "听回",
          "text": "袋口扎紧的事，传得比酒快。"
        },
        {
          "id": "cs0302_tvn4",
          "speaker": "leader",
          "text": "粮在。人在。谷香，我认。"
        },
        {
          "id": "cs0302_ret_mv4",
          "speaker": "leader",
          "text": "回堡入榜阴。"
        }
      ],
      "actions": [
        {
          "id": "keep_back",
          "label": "功粮仍并",
          "do": [
            {

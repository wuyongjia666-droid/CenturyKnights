{
  "id": "cs03_02",
  "title": "榜阴上的灯",
  "legacy_index": 413,
  "return_scene": "res://scenes/hub/castle_hub.tscn",
  "source": "docs/content-seasons/season-03/NOVEL.md",
  "beats": [
    {
      "id": "back",
      "title": "榜阴",
      "lines": [
        {
          "id": "cs03_02_back_0",
          "speaker": "旁白",
          "text": "功厅。上回榜文已入柜。榜阴还空着粮行。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_1",
          "speaker": "书记官",
          "text": "正面功写过了。榜阴要能念，不能只剩朱印。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_2",
          "speaker": "leader",
          "text": "我要听粮行。空着也得说得出。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_3",
          "speaker": "旁白",
          "text": "柜门一响。功榜与榜阴并排放上长桌。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_4",
          "speaker": "老管事",
          "text": "催功的人嗓门大。粮行的人说再等等。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_5",
          "speaker": "岁吏",
          "text": "年迹旁多了一行「榜阴夜」。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_6",
          "speaker": "苇原·灯影",
          "text": "巡防不问谁记功。问今夜谁还空着粮。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_7",
          "speaker": "旁白",
          "text": "两行字第一次对视。功面亮，榜阴暗。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_8",
          "speaker": "书记官",
          "text": "能念的字在功面。坐得住的粮在榜阴等。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_9",
          "speaker": "leader",
          "text": "把粮行念给我听。别念催功。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_10",
          "speaker": "老管事",
          "text": "催功可以喊。榜阴撕不得。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_11",
          "speaker": "旁白",
          "text": "灯矮了一寸。粮行反而更清楚。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_12",
          "speaker": "岁吏",
          "text": "功榜已记账。榜阴记账才算整张。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_13",
          "speaker": "书记官",
          "text": "并排不是拖。是让粮行也有灯。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_14",
          "speaker": "leader",
          "text": "我听懂了。空着，也要并排·朝报。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_15",
          "speaker": "旁白",
          "text": "风从窗缝进来。榜角动，字不动。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_16",
          "speaker": "老管事",
          "text": "催功的锣在门外。锣响不进功厅。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_y17",
          "speaker": "旁白",
          "text": "榜阴功行的墨干得比正面慢，慢在夹页里。"
        },
        {
          "id": "cs03_02_back_y18",
          "speaker": "石垒·晚担",
          "text": "夹页里的沉字，才配回头去对粮。"
        },
        {
          "id": "cs03_02_back_y19",
          "speaker": "leader",
          "text": "榜阴功粮并排。正面的空喊不抄。"
        },
        {
          "id": "cs0302_thm1",
          "speaker": "旁白",
          "text": "榜阴贴着正榜。阴面更凉。"
        },
        {
          "id": "cs0302_thm2",
          "speaker": "掌柜",
          "text": "阴面的空，比阳面更咬人。"
        },
        {
          "id": "cs0302_thm3",
          "speaker": "石垒·晚担",
          "text": "凉处不糊字。糊字的榜，挂不住。"
        },
        {
          "id": "cs0302_thm4",
          "speaker": "槐里·青禾",
          "text": "阴面不催功。催的人，先看自己行。"
        },
        {
          "id": "cs0302_thm5",
          "speaker": "老旗手",
          "text": "旗杆离阴面一掌。近了，风揭角。"
        },
        {
          "id": "cs0302_thm6",
          "speaker": "leader",
          "text": "阴面我留。空我认。认完再往回走。"
        },
        {
          "id": "cs03_02_back_17",
          "speaker": "槐里·青禾",
          "text": "榜阴比功面薄。薄的反而难装。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        }
      ],
      "next": "grain"
    },
    {
      "id": "grain",
      "title": "粮行",
      "lines": [
        {
          "id": "cs03_02_grain_0",
          "speaker": "旁白",
          "text": "粮行摊开。收成那格亮着，旁格还空。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_1",
          "speaker": "老管事",
          "text": "上回留并排的，粮行亮着空。只留功的，栏上有字、粮仍空。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_2",
          "speaker": "旁白",
          "text": "两行字第二次吵架。回读逼它们对视·朝报。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_3",
          "speaker": "苇原·灯影",
          "text": "巡防不问谁收成。问今夜谁还空着粮。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_4",
          "speaker": "书记官",
          "text": "有字的格能念。粮行要人敢看。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_5",
          "speaker": "leader",
          "text": "粮空不是错。催满才是错。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_6",
          "speaker": "岁吏",
          "text": "年迹不改粮。只记你敢不敢对空。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_7",
          "speaker": "旁白",
          "text": "朱印干了。粮行的边还潮。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_8",
          "speaker": "老管事",
          "text": "催功锣又响。响在门外，进不了粮。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_9",
          "speaker": "书记官",
          "text": "并排留粮，比硬填假功干净。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_10",
          "speaker": "leader",
          "text": "假功我不要。粮行我要听。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_11",
          "speaker": "旁白",
          "text": "灯把粮行照成浅坑。坑里没有字。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_12",
          "speaker": "岁吏",
          "text": "功榜上的字还在。榜阴上的空也在。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_13",
          "speaker": "苇原·灯影",
          "text": "带牌去。牌上写榜阴，不写催。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_14",
          "speaker": "老管事",
          "text": "催功条叠得高。粮行叠不住。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_15",
          "speaker": "书记官",
          "text": "能念的在功面。敢留的在榜阴。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_16",
          "speaker": "旁白",
          "text": "榜角又动。粮行仍空。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_y17",
          "speaker": "旁白",
          "text": "粮行仓门的风比功栏大，大风专门找假数。"
        },
        {
          "id": "cs03_02_grain_y18",
          "speaker": "石垒·晚担",
          "text": "假数一进风缝就漏。漏掉的，别再写回来。"
        },
        {
          "id": "cs03_02_grain_y19",
          "speaker": "leader",
          "text": "粮数过风。过了的才入榜阴。"
        },
        {
          "id": "cs03_02_grain_17",
          "speaker": "老旗手",
          "text": "粮行灯还亮。亮着，才敢回读。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        }
      ],
      "next": "hourglass"
    },
    {
      "id": "hourglass",
      "title": "两行",
      "lines": [
        {
          "id": "cs03_02_hourglass_0",
          "speaker": "旁白",
          "text": "沙漏厅。上行功榜、下行榜阴。回读把两行按住。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_1",
          "speaker": "老管事",
          "text": "沙漏边上，回读只问一句：你敢不敢对粮。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_2",
          "speaker": "岁吏",
          "text": "年迹旁多了一行「榜阴回读」。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_3",
          "speaker": "书记官",
          "text": "能念的字在上行。空得住的粮还在下行等。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_4",
          "speaker": "leader",
          "text": "两行都打开。我要听对看·朝报。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_5",
          "speaker": "旁白",
          "text": "沙响。上行亮，下行仍暗·朝报。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_6",
          "speaker": "苇原·灯影",
          "text": "巡防牌上写榜阴。不写急锣。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_7",
          "speaker": "老管事",
          "text": "催功的人在门外跺脚。跺不进沙漏。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_8",
          "speaker": "书记官",
          "text": "并排不是拖月。是让粮行跟月份并排走。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_9",
          "speaker": "岁吏",
          "text": "月结不抹粮。粮也要入迹。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_10",
          "speaker": "leader",
          "text": "我听粮行。不听跺脚。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_11",
          "speaker": "旁白",
          "text": "沙又落一层。下行多了一点亮·朝报。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_12",
          "speaker": "老管事",
          "text": "锣停了。粮行还在。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_13",
          "speaker": "书记官",
          "text": "回读夜的字，比催功长命。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_14",
          "speaker": "岁吏",
          "text": "带牌出去。沙漏还转·朝报。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_15",
          "speaker": "旁白",
          "text": "两行对准了。一对上，假填就站不住·朝报。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_16",
          "speaker": "老管事",
          "text": "假功进不了沙漏。粮行能。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_y17",
          "speaker": "旁白",
          "text": "沙漏下行贴着榜阴功簿，墨还在慢慢沉。"
        },
        {
          "id": "cs03_02_hourglass_y18",
          "speaker": "石垒·晚担",
          "text": "沉到沙里的功，才许跟粮并排。"
        },
        {
          "id": "cs03_02_hourglass_y19",
          "speaker": "leader",
          "text": "月份走之前，功粮先并稳。"
        },
        {
          "id": "cs03_02_hourglass_17",
          "speaker": "苇原·灯影",
          "text": "带牌去。牌上写榜阴，不写急。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs0302_vhg1",
          "speaker": "岁吏",
          "text": "榜阴贴着正榜。阴面的空，比阳面更刺眼。"
        },
        {
          "id": "cs0302_vhg2",
          "speaker": "书记官",
          "text": "朝报不改月份。改的是你敢不敢念阴面的缺口。"
        },
        {
          "id": "cs0302_vhg3",
          "speaker": "leader",
          "text": "榜阴空着。我对着缺口，不拿阳面的满去盖。"
        },
        {
          "id": "cs0302_vhg4",
          "speaker": "苇原·灯影",
          "text": "阴面灯更冷。冷着，字才不糊。"
        },
                  {
            "id": "cs0302_msr1",
            "speaker": "旁白",
            "text": "粮册边的灰拍尽。拍尽再出门，灰不进桥缝。"
          },
          {
            "id": "cs0302_msr2",
            "speaker": "老管事",
            "text": "空仓那格念过。念过束甲，甲不空响。"
          },
          {
            "id": "cs0302_msr3",
            "speaker": "岁吏",
            "text": "沙漏里的穗影淡了。淡了，人该走了。"
          },
          {
            "id": "cs0302_msr4",
            "speaker": "苇原·灯影",
            "text": "更鼓从田埂外传来。传进整装，不传进慌。"
          },
          {
            "id": "cs0302_msr5",
            "speaker": "槐里·青禾",
            "text": "穗壳还粘在袖。袖一抖，壳落，人起。"
          },
          {
            "id": "cs0302_msr6",
            "speaker": "leader",
            "text": "粮格我留过。整装完，上桥。"
          },
{
          "id": "cs0302_vis_mv1",
          "speaker": "旁白",
          "text": "时漏玻璃上有道指纹，从下往上抹。"
        },
        {
          "id": "cs0302_vis_mv2",
          "speaker": "岁吏",
          "text": "往上抹的，多半想让沙快。"
        },
        {
          "id": "cs0302_vis_mv3",
          "speaker": "石垒·晚担",
          "text": "沙不快。人急。"
        },
        {
          "id": "cs0302_vst1",
          "speaker": "岁吏",
          "text": "月份从粮秤星上滑过。滑过，才记进册。"
        },
        {
          "id": "cs0302_vst2",
          "speaker": "书记官",
          "text": "回粮格要等袋口扎紧。"
        },
        {
          "id": "cs0302_vst3",
          "speaker": "leader",
          "text": "月份滑过。粮，我秤。"
        },
        {
          "id": "cs0302_vis_mv4",
          "speaker": "leader",
          "text": "人不跟急走。去看月份。"
        }
      ],
      "next": "bridge",
      "actions": [
        {
          "id": "open_hourglass",
          "label": "去看月份怎么往前走",
          "do": [
            {
              "op": "visit",
              "path": "res://scenes/hub/hourglass.tscn"
            }
          ]
        },
        {
          "id": "continue_after_visit",
          "label": "继续，去门廊",
          "do": [
            {
              "op": "goto",
              "beat": "next"
            }
          ]
        }
      ]
    },
    {
      "id": "bridge",
      "title": "门廊",
      "lines": [
        {
          "id": "cs03_02_bridge_0",
          "speaker": "旁白",
          "text": "门廊。榜阴灯还在身后。锋镝在桥上试。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_1",
          "speaker": "岁吏",
          "text": "试锋不改粮行。只问你手稳不稳。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_2",
          "speaker": "leader",
          "text": "先试一锋。赢了再谈催功。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_3",
          "speaker": "老旗手",
          "text": "锋收回来也行。粮行不靠锋填。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_4",
          "speaker": "旁白",
          "text": "桥风大。灯小。字还在·朝报。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_5",
          "speaker": "书记官",
          "text": "催功可以喊。榜阴本撕不得。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_6",
          "speaker": "苇原·灯影",
          "text": "巡防站桥侧。不问胜负，问你还回不回读·朝报。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_7",
          "speaker": "老管事",
          "text": "锣在城门。桥上只听见水·朝报。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_8",
          "speaker": "leader",
          "text": "锋出不出，粮行都在。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_9",
          "speaker": "岁吏",
          "text": "试锋得手，锋镝压下，并排榜可续。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_10",
          "speaker": "旁白",
          "text": "水声盖过远处锣·朝报。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_11",
          "speaker": "老旗手",
          "text": "伤还在也行。先去酒馆选题·朝报。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_12",
          "speaker": "书记官",
          "text": "选题在前。假功在后——后的不要。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_13",
          "speaker": "苇原·灯影",
          "text": "牌还在手里。牌上仍是榜阴。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_14",
          "speaker": "老管事",
          "text": "催功的人等不及。你等得及。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_15",
          "speaker": "leader",
          "text": "我等粮行。不等锣。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_16",
          "speaker": "旁白",
          "text": "桥板一颤。灯不灭·朝报。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_17",
          "speaker": "岁吏",
          "text": "未试锋——锋未出鞘，也可去酒馆·朝报。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_18",
          "speaker": "老旗手",
          "text": "试锋未成——伤还在，先去酒馆·朝报。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_y20",
          "speaker": "旁白",
          "text": "门廊风钻进榜阴仓缝，缝里没有假数的位置。"
        },
        {
          "id": "cs03_02_bridge_y21",
          "speaker": "石垒·晚担",
          "text": "钻得进的是风。钻不进的假数，别硬塞。"
        },
        {
          "id": "cs03_02_bridge_y22",
          "speaker": "leader",
          "text": "门廊上只认钻不进去的真数。"
        },
        {
          "id": "cs03_02_bridge_19",
          "speaker": "岁吏",
          "text": "催功可以喊。榜阴本撕不得·朝报。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs0302_mid_mv1",
          "speaker": "旁白",
          "text": "榜阴纸角卷着。有人用指甲把卷边摁平，又弹开。"
        },
        {
          "id": "cs0302_mid_mv2",
          "speaker": "岁吏",
          "text": "弹开不是风。是手痒。"
        },
        {
          "id": "cs0302_mid_mv3",
          "speaker": "石垒·晚担",
          "text": "手痒的人，粮行门口最爱站。"
        },
        {
          "id": "cs0302_mid_mv4",
          "speaker": "苇原·灯影",
          "text": "站着看榜，不如上场把话说完。"
        },
        {
          "id": "cs0302_mid_mv5",
          "speaker": "老旗手",
          "text": "话说完要带锋。不然榜上只剩笑。"
        },
        {
          "id": "cs0302_mid_mv6",
          "speaker": "leader",
          "text": "笑我不怕。假功我怕。"
        },
        {
          "id": "cs0302_win1",
          "speaker": "旁白",
          "text": "锋再定。粮袋口扎紧，抢粮那拨退到埂下。",
          "when": {
            "flag": "cs03_mid_fought"
          }
        },
        {
          "id": "cs0302_win2",
          "speaker": "掌柜",
          "text": "空袋吓人。满袋，今晚不怕。",
          "when": {
            "flag": "cs03_mid_fought"
          }
        },
        {
          "id": "cs0302_win3",
          "speaker": "槐里·青禾",
          "text": "粮沉肩，心反而轻。",
          "when": {
            "flag": "cs03_mid_fought"
          }
        },
        {
          "id": "cs0302_win4",
          "speaker": "leader",
          "text": "锋护过粮。袋，我背得。",
          "when": {
            "flag": "cs03_mid_fought"
          }
        },
        {
          "speaker": "旁白",
          "text": "锋收回来。榜阴纸还钉着。粮行旁那拨，没散。",
          "when": {
            "all": [
              {
                "flag": "cs03_mid_lost"
              },
              {
                "not_flag": "cs03_mid_fought"
              }
            ]
          },
          "id": "cs03b_br_lost"
        }
      ],
      "next": "tavern",
      "actions": [
        {

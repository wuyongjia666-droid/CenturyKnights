{
  "id": "cs03_02",
  "title": "榜阴上的灯",
  "legacy_index": 413,
  "return_scene": "res://scenes/hub/castle_hub.tscn",
  "source": "docs/content-seasons/season-03/NOVEL.md",
  "beats": [
    {
      "id": "back",
      "title": "榜阴",
      "lines": [
        {
          "id": "cs03_02_back_0",
          "speaker": "旁白",
          "text": "功厅。上回榜文已入柜。榜阴还空着粮行。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_1",
          "speaker": "书记官",
          "text": "正面功写过了。榜阴要能念，不能只剩朱印。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_2",
          "speaker": "leader",
          "text": "我要听粮行。空着也得说得出。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_3",
          "speaker": "旁白",
          "text": "柜门一响。功榜与榜阴并排放上长桌。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_4",
          "speaker": "老管事",
          "text": "催功的人嗓门大。粮行的人说再等等。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_5",
          "speaker": "岁吏",
          "text": "年迹旁多了一行「榜阴夜」。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_6",
          "speaker": "苇原·灯影",
          "text": "巡防不问谁记功。问今夜谁还空着粮。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_7",
          "speaker": "旁白",
          "text": "两行字第一次对视。功面亮，榜阴暗。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_8",
          "speaker": "书记官",
          "text": "能念的字在功面。坐得住的粮在榜阴等。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_9",
          "speaker": "leader",
          "text": "把粮行念给我听。别念催功。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_10",
          "speaker": "老管事",
          "text": "催功可以喊。榜阴撕不得。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_11",
          "speaker": "旁白",
          "text": "灯矮了一寸。粮行反而更清楚。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_12",
          "speaker": "岁吏",
          "text": "功榜已记账。榜阴记账才算整张。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_13",
          "speaker": "书记官",
          "text": "并排不是拖。是让粮行也有灯。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_14",
          "speaker": "leader",
          "text": "我听懂了。空着，也要并排·朝报。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_15",
          "speaker": "旁白",
          "text": "风从窗缝进来。榜角动，字不动。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_16",
          "speaker": "老管事",
          "text": "催功的锣在门外。锣响不进功厅。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_back_y17",
          "speaker": "旁白",
          "text": "功簿墨干得慢。慢干的字沉。"
        },
        {
          "id": "cs03_02_back_y18",
          "speaker": "石垒·晚担",
          "text": "沉字扛得住粮。"
        },
        {
          "id": "cs03_02_back_y19",
          "speaker": "leader",
          "text": "功与粮并排。"
        },
        {
          "id": "cs03_02_back_17",
          "speaker": "槐里·青禾",
          "text": "榜阴比功面薄。薄的反而难装。",
          "stage": {
            "card": "一　榜阴",
            "bg": "hall",
            "music": "castle",
            "camera": "wide"
          }
        }
      ],
      "next": "grain"
    },
    {
      "id": "grain",
      "title": "粮行",
      "lines": [
        {
          "id": "cs03_02_grain_0",
          "speaker": "旁白",
          "text": "粮行摊开。收成那格亮着，旁格还空。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_1",
          "speaker": "老管事",
          "text": "上回留并排的，粮行亮着空。只留功的，栏上有字、粮仍空。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_2",
          "speaker": "旁白",
          "text": "两行字第二次吵架。回读逼它们对视·朝报。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_3",
          "speaker": "苇原·灯影",
          "text": "巡防不问谁收成。问今夜谁还空着粮。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_4",
          "speaker": "书记官",
          "text": "有字的格能念。粮行要人敢看。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_5",
          "speaker": "leader",
          "text": "粮空不是错。催满才是错。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_6",
          "speaker": "岁吏",
          "text": "年迹不改粮。只记你敢不敢对空。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_7",
          "speaker": "旁白",
          "text": "朱印干了。粮行的边还潮。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_8",
          "speaker": "老管事",
          "text": "催功锣又响。响在门外，进不了粮。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_9",
          "speaker": "书记官",
          "text": "并排留粮，比硬填假功干净。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_10",
          "speaker": "leader",
          "text": "假功我不要。粮行我要听。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_11",
          "speaker": "旁白",
          "text": "灯把粮行照成浅坑。坑里没有字。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_12",
          "speaker": "岁吏",
          "text": "功榜上的字还在。榜阴上的空也在。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_13",
          "speaker": "苇原·灯影",
          "text": "带牌去。牌上写榜阴，不写催。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_14",
          "speaker": "老管事",
          "text": "催功条叠得高。粮行叠不住。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_15",
          "speaker": "书记官",
          "text": "能念的在功面。敢留的在榜阴。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_16",
          "speaker": "旁白",
          "text": "榜角又动。粮行仍空。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_grain_y17",
          "speaker": "旁白",
          "text": "仓门风从缝里进。"
        },
        {
          "id": "cs03_02_grain_y18",
          "speaker": "石垒·晚担",
          "text": "风进得去，假数进不去。"
        },
        {
          "id": "cs03_02_grain_y19",
          "speaker": "leader",
          "text": "数要真。"
        },
        {
          "id": "cs03_02_grain_17",
          "speaker": "老旗手",
          "text": "粮行灯还亮。亮着，才敢回读。",
          "stage": {
            "card": "二　粮行",
            "bg": "hall",
            "music": "castle",
            "camera": "close"
          }
        }
      ],
      "next": "hourglass"
    },
    {
      "id": "hourglass",
      "title": "两行",
      "lines": [
        {
          "id": "cs03_02_hourglass_0",
          "speaker": "旁白",
          "text": "沙漏厅。上行功榜、下行榜阴。回读把两行按住。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_1",
          "speaker": "老管事",
          "text": "月份往前走。回读不改月份，只改你敢不敢对粮。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_2",
          "speaker": "岁吏",
          "text": "年迹旁多了一行「榜阴回读」。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_3",
          "speaker": "书记官",
          "text": "能念的字在上行。空得住的粮还在下行等。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_4",
          "speaker": "leader",
          "text": "两行都打开。我要听对看·朝报。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_5",
          "speaker": "旁白",
          "text": "沙响。上行亮，下行仍暗·朝报。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_6",
          "speaker": "苇原·灯影",
          "text": "巡防牌上写榜阴。不写急锣。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_7",
          "speaker": "老管事",
          "text": "催功的人在门外跺脚。跺不进沙漏。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_8",
          "speaker": "书记官",
          "text": "并排不是拖月。是让粮行跟月份并排走。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_9",
          "speaker": "岁吏",
          "text": "月结不抹粮。粮也要入迹。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_10",
          "speaker": "leader",
          "text": "我听粮行。不听跺脚。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_11",
          "speaker": "旁白",
          "text": "沙又落一层。下行多了一点亮·朝报。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_12",
          "speaker": "老管事",
          "text": "锣停了。粮行还在。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_13",
          "speaker": "书记官",
          "text": "回读夜的字，比催功长命。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_14",
          "speaker": "岁吏",
          "text": "带牌出去。沙漏还转·朝报。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_15",
          "speaker": "旁白",
          "text": "两行终于对上。一对，就不敢假填·朝报。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_16",
          "speaker": "老管事",
          "text": "假功进不了沙漏。粮行能。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_hourglass_y17",
          "speaker": "旁白",
          "text": "功簿墨干得慢。慢干的字沉。"
        },
        {
          "id": "cs03_02_hourglass_y18",
          "speaker": "石垒·晚担",
          "text": "沉字扛得住粮。"
        },
        {
          "id": "cs03_02_hourglass_y19",
          "speaker": "leader",
          "text": "功与粮并排。"
        },
        {
          "id": "cs03_02_hourglass_17",
          "speaker": "苇原·灯影",
          "text": "带牌去。牌上写榜阴，不写急。",
          "stage": {
            "card": "三　两行",
            "bg": "hourglass",
            "music": "castle",
            "camera": "wide"
          }
        }
      ],
      "next": "bridge",

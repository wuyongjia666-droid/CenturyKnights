    {
      "id": "bridge",
      "title": "门廊",
      "lines": [
        {
          "id": "cs03_02_bridge_0",
          "speaker": "旁白",
          "text": "门廊。榜阴灯还在身后。锋镝在桥上试。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_1",
          "speaker": "岁吏",
          "text": "试锋不改粮行。只问你手稳不稳。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_2",
          "speaker": "leader",
          "text": "先试一锋。赢了再谈催功。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_3",
          "speaker": "老旗手",
          "text": "锋收回来也行。粮行不靠锋填。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_4",
          "speaker": "旁白",
          "text": "桥风大。灯小。字还在·朝报。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_5",
          "speaker": "书记官",
          "text": "催功可以喊。榜阴本撕不得。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_6",
          "speaker": "苇原·灯影",
          "text": "巡防站桥侧。不问胜负，问你还回不回读·朝报。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_7",
          "speaker": "老管事",
          "text": "锣在城门。桥上只听见水·朝报。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_8",
          "speaker": "leader",
          "text": "锋出不出，粮行都在。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_9",
          "speaker": "岁吏",
          "text": "试锋得手，锋镝压下，并排榜可续。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_10",
          "speaker": "旁白",
          "text": "水声盖过远处锣·朝报。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_11",
          "speaker": "老旗手",
          "text": "伤还在也行。先去酒馆选题·朝报。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_12",
          "speaker": "书记官",
          "text": "选题在前。假功在后——后的不要。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_13",
          "speaker": "苇原·灯影",
          "text": "牌还在手里。牌上仍是榜阴。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_14",
          "speaker": "老管事",
          "text": "催功的人等不及。你等得及。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_15",
          "speaker": "leader",
          "text": "我等粮行。不等锣。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_16",
          "speaker": "旁白",
          "text": "桥板一颤。灯不灭·朝报。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_17",
          "speaker": "岁吏",
          "text": "未试锋——锋未出鞘，也可去酒馆·朝报。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_18",
          "speaker": "老旗手",
          "text": "试锋未成——伤还在，先去酒馆·朝报。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "id": "cs03_02_bridge_y20",
          "speaker": "旁白",
          "text": "仓门风从缝里进。"
        },
        {
          "id": "cs03_02_bridge_y21",
          "speaker": "石垒·晚担",
          "text": "风进得去，假数进不去。"
        },
        {
          "id": "cs03_02_bridge_y22",
          "speaker": "leader",
          "text": "数要真。"
        },
        {
          "id": "cs03_02_bridge_19",
          "speaker": "岁吏",
          "text": "催功可以喊。榜阴本撕不得·朝报。",
          "stage": {
            "card": "四　门廊",
            "bg": "bridge",
            "music": "battle_prep",
            "camera": "wide"
          }
        },
        {
          "speaker": "旁白",
          "text": "锋收回来。榜阴纸还钉着。粮行旁那拨，没散。",
          "when": {
            "all": [
              {
                "flag": "cs03_02_mid_lost"
              },
              {
                "not_flag": "cs03_02_mid_fought"
              }
            ]
          },
          "id": "cs03b_br_lost"
        }
      ],

    {
      "id": "tavern",
      "title": "选题",
      "lines": [
        {
          "id": "cs03_02_tavern_0",
          "speaker": "旁白",
          "text": "酒馆。板上两道题。手按上去·朝报。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_1",
          "speaker": "掌柜",
          "text": "一道功粮仍并。一道先催功栏。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_2",
          "speaker": "leader",
          "text": "我看题。不看谁嗓门大·朝报。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_3",
          "speaker": "老管事",
          "text": "并排留真。催功快。快的未必真。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_4",
          "speaker": "书记官",
          "text": "粮行进谱，才算整张功榜。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_5",
          "speaker": "岁吏",
          "text": "年迹听选择。不听锣·朝报。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_6",
          "speaker": "旁白",
          "text": "酒气里榜更白。白得能看见粮。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_7",
          "speaker": "掌柜",
          "text": "选完入柜。榜阴柜门会响。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_8",
          "speaker": "苇原·灯影",
          "text": "巡防在门外。门内只选题·朝报。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_9",
          "speaker": "leader",
          "text": "功粮仍并——我手按这道。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_10",
          "speaker": "老管事",
          "text": "按实了。别悬着·朝报。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_11",
          "speaker": "书记官",
          "text": "假功那道我划掉。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_12",
          "speaker": "旁白",
          "text": "板面一热。字进手心·朝报。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_13",
          "speaker": "岁吏",
          "text": "选择入账。榜阴夜可结。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_14",
          "speaker": "掌柜",
          "text": "另一道也在。你不选它·朝报。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_15",
          "speaker": "老管事",
          "text": "催功的锣远了。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_16",
          "speaker": "旁白",
          "text": "两道题还在板上。只一道进柜·朝报。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        },
        {
          "id": "cs03_02_tavern_y17",
          "speaker": "旁白",
          "text": "功簿墨干得慢。慢干的字沉。"
        },
        {
          "id": "cs03_02_tavern_y18",
          "speaker": "石垒·晚担",
          "text": "沉字扛得住粮。"
        },
        {
          "id": "cs03_02_tavern_y19",
          "speaker": "leader",
          "text": "功与粮并排。"
        },
        {
          "id": "cs03_02_tavern_17",
          "speaker": "老管事",
          "text": "选完入柜。榜阴柜门会响·朝报。",
          "stage": {
            "card": "五　选题",
            "bg": "tavern",
            "music": "tavern",
            "camera": "close"
          }
        }
      ],
      "actions": [
        {
          "id": "keep_back",
          "label": "功粮仍并",
          "do": [

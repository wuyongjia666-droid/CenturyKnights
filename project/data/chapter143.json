{
  "id": "chapter143",
  "title": "第一百四十三章·仓房",
  "beats": [
    {
      "id": "143.0",
      "title": "仓房令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可粮囤之后，仓房要验的是：灰旗敢不敢在粮堆里把刀收短——火太近，仓会先把民烧掉。"
        },
        {
          "speaker": "管事",
          "text": "两场：仓房、斗秤。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "仓心有垒。斗秤有竖水槽。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸斗秤。砸了要写进王朝手记的黑页——无秤之粮等于无民。"
        },
        {
          "speaker": "系统",
          "text": "第二十三卷。"
        }
      ],
      "next": "143.1"
    },
    {
      "id": "143.1",
      "title": "仓房",
      "lines": [
        {
          "speaker": "斥候",
          "text": "仓房门封，新粮在心。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "破门先护仓心，别把战拖成纵火。"
        },
        {
          "speaker": "管事",
          "text": "禁火推进。一星火，满仓尽废。"
        },
        {
          "speaker": "系统",
          "text": "出战「仓房」。"
        }
      ],
      "battle": "ch143_barn",
      "unlock": [
        "ch143_barn_done"
      ],
      "next": "143.2"
    },
    {
      "id": "143.2",
      "title": "斗秤",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "斗秤被撬。砝码散了一地。"
        },
        {
          "speaker": "斥候",
          "text": "水槽护秤禁乱火，主秤在心。"
        },
        {
          "speaker": "管事",
          "text": "清贼再合秤。秤不全，下一章粮印盖不下去。"
        },
        {
          "speaker": "系统",
          "text": "出战「斗秤」。"
        }
      ],
      "battle": "ch143_scale",
      "unlock": [
        "ch143_scale_done"
      ],
      "next": "143.3"
    },
    {
      "id": "143.3",
      "title": "可仓秤",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可仓秤』。下一章是二十三卷钤印——粮印。"
        },
        {
          "speaker": "春令使者",
          "text": "粮印盖在仓门。盖歪了，粮仓不认。"
        },
        {
          "speaker": "系统",
          "text": "第一百四十三章完成。"
        }
      ],

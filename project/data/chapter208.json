{
  "id": "chapter208",
  "title": "第二百零八章·染坊",
  "beats": [
    {
      "id": "208.0",
      "title": "染坊令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "三十三卷已执。第三十四卷·染坊要验的是：灰旗敢不敢把脚放稳、把色放清——色浑了，布会先从竿上花成空旗。"
        },
        {
          "speaker": "管事",
          "text": "两场：染坊、染缸。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "染坊缸池星布。染缸中隔，桥口错落。"
        },
        {
          "speaker": "老旗手",
          "text": "别踏翻缸。翻了写进黑页——空缸等于空色。"
        },
        {
          "speaker": "系统",
          "text": "第三十四卷中段。"
        }
      ],
      "next": "208.1"
    },
    {
      "id": "208.1",
      "title": "染坊",
      "lines": [
        {
          "speaker": "斥候",
          "text": "染坊缸池被撬，好布堆在心垒。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护色，别把战拖成花雾。"
        },
        {
          "speaker": "管事",
          "text": "清池掩护，心垒夺布。"
        },
        {
          "speaker": "系统",
          "text": "出战「染坊」。"
        }
      ],
      "battle": "ch208_yard",
      "unlock": [
        "ch208_yard_done"
      ],
      "next": "208.2"
    },
    {
      "id": "208.2",
      "title": "染缸",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "染缸中隔有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "外坊内缸，桥口禁乱踏，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清桥再夺垒。色不稳，晾竿开不了。"
        },
        {
          "speaker": "春令使者",
          "text": "缸一散，满坊的色都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「染缸」。"
        }
      ],
      "battle": "ch208_vat",
      "unlock": [
        "ch208_vat_done"
      ],
      "next": "208.3"
    },
    {
      "id": "208.3",
      "title": "可缸",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可缸』。下一章是晾竿。"
        },
        {
          "speaker": "春令使者",
          "text": "晾竿不是歇色。是还敢不敢成色。"
        },
        {
          "speaker": "系统",
          "text": "第二百零八章完成。"
        }
      ],

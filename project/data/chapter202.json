{
  "id": "chapter202",
  "title": "第二百零二章·盐滩",
  "beats": [
    {
      "id": "202.0",
      "title": "盐滩令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "三十二卷已执。第三十三卷·盐滩要验的是：灰旗敢不敢把脚放稳、把卤放清——卤浑了，盐会先从滩上白成空旗。"
        },
        {
          "speaker": "管事",
          "text": "两场：盐滩、卤渠。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "盐滩卤池星布。卤渠中隔，桥口错落。"
        },
        {
          "speaker": "老旗手",
          "text": "别踏碎盐壳。碎了写进黑页——空壳等于空滩。"
        },
        {
          "speaker": "系统",
          "text": "第三十三卷中段。"
        }
      ],
      "next": "202.1"
    },
    {
      "id": "202.1",
      "title": "盐滩",
      "lines": [
        {
          "speaker": "斥候",
          "text": "盐滩卤池被撬，好盐堆在心垒。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护盐，别把战拖成白雾。卤池交错，落脚先想第二步。"
        },
        {
          "speaker": "管事",
          "text": "清池掩护，心垒夺盐。"
        },
        {
          "speaker": "系统",
          "text": "出战「盐滩」。"
        }
      ],
      "battle": "ch202_flat",
      "unlock": [
        "ch202_flat_done"
      ],
      "next": "202.2"
    },
    {
      "id": "202.2",
      "title": "卤渠",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "卤渠中隔有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "外滩内渠，桥口禁乱踏，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清桥再夺垒。卤不稳，盐堆开不了。"
        },
        {
          "speaker": "春令使者",
          "text": "渠一散，满滩的盐都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「卤渠」。"
        }
      ],
      "battle": "ch202_canal",
      "unlock": [
        "ch202_canal_done"
      ],
      "next": "202.3"
    },
    {
      "id": "202.3",
      "title": "可渠",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可渠』。下一章是盐堆——要把中段真正推上滩。"
        },
        {
          "speaker": "春令使者",
          "text": "盐堆不是歇卤。是还敢不敢成堆。"
        },
        {
          "speaker": "系统",
          "text": "第二百零二章完成。"
        }
      ],
      "unlock": [
        "chapter202_done"
      ],

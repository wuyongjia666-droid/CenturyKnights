{
  "id": "chapter83",
  "title": "第八十三章·缫丝",
  "beats": [
    {
      "id": "83.0",
      "title": "缫丝令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可桑陌之后，缫丝河亮得像有人把整条河抽成丝。河上的桥是梭——梭乱了，绢面就会起结。"
        },
        {
          "speaker": "管事",
          "text": "两场：缫丝、织机。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "缫丝中有水桥。织机在丘环内，地方窄。"
        },
        {
          "speaker": "老旗手",
          "text": "别把旗伸进热水里。"
        },
        {
          "speaker": "系统",
          "text": "第十三卷。"
        }
      ],
      "next": "83.1"
    },
    {
      "id": "83.1",
      "title": "缫丝",
      "lines": [
        {
          "speaker": "管事",
          "text": "目标「缫丝」。编制按我标的三路走，第二路拖时间。"
        },
        {
          "speaker": "老旗手",
          "text": "第一路见红再喊。别提前暴露旗。"
        },
        {
          "speaker": "系统",
          "text": "出战「缫丝」。"
        }
      ],
      "battle": "ch83_reel",
      "unlock": [
        "ch83_reel_done"
      ],
      "next": "83.2"
    },
    {
      "id": "83.2",
      "title": "织机",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "我年青时在比这更烂的地方打过。听指挥，别英雄。"
        },
        {
          "speaker": "斥候",
          "text": "「织机」入口只有一处干净的。其余都是坑。"
        },
        {
          "speaker": "系统",
          "text": "出战「织机」。"
        }
      ],
      "battle": "ch83_loom",

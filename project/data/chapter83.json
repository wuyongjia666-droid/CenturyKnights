{
  "id": "chapter83",
  "title": "第八十三章·缫丝",
  "beats": [
    {
      "id": "83.0",
      "title": "缫丝令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可桑陌之后，缫丝河亮得像有人把整条河抽成丝。河上的桥是梭——梭乱了，绢面就会起结。"
        },
        {
          "speaker": "管事",
          "text": "两场：缫丝、织机。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "缫丝中有水桥。织机在丘环内，地方窄。"
        },
        {
          "speaker": "老旗手",
          "text": "别把旗伸进热水里。"
        },
        {
          "speaker": "系统",
          "text": "第十三卷。"
        }
      ],
      "next": "83.1"
    },
    {
      "id": "83.1",
      "title": "缫丝",
      "lines": [
        {
          "speaker": "管事",
          "text": "「缫丝」——这一格格子都像在等谁先心急。 此地多水、桥、垒。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "敌精锐靠后。前排散兵是诱饵，别追过深。"
        },
        {
          "speaker": "老旗手",
          "text": "旗在，名册在，人可以撤；三者丢一，这一仗就算白打。"
        },
        {
          "speaker": "系统",
          "text": "出战「缫丝」。"
        }
      ],
      "battle": "ch83_reel",
      "unlock": [
        "ch83_reel_done"
      ],
      "next": "83.2"
    },
    {
      "id": "83.2",
      "title": "织机",
      "lines": [
        {
          "speaker": "旁白",
          "text": "「织机」：旗帜可以湿，名册不能湿。"
        },
        {
          "speaker": "斥候",
          "text": "两路：一路粘住正面，一路从丘摸进去。"
        },
        {
          "speaker": "斥候",
          "text": "主旗居中，两翼用呼号，不靠眼神。"
        },
        {
          "speaker": "系统",
          "text": "出战「织机」。"
        }
      ],
      "battle": "ch83_loom",
      "unlock": [
        "ch83_loom_done"
      ],
      "next": "83.3"
    },
    {
      "id": "83.3",
      "title": "可缫织",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可缫织』。下一章是十三卷钤印——丝印。"
        },
        {
          "speaker": "春令使者",
          "text": "丝印盖在绢角。盖歪了，整匹作废。"
        },
        {
          "speaker": "系统",
          "text": "第八十三章完成。"
        }
      ],

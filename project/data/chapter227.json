{
  "id": "chapter227",
  "title": "第二百二十七章·礁脉",
  "beats": [
    {
      "id": "227.0",
      "title": "礁脉令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可潮渠之后，礁脉与夜潮要验：灰旗敢不敢把刀放短、把壳放稳。"
        },
        {
          "speaker": "管事",
          "text": "两场：礁脉、夜潮。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "礁脉水格交错。夜潮双岸夹中，内有心垒。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸礁边。砸了写进王朝手记——无礁之潮等于无滩。"
        },
        {
          "speaker": "系统",
          "text": "第三十七卷中段。"
        }
      ],
      "next": "227.1"
    },
    {
      "id": "227.1",
      "title": "礁脉",
      "lines": [
        {
          "speaker": "斥候",
          "text": "礁脉水格被拦，心垒有人。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "择格夺心，别浪踏软壳。"
        },
        {
          "speaker": "管事",
          "text": "护格清射，再夺心垒。"
        },
        {
          "speaker": "系统",
          "text": "出战「礁脉」。"
        }
      ],
      "battle": "ch227_reef",
      "unlock": [
        "ch227_reef_done"
      ],
      "next": "227.2"
    },
    {
      "id": "227.2",
      "title": "夜潮",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "夜潮双岸有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "外岸内心，禁乱踏，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清岸再夺台。潮不稳，潮印盖不下。"
        },
        {
          "speaker": "春令使者",
          "text": "岸一散，满滩的迹都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「夜潮」。"
        }
      ],
      "battle": "ch227_night",
      "unlock": [
        "ch227_night_done"
      ],
      "next": "227.3"
    },
    {
      "id": "227.3",
      "title": "可夜",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可夜潮』。下一章是潮印。"
        },
        {
          "speaker": "春令使者",
          "text": "潮印不是歇潮。是还敢不敢续迹。"
        },
        {
          "speaker": "系统",
          "text": "第二百二十七章完成。"
        }
      ],

{
  "id": "chapter164",
  "title": "第一百六十四章·夜驿",
  "beats": [
    {
      "id": "164.0",
      "title": "夜驿令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可开市之后，夜驿要验的是：灰旗敢不敢把刀放短、把符放稳——符歪了，信会先从道上倒进空牌。"
        },
        {
          "speaker": "管事",
          "text": "两场：夜驿、守驿。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "夜驿林环双垒。守驿丘环中垒，如护符匣。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸驿灯。砸了要写进王朝手记的黑页——无符之夜等于无道。"
        },
        {
          "speaker": "系统",
          "text": "第二十六卷后半。"
        }
      ],
      "next": "164.1"
    },
    {
      "id": "164.1",
      "title": "夜驿",
      "lines": [
        {
          "speaker": "斥候",
          "text": "夜驿被撬，好符堆在东垒。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护符匣，别把战拖成纵火。林环不利浪冲。"
        },
        {
          "speaker": "管事",
          "text": "西垒掩护，东垒夺符。"
        },
        {
          "speaker": "系统",
          "text": "出战「夜驿」。"
        }
      ],
      "battle": "ch164_nightpost",
      "unlock": [
        "ch164_nightpost_done"
      ],
      "next": "164.2"
    },
    {
      "id": "164.2",
      "title": "守驿",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "守驿丘环有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "丘环八向，场心垒禁乱火，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清索再守驿。火不稳，席终盖不下印。"
        },
        {
          "speaker": "春令使者",
          "text": "驿一灭，满道的信都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「守驿」。"
        }
      ],
      "battle": "ch164_guardpost",
      "unlock": [
        "ch164_guardpost_done"
      ],
      "next": "164.3"
    },
    {
      "id": "164.3",
      "title": "可守驿",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可守驿』。下一章是二十六卷席终——要把驿道的姓真正写入旗角。"
        },
        {
          "speaker": "春令使者",
          "text": "席终不是歇马。是还敢不敢让满道看灰旗的递笺。"
        },
        {
          "speaker": "系统",
          "text": "第一百六十四章完成。"
        }
      ],
      "unlock": [

{
  "id": "chapter226",
  "title": "第二百二十六章·潮滩",
  "beats": [
    {
      "id": "226.0",
      "title": "潮滩令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "三十六卷已执。第三十七卷·潮汐要验的是：灰旗敢不敢把脚放稳、把潮放清——潮乱了，旗会先从滩上退成空迹。"
        },
        {
          "speaker": "管事",
          "text": "两场：潮滩、潮渠。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "潮滩水带横贯。潮渠双渠夹中，桥口错落。"
        },
        {
          "speaker": "老旗手",
          "text": "别踏碎潮壳。碎了写进黑页——空壳等于空潮。"
        },
        {
          "speaker": "系统",
          "text": "第三十七卷中段。"
        }
      ],
      "next": "226.1"
    },
    {
      "id": "226.1",
      "title": "潮滩",
      "lines": [
        {
          "speaker": "斥候",
          "text": "潮滩水带被撬，好道堆在心垒。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护迹，别把战拖成退潮。"
        },
        {
          "speaker": "管事",
          "text": "清带掩护，心垒夺道。"
        },
        {
          "speaker": "系统",
          "text": "出战「潮滩」。"
        }
      ],
      "battle": "ch226_flat",
      "unlock": [
        "ch226_flat_done"
      ],
      "next": "226.2"
    },
    {
      "id": "226.2",
      "title": "潮渠",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "潮渠双渠有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "外滩内渠，桥口禁乱踏，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清桥再夺垒。潮不稳，礁脉开不了。"
        },
        {
          "speaker": "春令使者",
          "text": "渠一散，满滩的迹都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「潮渠」。"
        }
      ],
      "battle": "ch226_channel",
      "unlock": [
        "ch226_channel_done"
      ],
      "next": "226.3"
    },
    {
      "id": "226.3",
      "title": "可渠",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可潮渠』。下一章是礁脉。"
        },
        {
          "speaker": "春令使者",
          "text": "礁脉不是歇潮。是还敢不敢成迹。"
        },
        {
          "speaker": "系统",
          "text": "第二百二十六章完成。"
        }

{
  "id": "chapter191",
  "title": "第一百九十一章·回音",
  "beats": [
    {
      "id": "191.0",
      "title": "回音令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可闻笛之后，回音要验的是：灰旗敢不敢把刀放短、把声放稳——声歪了，曲会先从台上倒进空票。"
        },
        {
          "speaker": "管事",
          "text": "两场：回音、台口。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "回音凹字壁。台口四翼丘，中心小垒。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸笛孔。砸了要写进王朝手记的黑页——无声之回等于无曲。"
        },
        {
          "speaker": "系统",
          "text": "第三十一卷中段。"
        }
      ],
      "next": "191.1"
    },
    {
      "id": "191.1",
      "title": "回音",
      "lines": [
        {
          "speaker": "斥候",
          "text": "回音壁被撬，好笛堆在心台。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护笛火，别把战拖成哑台。凹字外廊清完还要进内庭。"
        },
        {
          "speaker": "管事",
          "text": "清廊掩护，心台夺笛。"
        },
        {
          "speaker": "系统",
          "text": "出战「回音」。"
        }
      ],
      "battle": "ch191_echo",
      "unlock": [
        "ch191_echo_done"
      ],
      "next": "191.2"
    },
    {
      "id": "191.2",
      "title": "台口",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "台口四翼有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "翼丘掩护敌射，场心垒禁乱火，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清索再守台。火不稳，笛印盖不下。"
        },
        {
          "speaker": "春令使者",
          "text": "台一哑，满楼的曲都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「台口」。"
        }
      ],
      "battle": "ch191_stage",
      "unlock": [
        "ch191_stage_done"
      ],
      "next": "191.3"
    },
    {
      "id": "191.3",
      "title": "可台口",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可台口』。下一章是笛印——要把三十一卷中段真正盖上。"
        },
        {
          "speaker": "春令使者",
          "text": "笛印不是歇管。是还敢不敢续声。"
        },
        {
          "speaker": "系统",
          "text": "第一百九十一章完成。"
        }
      ],

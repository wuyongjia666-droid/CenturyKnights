{
  "id": "chapter212",
  "title": "第二百一十二章·独染",
  "beats": [
    {
      "id": "212.0",
      "title": "独染令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可织架之后，独染与夜色要验：灰旗敢不敢把刀放短、把布放稳。"
        },
        {
          "speaker": "管事",
          "text": "两场：独染、夜色。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "独染水镜桥心。夜色林环，内有心台。"
        },
        {
          "speaker": "老旗手",
          "text": "别踏碎镜水。碎了写进王朝手记——无镜之色等于无坊。"
        },
        {
          "speaker": "系统",
          "text": "第三十四卷后半。"
        }
      ],
      "next": "212.1"
    },
    {
      "id": "212.1",
      "title": "独染",
      "lines": [
        {
          "speaker": "斥候",
          "text": "独染水镜被拦，桥心有人。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "择桥夺心，别浪游深水。"
        },
        {
          "speaker": "管事",
          "text": "护桥清射，再夺心台。"
        },
        {
          "speaker": "系统",
          "text": "出战「独染」。"
        }
      ],
      "battle": "ch212_solo",
      "unlock": [
        "ch212_solo_done"
      ],
      "next": "212.2"
    },
    {
      "id": "212.2",
      "title": "夜色",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "夜色林环有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "外林内心，禁乱踏，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清林再夺台。色不稳，席终盖不下。"
        },
        {
          "speaker": "春令使者",
          "text": "色一散，满坊的布都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「夜色」。"
        }
      ],
      "battle": "ch212_night",
      "unlock": [
        "ch212_night_done"
      ],
      "next": "212.3"
    },
    {
      "id": "212.3",
      "title": "可夜",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可夜色』。下一章是席终。"
        },
        {
          "speaker": "春令使者",
          "text": "席终不是歇色。是还敢不敢把姓配进最后一匹布。"
        },
        {
          "speaker": "系统",
          "text": "第二百一十二章完成。"
        }
      ],

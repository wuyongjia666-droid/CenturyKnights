{
  "id": "chapter173",
  "title": "第一百七十三章·伞棚",
  "beats": [
    {
      "id": "173.0",
      "title": "伞棚令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可入巷之后，伞棚要验的是：灰旗敢不敢把刀放短、把伞放稳——伞歪了，人会先从雨里倒进空票。"
        },
        {
          "speaker": "管事",
          "text": "两场：伞棚、水道。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "伞棚环心如盖。水道三槽夹桥，桥位稀疏。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸伞骨。砸了要写进王朝手记的黑页——无伞之巷等于无街。"
        },
        {
          "speaker": "系统",
          "text": "第二十八卷中段。"
        }
      ],
      "next": "173.1"
    },
    {
      "id": "173.1",
      "title": "伞棚",
      "lines": [
        {
          "speaker": "斥候",
          "text": "伞棚被撬，好伞堆在心垒。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护伞火，别把战拖成湿街。环棚先清外再夺心。"
        },
        {
          "speaker": "管事",
          "text": "清环掩护，心垒夺伞。"
        },
        {
          "speaker": "系统",
          "text": "出战「伞棚」。"
        }
      ],
      "battle": "ch173_umbrella",
      "unlock": [
        "ch173_umbrella_done"
      ],
      "next": "173.2"
    },
    {
      "id": "173.2",
      "title": "水道",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "水道三槽有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "桥稀，错一桥要绕远。场心垒禁乱火，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "择桥再守道。火不稳，雨印盖不下。"
        },
        {
          "speaker": "春令使者",
          "text": "道一淹，满街的伞都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「水道」。"
        }
      ],
      "battle": "ch173_drain",

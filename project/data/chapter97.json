{
  "id": "chapter97",
  "title": "第九十七章·煎药",
  "beats": [
    {
      "id": "97.0",
      "title": "煎药令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "十五卷中段方印之后，后半从煎药起。火候差一度，整锅方就苦——苦方救人不成，只会把胜仗熬成葬礼。"
        },
        {
          "speaker": "管事",
          "text": "两场：煎药、穴位。打完，旅馆写『可煎穴』。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "煎房林廊夹竈。穴位多点小垒，像人身穴道。"
        },
        {
          "speaker": "老旗手",
          "text": "灭敌，别灭该留的文火。"
        },
        {
          "speaker": "系统",
          "text": "第十五卷后半。"
        }
      ],
      "next": "97.1"
    },
    {
      "id": "97.1",
      "title": "煎药",
      "lines": [
        {
          "speaker": "斥候",
          "text": "煎房两竈。有人要加柴猛火——猛火毁药。"
        },
        {
          "speaker": "管事",
          "text": "护文火竈，清林弓。别把战拖到锅边。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "谁掀锅盖泄药，优先放倒。"
        },
        {
          "speaker": "系统",
          "text": "出战「煎药」。"
        }
      ],
      "battle": "ch97_decoct",
      "unlock": [
        "ch97_decoct_done"
      ],
      "next": "97.2"
    },
    {
      "id": "97.2",
      "title": "穴位",
      "lines": [
        {
          "speaker": "旁白",
          "text": "煎药既稳，穴位场上点点小垒如人身。点错一穴，整套针法作废——作废的是救人的路。"
        },
        {
          "speaker": "老旗手",
          "text": "逐点取或牵制后取主穴。别乱砸垒。"
        },
        {
          "speaker": "春令使者",
          "text": "主穴在场心偏南。认准再下针——下刀。"
        },
        {
          "speaker": "系统",
          "text": "出战「穴位」。"
        }
      ],
      "battle": "ch97_point",
      "unlock": [
        "ch97_point_done"
      ],
      "next": "97.3"
    },
    {
      "id": "97.3",
      "title": "可煎穴",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可煎穴』。下一章是医籍与悬壶。"
        },
        {
          "speaker": "春令使者",
          "text": "籍是方的根，壶是行医的招牌。两样都丢，药市就只剩空摊。"
        },
        {
          "speaker": "系统",
          "text": "第九十七章完成。"
        }
      ],
      "unlock": [
        "chapter97_done"
      ],
      "next": null
    }
  ]
}
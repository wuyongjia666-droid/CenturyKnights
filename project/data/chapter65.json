{
  "id": "chapter65",
  "title": "第六十五章·铜铃",
  "beats": [
    {
      "id": "65.0",
      "title": "铜铃令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可井市之后，有人把一串铜铃挂在驿门上——铃不响则通行，铃一响则刀来。铜铃不是关，是规矩；规矩坏了，井市的水也会臭。"
        },
        {
          "speaker": "管事",
          "text": "两场：铃巷、哑钟。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "铃巷中间有林墙，只留一条缺口。哑钟在丘环里，地方窄。"
        },
        {
          "speaker": "老旗手",
          "text": "铃响之前先动手的人，配不上井市。铃响之后不动手的人，也配不上。"
        },
        {
          "speaker": "系统",
          "text": "第十卷。"
        }
      ],
      "next": "65.1"
    },
    {
      "id": "65.1",
      "title": "铃巷",
      "lines": [
        {
          "speaker": "旁白",
          "text": "刀可以快，姓必须慢——慢到每一个格子都还认得自己。"
        },
        {
          "speaker": "斥候",
          "text": "敌已在「铃巷」摆好。等的就是你们心急。"
        },
        {
          "speaker": "管事",
          "text": "不急。先射，再动。"
        },
        {
          "speaker": "系统",
          "text": "出战「铃巷」。"
        }
      ],
      "battle": "ch65_bell",
      "unlock": [
        "ch65_bell_done"
      ],
      "next": "65.2"
    },
    {
      "id": "65.2",
      "title": "哑钟",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "我年青时在比这更烂的地方打过。听指挥，别英雄。"
        },
        {
          "speaker": "斥候",
          "text": "「哑钟」入口只有一处干净的。其余都是坑。"
        },
        {
          "speaker": "系统",
          "text": "出战「哑钟」。"
        }
      ],
      "battle": "ch65_mute",
      "unlock": [
        "ch65_mute_done"
      ],
      "next": "65.3"
    },
    {
      "id": "65.3",
      "title": "可铜铃",
      "lines": [
        {
          "speaker": "旁白",
          "text": "铜铃两印落下。旅馆写『可铜铃』。铃可以哑，规矩不能哑。"
        },
        {
          "speaker": "春令使者",
          "text": "下一章是十卷钤印——井印。井字形战场，别走成井底之蛙。"
        },
        {
          "speaker": "系统",
          "text": "第六十五章完成。"
        }
      ],
      "unlock": [
        "chapter65_done"
      ],
      "next": null
    }
  ]
}
{
  "id": "chapter205",
  "title": "第二百零五章·盐市",
  "beats": [
    {
      "id": "205.0",
      "title": "盐市令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "盐印盖过之后，三十三卷后半要验盐市与盐架——市里的盐票会骗人，架上的卤壳会先碎。"
        },
        {
          "speaker": "管事",
          "text": "两场：盐市、盐架。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "盐市三列棚廊。盐架竖廊夹中，像一排关着盐的屉。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸架纽。砸了写进黑页——空架等于空滩。"
        },
        {
          "speaker": "系统",
          "text": "第三十三卷后半。"
        }
      ],
      "next": "205.1"
    },
    {
      "id": "205.1",
      "title": "盐市",
      "lines": [
        {
          "speaker": "斥候",
          "text": "盐市棚廊被撬，好盐堆在中廊。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护盐，别把战拖成白雾。"
        },
        {
          "speaker": "管事",
          "text": "清廊掩护，中廊夺盐。"
        },
        {
          "speaker": "系统",
          "text": "出战「盐市」。"
        }
      ],
      "battle": "ch205_fair",
      "unlock": [
        "ch205_fair_done"
      ],
      "next": "205.2"
    },
    {
      "id": "205.2",
      "title": "盐架",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "盐架竖廊有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "外廊内屉，禁乱踏，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清廊再夺架。卤不稳，独晒开不了。"
        },
        {
          "speaker": "春令使者",
          "text": "架一散，满市的盐都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「盐架」。"
        }
      ],
      "battle": "ch205_rack",
      "unlock": [
        "ch205_rack_done"
      ],
      "next": "205.3"
    },
    {
      "id": "205.3",
      "title": "可架",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可架』。下一章是独晒。"
        },
        {
          "speaker": "春令使者",
          "text": "独晒不是歇卤。是还敢不敢一人成盐。"
        },
        {
          "speaker": "系统",
          "text": "第二百零五章完成。"
        }

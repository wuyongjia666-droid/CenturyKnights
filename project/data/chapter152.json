{
  "id": "chapter152",
  "title": "第一百五十二章·暖驿",
  "beats": [
    {
      "id": "152.0",
      "title": "暖驿令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可开市之后，暖驿要验的是：灰旗敢不敢把刀放短、把暖放稳——暖歪了，人会先从雪里倒进空票。"
        },
        {
          "speaker": "管事",
          "text": "两场：暖驿、守栈。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "暖驿散垒。守栈场心有小垒，开阔。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸驿灯。砸了要写进王朝手记的黑页——无暖之驿等于无岭。"
        },
        {
          "speaker": "系统",
          "text": "第二十四卷后半。"
        }
      ],
      "next": "152.1"
    },
    {
      "id": "152.1",
      "title": "暖驿",
      "lines": [
        {
          "speaker": "斥候",
          "text": "暖驿被撬，好炭堆在东垒。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护暖火，别把战拖成埋雪。"
        },
        {
          "speaker": "管事",
          "text": "西垒掩护，东垒夺炭。"
        },
        {
          "speaker": "系统",
          "text": "出战「暖驿」。"
        }
      ],
      "battle": "ch152_inn",
      "unlock": [
        "ch152_inn_done"
      ],
      "next": "152.2"
    },
    {
      "id": "152.2",
      "title": "守栈",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "守栈场有人投冰折。"
        },
        {
          "speaker": "斥候",
          "text": "场心垒禁乱灭，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清折再守栈。火不稳，席终盖不下印。"
        },
        {
          "speaker": "春令使者",
          "text": "火一灭，满岭的夜都会冻。"
        },
        {
          "speaker": "系统",
          "text": "出战「守栈」。"
        }
      ],
      "battle": "ch152_hold",
      "unlock": [
        "ch152_hold_done"
      ],
      "next": "152.3"
    },
    {
      "id": "152.3",
      "title": "可守栈",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可守栈』。下一章是二十四卷席终——要把雪栈的姓真正写入旗角。"
        },
        {
          "speaker": "春令使者",
          "text": "席终不是歇炭。是还敢不敢让满岭看灰旗的暖花笺。"
        },
        {
          "speaker": "系统",
          "text": "第一百五十二章完成。"
        }
      ],

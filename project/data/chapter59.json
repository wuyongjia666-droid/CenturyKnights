{
  "id": "chapter59",
  "title": "第五十九章·霜驿",
  "beats": [
    {
      "id": "59.0",
      "title": "霜驿令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可余烬之后，驿道上的霜不化。霜驿要验的是：灰旗护得了港，护不护得了夜里递信的人。"
        },
        {
          "speaker": "管事",
          "text": "两场：霜驿、夜驿。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "夜驿一战，名字会掉进黑暗里。带治疗。"
        },
        {
          "speaker": "老旗手",
          "text": "驿卒的命比银重。丢了驿，九卷就断气。"
        },
        {
          "speaker": "系统",
          "text": "第九卷。"
        }
      ],
      "next": "59.1"
    },
    {
      "id": "59.1",
      "title": "霜驿",
      "lines": [
        {
          "speaker": "斥候",
          "text": "霜驿被围。林丘交错。"
        },
        {
          "speaker": "管事",
          "text": "解围。驿道要通。"
        },
        {
          "speaker": "系统",
          "text": "出战「霜驿」。"
        }
      ],
      "battle": "ch59_frost",
      "unlock": [
        "ch59_frost_done"
      ],
      "next": "59.2"
    },
    {
      "id": "59.2",
      "title": "夜驿",
      "lines": [
        {
          "speaker": "旁白",
          "text": "霜驿既通，夜驿仍黑。黑里有刀，也有要灰旗签字的人——签的是『夜里也通行』。"
        },
        {
          "speaker": "老旗手",
          "text": "护住驿心。旗立住，夜才肯让路。"
        },
        {
          "speaker": "系统",
          "text": "出战「夜驿」。"
        }
      ],
      "battle": "ch59_night",
      "unlock": [
        "ch59_night_done"
      ],
      "next": "59.3"
    },
    {
      "id": "59.3",
      "title": "可霜驿",
      "lines": [
        {
          "speaker": "旁白",
          "text": "霜驿两印落下。旅馆写『可霜驿』。九卷中段钤印在下一章。"
        },
        {
          "speaker": "春令使者",
          "text": "下一章是九卷钤印。带上你最沉的人。"
        },
        {
          "speaker": "系统",
          "text": "第五十九章完成。"
        }
      ],

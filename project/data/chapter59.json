{
  "id": "chapter59",
  "title": "第五十九章·霜驿",
  "beats": [
    {
      "id": "59.0",
      "title": "霜驿令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可余烬之后，驿道上的霜不化。霜驿要验的是：灰旗护得了港，护不护得了夜里递信的人。"
        },
        {
          "speaker": "管事",
          "text": "两场：霜驿、夜驿。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "夜驿一战，名字会掉进黑暗里。带治疗。"
        },
        {
          "speaker": "老旗手",
          "text": "驿卒的命比银重。丢了驿，九卷就断气。"
        },
        {
          "speaker": "系统",
          "text": "第九卷。"
        }
      ],
      "next": "59.1"
    },
    {
      "id": "59.1",
      "title": "霜驿",
      "lines": [
        {
          "speaker": "斥候",
          "text": "「霜驿」——假旗、假路、假和谈，三样里至少有一样。 此地多丘、林、垒。"
        },
        {
          "speaker": "春令使者",
          "text": "别在开阔地站成一排。弓手换位要快。"
        },
        {
          "speaker": "管事",
          "text": "别砸民居与作坊。砸了要赔，也要写进手记。"
        },
        {
          "speaker": "系统",
          "text": "出战「霜驿」。"
        }
      ],
      "battle": "ch59_frost",
      "unlock": [
        "ch59_frost_done"
      ],
      "next": "59.2"
    },
    {
      "id": "59.2",
      "title": "夜驿",
      "lines": [
        {
          "speaker": "苇原·灯影",
          "text": "「夜驿」——敌方不急着歼灭——他们急着让你们先乱。 此地多林、丘、垒。"
        },
        {
          "speaker": "管事",
          "text": "治疗跟主旗三步内。落单的人我会点名。"
        },
        {
          "speaker": "管事",
          "text": "别砸民居与作坊。砸了要赔，也要写进手记。"
        },
        {
          "speaker": "系统",
          "text": "出战「夜驿」。"
        }
      ],
      "battle": "ch59_night",
      "unlock": [
        "ch59_night_done"
      ],
      "next": "59.3"
    },
    {
      "id": "59.3",
      "title": "可霜驿",
      "lines": [
        {
          "speaker": "旁白",
          "text": "霜驿两印落下。旅馆写『可霜驿』。九卷中段钤印在下一章。"
        },
        {
          "speaker": "春令使者",
          "text": "下一章是九卷钤印。带上你最沉的人。"
        },
        {
          "speaker": "系统",
          "text": "第五十九章完成。"
        }
      ],

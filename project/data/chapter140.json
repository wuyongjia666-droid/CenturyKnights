{
  "id": "chapter140",
  "title": "第一百四十章·灯塔",
  "beats": [
    {
      "id": "140.0",
      "title": "灯塔令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可开市之后，灯塔要验的是：灰旗敢不敢把刀放短、把火放稳——火歪了，船会先从夜里撞上礁。"
        },
        {
          "speaker": "管事",
          "text": "两场：灯塔、守夜。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "灯塔西丘东垒。守夜场心有小垒，开阔。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸塔灯。砸了要写进王朝手记的黑页——无灯之塔等于无夜。"
        },
        {
          "speaker": "系统",
          "text": "第二十二卷后半。"
        }
      ],
      "next": "140.1"
    },
    {
      "id": "140.1",
      "title": "灯塔",
      "lines": [
        {
          "speaker": "斥候",
          "text": "灯塔被撬，好灯堆在东垒。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护塔灯，别把战拖成纵火。"
        },
        {
          "speaker": "管事",
          "text": "西丘掩护，东垒夺灯。"
        },
        {
          "speaker": "系统",
          "text": "出战「灯塔」。"
        }
      ],
      "battle": "ch140_tower",
      "unlock": [
        "ch140_tower_done"
      ],
      "next": "140.2"
    },
    {
      "id": "140.2",
      "title": "守夜",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "守夜场有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "场心垒禁乱火，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清索再守夜。火不稳，席终盖不下印。"
        },
        {
          "speaker": "春令使者",
          "text": "火一灭，满城的夜都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「守夜」。"
        }
      ],
      "battle": "ch140_vigil",
      "unlock": [
        "ch140_vigil_done"
      ],
      "next": "140.3"
    },
    {
      "id": "140.3",
      "title": "可塔夜",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可塔夜』。下一章是二十二卷席终——要把灯市的姓真正写入旗角。"
        },
        {
          "speaker": "春令使者",
          "text": "席终不是歇灯。是还敢不敢让满城看灰旗的灯花笺。"
        },
        {
          "speaker": "系统",
          "text": "第一百四十章完成。"
        }
      ],

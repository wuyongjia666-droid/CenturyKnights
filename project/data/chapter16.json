      ],
      "next": "16.3"
    },
    {
      "id": "16.3",
      "title": "双烽台",
      "lines": [
        {
          "speaker": "旁白",
          "text": "海与草的信号要在双烽台会合。灭一台，远征名册就缺一页。"
        },
        {
          "speaker": "春令使者",
          "text": "守住两台。写上『可远征』。"
        },
        {
          "speaker": "系统",
          "text": "出战「双烽台」。"
        }
      ],
      "battle": "ch16_beacon",
      "unlock": [
        "ch16_beacon_done"
      ],
      "next": "16.4"
    },
    {
      "id": "16.4",
      "title": "可远征",
      "lines": [
        {
          "speaker": "旁白",
          "text": "三场落下。灰旗『可远征』。海与草都在名册上留了印。"
        },
        {
          "speaker": "系统",
          "text": "第十六章完成。可进入第十七章·盐河风暴。"

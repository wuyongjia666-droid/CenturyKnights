{
  "id": "chapter16",
  "title": "第十六章·海与草原",
  "beats": [
    {
      "id": "16.0",
      "title": "更远的风",
      "lines": [
        {
          "speaker": "旁白",
          "text": "已执百年之后，更远的风从海与草原同时吹来——港市要灰旗护航，草原要灰旗认路。第二卷的棋盘展开了。"
        },
        {
          "speaker": "管事",
          "text": "三场开篇：海风哨口、草原驿路、双烽台。打完，旅馆才会写上『可远征』。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "双嗣校场现在会把真人送上阵。敌宅契约也可改约或撕毁。"
        },
        {
          "speaker": "系统",
          "text": "第二卷开启。"
        }
      ],
      "next": "16.1"
    },
    {
      "id": "16.1",
      "title": "海风哨口",
      "lines": [
        {
          "speaker": "斥候",
          "text": "哨口临水。护住航标，港市才肯借船。"
        },
        {
          "speaker": "系统",
          "text": "出战「海风哨口」。"
        }
      ],
      "battle": "ch16_sea",
      "unlock": [
        "ch16_sea_done"
      ],
      "next": "16.2"
    },
    {
      "id": "16.2",
      "title": "草原驿路",
      "lines": [
        {
          "speaker": "旁白",
          "text": "航标未冷，草原驿路又断。有人要灰旗在草上认路。"
        },
        {
          "speaker": "老旗手",
          "text": "路阔。骑冲与连射能撕开口子。"
        },
        {
          "speaker": "系统",
          "text": "出战「草原驿路」。"
        }
      ],
      "battle": "ch16_grass",
      "unlock": [

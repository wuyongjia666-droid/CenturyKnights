{
  "id": "chapter101",
  "title": "第一百零一章·驯场",
  "beats": [
    {
      "id": "101.0",
      "title": "驯场令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可马厩之后，驯场要验的是：灰旗敢不敢在圆环里把刀收短——圈太紧，坐骑会先把骑士甩下旗。"
        },
        {
          "speaker": "管事",
          "text": "两场：驯场、辔头。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "场心有垒丘环。辔头在跑道边，窄。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸辔架。砸了要写进王朝手记的黑页——骑士无辔等于无旗。"
        },
        {
          "speaker": "系统",
          "text": "第十六卷。"
        }
      ],
      "next": "101.1"
    },
    {
      "id": "101.1",
      "title": "驯场",
      "lines": [
        {
          "speaker": "斥候",
          "text": "驯场门封，生马在环心。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "破门先护环心槽，别把战拖成围猎。"
        },
        {
          "speaker": "管事",
          "text": "顺环推进。逆环会惊马。"
        },
        {
          "speaker": "系统",
          "text": "出战「驯场」。"
        }
      ],
      "battle": "ch101_ring",
      "unlock": [
        "ch101_ring_done"
      ],
      "next": "101.2"
    },
    {
      "id": "101.2",
      "title": "辔头",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "辔架被撬。铁环散了一地。"
        },
        {
          "speaker": "斥候",
          "text": "跑道护架禁火，主架在心。"
        },
        {
          "speaker": "管事",
          "text": "清贼再拾辔。辔不全，下一章马印盖不下去。"
        },
        {
          "speaker": "系统",
          "text": "出战「辔头」。"
        }
      ],
      "battle": "ch101_bit",
      "unlock": [
        "ch101_bit_done"
      ],
      "next": "101.3"
    },
    {
      "id": "101.3",
      "title": "可驯辔",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可驯辔』。下一章是十六卷钤印——马印。"
        },
        {
          "speaker": "春令使者",
          "text": "马印烙在鞍下。烙歪了，马市不认。"
        },
        {
          "speaker": "系统",
          "text": "第一百零一章完成。"
        }
      ],
      "unlock": [
        "chapter101_done"
      ],

{
  "id": "chapter218",
  "title": "第二百一十八章·独擂",
  "beats": [
    {
      "id": "218.0",
      "title": "独擂令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可鼓架之后，独擂与夜擂要验：灰旗敢不敢把刀放短、把面放稳。"
        },
        {
          "speaker": "管事",
          "text": "两场：独擂、夜擂。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "独擂水镜桥心。夜擂林环，内有心台。"
        },
        {
          "speaker": "老旗手",
          "text": "别踏碎镜水。碎了写进王朝手记——无镜之鼓等于无楼。"
        },
        {
          "speaker": "系统",
          "text": "第三十五卷后半。"
        }
      ],
      "next": "218.1"
    },
    {
      "id": "218.1",
      "title": "独擂",
      "lines": [
        {
          "speaker": "斥候",
          "text": "独擂水镜被拦，桥心有人。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "择桥夺心，别浪游深水。"
        },
        {
          "speaker": "管事",
          "text": "护桥清射，再夺心台。"
        },
        {
          "speaker": "系统",
          "text": "出战「独擂」。"
        }
      ],
      "battle": "ch218_solo",
      "unlock": [
        "ch218_solo_done"
      ],
      "next": "218.2"
    },
    {
      "id": "218.2",
      "title": "夜擂",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "夜擂林环有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "外林内心，禁乱砸，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清林再夺台。拍不稳，席终盖不下。"
        },
        {
          "speaker": "春令使者",
          "text": "拍一散，满楼的鼓都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「夜擂」。"
        }
      ],
      "battle": "ch218_night",
      "unlock": [
        "ch218_night_done"
      ],
      "next": "218.3"
    },
    {
      "id": "218.3",
      "title": "可夜",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可夜擂』。下一章是席终。"
        },
        {
          "speaker": "春令使者",
          "text": "席终不是歇拍。是还敢不敢把姓配进最后一鼓。"
        },
        {
          "speaker": "系统",
          "text": "第二百一十八章完成。"
        }
      ],
      "unlock": [
        "chapter218_done"
      ],

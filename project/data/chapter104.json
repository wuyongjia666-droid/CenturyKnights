{
  "id": "chapter104",
  "title": "第一百零四章·鞍房",
  "beats": [
    {
      "id": "104.0",
      "title": "鞍房令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可开市之后，鞍房要验的是：灰旗敢不敢把刀放短、把鞍放稳——鞍歪了，旗会先从骑士背上摔下去。"
        },
        {
          "speaker": "管事",
          "text": "两场：鞍房、试骑。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "鞍房西丘东垒。试骑场心有小垒，开阔。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸鞍架。砸了要写进王朝手记的黑页——无鞍之骑等于无旗。"
        },
        {
          "speaker": "系统",
          "text": "第十六卷后半。"
        }
      ],
      "next": "104.1"
    },
    {
      "id": "104.1",
      "title": "鞍房",
      "lines": [
        {
          "speaker": "斥候",
          "text": "鞍房被撬，好鞍堆在东垒。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护鞍架，别把战拖成拆屋。"
        },
        {
          "speaker": "管事",
          "text": "西丘掩护，东垒夺鞍。"
        },
        {
          "speaker": "系统",
          "text": "出战「鞍房」。"
        }
      ],
      "battle": "ch104_saddle",
      "unlock": [
        "ch104_saddle_done"
      ],
      "next": "104.2"
    },
    {
      "id": "104.2",
      "title": "试骑",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "试骑场有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "场心垒禁火，主骑线在中。"
        },
        {
          "speaker": "管事",
          "text": "清索再试骑。骑不稳，席终盖不下印。"
        },
        {
          "speaker": "系统",
          "text": "出战「试骑」。"
        }
      ],
      "battle": "ch104_gallop",
      "unlock": [
        "ch104_gallop_done"
      ],
      "next": "104.3"
    },
    {
      "id": "104.3",
      "title": "可鞍骑",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可鞍骑』。下一章是十六卷席终——要把马市的姓真正写入旗角。"
        },
        {
          "speaker": "春令使者",
          "text": "席终不是歇市。是还敢不敢让满市看灰旗的蹄印。"
        },
        {
          "speaker": "系统",
          "text": "第一百零四章完成。"
        }
      ],

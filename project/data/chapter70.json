{
  "id": "chapter70",
  "title": "第七十章·窑口",
  "beats": [
    {
      "id": "70.0",
      "title": "窑火令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "十卷席终之后，旅馆墙上贴的不是井拓，是一片窑汗渍透的匣钵碎片。十一卷不靠水声，也不靠北风与台阶——它靠火温：火够不够，坯才肯认姓。"
        },
        {
          "speaker": "管事",
          "text": "两场：窑口、匣钵。打完，旅馆写『可窑口』。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "窑口丘多。匣钵像货架林墙，别迷路。"
        },
        {
          "speaker": "老旗手",
          "text": "窑火认的不是旗新不新，是你还敢不敢把姓烤进釉里。"
        },
        {
          "speaker": "系统",
          "text": "第十一卷·窑火开启。"
        }
      ],
      "next": "70.1"
    },
    {
      "id": "70.1",
      "title": "窑口",
      "lines": [
        {
          "speaker": "斥候",
          "text": "窑口灰丘埋伏。"
        },
        {
          "speaker": "管事",
          "text": "夺中心窑堡，别站出烟口下风。"
        },
        {
          "speaker": "系统",
          "text": "出战「窑口」。"
        }
      ],
      "battle": "ch70_kiln",
      "unlock": [
        "ch70_kiln_done"
      ],
      "next": "70.2"
    },
    {
      "id": "70.2",
      "title": "匣钵",
      "lines": [
        {
          "speaker": "管事",
          "text": "匣钵网格如货架。"
        },
        {
          "speaker": "老旗手",
          "text": "沿廊推进，别推倒匣钵架。"
        },
        {
          "speaker": "系统",
          "text": "出战「匣钵」。"
        }
      ],
      "battle": "ch70_sagger",

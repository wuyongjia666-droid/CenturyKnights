{
  "id": "chapter176",
  "title": "第一百七十六章·避雨",
  "beats": [
    {
      "id": "176.0",
      "title": "避雨令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可开市之后，避雨要验的是：灰旗敢不敢把刀放短、把伞放稳——伞歪了，人会先从雨里倒进空票。"
        },
        {
          "speaker": "管事",
          "text": "两场：避雨、守巷。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "避雨长檐横厅。守巷林廊如迷宫，节点有垒。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸伞骨。砸了要写进王朝手记的黑页——无伞之避等于无街。"
        },
        {
          "speaker": "系统",
          "text": "第二十八卷后半。"
        }
      ],
      "next": "176.1"
    },
    {
      "id": "176.1",
      "title": "避雨",
      "lines": [
        {
          "speaker": "斥候",
          "text": "避雨檐被撬，好伞堆在心垒。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护伞火，别把战拖成湿街。长檐下积水，别踩洼。"
        },
        {
          "speaker": "管事",
          "text": "檐下掩护，心垒夺伞。"
        },
        {
          "speaker": "系统",
          "text": "出战「避雨」。"
        }
      ],
      "battle": "ch176_shelter",
      "unlock": [
        "ch176_shelter_done"
      ],
      "next": "176.2"
    },
    {
      "id": "176.2",
      "title": "守巷",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "守巷林廊有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "廊如迷宫，节点垒禁乱火，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清索再守巷。火不稳，席终盖不下印。"
        },
        {
          "speaker": "春令使者",
          "text": "巷一淹，满街的伞都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「守巷」。"
        }
      ],
      "battle": "ch176_hold",
      "unlock": [
        "ch176_hold_done"
      ],
      "next": "176.3"
    },
    {
      "id": "176.3",
      "title": "可守巷",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可守巷』。下一章是二十八卷席终——要把雨巷的姓真正写入旗角。"
        },
        {
          "speaker": "春令使者",
          "text": "席终不是歇伞。是还敢不敢让满街看灰旗的檐笺。"
        },
        {
          "speaker": "系统",
          "text": "第一百七十六章完成。"
        }
      ],

      "lines": [
        {
          "speaker": "老旗手",
          "text": "祝爵场有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "场心垒禁火，主爵线在中。"
        },
        {
          "speaker": "管事",
          "text": "清索再祝爵。爵不稳，席终盖不下印。"
        },
        {
          "speaker": "系统",
          "text": "出战「祝爵」。"

      "lines": [
        {
          "speaker": "旁白",
          "text": "七卷钤印。余烬与冠火之间，印要烫手——烫手才记得中段不是歇脚处。"
        },
        {
          "speaker": "管事",
          "text": "钤印。敌酋在场。"
        },
        {
          "speaker": "系统",
          "text": "第四十八章·钤印。"
        }
      ]
    },
    {
      "id": "48.1",
      "title": "七卷钤印",
      "battle": "ch48_seal",
      "unlock": [
        "ch48_seal_done"
      ],
      "next": "48.2",
      "lines": [
        {
          "speaker": "斥候",
          "text": "敌方精锐压阵。钤印台在中央，左右丘林可作掩护，也可成埋伏。"
        },
        {
          "speaker": "管事",
          "text": "先清射，再夺台。别被佯攻引到没掩护的空地。"
        },
        {
          "speaker": "老旗手",
          "text": "重步顶中，轻步侧袭。治疗贴旗手。"
        },
        {
          "speaker": "系统",
          "text": "出战「七卷钤印」。"
        }
      ]
    },
    {
      "id": "48.2",
      "title": "七卷中段",
      "unlock": [
        "chapter48_done",
        "volume7_mid_done"
      ],
      "next": null,
      "lines": [
        {
          "speaker": "旁白",
          "text": "钤印落下。风从余烬那边停住片刻。陆桥旅馆写入『七卷中段』。火灭过，也燃过；印落了，路还没完。"
        },
        {
          "speaker": "春令使者",
          "text": "七卷还没有席终——但中段已执。后半会是烬原与百旗，再往后才是席终。"
        },
        {
          "speaker": "管事",
          "text": "军饷已加。可回堡经营，也可继续主线。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "双嗣校场与敌宅契约仍可用。中段之后，月中事件会更勤。"
        },
        {
          "speaker": "系统",
          "text": "第四十八章完成。"
        }
      ]
    }
  ]
}
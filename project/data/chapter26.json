      "title": "冠雪令",
      "next": "26.1",
      "lines": [
        {
          "speaker": "旁白",
          "text": "冠雪压在盔上。雪不重，重的是谁还肯在雪里报出灰旗两个字。"
        },
        {
          "speaker": "管事",
          "text": "冠雪。注意丘地。"
        },
        {
          "speaker": "系统",
          "text": "第二十六章·冠雪。"
        }
      ]
    },
    {
      "id": "26.1",
      "title": "冠雪关",
      "battle": "ch26_snow",
      "unlock": [
        "ch26_snow_done"
      ],
      "next": "26.2",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "「冠雪关」——这里一仗，赢的不只是地，是旅馆墙上那一行字还改不改。 此地多林、丘、水。"
        },
        {
          "speaker": "斥候",
          "text": "夺林之后立刻成阵，别恋战收割。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "活口留一个。问清背后宅邸。"
        },
        {
          "speaker": "系统",
          "text": "出战「冠雪关」。"
        }
      ]
    },
    {
      "id": "26.2",
      "title": "冠峰守",
      "battle": "ch26_peak",
      "unlock": [
        "ch26_peak_done"
      ],
      "next": "26.3",
      "lines": [
        {
          "speaker": "春令使者",
          "text": "「冠峰守」——风从敌阵那边过来，带着金属味。 此地多丘、垒。"
        },
        {
          "speaker": "老旗手",
          "text": "两路：一路粘住正面，一路从丘摸进去。"
        },
        {
          "speaker": "斥候",
          "text": "主旗居中，两翼用呼号，不靠眼神。"
        },
        {
          "speaker": "系统",
          "text": "出战「冠峰守」。"
        }
      ]
    },
    {
      "id": "26.3",
      "title": "冠雪两印",
      "unlock": [
        "chapter26_done"
      ],
      "next": null,
      "lines": [
        {
          "speaker": "旁白",
          "text": "第二十六章·冠雪到了收束处。风停一刻，墨才能干。"
        },
        {
          "speaker": "春令使者",
          "text": "印若已落，便可回堡，也可继续下一章。灰旗的路，从来不是单行。"
        },
        {
          "speaker": "管事",
          "text": "银粮与声望已按章结算。旗手歇口气。"
        },
        {
          "speaker": "系统",
          "text": "第二十六章完成。"
        }
      ]
    }
  ]

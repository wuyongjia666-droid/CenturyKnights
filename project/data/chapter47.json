      "next": "47.3",
      "lines": [
        {
          "speaker": "旁白",
          "text": "城垣既清，炉心的热浪却迎面扑来。炉火旁站着的人，不是来取暖的——他们要看灰旗怕不怕烫。"
        },
        {
          "speaker": "斥候",
          "text": "炉心精锐已列阵。热浪会干扰近战节奏，治疗跟紧。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "守住炉心，火印才算落下。伤员往后撤，旗手顶前。"
        },
        {
          "speaker": "系统",
          "text": "出战「冠火炉心」。"
        }
      ]
    },
    {
      "id": "47.3",
      "title": "火印",
      "unlock": [
        "chapter47_done"
      ],
      "next": null,
      "lines": [
        {
          "speaker": "旁白",
          "text": "冠火两印落下。族谱上「火」字烫手，却也烫得人清醒：七卷的路，是从余烬走到冠火，再走到钤印。"
        },
        {
          "speaker": "春令使者",
          "text": "下一章是七卷钤印——中段收束。能改约的契约，趁现在看一眼。"
        },
        {
          "speaker": "管事",
          "text": "银粮已结。可回堡，也可继续。"
        },
        {
          "speaker": "系统",
          "text": "第四十七章完成。"
        }
      ]
    }

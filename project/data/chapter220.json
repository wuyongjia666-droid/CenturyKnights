{
  "id": "chapter220",
  "title": "第二百二十章·香市",
  "beats": [
    {
      "id": "220.0",
      "title": "香市令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "三十五卷已执。第三十六卷·香市要验的是：灰旗敢不敢把脚放稳、把烟放清——烟乱了，香会先从市上散成空旗。"
        },
        {
          "speaker": "管事",
          "text": "两场：香市、香堂。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "香市炉池星布。香堂中隔，桥口错落。"
        },
        {
          "speaker": "老旗手",
          "text": "别翻香炉。翻了写进黑页——空炉等于空香。"
        },
        {
          "speaker": "系统",
          "text": "第三十六卷中段。"
        }
      ],
      "next": "220.1"
    },
    {
      "id": "220.1",
      "title": "香市",
      "lines": [
        {
          "speaker": "斥候",
          "text": "香市炉池被撬，好香堆在心垒。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护烟，别把战拖成灰雾。"
        },
        {
          "speaker": "管事",
          "text": "清池掩护，心垒夺香。"
        },
        {
          "speaker": "系统",
          "text": "出战「香市」。"
        }
      ],
      "battle": "ch220_market",
      "unlock": [
        "ch220_market_done"
      ],
      "next": "220.2"
    },
    {
      "id": "220.2",
      "title": "香堂",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "香堂中隔有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "外市内堂，桥口禁乱踏，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清桥再夺垒。烟不稳，烟径开不了。"
        },
        {
          "speaker": "春令使者",
          "text": "堂一散，满市的香都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「香堂」。"
        }
      ],
      "battle": "ch220_hall",
      "unlock": [
        "ch220_hall_done"
      ],
      "next": "220.3"
    },
    {
      "id": "220.3",
      "title": "可堂",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可香堂』。下一章是烟径。"
        },
        {
          "speaker": "春令使者",
          "text": "烟径不是歇烟。是还敢不敢成烟。"
        },
        {
          "speaker": "系统",
          "text": "第二百二十章完成。"
        }
      ],

        {
          "speaker": "旁白",
          "text": "六卷钤印。雾原与石冢之后，印盖在雾散的那一刻——雾还在，印就虚。"
        },
        {
          "speaker": "管事",
          "text": "钤印。看清地形再动。"
        },
        {
          "speaker": "系统",
          "text": "第四十二章·钤印。"
        }
      ]
    },

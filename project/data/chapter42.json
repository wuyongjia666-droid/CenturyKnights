      "lines": [
        {
          "speaker": "斥候",
          "text": "「六卷钤印」敌阵已立。地形与编制都会骗人——骗人的地方先搜。"
        },
        {
          "speaker": "管事",
          "text": "按地形展开：先清射界与侧翼，再向心推进。别浪冲成一串靶。"
        },
        {
          "speaker": "老旗手",
          "text": "护旗。技能别藏到用不上的时候。败了可重试，旗与名册不能丢。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "治疗跟紧主旗。落单的人最先死在『看起来安全』的格子上。"
        },
        {
          "speaker": "系统",
          "text": "出战「六卷钤印」。"
        }
      ]
    },
    {
      "id": "42.2",
      "title": "六卷中段",
      "unlock": [
        "chapter42_done",
        "volume6_mid_done"
      ],
      "next": null,
      "lines": [
        {
          "speaker": "旁白",
          "text": "第四十二章·钤印到了收束处。风停一刻，墨才能干。"
        },
        {
          "speaker": "春令使者",
          "text": "印若已落，便可回堡，也可继续下一章。灰旗的路，从来不是单行。"
        },
        {
          "speaker": "管事",
          "text": "银粮与声望已按章结算。旗手歇口气。"
        },
        {
          "speaker": "系统",
          "text": "第四十二章完成（v1.8）。"
        }
      ]
    }

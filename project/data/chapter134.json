{
  "id": "chapter134",
  "title": "第一百三十四章·甲库",
  "beats": [
    {
      "id": "134.0",
      "title": "甲库令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可开市之后，甲库要验的是：灰旗敢不敢把刀放短、把甲放稳——甲歪了，旗会先从骑士背上摔下去。"
        },
        {
          "speaker": "管事",
          "text": "两场：甲库、试甲。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "甲库西丘东垒。试甲场心有小垒，开阔。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸甲架。砸了要写进王朝手记的黑页——无甲之骑等于无旗。"
        },
        {
          "speaker": "系统",
          "text": "第二十一卷后半。"
        }
      ],
      "next": "134.1"
    },
    {
      "id": "134.1",
      "title": "甲库",
      "lines": [
        {
          "speaker": "斥候",
          "text": "甲库被撬，好甲堆在东垒。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护甲架，别把战拖成拆屋。"
        },
        {
          "speaker": "管事",
          "text": "西丘掩护，东垒夺甲。"
        },
        {
          "speaker": "系统",
          "text": "出战「甲库」。"
        }
      ],
      "battle": "ch134_armory",
      "unlock": [
        "ch134_armory_done"
      ],
      "next": "134.2"
    },
    {
      "id": "134.2",
      "title": "试甲",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "试甲场有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "场心垒禁乱火，主试线在中。"
        },
        {
          "speaker": "管事",
          "text": "清索再试甲。甲不稳，席终盖不下印。"
        },
        {
          "speaker": "春令使者",
          "text": "甲一裂，满市的骑都会裸。"
        },
        {
          "speaker": "系统",
          "text": "出战「试甲」。"
        }
      ],
      "battle": "ch134_plate",
      "unlock": [
        "ch134_plate_done"
      ],
      "next": "134.3"
    },
    {
      "id": "134.3",
      "title": "可甲试",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可甲试』。下一章是二十一卷席终——要把铜市的姓真正写入旗角。"
        },
        {
          "speaker": "春令使者",
          "text": "席终不是歇炉。是还敢不敢让满市看灰旗的炉票。"
        },
        {
          "speaker": "系统",
          "text": "第一百三十四章完成。"
        }

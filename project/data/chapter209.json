{
  "id": "chapter209",
  "title": "第二百零九章·晾竿",
  "beats": [
    {
      "id": "209.0",
      "title": "晾竿令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可缸之后，晾竿与榨色要验：灰旗敢不敢把刀放短、把布放稳。"
        },
        {
          "speaker": "管事",
          "text": "两场：晾竿、榨色。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "晾竿水格交错。榨色盘格棋布，内有心垒。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸竿脚。砸了写进王朝手记——无竿之色等于无坊。"
        },
        {
          "speaker": "系统",
          "text": "第三十四卷中段。"
        }
      ],
      "next": "209.1"
    },
    {
      "id": "209.1",
      "title": "晾竿",
      "lines": [
        {
          "speaker": "斥候",
          "text": "晾竿水格被拦，心垒有人。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "择格夺心，别浪踏湿布。"
        },
        {
          "speaker": "管事",
          "text": "护竿清射，再夺心垒。"
        },
        {
          "speaker": "系统",
          "text": "出战「晾竿」。"
        }
      ],
      "battle": "ch209_rack",
      "unlock": [
        "ch209_rack_done"
      ],
      "next": "209.2"
    },
    {
      "id": "209.2",
      "title": "榨色",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "榨色盘格有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "外盘内心，禁乱踏，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清盘再夺台。色不稳，染印盖不下。"
        },
        {
          "speaker": "春令使者",
          "text": "盘一散，满坊的色都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「榨色」。"
        }
      ],
      "battle": "ch209_press",
      "unlock": [
        "ch209_press_done"
      ],
      "next": "209.3"
    },
    {
      "id": "209.3",
      "title": "可榨",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可榨』。下一章是染印。"
        },
        {
          "speaker": "春令使者",
          "text": "染印不是歇色。是还敢不敢续染。"
        },
        {
          "speaker": "系统",
          "text": "第二百零九章完成。"
        }
      ],

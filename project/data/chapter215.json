{
  "id": "chapter215",
  "title": "第二百一十五章·擂台",
  "beats": [
    {
      "id": "215.0",
      "title": "擂台令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可鼓廊之后，擂台与夜鼓要验：灰旗敢不敢把刀放短、把面放稳。"
        },
        {
          "speaker": "管事",
          "text": "两场：擂台、夜鼓。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "擂台丘环居中。夜鼓棋格交错，内有心垒。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸台边。砸了写进王朝手记——无台之鼓等于无楼。"
        },
        {
          "speaker": "系统",
          "text": "第三十五卷中段。"
        }
      ],
      "next": "215.1"
    },
    {
      "id": "215.1",
      "title": "擂台",
      "lines": [
        {
          "speaker": "斥候",
          "text": "擂台丘环被拦，心垒有人。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "择丘夺心，别浪踏软面。"
        },
        {
          "speaker": "管事",
          "text": "护丘清射，再夺心垒。"
        },
        {
          "speaker": "系统",
          "text": "出战「擂台」。"
        }
      ],
      "battle": "ch215_beat",
      "unlock": [
        "ch215_beat_done"
      ],
      "next": "215.2"
    },
    {
      "id": "215.2",
      "title": "夜鼓",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "夜鼓棋格有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "外格内心，禁乱踏，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清格再夺台。拍不稳，鼓印盖不下。"
        },
        {
          "speaker": "春令使者",
          "text": "格一散，满楼的鼓都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「夜鼓」。"
        }
      ],
      "battle": "ch215_night",
      "unlock": [
        "ch215_night_done"
      ],
      "next": "215.3"
    },
    {
      "id": "215.3",
      "title": "可夜",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可夜鼓』。下一章是鼓印。"
        },
        {
          "speaker": "春令使者",
          "text": "鼓印不是歇拍。是还敢不敢续擂。"
        },
        {
          "speaker": "系统",
          "text": "第二百一十五章完成。"
        }
      ],
      "unlock": [
        "chapter215_done"
      ],

{
  "id": "chapter194",
  "title": "第一百九十四章·独奏",
  "beats": [
    {
      "id": "194.0",
      "title": "独奏令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可开市之后，独奏要验的是：灰旗敢不敢把刀放短、把声放稳——声歪了，曲会先从台上倒进空票。"
        },
        {
          "speaker": "管事",
          "text": "两场：独奏、夜曲。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "独奏水环孤台。夜曲林环双垒，桥通中廊。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸笛孔。砸了要写进王朝手记的黑页——无声之独等于无曲。"
        },
        {
          "speaker": "系统",
          "text": "第三十一卷后半。"
        }
      ],
      "next": "194.1"
    },
    {
      "id": "194.1",
      "title": "独奏",
      "lines": [
        {
          "speaker": "斥候",
          "text": "独奏台被撬，好笛堆在岛台。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护笛火，别把战拖成哑台。择桥再登。"
        },
        {
          "speaker": "管事",
          "text": "择桥掩护，岛台夺笛。"
        },
        {
          "speaker": "系统",
          "text": "出战「独奏」。"
        }
      ],
      "battle": "ch194_solo",
      "unlock": [
        "ch194_solo_done"
      ],
      "next": "194.2"
    },
    {
      "id": "194.2",
      "title": "夜曲",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "夜曲林环有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "双垒分据，中廊禁乱火，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "先近后远。火不稳，席终盖不下印。"
        },
        {
          "speaker": "春令使者",
          "text": "曲一哑，满楼的夜都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「夜曲」。"
        }
      ],
      "battle": "ch194_night",
      "unlock": [
        "ch194_night_done"
      ],
      "next": "194.3"
    },
    {
      "id": "194.3",
      "title": "可夜曲",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可夜曲』。下一章是三十一卷席终——要把笛楼的姓真正写入旗角。"
        },
        {
          "speaker": "春令使者",
          "text": "席终不是歇管。是还敢不敢让满楼听灰旗的声笺。"
        },
        {
          "speaker": "系统",
          "text": "第一百九十四章完成。"
        }
      ],

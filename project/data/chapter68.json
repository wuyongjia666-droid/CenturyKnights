{
  "id": "chapter68",
  "title": "第六十八章·纸坊",
  "beats": [
    {
      "id": "68.0",
      "title": "纸坊令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可盐路之后，纸坊的灯亮得过分客气。纸能写契约，也能写毁约书。墨渠里的墨，有人说是井市的第二口井。"
        },
        {
          "speaker": "管事",
          "text": "两场：纸坊、墨渠。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "纸坊像房间。墨渠斜切，别沿对角线浪冲。"
        },
        {
          "speaker": "老旗手",
          "text": "烧纸坊的人，配不上井市。护住纸垛。"
        },
        {
          "speaker": "系统",
          "text": "第十卷后半。"
        }
      ],
      "next": "68.1"
    },
    {
      "id": "68.1",
      "title": "纸坊",
      "lines": [
        {
          "speaker": "斥候",
          "text": "林墙围成坊。中廊有缺口。"
        },
        {
          "speaker": "管事",
          "text": "缺口切入，分两室清剿。别放火。"
        },
        {
          "speaker": "系统",
          "text": "出战「纸坊」。"
        }
      ],
      "battle": "ch68_paper",
      "unlock": [
        "ch68_paper_done"
      ],
      "next": "68.2"
    },
    {
      "id": "68.2",
      "title": "墨渠",
      "lines": [
        {
          "speaker": "旁白",
          "text": "纸坊既保，墨渠仍黑。黑里有刀，也有要灰旗签字的笔——笔比刀轻，毁约却更快。"
        },
        {
          "speaker": "老旗手",
          "text": "沿渠两侧推进。对角桥谨慎。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "治疗跟后。墨渠边站久了人会晕。"
        },
        {
          "speaker": "系统",
          "text": "出战「墨渠」。"
        }
      ],
      "battle": "ch68_ink",
      "unlock": [
        "ch68_ink_done"
      ],
      "next": "68.3"
    },
    {
      "id": "68.3",
      "title": "可纸墨",
      "lines": [
        {
          "speaker": "旁白",
          "text": "纸墨两印落下。旅馆写『可纸墨』。席终只剩最后一场——井市广场环水。"
        },
        {
          "speaker": "春令使者",
          "text": "下一章是十卷席终。把能带的都带上。"
        },
        {
          "speaker": "系统",
          "text": "第六十八章完成。"
        }
      ],
      "unlock": [
        "chapter68_done"
      ],

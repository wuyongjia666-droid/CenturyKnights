{
  "id": "chapter230",
  "title": "第二百三十章·独潮",
  "beats": [
    {
      "id": "230.0",
      "title": "独潮令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可潮架之后，独潮与夜退要验：灰旗敢不敢把刀放短、把壳放稳。"
        },
        {
          "speaker": "管事",
          "text": "两场：独潮、夜退。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "独潮水镜桥心。夜退林环，内有心台。"
        },
        {
          "speaker": "老旗手",
          "text": "别踏碎镜水。碎了写进王朝手记——无镜之潮等于无滩。"
        },
        {
          "speaker": "系统",
          "text": "第三十七卷后半。"
        }
      ],
      "next": "230.1"
    },
    {
      "id": "230.1",
      "title": "独潮",
      "lines": [
        {
          "speaker": "斥候",
          "text": "独潮水镜被拦，桥心有人。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "择桥夺心，别浪游深水。"
        },
        {
          "speaker": "管事",
          "text": "护桥清射，再夺心台。"
        },
        {
          "speaker": "系统",
          "text": "出战「独潮」。"
        }
      ],
      "battle": "ch230_solo",
      "unlock": [
        "ch230_solo_done"
      ],
      "next": "230.2"
    },
    {
      "id": "230.2",
      "title": "夜退",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "夜退林环有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "外林内心，禁乱踏，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清林再夺台。潮不稳，席终盖不下。"
        },
        {
          "speaker": "春令使者",
          "text": "潮一散，满滩的迹都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「夜退」。"
        }
      ],
      "battle": "ch230_night",
      "unlock": [
        "ch230_night_done"
      ],
      "next": "230.3"
    },
    {
      "id": "230.3",
      "title": "可夜",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可夜退』。下一章是席终。"
        },
        {
          "speaker": "春令使者",
          "text": "席终不是歇潮。是还敢不敢把姓配进最后一潮。"
        },
        {
          "speaker": "系统",
          "text": "第二百三十章完成。"
        }
      ],

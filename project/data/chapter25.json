      "title": "朔原烽",
      "battle": "ch25_plain",
      "unlock": [
        "ch25_plain_done"
      ],
      "next": "25.2",
      "lines": [
        {
          "speaker": "管事",
          "text": "「朔原烽」——这一格格子都像在等谁先心急。 此地多丘、林、垒。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "桥/窄路只过一人宽时，单列，掩护弓先到位。"
        },
        {
          "speaker": "老旗手",
          "text": "旗在，名册在，人可以撤；三者丢一，这一仗就算白打。"
        },
        {
          "speaker": "系统",
          "text": "出战「朔原烽」。"
        }
      ]
    },
    {
      "id": "25.2",
      "title": "朔脊夜",
      "battle": "ch25_ridge",
      "unlock": [
        "ch25_ridge_done"
      ],
      "next": "25.3",
      "lines": [
        {
          "speaker": "旁白",
          "text": "「朔脊夜」：旗帜可以湿，名册不能湿。"
        },
        {
          "speaker": "斥候",
          "text": "敌精锐靠后。前排散兵是诱饵，别追过深。"
        },
        {
          "speaker": "斥候",
          "text": "主旗居中，两翼用呼号，不靠眼神。"
        },
        {
          "speaker": "系统",
          "text": "出战「朔脊夜」。"
        }
      ]
    },
    {
      "id": "25.3",
      "title": "可朔原",
      "unlock": [
        "chapter25_done"
      ],
      "next": null,
      "lines": [
        {
          "speaker": "旁白",
          "text": "第二十五章·朔原到了收束处。风停一刻，墨才能干。"
        },
        {
          "speaker": "春令使者",
          "text": "印若已落，便可回堡，也可继续下一章。灰旗的路，从来不是单行。"
        },
        {
          "speaker": "管事",
          "text": "银粮与声望已按章结算。旗手歇口气。"
        },
        {
          "speaker": "系统",
          "text": "第二十五章完成。"
        }
      ]
    }
  ]

{
  "id": "chapter221",
  "title": "第二百二十一章·烟径",
  "beats": [
    {
      "id": "221.0",
      "title": "烟径令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可香堂之后，烟径与灰台要验：灰旗敢不敢把刀放短、把灰放稳。"
        },
        {
          "speaker": "管事",
          "text": "两场：烟径、灰台。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "烟径丘格交错。灰台炉格棋布，内有心垒。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸炉边。砸了写进王朝手记——无炉之香等于无市。"
        },
        {
          "speaker": "系统",
          "text": "第三十六卷中段。"
        }
      ],
      "next": "221.1"
    },
    {
      "id": "221.1",
      "title": "烟径",
      "lines": [
        {
          "speaker": "斥候",
          "text": "烟径丘格被拦，心垒有人。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "择丘夺心，别浪踏软灰。"
        },
        {
          "speaker": "管事",
          "text": "护丘清射，再夺心垒。"
        },
        {
          "speaker": "系统",
          "text": "出战「烟径」。"
        }
      ],
      "battle": "ch221_smoke",
      "unlock": [
        "ch221_smoke_done"
      ],
      "next": "221.2"
    },
    {
      "id": "221.2",
      "title": "灰台",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "灰台炉格有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "外台内心，禁乱踏，主守线在中。"
        },
        {
          "speaker": "管事",
          "text": "清台再夺心。烟不稳，香印盖不下。"
        },
        {
          "speaker": "春令使者",
          "text": "台一散，满市的香都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「灰台」。"
        }
      ],
      "battle": "ch221_ash",
      "unlock": [
        "ch221_ash_done"
      ],
      "next": "221.3"
    },
    {
      "id": "221.3",
      "title": "可灰",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可灰台』。下一章是香印。"
        },
        {
          "speaker": "春令使者",
          "text": "香印不是歇烟。是还敢不敢续香。"
        },
        {
          "speaker": "系统",
          "text": "第二百二十一章完成。"
        }
      ],

{
  "id": "chapter182",
  "title": "第一百八十二章·捺印",
  "beats": [
    {
      "id": "182.0",
      "title": "捺印令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可开市之后，捺印要验的是：灰旗敢不敢把刀放短、把墨放稳——墨歪了，字会先从案上倒进空票。"
        },
        {
          "speaker": "管事",
          "text": "两场：捺印、墨库。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "捺印双柱夹心。墨库丘套内室，门桥数处。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸印纽。砸了要写进王朝手记的黑页——无墨之捺等于无字。"
        },
        {
          "speaker": "系统",
          "text": "第二十九卷后半。"
        }
      ],
      "next": "182.1"
    },
    {
      "id": "182.1",
      "title": "捺印",
      "lines": [
        {
          "speaker": "斥候",
          "text": "捺印柱被撬，好印堆在心垒。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "清贼先护印火，别把战拖成糊案。双柱先合桥。"
        },
        {
          "speaker": "管事",
          "text": "合桥掩护，心垒夺印。"
        },
        {
          "speaker": "系统",
          "text": "出战「捺印」。"
        }
      ],
      "battle": "ch182_press",
      "unlock": [
        "ch182_press_done"
      ],
      "next": "182.2"
    },
    {
      "id": "182.2",
      "title": "墨库",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "墨库丘套有人投绊索。"
        },
        {
          "speaker": "斥候",
          "text": "外丘内室，侧室另有贼。场心垒禁乱火。"
        },
        {
          "speaker": "管事",
          "text": "破门再夺库。火不稳，席终盖不下印。"
        },
        {
          "speaker": "春令使者",
          "text": "库一糊，满市的字都会盲。"
        },
        {
          "speaker": "系统",
          "text": "出战「墨库」。"
        }
      ],
      "battle": "ch182_vault",
      "unlock": [
        "ch182_vault_done"
      ],
      "next": "182.3"
    },
    {
      "id": "182.3",
      "title": "可墨库",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可墨库』。下一章是二十九卷席终——要把砚市的姓真正写入旗角。"
        },
        {
          "speaker": "春令使者",
          "text": "席终不是歇墨。是还敢不敢让满市看灰旗的墨笺。"
        },
        {
          "speaker": "系统",
          "text": "第一百八十二章完成。"
        }
      ],

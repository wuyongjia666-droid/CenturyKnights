{
  "id": "chapter131",
  "title": "第一百三十一章·砧台",
  "beats": [
    {
      "id": "131.0",
      "title": "砧台令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可铜炉之后，砧台要验的是：灰旗敢不敢在火星里把刀收短——锤太乱，甲会先把旗砸扁。"
        },
        {
          "speaker": "管事",
          "text": "两场：砧台、铸模。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "砧心有垒。铸模有竖水槽。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸铸模。砸了要写进王朝手记的黑页——无模之铜等于无甲。"
        },
        {
          "speaker": "系统",
          "text": "第二十一卷。"
        }
      ],
      "next": "131.1"
    },
    {
      "id": "131.1",
      "title": "砧台",
      "lines": [
        {
          "speaker": "斥候",
          "text": "砧台门封，新锭在心。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "破门先护砧心，别把战拖成砸炉。"
        },
        {
          "speaker": "管事",
          "text": "顺火星推进。逆火会灼己。"
        },
        {
          "speaker": "系统",
          "text": "出战「砧台」。"
        }
      ],
      "battle": "ch131_anvil",
      "unlock": [
        "ch131_anvil_done"
      ],
      "next": "131.2"
    },
    {
      "id": "131.2",
      "title": "铸模",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "铸模被撬。铜水散了一地。"
        },
        {
          "speaker": "斥候",
          "text": "水槽护模禁乱锤，主模在心。"
        },
        {
          "speaker": "管事",
          "text": "清贼再合模。模不全，下一章铜印盖不下去。"
        },
        {
          "speaker": "系统",
          "text": "出战「铸模」。"
        }
      ],
      "battle": "ch131_mold",
      "unlock": [

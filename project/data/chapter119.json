{
  "id": "chapter119",
  "title": "第一百一十九章·潮汐",
  "beats": [
    {
      "id": "119.0",
      "title": "潮汐令",
      "lines": [
        {
          "speaker": "旁白",
          "text": "可码头之后，潮汐要验的是：灰旗敢不敢在涨落之间把刀收短——潮太急，船会先把旗冲走。"
        },
        {
          "speaker": "管事",
          "text": "两场：潮汐、礁口。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "潮道双桥。礁口丘环，窄。"
        },
        {
          "speaker": "老旗手",
          "text": "别砸灯塔桩。砸了要写进王朝手记的黑页——无灯之港等于无旗。"
        },
        {
          "speaker": "系统",
          "text": "第十九卷。"
        }
      ],
      "next": "119.1"
    },
    {
      "id": "119.1",
      "title": "潮汐",
      "lines": [
        {
          "speaker": "斥候",
          "text": "潮道被封，渔船困在桥间。"
        },
        {
          "speaker": "苇原·灯影",
          "text": "破封先护桥心船，别把战拖成沉港。"
        },
        {
          "speaker": "管事",
          "text": "顺潮推进。逆潮会搁浅。"
        },
        {
          "speaker": "系统",
          "text": "出战「潮汐」。"
        }
      ],
      "battle": "ch119_tide",
      "unlock": [
        "ch119_tide_done"
      ],
      "next": "119.2"
    },
    {
      "id": "119.2",
      "title": "礁口",
      "lines": [
        {
          "speaker": "老旗手",
          "text": "礁口灯桩被撬。"
        },
        {
          "speaker": "斥候",
          "text": "丘环护桩禁火，主灯在心。"
        },
        {
          "speaker": "管事",
          "text": "清贼再升灯。灯不全，下一章港印盖不下去。"
        },
        {
          "speaker": "系统",
          "text": "出战「礁口」。"
        }
      ],
      "battle": "ch119_reef",
      "unlock": [
        "ch119_reef_done"
      ],
      "next": "119.3"
    },
    {
      "id": "119.3",
      "title": "可潮礁",
      "lines": [
        {
          "speaker": "旁白",
          "text": "两印落下。旅馆写『可潮礁』。下一章是十九卷钤印——港印。"
        },
        {
          "speaker": "春令使者",
          "text": "港印盖在舵柄。盖歪了，渔港不认。"
        },
        {
          "speaker": "系统",
          "text": "第一百一十九章完成。"
        }
      ],
